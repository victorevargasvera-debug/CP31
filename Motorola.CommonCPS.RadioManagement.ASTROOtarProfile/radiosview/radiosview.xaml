<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.ASTROOtarProfile.RadiosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure"
	Name="uscRadios" xmlns:astrootarprofile="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTROOtarProfile">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.ASTROOtarProfile;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:SystemTypeConverter
				x:Key="systemTypeConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 2-->
	<controls:RMDataGrid
		Name="dgrRadios"
		igDP:GroupByAreaLocation="None"
		CRUDToolBarVisibility="Visible"
		igDP:DataSource="{Binding Items}"
		SearchCommand="{Binding SearchCommand}"
		infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
		IsLoadingItemsFromViewCache="{Binding IsLoadingItemsFromViewCache}">
		<igDP:DataPresenterBase.FieldLayouts>
			<igDP:FieldLayout>
				<igDP:FieldLayout.Fields>
					<igDP:Field
						Name="SerialNumber"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Radio_SerialNumber}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.CellValuePresenterStyle>
									<Style
										TargetType="{x:Type igDP:CellValuePresenter}">
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type igDP:CellValuePresenter}">
													<TextBlock
														Margin="{TemplateBinding Padding}"
														VerticalAlignment="Center">
														<controls:RMHyperlink
															Command="{Binding Path=DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
															CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
															<TextBlock
																Text="{Binding Path=Value, RelativeSource={RelativeSource TemplatedParent}}" />
														</controls:RMHyperlink>
													</TextBlock>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</igDP:FieldSettings.CellValuePresenterStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="ConfigurationName"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Radio_Configuration}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										BasedOn="{StaticResource rmTextEditorStyle}"
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="TemplateName"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Radio_Template}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										BasedOn="{StaticResource rmTextEditorStyle}"
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="RadioAlias"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Radio_Alias}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										BasedOn="{StaticResource rmTextEditorStyle}"
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="OtarProfileName"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Otar_Profile_Name}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.CellValuePresenterStyle>
									<Style
										TargetType="{x:Type igDP:CellValuePresenter}">
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type igDP:CellValuePresenter}">
													<TextBlock
														Margin="{TemplateBinding Padding}"
														VerticalAlignment="Center">
														<controls:RMHyperlink
															Command="{Binding Path=DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
															CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
															<TextBlock
																Text="{Binding Path=Value, RelativeSource={RelativeSource TemplatedParent}}" />
														</controls:RMHyperlink>
													</TextBlock>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</igDP:FieldSettings.CellValuePresenterStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="IndependentList"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Independent_List}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										BasedOn="{StaticResource rmTextEditorStyle}"
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="OtarID"
						Label="{x:Static resourceRepository:Resources.RMC_Model_ASTROOtarProfile_Otar_ID}">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										BasedOn="{StaticResource rmTextEditorStyle}"
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
				</igDP:FieldLayout.Fields>
			</igDP:FieldLayout>
		</igDP:DataPresenterBase.FieldLayouts>
	</controls:RMDataGrid>
</UserControl>
