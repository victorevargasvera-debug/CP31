<ResourceDictionary
	x:Class="Motorola.CommonCPS.RadioManagement.ASTROOtarProfile.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:astrootarprofile="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTROOtarProfile">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<converters:BoolToInverseConverter
		x:Key="BoolToInverseConverter" />
	<converters:IPAddressEditCharacterConverter
		x:Key="IPAddressEditCharacterConverter" />
	<converters:IPAddressDisplayTextConverter
		x:Key="IPAddressDisplayTextConverter" />
	<converters:RadioStatusToStringConverter
		x:Key="RadioStatusToStringConverter" />
	<Style
		TargetType="{x:Type igDP:CellValuePresenter}"
		BasedOn="{StaticResource CellValuePresenterStyle}"
		x:Key="ShowDetailsButtonStyle">
		<Style.Setters>
			<Setter
				Property="Visibility"
				Value="Hidden" />
			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}">
							<!--Unknown connection ID: 1-->
							<controls:RMLinkButton
								Name="lkbShowDetails"
								Content="è"
								FontFamily="Wingdings"
								ToolTip="{x:Static resourceRepository:Resources.RMC_Action_ShowDetails_Tooltip}"
								Command="{Binding Path=DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
								Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:RMDataGrid}}}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style.Setters>
		<Style.Triggers>
			<DataTrigger
				Value="True"
				Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
				<Setter
					Property="Visibility"
					Value="Visible" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
