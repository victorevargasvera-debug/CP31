<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Template.TemplateMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prism="http://www.codeplex.com/prism" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Template">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
		<KeyBinding
			Key="T"
			Modifiers="Control+Shift"
			Command="{Binding CommandProxy.PrepareImportTemplatesCommand}" />
		<KeyBinding
			Key="T"
			Modifiers="Control"
			Command="{Binding CommandProxy.EditTemplateCommand}" />
		<KeyBinding
			Key="U"
			Modifiers="Control"
			Command="{Binding UpgradeLanguagePackCommnand}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<x:ArrayExtension
				Type="{Type sys:Object}"
				x:Key="TemplateListContextMenuItems">
				<Separator />
				<MenuItem
					Header="{x:Static resourceRepository:Resources.RMC_ContextMenu_Delete}"
					InputGestureText="{x:Static resourceRepository:Resources.Gesture_Delete}"
					Command="{Binding CommandProxy.DeleteTemplatesCommand, IsAsync=True}" />
				<MenuItem
					Header="{x:Static resourceRepository:Resources.RMC_ContextMenu_EditTemplate}"
					InputGestureText="{x:Static resourceRepository:Resources.Gesture_Ctrl_T}"
					Command="{Binding CommandProxy.EditTemplateCommand, IsAsync=True}" />
				<MenuItem
					Header="{x:Static resourceRepository:Resources.RMC_ContextMenu_UpgradeLanguagePack}"
					InputGestureText="{x:Static resourceRepository:Resources.Gesture_Ctrl_U}"
					Command="{Binding UpgradeLanguagePackCommnand, IsAsync=True}"
					Visibility="{Binding ConverterParameter=[PAC:ASTRO], Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}}" />
			</x:ArrayExtension>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<i:Interaction.Triggers>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowImportTemplatesDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True">
				<infrastructure:PopupWindowAction.Content>
					<local:ImportTemplatesView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowSelectRelatedRadiosDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True"
				ResizeWindow="True"
				DisableMinimalizingButtonInWindow="True">
				<infrastructure:PopupWindowAction.Content>
					<local:ApplyTemplatetoRelatedRadiosView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowSelectFirmwareDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True"
				ResizeWindow="True"
				DisableMinimalizingButtonInWindow="True">
				<infrastructure:PopupWindowAction.Content>
					<local:SelectFirmwareView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowTemplateLanguagePacksDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True">
				<infrastructure:PopupWindowAction.Content>
					<local:ShowLanguagePacksView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowTemplateVAPacksDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True">
				<infrastructure:PopupWindowAction.Content>
					<local:ShowVAPacksView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
	</i:Interaction.Triggers>
	<!--Unknown connection ID: 1-->
	<controls:RMTemplateList
		Name="tplTemplates"
		Templates="{Binding Items}"
		SelectedTemplates="{Binding SelectedItems}"
		AddTemplatesCommand="{Binding CommandProxy.PrepareImportTemplatesCommand}"
		DeleteTemplatesCommand="{Binding CommandProxy.DeleteTemplatesCommand}"
		EditTemplateCommand="{Binding CommandProxy.EditTemplateCommand}"
		infrastructure:TemplateGridEditModeEnding.Command="{Binding SaveItemCommand}">
		<FrameworkElement.ContextMenu>
			<ContextMenu>
				<ItemsControl.ItemsSource>
					<CompositeCollection>
						<CollectionContainer
							Collection="{StaticResource CutCopyPasteContextMenuItems}" />
						<CollectionContainer
							Collection="{StaticResource TemplateListContextMenuItems}" />
					</CompositeCollection>
				</ItemsControl.ItemsSource>
			</ContextMenu>
		</FrameworkElement.ContextMenu>
	</controls:RMTemplateList>
</UserControl>
