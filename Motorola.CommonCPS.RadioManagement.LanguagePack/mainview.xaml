<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.LanguagePack.LanguagePackMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://www.codeplex.com/prism" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.LanguagePack" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="uscLanguagePacks">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
		<KeyBinding
			Key="L"
			Modifiers="Control+Shift"
			Command="{Binding CommandProxy.PrepareImportLanguagePacksCommand}" />
	</UIElement.InputBindings>
	<i:Interaction.Triggers>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowImportLanguagePackDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True">
				<infrastructure:PopupWindowAction.Content>
					<local:ImportLanguagePackView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
	</i:Interaction.Triggers>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.LanguagePack;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		BorderBrush="#FFD3D3D3"
		BorderThickness="1">
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrLanguagePacks"
			Margin="10"
			igDP:GroupByAreaLocation="None"
			AdditionalButtonVisibility="Visible"
			CRUDToolBarVisibility="Visible"
			ContextMenu="{StaticResource CutCopyPasteDeleteContextMenu}"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			ImportCommand="{Binding CommandProxy.PrepareImportLanguagePacksCommand}"
			DeleteCommand="{Binding CommandProxy.DeleteLanguagePacksCommand}"
			infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
			infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}">
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="Name"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Language}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Locale"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Locale}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Version"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="LanguageFamily"
							Label="{x:Static resourceRepository:Resources.RMC_PM_LanguageFamily}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Size"
							Label="{x:Static resourceRepository:Resources.RMC_PM_SizeKB}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ImportTime"
							Label="{x:Static resourceRepository:Resources.RMC_PM_ImportedTime}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="References"
							Label="{x:Static resourceRepository:Resources.RMC_TOTAL_ReferenceCount}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ReferencesInTemplate"
							Label="{x:Static resourceRepository:Resources.RMC_PM_ReferencedTemplates}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ReferencesInTemplateRadios"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Template_Radios}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Comments"
							Label="{x:Static resourceRepository:Resources.General_Comments}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.ValueConstraint">
												<Setter.Value>
													<igEditors:ValueConstraint
														MaxLength="1024" />
												</Setter.Value>
											</Setter>
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
	</Border>
</UserControl>
