<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.LanguagePack.ImportLanguagePackView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters"
	Name="LanguagePackView"
	Height="540"
	Width="720" xmlns:languagepack="clr-namespace:Motorola.CommonCPS.RadioManagement.LanguagePack">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.LanguagePack;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<converters:SelectAllParameterConverter
				x:Key="SelectAllParameterConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrImportLanguagePack"
			igDP:GroupByAreaLocation="None"
			CustomizedSelectedCount="{Binding ImportLanguagePackContext.SelectedLanguagePacks.Count}"
			igDP:DataSource="{Binding ImportLanguagePackContext.LanguagePacks, Converter={StaticResource GridViewSourceConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							BindingType="Unbound"
							Name="Selected">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellClickAction="EnterEditModeIfAllowed"
									LabelClickAction="Nothing"
									AllowResize="False"
									EditAsType="{x:Type sys:Boolean}">
									<igDP:FieldSettings.EditorStyle>
										<!--Unknown connection ID: 3-->
										<Style
											TargetType="{x:Type igEditors:XamCheckEditor}">
											<Setter
												Property="infrastructure:FieldCheckChanged.Command"
												Value="{Binding ElementName=LanguagePackView, Path=DataContext.FieldCheckChangedCommand}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
									<igDP:FieldSettings.LabelPresenterStyle>
										<Style
											TargetType="{x:Type igDP:LabelPresenter}">
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type igDP:LabelPresenter}">
														<!--Unknown connection ID: 4-->
														<CheckBox
															Name="HeaderCheckBox"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															IsThreeState="False"
															Command="{Binding ElementName=LanguagePackView, Path=DataContext.SelectedAllCheckChangedCommand}"
															IsChecked="{Binding Path=IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
															<ButtonBase.CommandParameter>
																<MultiBinding
																	Converter="{StaticResource SelectAllParameterConverter}">
																	<MultiBinding.Bindings>
																		<Binding
																			Path="IsSelectAll"
																			RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
																		<Binding
																			ElementName="dgrImportLanguagePack"
																			Path="Records" />
																	</MultiBinding.Bindings>
																</MultiBinding>
															</ButtonBase.CommandParameter>
														</CheckBox>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</igDP:FieldSettings.LabelPresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Name"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Language}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Locale"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Locale}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Version"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="LanguageFamily"
							Label="{x:Static resourceRepository:Resources.RMC_PM_LanguageFamily}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Size"
							Label="{x:Static resourceRepository:Resources.RMC_PM_SizeKB}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnImport"
				MinWidth="95"
				Content="{x:Static resourceRepository:Resources.RMC_PM_Import}"
				Command="{Binding ImportLanguagePackCommand}" />
			<!--Unknown connection ID: 6-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
