<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.ResetRadioPasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Width="460" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Radio;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<controls:RMTextBlock
			Grid.Row="0"
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Margin="0,0,0,10"
			Text="{x:Static resourceRepository:Resources.ResetRadioPassword_promptingMessage}" />
		<Grid
			Row="1"
			Column="0"
			ColumnSpan="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Grid.Column="0"
				Text="*"
				FontWeight="Bold"
				FontSize="20"
				Foreground="#FFFF0000"
				Height="22"
				ToolTip="{x:Static resourceRepository:Resources.ResetRadioPassword_wrongPathTooltip}"
				Visibility="{Binding Path=ResetRadioPasswordContext.IsPasswordResetFilePathCorrect, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
			<!--Unknown connection ID: 1-->
			<controls:RMTextBox
				Name="PasswordResetFilePath"
				Grid.Column="1"
				Margin="5,0"
				IsReadOnly="False"
				Text="{Binding Path=ResetRadioPasswordContext.PasswordResetFilePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
			<!--Unknown connection ID: 2-->
			<controls:RMButton
				Name="btnBrowse"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Browse}"
				Command="{Binding BrowseForFileCommand}" />
		</Grid>
		<Grid
			Row="4"
			Column="1"
			Margin="0,10,0,0"
			HorizontalAlignment="Right">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnOK"
				Margin="0,0,10,0"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding ResetRadioPasswordCommand}" />
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="1"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
