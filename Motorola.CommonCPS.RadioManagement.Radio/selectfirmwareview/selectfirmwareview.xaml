<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.SelectFirmwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converters:BoolToVisibilityConverter
				x:Key="BoolToVisibilityConverter" />
			<converters:FirmwareInfoConverter
				x:Key="FirmwareInfoConverter" />
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			TextElement.FontSize="12"
			Margin="20,20,20,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="30" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 1-->
			<Grid
				Name="codeplugSelectionGrid"
				Row="1"
				Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO][MODE:Configuration]}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="20" />
					<ColumnDefinition
						Width="370" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_SelectFirmwareView_CodeplugVersion}"
					VerticalAlignment="Center" />
				<!--Unknown connection ID: 2-->
				<controls:RMComboBox
					Name="cb_CodeplugSelections"
					Grid.Column="2"
					ItemsSource="{Binding SelectFirmwareContext.Codeplugs}"
					SelectedItem="{Binding SelectFirmwareContext.SelectedCodeplug, Mode=TwoWay}" />
			</Grid>
			<Grid
				Row="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="20" />
					<ColumnDefinition
						Width="370" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_SelectFirmwareView_FirmwareVersion}"
					VerticalAlignment="Center" />
				<!--Unknown connection ID: 3-->
				<controls:RMComboBox
					Name="cb_FirmwareSelectins"
					Grid.Column="2"
					ItemsSource="{Binding SelectFirmwareContext.Firmwares, Converter={StaticResource FirmwareInfoConverter}}"
					SelectedItem="{Binding SelectFirmwareContext.SelectedFirmwareInfo, Mode=TwoWay}" />
			</Grid>
			<Grid
				Row="4"
				Visibility="{Binding Converter={StaticResource BoolToVisibilityConverter}, Path=SelectFirmwareContext.IsASKDialogVisible}" />
			<Grid
				Row="5"
				Visibility="{Binding Converter={StaticResource BoolToVisibilityConverter}, Path=SelectFirmwareContext.IsASKDialogVisible}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="20" />
					<ColumnDefinition
						Width="370" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_SelectFirmwareView_OwnerSystemID}"
					VerticalAlignment="Center" />
				<!--Unknown connection ID: 4-->
				<controls:RMComboBox
					Name="cbxSystemID"
					Grid.Column="2"
					DisplayMemberPath="SystemIDHex"
					ItemsSource="{Binding SelectFirmwareContext.SystemIDs}"
					SelectedItem="{Binding SelectFirmwareContext.SelectedSystemID}" />
			</Grid>
			<Grid
				Row="6"
				Visibility="{Binding Converter={StaticResource BoolToVisibilityConverter}, Path=SelectFirmwareContext.IsASKDialogVisible}" />
			<Grid
				Row="7"
				Visibility="{Binding Converter={StaticResource BoolToVisibilityConverter}, Path=SelectFirmwareContext.IsASKDialogVisible}">
				<controls:RMTextBlock
					FontSize="13"
					Text="{x:Static resourceRepository:Resources.RMC_Warning_NOASK}"
					TextWrapping="Wrap"
					Visibility="{Binding SelectFirmwareContext.ErrorVisibility}" />
			</Grid>
		</Grid>
		<Grid
			Row="1"
			HorizontalAlignment="Right"
			Margin="24"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectFirmwareCommand}" />
			<!--Unknown connection ID: 6-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="2"
			Error="{Binding SelectFirmwareContext.ExceptionMessage}" />
	</Grid>
</UserControl>
