<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.ShowCACertificatePacksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters"
	Height="450"
	Width="600" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="5" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Text="{x:Static resourceRepository:Resources.RMC_Label_Radio_SerialNumber}" />
				<controls:RMTextBlock
					Grid.Column="2"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					TextWrapping="Wrap"
					Text="{Binding ShowCACertificatesPacksContext.Radio.SerialNumber}" />
			</Grid>
			<Grid
				Column="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="5" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Text="{x:Static resourceRepository:Resources.RMC_Label_TotalSize}" />
				<controls:RMTextBlock
					Grid.Column="2"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					TextWrapping="Wrap"
					Text="{Binding ShowCACertificatesPacksContext.TotalSize}" />
			</Grid>
		</Grid>
		<!--Unknown connection ID: 1-->
		<controls:RMDataGrid
			Name="dgrCACertificatePacks"
			Grid.Row="2"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding ShowCACertificatesPacksContext.CACertificatePacksDetailInfo, Converter={StaticResource GridViewSourceConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					AllowEdit="False"
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="PackageName"
							Label="{x:Static resourceRepository:Resources.General_Name}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="PackageSize"
							Label="{x:Static resourceRepository:Resources.RMC_PM_SizeKB}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="4"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 2-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Close}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
