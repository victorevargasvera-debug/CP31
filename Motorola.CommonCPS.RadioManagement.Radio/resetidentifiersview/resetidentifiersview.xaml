<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.ResetIdentifiersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Width="460" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Radio;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:EmptyStringToNullValueConverter
				x:Key="EmptyStringToNullValueConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="30" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="200" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Model_ResetIdentifiersContext_SerialNumber}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 1-->
			<controls:RMTextBox
				Name="tbxSerialNumber"
				Grid.Column="1"
				IsReadOnly="True"
				Text="{Binding ResetIdentifiersContext.SerialNumber}" />
		</Grid>
		<Grid
			Row="1"
			Margin="0,10,0,0"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:PCR]}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="200" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Model_ResetIdentifiersContext_RadioID}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 2-->
			<controls:RMMaskedInput
				Name="msiRadioID"
				Grid.Column="1"
				Mask="{}{char:8:0-9}"
				p11:Text="{Binding Path=ResetIdentifiersContext.RadioID, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={StaticResource EmptyStringToNullValueConverter}}"
				IsEnabled="{Binding Path=ResetIdentifiersContext.RadioIdCAIEnable}" xmlns:p11="http://schemas.infragistics.com/xaml" />
		</Grid>
		<Grid
			Row="2"
			Margin="0,10,0,0"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:PCR]}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="200" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Model_ResetIdentifiersContext_CAI}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 3-->
			<controls:RMMaskedInput
				Name="nmiCAI"
				Grid.Column="1"
				Mask="{}{char:3:0-9}"
				p11:Text="{Binding Path=ResetIdentifiersContext.CAI, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={StaticResource EmptyStringToNullValueConverter}}"
				IsEnabled="{Binding Path=ResetIdentifiersContext.RadioIdCAIEnable}" xmlns:p11="http://schemas.infragistics.com/xaml" />
		</Grid>
		<Grid
			Row="3"
			Margin="0,10,0,0"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO/PCR]}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="200" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Model_ResetIdentifiersContext_Password}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 4-->
			<controls:RMPasswordBox
				Name="msiPassword"
				Grid.Column="1"
				Password="{Binding Path=ResetIdentifiersContext.Password, ValidatesOnDataErrors=True}" />
		</Grid>
		<Grid
			Row="4"
			Margin="0,10,0,0"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding ResetIdentifiersCommand}" />
			<!--Unknown connection ID: 6-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="5"
			Error="{Binding ResetIdentifiersContext.ExceptionMessage}" />
	</Grid>
</UserControl>
