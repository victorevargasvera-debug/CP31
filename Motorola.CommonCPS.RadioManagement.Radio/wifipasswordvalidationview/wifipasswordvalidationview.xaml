<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.WiFiPasswordValidationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Height="450"
	Width="600" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 1-->
		<controls:RMTextBlock
			Name="txtTemplateName"
			Grid.Row="0"
			FontWeight="Bold"
			FontSize="12"
			VerticalAlignment="Center"
			HorizontalAlignment="Left"
			Height="Auto"
			TextWrapping="Wrap"
			Text="{Binding WiFiPasswordValidationContext.ApxTemplateName}" />
		<!--Unknown connection ID: 2-->
		<controls:RMTextBlock
			Name="LblCloneWiFiDescription"
			Margin="0,10"
			Grid.Row="1"
			Text="{x:Static resourceRepository:Resources.WiFi_Password_Validation_Description}"
			VerticalAlignment="Center"
			HorizontalAlignment="Left"
			Height="Auto"
			TextWrapping="Wrap" />
		<!--Unknown connection ID: 3-->
		<controls:RMWiFiPasswordList
			Name="tplWiFiPassword"
			Grid.Row="2"
			WiFiNetworks="{Binding WiFiPasswordValidationContext.WiFiNetworks}" />
		<Grid
			Row="4"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding WiFiPasswordValidationCommand}" />
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="5"
			HorizontalAlignment="Left"
			Error="{Binding WiFiPasswordValidationContext.ExceptionMessage}" />
	</Grid>
</UserControl>
