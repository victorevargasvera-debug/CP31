<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.SelectProvisioningPackageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Height="450"
	Width="600" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type igDP:CellValuePresenter}"
				x:Key="SelectValuePresender">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type igDP:CellValuePresenter}">
							<StackPanel>
								<Rectangle
									Name="RightBorder"
									Fill="#FFBBBBBB"
									Width="1"
									Margin="0,1,0,0"
									HorizontalAlignment="Right"
									VerticalAlignment="Stretch" />
								<controls:RMTextBlock
									Name="txtfield"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="15"
									FontWeight="Bold"
									Text="{Binding Path=Record.DataItem.VValue, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordPresenter}}}" />
							</StackPanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger
						Property="igDP:CellValuePresenter.IsRecordSelected"
						Value="True">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type igDP:CellValuePresenter}">
									<StackPanel>
										<Rectangle
											Name="RightBorder"
											Fill="#FFBBBBBB"
											Width="1"
											Margin="0,1,0,0"
											HorizontalAlignment="Right"
											VerticalAlignment="Stretch" />
										<controls:RMTextBlock
											Name="txtRecordSelected"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="15"
											FontWeight="Bold"
											Text="{Binding Path=Record.DataItem.VValue, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordPresenter}}}" />
									</StackPanel>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Trigger>
					<Trigger
						Property="igDP:CellValuePresenter.IsRecordSelected"
						Value="False">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type igDP:CellValuePresenter}">
									<StackPanel>
										<Rectangle
											Name="RightBorder"
											Fill="#FFBBBBBB"
											Width="1"
											Margin="0,1,0,0"
											HorizontalAlignment="Right"
											VerticalAlignment="Stretch" />
										<controls:RMTextBlock
											Name="txtRecordDeSelected"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="15"
											FontWeight="Bold"
											Text="{Binding Path=Record.DataItem.VValue, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type igDP:DataRecordPresenter}}}" />
									</StackPanel>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 1-->
		<controls:RMDataGrid
			Name="dgrGeneralPackages"
			Grid.Row="0"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			ToolbarVisibility="Collapsed"
			SearchVisibility="Collapsed"
			StatusbarVisibility="Collapsed"
			igDP:DataSource="{Binding Context.Packages}"
			infrastructure:DataGridSelectedItemsChanged.Command="{Binding SelectedItemChangedCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayoutSettings>
				<igDP:FieldLayoutSettings
					SelectionTypeRecord="Single"
					AutoGenerateFields="False" />
			</igDP:DataPresenterBase.FieldLayoutSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="VValue"
							Label=""
							Width="Auto">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource SelectValuePresender}"
									LabelClickAction="Nothing" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Name"
							Label="{x:Static resourceRepository:Resources.General_Name}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ManifestVersion"
							Label="{x:Static resourceRepository:Resources.RMC_PBB_Manifest_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Version"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Size"
							Label="{x:Static resourceRepository:Resources.RMC_PM_SizeKB}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="1"
			HorizontalAlignment="Right"
			Margin="24"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 2-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectProvisioningPackageCommand}" />
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="2"
			Error="{Binding Context.ExceptionMessage}" />
	</Grid>
</UserControl>
