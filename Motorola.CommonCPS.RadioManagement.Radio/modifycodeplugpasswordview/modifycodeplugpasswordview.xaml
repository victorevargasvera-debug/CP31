<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.ModifyCodeplugPasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Width="460" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Radio;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:CheckforPasswordtoStringConverter
				x:Key="CheckforPasswordtoStringConverter" />
			<converters:CheckforPasswordCollectionConverter
				x:Key="CheckforPasswordCollectionConverter" />
			<converters:ShowCheckBoxConverter
				x:Key="ShowCheckBoxConverter" />
			<converters:PasswordMaxAttemptConverter
				x:Key="PasswordMaxAttemptConverter" />
			<converters:PasswordNullValueConverter
				x:Key="PasswordNullValueConverter" />
			<converters:SelectedPasswordPolicyToMaxAttemptsEnable
				x:Key="SelectedPasswordPolicyToMaxAttemptsEnable" />
			<converters:ModifyPasswordToVisibilityConverter
				x:Key="ModifyPasswordToVisibilityConverter" />
			<converters:ModifyPasswordVisibilityForPACConverter
				x:Key="ModifyPasswordVisibilityForPACConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<controls:RMTextBlock
			Grid.Row="0"
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Margin="0,0,0,10"
			Text="{x:Static resourceRepository:Resources.ModifyRadioPassword_promptingMessage}" />
		<controls:RMTextBlock
			Grid.Row="1"
			Grid.Column="0"
			VerticalAlignment="Center"
			Margin="10,0,0,0"
			Text="{x:Static resourceRepository:Resources.CodeplugPasswordForValidate}" />
		<Grid
			Row="1"
			Column="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 1-->
			<controls:RMPasswordBox
				Name="RMPassword"
				Grid.Column="0"
				InputMethod.IsInputMethodEnabled="False"
				Password="{Binding Path=ModifyContext.OldPasswordForValidate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
			<controls:RMTextBlock
				Grid.Column="1"
				Text="*"
				FontWeight="Bold"
				FontSize="20"
				Foreground="#FFFF0000"
				ToolTip="{x:Static resourceRepository:Resources.RMC_ModifyPW_Validation_ErrorMsg}"
				Height="24"
				Visibility="{Binding Path=ModifyContext.IsPasswordCorrect, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
		</Grid>
		<controls:RMTextBlock
			Grid.Row="2"
			Grid.Column="0"
			Margin="10,10,0,10"
			Text="{x:Static resourceRepository:Resources.ConfigurePasswordPerDevice}" />
		<!--Unknown connection ID: 2-->
		<controls:RMCheckBox
			Name="RMCheckCPPD"
			Grid.Row="2"
			Grid.Column="1"
			IsChecked="{Binding Path=ModifyContext.PasswordPerDevice}"
			IsEnabled="{Binding Path=ModifyContext.IsPasswordCorrect}" />
		<controls:RMGroupBox
			Grid.Row="3"
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Padding="5,5,5,5"
			Header="{x:Static resourceRepository:Resources.RMC_New_Password}">
			<UIElement.IsEnabled>
				<MultiBinding
					Converter="{StaticResource ShowCheckBoxConverter}">
					<Binding
						Path="ModifyContext.IsPasswordCorrect" />
					<Binding
						Path="ModifyContext.PasswordPerDevice" />
				</MultiBinding>
			</UIElement.IsEnabled>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Grid.Row="0"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static resourceRepository:Resources.CodeplugPassword}" />
				<!--Unknown connection ID: 3-->
				<controls:RMPasswordBox
					Name="PcrRMCPPassword"
					Grid.Row="0"
					Grid.Column="1"
					Mask="&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;"
					Password="{Binding Path=ModifyContext.NewRadioPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
					Visibility="{Binding Converter={StaticResource ModifyPasswordVisibilityForPACConverter}, ConverterParameter=PCR}">
					<i:Interaction.Triggers>
						<i:EventTrigger
							EventName="LostFocus">
							<i:InvokeCommandAction
								CommandParameter="NEW"
								Command="{Binding Path=ClearBlankPasswordCommand}" />
						</i:EventTrigger>
					</i:Interaction.Triggers>
				</controls:RMPasswordBox>
				<!--Unknown connection ID: 4-->
				<controls:RMPasswordBox
					Name="AstroRMCPPassword"
					Grid.Row="0"
					Grid.Column="1"
					Password="{Binding Path=ModifyContext.NewRadioPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
					Visibility="{Binding Converter={StaticResource ModifyPasswordVisibilityForPACConverter}, ConverterParameter=ASTRO}" />
				<controls:RMTextBlock
					Grid.Row="1"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static resourceRepository:Resources.CheckforPassword}" />
				<!--Unknown connection ID: 5-->
				<controls:RMComboBox
					Name="RMCombCPD"
					Grid.Row="1"
					Grid.Column="1"
					Margin="0,10,0,10"
					Visibility="{Binding Converter={StaticResource ModifyPasswordVisibilityForPACConverter}, ConverterParameter=PCR}"
					IsEnabled="{Binding ModifyContext.IsPasswordForWriteNotBlank}"
					SelectedItem="{Binding ModifyContext.SelectedPasswordPolicy, Converter={StaticResource CheckforPasswordtoStringConverter}, Mode=TwoWay}">
					<ItemsControl.ItemsSource>
						<MultiBinding
							Converter="{StaticResource CheckforPasswordCollectionConverter}">
							<Binding
								Path="ModifyContext.PasswordPolicyList" />
							<Binding
								Path="ModifyContext.Region" />
							<Binding
								Path="ModifyContext.IsRepeater" />
						</MultiBinding>
					</ItemsControl.ItemsSource>
				</controls:RMComboBox>
				<StackPanel
					Grid.Row="1"
					Grid.Column="1"
					Orientation="Vertical"
					Margin="0,10,0,10"
					Visibility="{Binding Converter={StaticResource ModifyPasswordVisibilityForPACConverter}, ConverterParameter=ASTRO}">
					<!--Unknown connection ID: 6-->
					<CheckBox
						Name="ReadRadioCheckBox"
						Margin="0,5,0,0"
						Content="{x:Static resourceRepository:Resources.ReadRadio_Password}"
						IsEnabled="{Binding ModifyContext.IsPasswordNotNullOrEmpty}"
						IsChecked="{Binding ModifyContext.AstroReadPasswordEnabled}" />
					<!--Unknown connection ID: 7-->
					<CheckBox
						Name="WriteRadioCheckBox"
						Margin="0,5,0,0"
						Content="{x:Static resourceRepository:Resources.WriteRadio_Password}"
						IsEnabled="{Binding ModifyContext.IsPasswordNotNullOrEmpty}"
						IsChecked="{Binding ModifyContext.AstroWritePasswordEnabled}" />
					<!--Unknown connection ID: 8-->
					<CheckBox
						Name="OpenFileCheckBox"
						Margin="0,5,0,0"
						Content="{x:Static resourceRepository:Resources.OpenFile_Password}"
						IsEnabled="{Binding ModifyContext.IsPasswordNotNullOrEmpty}"
						IsChecked="{Binding ModifyContext.AstroOpenFilePasswordEnabled}" />
				</StackPanel>
				<controls:RMTextBlock
					Grid.Row="2"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static resourceRepository:Resources.MaxAttempts}"
					Visibility="{Binding Path=ModifyContext, Converter={StaticResource ModifyPasswordToVisibilityConverter}}" />
				<!--Unknown connection ID: 9-->
				<controls:RMMaskedInput
					Name="RMMaxAttempts"
					Grid.Row="2"
					Grid.Column="1"
					InvalidValueBehavior="RevertValue"
					Mask="nnn"
					SpinButtonDisplayMode="Always"
					SpinIncrement="1"
					ValueToDisplayTextConverter="{StaticResource PasswordMaxAttemptConverter}"
					Visibility="{Binding Path=ModifyContext, Converter={StaticResource ModifyPasswordToVisibilityConverter}}"
					p13:Value="{Binding Path=ModifyContext.MaxAttempts, Converter={StaticResource PasswordNullValueConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					IsEnabled="{Binding Path=ModifyContext.SelectedPasswordPolicy, Converter={StaticResource SelectedPasswordPolicyToMaxAttemptsEnable}}" xmlns:p13="http://schemas.infragistics.com/xaml" />
			</Grid>
		</controls:RMGroupBox>
		<Grid
			Row="4"
			Column="1"
			Margin="0,10,0,0"
			HorizontalAlignment="Right">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 10-->
			<controls:RMButton
				Name="btnOK"
				Margin="0,0,10,0"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				IsEnabled="{Binding ModifyContext.ContextIsChanged}"
				Command="{Binding AddModifyCodeplugPasswordCommand}" />
			<!--Unknown connection ID: 11-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="1"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
