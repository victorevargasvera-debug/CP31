<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.GroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<UIElement.InputBindings>
		<KeyBinding
			Key="G"
			Modifiers="Control+Shift"
			Command="{Binding CommandProxy.AddGroupCommand}" />
		<KeyBinding
			Key="DELETE"
			Command="{Binding CommandProxy.DeleteGroupCommand}" />
		<KeyBinding
			Key="F2"
			Command="{Binding CommandProxy.PrepareRenameGroupCommand}" />
	</UIElement.InputBindings>
	<!--Unknown connection ID: 1-->
	<controls:RMGroupList
		Name="gplGroups"
		AutomationProperties.AutomationId="gplGroupsRadio"
		AllowEdit="True"
		AllowDragAndDrop="True"
		Groups="{Binding NavigationItems}"
		SelectedGroup="{Binding Path=SelectedNavigationItem, Mode=TwoWay}"
		RenameCommand="{Binding RenameGroupCommand}"
		UpdateCommand="{Binding UpdateGroupCommand}"
		RefreshCommand="{Binding RefreshGroupCommand}">
		<FrameworkElement.ContextMenu>
			<ContextMenu>
				<ItemsControl.Items>
					<MenuItem
						Header="{x:Static resourceRepository:Resources.RMC_GroupView_NewGroup}"
						InputGestureText="{x:Static resourceRepository:Resources.Gesture_Ctrl_Shift_G}"
						Command="{Binding CommandProxy.AddGroupCommand, IsAsync=True}" />
					<MenuItem
						Header="{x:Static resourceRepository:Resources.RMC_ContextMenu_Delete}"
						InputGestureText="{x:Static resourceRepository:Resources.Gesture_Del}"
						Command="{Binding CommandProxy.DeleteGroupCommand, IsAsync=True}" />
					<MenuItem
						Header="{x:Static resourceRepository:Resources.RMC_GroupView_Rename}"
						InputGestureText="{x:Static resourceRepository:Resources.Gesture_F2}"
						Command="{Binding CommandProxy.PrepareRenameGroupCommand, IsAsync=True}" />
				</ItemsControl.Items>
			</ContextMenu>
		</FrameworkElement.ContextMenu>
	</controls:RMGroupList>
</UserControl>
