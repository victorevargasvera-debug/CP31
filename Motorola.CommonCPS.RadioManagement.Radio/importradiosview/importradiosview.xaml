<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.ImportRadiosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters"
	Height="Auto"
	Width="600" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:ImportRadiosOverrideOptionToBoolConverter
				x:Key="ImportRadiosOverrideOptionToBoolConverter" />
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:RadiosCountToVisibilityConverter
				x:Key="RadiosCountToVisibilityConverter" />
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 2-->
		<Grid
			Name="gridBasic"
			Row="1"
			TextElement.FontSize="12"
			Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 3-->
			<controls:RMCheckBox
				Name="cbxCreateRadios"
				Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosContext_CreateRadios}"
				IsChecked="{Binding ImportRadiosContext.CreateRadios}"
				Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[MODE:Configuration]}" />
			<!--Unknown connection ID: 4-->
			<controls:RMCheckBox
				Name="cbxCreateConfiguration"
				Grid.Row="1"
				Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosContext_CreateConfigurations}"
				Margin="0,10,0,0"
				IsChecked="{Binding ImportRadiosContext.CreateConfigurations}"
				Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO/PCR][MODE:Configuration]}" />
			<!--Unknown connection ID: 5-->
			<controls:RMCheckBox
				Name="cbxApplyConfiguration"
				Grid.Row="2"
				Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosContext_ApplyConfigurationsToRadios}"
				Margin="0,10,0,0"
				IsChecked="{Binding ImportRadiosContext.ApplyConfigurationsToRadios}"
				IsEnabled="{Binding ImportRadiosContext.IsApplyConfigurationsToRadiosEditable}"
				Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO/PCR][MODE:Configuration]}" />
			<!--Unknown connection ID: 6-->
			<controls:RMGroupBox
				Name="gpbOptions"
				Grid.Row="5"
				Header="{x:Static resourceRepository:Resources.RMC_ImportRadio_OverrideOptions}"
				Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<!--Unknown connection ID: 7-->
					<controls:RMRadioButton
						Name="rbtAlways"
						Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosOverrideOption_AlwaysOverride}"
						IsChecked="{Binding Path=ImportRadiosContext.OverrideOption, Converter={StaticResource ImportRadiosOverrideOptionToBoolConverter}, ConverterParameter=Overwrite_Always}"
						IsEnabled="{Binding ImportRadiosContext.IsAlwaysOverrideEditable}" />
					<!--Unknown connection ID: 8-->
					<controls:RMRadioButton
						Name="rbtNever"
						Grid.Row="1"
						Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosOverrideOption_NeverOverride}"
						Margin="0,10,0,0"
						IsChecked="{Binding Path=ImportRadiosContext.OverrideOption, Converter={StaticResource ImportRadiosOverrideOptionToBoolConverter}, ConverterParameter=Overwrite_Never}"
						IsEnabled="{Binding ImportRadiosContext.IsNeverOverrideEditable}" />
					<!--Unknown connection ID: 9-->
					<controls:RMRadioButton
						Name="rbtFlashCode"
						Grid.Row="2"
						Content="{x:Static resourceRepository:Resources.RMC_Model_ImportRadiosOverrideOption_OverrideWhenFlashcodeNotChanged}"
						Margin="0,10,0,0"
						IsChecked="{Binding Path=ImportRadiosContext.OverrideOption, Converter={StaticResource ImportRadiosOverrideOptionToBoolConverter}, ConverterParameter=Overwrite_FlashCode_NOChange}"
						IsEnabled="{Binding ImportRadiosContext.IsOverrideWhenFlashcodeNotChangedEditable}"
						Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO]}" />
				</Grid>
			</controls:RMGroupBox>
			<!--Unknown connection ID: 10-->
			<Grid
				Name="gridPassword"
				Row="7">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="40" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>
					<controls:RMTextBlock
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Text="{x:Static resourceRepository:Resources.RMC_ImportTemplate_Password}" />
					<!--Unknown connection ID: 11-->
					<controls:RMPasswordBox
						Name="xmePassword"
						Margin="10,0,0,0"
						Grid.Column="1"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Width="250"
						Password="{Binding ImportRadiosContext.Password}" />
				</Grid>
				<Grid
					Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>
					<!--Unknown connection ID: 12-->
					<controls:RMButton
						Name="btnAdvance"
						CommandParameter="advance"
						Content="{x:Static resourceRepository:Resources.RMC_Action_AdvancedOptions}"
						MinWidth="120"
						HorizontalAlignment="Left"
						Visibility="{Binding Path=ImportRadiosContext.FilesCount, Converter={StaticResource RadiosCountToVisibilityConverter}}"
						Command="{Binding SwitchPasswordModeCommand}" />
				</Grid>
			</Grid>
			<!--Unknown connection ID: 13-->
			<Grid
				Name="gridAdvanced"
				Row="7">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="40" />
				</Grid.RowDefinitions>
				<!--Unknown connection ID: 14-->
				<controls:RMDataGrid
					Name="dgrFiles"
					Grid.Row="0"
					TextElement.FontSize="12"
					igDP:GroupByAreaLocation="None"
					MaxHeight="200"
					igDP:DataSource="{Binding ImportRadiosContext.FilePasswords, Converter={StaticResource GridViewSourceConverter}}"
					SearchCommand="{Binding SearchCommand}">
					<igDP:DataPresenterBase.FieldLayouts>
						<igDP:FieldLayout>
							<igDP:FieldLayout.Fields>
								<igDP:Field
									Name="FileName"
									Label="{x:Static resourceRepository:Resources.RMC_Model_FilePassword_FileName}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="Password"
									Label="{x:Static resourceRepository:Resources.RMC_Model_FilePassword_Password}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.EditTemplate">
														<Setter.Value>
															<ControlTemplate
																TargetType="{x:Type igEditors:XamTextEditor}">
																<controls:RMPasswordBox
																	IsHideBorder="True"
																	Password="{Binding DataItem.Password}" />
															</ControlTemplate>
														</Setter.Value>
													</Setter>
													<Setter
														Property="Template">
														<Setter.Value>
															<ControlTemplate
																TargetType="{x:Type igEditors:XamTextEditor}">
																<Grid>
																	<controls:RMPasswordBox
																		IsShowingEyeButton="False"
																		IsHideBorder="True"
																		Password="{Binding DataItem.Password}" />
																	<Border
																		Background="#00FFFFFF" />
																</Grid>
															</ControlTemplate>
														</Setter.Value>
													</Setter>
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
							</igDP:FieldLayout.Fields>
						</igDP:FieldLayout>
					</igDP:DataPresenterBase.FieldLayouts>
				</controls:RMDataGrid>
				<Grid
					Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>
					<!--Unknown connection ID: 15-->
					<controls:RMButton
						Name="btnBasic"
						CommandParameter="basic"
						Content="{x:Static resourceRepository:Resources.RMC_Action_BasicOptions}"
						MinWidth="120"
						HorizontalAlignment="Left"
						Command="{Binding SwitchPasswordModeCommand}" />
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Row="3"
			HorizontalAlignment="Right"
			Margin="24,15,24,15"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 16-->
			<controls:RMButton
				Name="btnImport"
				MinWidth="95"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Import}"
				Command="{Binding ImportRadiosCommand}" />
			<!--Unknown connection ID: 17-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
