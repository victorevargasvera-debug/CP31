					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="5" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_ScheduleJob_EndBefore}" />
				<Grid
					Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="32" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<!--Unknown connection ID: 30-->
					<controls:RMDateInput
						Name="ditEndDate"
						ig:InvalidValueBehavior="RevertValue"
						ig:Text="{Binding Path=ScheduleJobContext.EndBeforeDate, ValidatesOnDataErrors=True}" />
					<!--Unknown connection ID: 31-->
					<controls:RMMaskedInput
						Name="msiEndTime"
						Grid.Column="2"
						ig:InvalidValueBehavior="RevertValue"
						ig:Mask="hh:mm"
						ig:SpinButtonDisplayMode="Focused"
						Width="75"
						ig:Text="{Binding Path=ScheduleJobContext.EndBeforeTime, ValidatesOnDataErrors=True}" />
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Row="10"
			HorizontalAlignment="Right"
			Width="200"
			Margin="0, 20, 0, 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 32-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding ScheduleJobCommand}">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource ScheduleJobViewOKButtonEnableConverter}">
						<Binding
							Path="ScheduleJobContext.IsTypeReadEditable" />
						<Binding
							Path="ScheduleJobContext.IsTypeWriteEditable" />
					</MultiBinding>
				</UIElement.IsEnabled>
			</controls:RMButton>
			<!--Unknown connection ID: 33-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="11"
			Error="{Binding ScheduleJobContext.ExceptionMessage}" />
	</Grid>
</UserControl>
