<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.CopyPasteWarningView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="usc_CopyPasteView"
	Height="Auto"
	Width="600" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<converters:VisibilityByRecordCountConverter
				x:Key="VisibilityByRecordCountConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<controls:RMTextBlock
			FontSize="14"
			VerticalAlignment="Center"
			TextWrapping="Wrap"
			Text="{Binding CopyPasteWarningContext.InvalidDataWarning}"
			Visibility="{Binding CopyPasteWarningContext.HasInvalidData, Converter={StaticResource BoolToVisibilityConverter}}" />
		<controls:RMTextBlock
			Grid.Row="2"
			FontSize="14"
			VerticalAlignment="Center"
			TextWrapping="Wrap"
			Text="{Binding CopyPasteWarningContext.CannotPasteDataWarning}"
			Visibility="{Binding CopyPasteWarningContext.FieldCannotPastedList.Count, Converter={StaticResource VisibilityByRecordCountConverter}}" />
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrCannotPasteWarning"
			Grid.Row="3"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding CopyPasteWarningContext.FieldCannotPastedList, Converter={StaticResource GridViewSourceConverter}}"
			Visibility="{Binding CopyPasteWarningContext.FieldCannotPastedList.Count, Converter={StaticResource VisibilityByRecordCountConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="FieldName"
							Label="{x:Static resourceRepository:Resources.RM_FieldName}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Reason"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_Reason}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="5"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SubmitPasteValueCommand}" />
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
