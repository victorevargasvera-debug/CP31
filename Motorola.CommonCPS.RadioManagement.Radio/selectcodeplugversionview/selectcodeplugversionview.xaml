<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.SelectCodeplugVersionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Width="360" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<Grid
		Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="20" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 2-->
			<Grid
				Name="codeplugSelectionGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="20" />
					<ColumnDefinition
						Width="200" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_SelectFirmwareView_CodeplugVersion}"
					VerticalAlignment="Center" />
				<!--Unknown connection ID: 3-->
				<controls:RMComboBox
					Name="cb_CodeplugSelections"
					Grid.Column="2"
					ItemsSource="{Binding SelectCodeplugVersionContext.Codeplugs}"
					SelectedItem="{Binding SelectCodeplugVersionContext.SelectedCodeplug, Mode=TwoWay}" />
			</Grid>
		</Grid>
		<Grid
			Row="1"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectCodeplugVersionCommand}" />
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="2"
			Error="{Binding SelectFirmwareContext.ExceptionMessage}" />
	</Grid>
</UserControl>
