<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.UpdateRadioDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Height="Auto"
	Width="480" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:KeyTypesToItemsSourceConverter
				x:Key="KeyTypesToItemsSourceConverter" />
			<converters:KeyTypeToStringConverter
				x:Key="KeyTypeToStringConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition />
			<RowDefinition
				Height="30" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<controls:RMTextBlock
			Grid.Row="0"
			Text="{x:Static resourceRepository:Resources.RMC_UpdateRadioDataView_General}"
			TextWrapping="Wrap" />
		<Grid
			Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_UpdateRadioDataView_KeyType}"
				Grid.Column="0"
				Grid.Row="0" />
			<!--Unknown connection ID: 1-->
			<controls:RMComboBox
				Name="cbxKeyType"
				Grid.Column="1"
				Grid.Row="0"
				ItemsSource="{Binding UpdateRadioContext.KeyTypes, Converter={StaticResource KeyTypesToItemsSourceConverter}}"
				SelectedItem="{Binding UpdateRadioContext.SelectedkeyType, Converter={StaticResource KeyTypeToStringConverter}}" />
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_UpdateRadioDataView_OwnerSystemID}"
				Grid.Column="0"
				Grid.Row="2" />
			<!--Unknown connection ID: 2-->
			<controls:RMComboBox
				Name="cbxSystemID"
				Grid.Column="1"
				Grid.Row="2"
				DisplayMemberPath="SystemIDHex"
				ItemsSource="{Binding UpdateRadioContext.SystemKeysByType}"
				SelectedItem="{Binding UpdateRadioContext.SelectSystemKeyData}" />
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_UpdateRadioDataView_WriteProtect}"
				Grid.Column="0"
				Grid.Row="4" />
			<!--Unknown connection ID: 3-->
			<controls:RMCheckBox
				Name="cbxIsWriteProtect"
				Grid.Column="1"
				Grid.Row="4"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				IsChecked="{Binding UpdateRadioContext.WriteProtect}"
				IsEnabled="{Binding UpdateRadioContext.WriteProtectEnable}" />
		</Grid>
		<Grid
			Row="4"
			HorizontalAlignment="Right"
			Width="170">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding UpdateRadioDataCommand}" />
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="5"
			Error="{Binding UpdateRadioContext.ExceptionMessage}" />
	</Grid>
</UserControl>
