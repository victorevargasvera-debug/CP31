														Value="#00FFFFFF" />
													<Setter
														Property="BorderThickness"
														Value="0" />
													<Setter
														Property="BorderBrush"
														Value="#00FFFFFF" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="Comments"
									Label="{x:Static resourceRepository:Resources.General_Comments}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													BasedOn="{StaticResource rmTextEditorStyle}"
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.ValueConstraint">
														<Setter.Value>
															<igEditors:ValueConstraint
																MaxLength="1024" />
														</Setter.Value>
													</Setter>
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="{Binding Path=DataItem.IsCommentEditable, Converter={StaticResource BoolToInverseConverter}}" />
													<Setter
														Property="Background"
														Value="#00FFFFFF" />
													<Setter
														Property="BorderThickness"
														Value="0" />
													<Setter
														Property="BorderBrush"
														Value="#00FFFFFF" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
							</igDP:FieldLayout.Fields>
						</igDP:FieldLayout>
					</igDP:DataPresenterBase.FieldLayouts>
				</controls:RMDataGrid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
