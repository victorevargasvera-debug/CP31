<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Radio.SelectTemplateView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Height="450"
	Width="650" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio">
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 1-->
		<controls:RMTemplateList
			Name="tplTemplate"
			WorkMode="Picking"
			Templates="{Binding SelectTemplateContext.Templates}"
			SelectedTemplates="{Binding SelectTemplateContext.SelectedTemplates}" />
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 2-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectTemplateCommand}" />
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
	</Grid>
</UserControl>
