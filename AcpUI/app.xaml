<Page
	x:Class="AcpUI.AcpIuiPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:ui="clr-namespace:System.Windows.Documents;assembly=PresentationUI" xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:dd="clr-namespace:DevComponents.WpfDock;assembly=AcpWpfDock" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:browser="clr-namespace:ACPBrowser;assembly=ACPBrowser"
	Title="AcpIuiPage">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:InvalidFieldsDockWndHeaderConverter
				x:Key="InvalidFieldsHeaderConverter" />
			<Style
				TargetType="{x:Type Image}"
				x:Key="Image16x16Style">
				<Setter
					Property="Height"
					Value="16" />
				<Setter
					Property="Width"
					Value="16" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel
		Background="{DynamicResource LightSilverGradBrush}">
		<!--Unknown connection ID: 1-->
		<Frame
			Name="StatusBarFrame"
			DockPanel.Dock="Bottom"
			MinHeight="25" />
		<!--Unknown connection ID: 2-->
		<dd:DockSite
			Name="AppDock"
			LicenseKey="DAD80300DA22">
			<dd:DockSite.SplitPanels>
				<!--Unknown connection ID: 3-->
				<dd:SplitPanel
					Name="NavPanel"
					DockSite.Dock="Left"
					DockSite.DockSize="300">
					<!--Unknown connection ID: 4-->
					<dd:DockWindowGroup
						Name="NavPanelGrp">
						<!--Unknown connection ID: 5-->
						<AcpUINS:AcpDockWindow
							Name="NavWindowDockWnd"
							Header="{x:Static AcpCommonResources:AcpResources.Navigation_Id}"
							dd:ImageSource="images/AppWindow.bmp"
							dd:CanDockBottom="False"
							dd:CanDockTop="False"
							dd:CanDockAsDocument="False"
							dd:IsAutoHide="False">
							<!--Unknown connection ID: 6-->
							<Frame
								Name="FrameLeft"
								NavigationUIVisibility="Hidden"
								MinWidth="50" />
						</AcpUINS:AcpDockWindow>
					</dd:DockWindowGroup>
				</dd:SplitPanel>
				<!--Unknown connection ID: 7-->
				<dd:SplitPanel
					Name="TaskPanel"
					DockSite.Dock="Right"
					DockSite.DockSize="200">
					<!--Unknown connection ID: 8-->
					<dd:DockWindowGroup
						Name="TaskPanelGrp">
						<!--Unknown connection ID: 9-->
						<AcpUINS:AcpDockWindow
							Name="TaskWindowDockWnd"
							Header="{x:Static AcpCommonResources:AcpResources.Field_Information}"
							dd:ImageSource="images/Help.png"
							dd:CanDockBottom="False"
							dd:CanDockAsDocument="False"
							dd:IsAutoHide="True">
							<!--Unknown connection ID: 10-->
							<Frame
								Name="FrameRight">
								<ContentControl.Content>
									<!--Unknown connection ID: 11-->
									<browser:ContextHelp
										Name="browser" />
								</ContentControl.Content>
							</Frame>
						</AcpUINS:AcpDockWindow>
					</dd:DockWindowGroup>
				</dd:SplitPanel>
			</dd:DockSite.SplitPanels>
			<dd:SplitPanel>
				<DockPanel>
					<!--Unknown connection ID: 12-->
					<dd:DockSite
						Name="CenterDock"
						LicenseKey="DAD80300DA22">
						<dd:DockSite.SplitPanels>
							<!--Unknown connection ID: 13-->
							<dd:SplitPanel
								Name="EventPanel"
								DockSite.Dock="Bottom"
								DockSite.DockSize="150">
								<!--Unknown connection ID: 14-->
								<dd:DockWindowGroup
									Name="EventPanelGrp">
									<!--Unknown connection ID: 15-->
									<AcpUINS:AcpDockWindow
										Name="OutputDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Output_Id}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 16-->
										<Frame
											Name="FrameOutput" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/RedXClipboard.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 17-->
									<AcpUINS:AcpDockWindow
										Name="InvalidFieldsDockWnd"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True"
										Header="{Binding Path=UiCount, Converter={StaticResource InvalidFieldsHeaderConverter}, Mode=OneWay}">
										<!--Unknown connection ID: 18-->
										<Frame
											Name="FrameInvalidFields"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/invalid.ico" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 19-->
									<AcpUINS:AcpDockWindow
										Name="DnDDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Drag_and_Drop_Report}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 20-->
										<Frame
											Name="FrameDnD"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/CopyIcon.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 21-->
									<AcpUINS:AcpDockWindow
										Name="ImpExpDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Import_Export_Report}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 22-->
										<Frame
											Name="FrameImpExp"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/NewReport.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 23-->
									<AcpUINS:AcpDockWindow
										Name="ComparatorDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Comparator_Report}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 24-->
										<Frame
											Name="FrameComparator"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/GreenCheckClipboard.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 25-->
									<AcpUINS:AcpDockWindow
										Name="FillUpFillDownDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Fill_Up_Fill_Down_Report}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 26-->
										<Frame
											Name="FrameFillUpFillDown"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/SychronizeListHSRotated.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 27-->
									<AcpUINS:AcpDockWindow
										Name="FindResultsDockWnd"
										Header="{x:Static AcpCommonResources:AcpResources.Find_Results}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 28-->
										<Frame
											Name="FrameFindResults"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/Find.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
									<!--Unknown connection ID: 29-->
									<AcpUINS:AcpDockWindow
										Name="SysKeyReportWnd"
										Header="{x:Static AcpCommonResources:AcpResources.System_Key_Report}"
										dd:CanAutoHide="True"
										dd:CanDockAsDocument="False"
										dd:IsAutoHide="True">
										<!--Unknown connection ID: 30-->
										<Frame
											Name="FrameSysKeyReport"
											JournalOwnership="OwnsJournal"
											NavigationUIVisibility="Hidden" />
										<dd:DockWindow.Image>
											<Image
												Style="{StaticResource Image16x16Style}"
												Source="images/ReportLoadedSystemKeys.png" />
										</dd:DockWindow.Image>
									</AcpUINS:AcpDockWindow>
								</dd:DockWindowGroup>
							</dd:SplitPanel>
						</dd:DockSite.SplitPanels>
						<dd:SplitPanel>
							<!--Unknown connection ID: 31-->
							<Frame
								Name="FrameCenterTop"
								JournalOwnership="OwnsJournal"
								NavigationUIVisibility="Visible"
								VerticalContentAlignment="Top"
								HorizontalContentAlignment="Left" />
						</dd:SplitPanel>
					</dd:DockSite>
				</DockPanel>
			</dd:SplitPanel>
		</dd:DockSite>
	</DockPanel>
</Page>
