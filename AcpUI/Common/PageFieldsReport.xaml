<Page
	x:Class="AcpUI.Common.PageFieldsReport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources" xmlns:AcpUIStylesNS="clr-namespace:AcpUI.Styles"
	Height="Auto"
	Width="Auto" xmlns:common="clr-namespace:AcpUI.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUIStylesNS:ListViewItemStyleSelector
				x:Key="ListViewItemStyleSelector" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel>
		<!--Unknown connection ID: 1-->
		<ListView
			Name="myListView"
			DockPanel.Dock="Top"
			ScrollViewer.CanContentScroll="True"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			Grid.Row="1"
			IsSynchronizedWithCurrentItem="true"
			Width="Auto"
			Background="#00FFFFFF"
			ItemsSource="{Binding}">
			<ListView.View>
				<!--Unknown connection ID: 2-->
				<GridView
					x:Name="FieldsReportGV">
					<GridView.Columns>
						<!--Unknown connection ID: 3-->
						<GridViewColumn
							x:Name="FieldsReportGVC1"
							Header="{x:Static AcpCommonResources:AcpResources.Location_Id}"
							Width="Auto"
							DisplayMemberBinding="{Binding Path}" />
						<!--Unknown connection ID: 4-->
						<GridViewColumn
							x:Name="FieldsReportGVC2"
							Header="{x:Static AcpCommonResources:AcpResources.Field_Id}"
							Width="Auto"
							DisplayMemberBinding="{Binding Name}" />
						<!--Unknown connection ID: 5-->
						<GridViewColumn
							x:Name="FieldsReportGVC3"
							Header="{x:Static AcpCommonResources:AcpResources.Field_Value}"
							Width="Auto"
							DisplayMemberBinding="{Binding FieldValue}" />
						<!--Unknown connection ID: 6-->
						<GridViewColumn
							x:Name="FieldsReportGVC4"
							Header="{x:Static AcpCommonResources:AcpResources.Comparison_Field_Value}"
							Width="Auto"
							DisplayMemberBinding="{Binding Message}" />
					</GridView.Columns>
				</GridView>
			</ListView.View>
		</ListView>
	</DockPanel>
</Page>
