<Page
	x:Class="AcpUI.Common.PageFindResults" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
	Title="Find Results" xmlns:common="clr-namespace:AcpUI.Common">
	<DockPanel
		LastChildFill="True">
		<StackPanel
			DockPanel.Dock="Bottom"
			Orientation="Horizontal"
			Height="16">
			<!--Unknown connection ID: 1-->
			<TextBlock
				Name="TxtBlkCounter"
				Text="{Binding Path=Count}" />
			<TextBlock
				Text="{x:Static AcpCommonResources:AcpResources.Items_Found}" />
		</StackPanel>
		<!--Unknown connection ID: 2-->
		<ListView
			Name="FindResultsList"
			DockPanel.Dock="Top"
			ScrollViewer.CanContentScroll="True"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			IsSynchronizedWithCurrentItem="true"
			Width="Auto"
			Background="#00FFFFFF"
			ItemsSource="{Binding}">
			<ListView.View>
				<!--Unknown connection ID: 3-->
				<GridView
					x:Name="FindResultsGrid">
					<GridView.Columns>
						<!--Unknown connection ID: 4-->
						<GridViewColumn
							x:Name="Num"
							Header="{x:Static AcpCommonResources:AcpResources.Number_Short_Id}"
							Width="Auto"
							DisplayMemberBinding="{Binding Index}" />
						<!--Unknown connection ID: 5-->
						<GridViewColumn
							x:Name="FieldName"
							Header="{x:Static AcpCommonResources:AcpResources.Field_Name}"
							Width="Auto"
							DisplayMemberBinding="{Binding Name}" />
						<!--Unknown connection ID: 6-->
						<GridViewColumn
							x:Name="Path"
							Header="{x:Static AcpCommonResources:AcpResources.Path_Id}"
							Width="Auto"
							DisplayMemberBinding="{Binding Path}" />
					</GridView.Columns>
				</GridView>
			</ListView.View>
		</ListView>
	</DockPanel>
</Page>
