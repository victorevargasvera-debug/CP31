<UserControl
	x:Class="AcpUI.AcpPasswordEyeBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common" xmlns:igEditors="http://infragistics.com/Editors">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="0" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 1-->
		<PasswordBox
			Name="MyPasswordBox"
			Grid.Row="0"
			Grid.Column="0"
			PasswordChar="*"
			ContextMenu="{x:Null}"
			MaxLength="{Binding Path=MaxPasswordLength, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Visibility="{Binding Path=Visibility, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Background="{Binding Path=Background, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Foreground="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}">
			<UIElement.CommandBindings>
				<!--Unknown connection ID: 2-->
				<CommandBinding
					Command="ApplicationCommands.Copy" />
				<!--Unknown connection ID: 3-->
				<CommandBinding
					Command="ApplicationCommands.Cut" />
			</UIElement.CommandBindings>
		</PasswordBox>
		<!--Unknown connection ID: 4-->
		<TextBox
			Name="MyOpenPasswordBox"
			Grid.Row="0"
			Grid.Column="0"
			Visibility="Collapsed"
			Text="{Binding Path=PIN, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Background="{Binding Path=Background, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Foreground="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}" />
		<!--Unknown connection ID: 5-->
		<Button
			Name="btnShowPassword"
			Grid.Row="0"
			Grid.Column="2"
			IsTabStop="False"
			ClickMode="Press"
			Height="22"
			Width="22"
			Style="{x:Null}"
			FocusVisualStyle="{x:Null}"
			IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Visibility="{Binding Path=Visibility, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Background="{Binding Path=Background, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			Foreground="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}"
			BorderBrush="{Binding ElementName=MyPasswordBox, Path=BorderBrush}"
			Opacity="{Binding Path=IsEyeVisible, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordEyeBox}}}">
			<StackPanel>
				<!--Unknown connection ID: 6-->
				<Grid
					Name="imgWhiteEye">
					<Path
						Stretch="Uniform"
						Fill="#FF000000"
						Data="M0,0 M512,512 M326.971,309.228 C326.971,348.424 295.196,380.198 256,380.198 C216.804,380.198 185.03,348.424 185.03,309.228 C185.03,288.031 194.323,269.004 209.057,256 C221.567,244.958 238.001,238.257 256,238.257 C273.999,238.257 290.433,244.958 302.944,256 C317.678,269.004 326.971,288.031 326.971,309.228 M480,309.228 L397.941,309.228 C397.941,309.228 389.069,282.614 366.891,256 C344.713,229.386 309.228,202.772 256,202.772 C202.773,202.772 167.287,229.386 145.109,256 C122.931,282.614 114.059,309.228 114.059,309.228 L32,309.228 C32,309.228 40.8368,285.816 59.6176,256 C92.5377,203.738 156.011,131.802 256,131.802 C355.989,131.802 419.462,203.738 452.382,256 C471.163,285.816 480,309.228 480,309.228" />
				</Grid>
				<!--Unknown connection ID: 7-->
				<Grid
					Name="imgBlackEye"
					Visibility="Collapsed">
					<Path
						Stretch="Uniform"
						Fill="#FF000000"
						Data="M0,0 L512,0 L512,512 L0,512 L0,0 M256,238.258 C295.196,238.258 326.971,270.032 326.971,309.228 C326.971,348.424 295.196,380.198 256,380.198 C216.804,380.198 185.03,348.424 185.03,309.228 C185.03,270.032 216.804,238.258 256,238.258 M256,131.802 C413.033,131.802 480,309.228 480,309.228 L397.941,309.228 C397.941,309.228 362.456,202.772 256,202.772 C149.545,202.772 114.059,309.228 114.059,309.228 L32,309.228 C32,309.228 98.9674,131.802 256,131.802" />
				</Grid>
			</StackPanel>
		</Button>
	</Grid>
</UserControl>
