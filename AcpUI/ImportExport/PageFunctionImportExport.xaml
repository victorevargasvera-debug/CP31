			Width="125"
			IsEnabled="False"
			Content="{x:Static AcpCommonResources:AcpResources.Import_Export}" />
		<!--Unknown connection ID: 5-->
		<Button
			Name="BtnUnselectAll"
			Height="23"
			HorizontalAlignment="Right"
			Margin="0,46,10,0"
