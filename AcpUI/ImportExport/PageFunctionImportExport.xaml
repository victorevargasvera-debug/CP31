<z:PageFunctionImportExportBase
	x:Class="AcpUI.ImportExport.PageFunctionImportExport" xmlns:z="clr-namespace:AcpUI.ImportExport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
	Title="PageFunctionImportExport"
	ShowsNavigationUI="False"
	Height="293"
