			Margin="14,22,152,18"
			DisplayMemberPath="RecsetName" />
		<!--Unknown connection ID: 2-->
		<Button
			Name="BtnSelectAll"
			Height="23"
			HorizontalAlignment="Right"
			Margin="0,22,10,0"
