			Width="125"
			Content="{x:Static AcpCommonResources:AcpResources.Select_All}" />
		<!--Unknown connection ID: 3-->
		<Button
			Name="BtnCancel"
			Height="23"
			HorizontalAlignment="Right"
			Margin="0,0,10,20"
