<UserControl
	x:Class="AcpUI.AcpChannelNavToolBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 1-->
		<AcpUINS:AcpLabel
			Name="RecNavLbl"
			Grid.Row="0"
			Grid.Column="0" />
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpButton
			Name="RecNavBtnFirst"
			Click="OnClick"
			ToolTip="First"
			Grid.Row="0"
			Grid.Column="1">
			<!--Unknown connection ID: 3-->
			<Image
				Name="RecNavBtnFirstImage"
				Opacity="1.0"
				Source="../../icons/RecFirst.bmp"
				ClipToBounds="True"
				Stretch="None" />
		</AcpUINS:AcpButton>
		<!--Unknown connection ID: 4-->
		<AcpUINS:AcpButton
			Name="RecNavBtnPrevious"
			Click="OnClick"
			ToolTip="Previous"
			Grid.Row="0"
			Grid.Column="2">
			<!--Unknown connection ID: 5-->
			<Image
				Name="RecNavBtnPreviousImage"
				Opacity="1.0"
				Source="../../icons/RecPrev.bmp"
				ClipToBounds="True"
				Stretch="None" />
		</AcpUINS:AcpButton>
		<!--Unknown connection ID: 6-->
		<AcpUINS:AcpButton
			Name="RecNavBtnNext"
			Click="OnClick"
			ToolTip="Next"
			Grid.Row="0"
			Grid.Column="3">
			<!--Unknown connection ID: 7-->
			<Image
				Name="RecNavBtnNextImage"
				Opacity="1.0"
				Source="../../icons/RecNext.bmp"
				ClipToBounds="True"
				Stretch="None" />
		</AcpUINS:AcpButton>
		<!--Unknown connection ID: 8-->
		<AcpUINS:AcpButton
			Name="RecNavBtnLast"
			Click="OnClick"
			ToolTip="Last"
			Grid.Row="0"
			Grid.Column="4">
			<!--Unknown connection ID: 9-->
			<Image
				Name="RecNavBtnLastImage"
				Opacity="1.0"
				Source="../../icons/RecLast.bmp"
				ClipToBounds="True"
				Stretch="None" />
		</AcpUINS:AcpButton>
	</Grid>
</UserControl>
