<UserControl
	x:Class="AcpUI.AcpListBoxMruFiles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:AcpUIMruNS="clr-namespace:AcpUI.Mru" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Height="Auto"
	Width="Auto">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<XmlDataProvider
				Document="{x:Static Member=AcpUIMruNS:MruFiles.MRUDoc}"
				x:Key="MruSrc" />
			<Style
				TargetType="{x:Type ListBox}"
				x:Key="{x:Type ListBox}">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Grid
								Width="Auto"
								Height="Auto">
								<Border
									Name="Border"
									CornerRadius="0,0,0,0" />
								<ScrollViewer
									Focusable="False"
									IsTabStop="False"
									HorizontalScrollBarVisibility="Disabled">
									<StackPanel
										IsItemsHost="True" />
								</ScrollViewer>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										Property="Background"
										Value="#00FFFFFF" />
								</Trigger>
								<Trigger
									Property="ItemsControl.IsGrouping"
									Value="True">
									<Setter
										Property="CanContentScroll"
										Value="False" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="BorderThickness"
					Value="0,0,0,0" />
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		DataContext="{Binding Source={StaticResource MruSrc}, XPath=/data/item}">
		<!--Unknown connection ID: 1-->
		<ListBox
			Name="MruListBox"
			BorderThickness="0"
			ScrollViewer.HorizontalScrollBarVisibility="Hidden"
			ScrollViewer.VerticalScrollBarVisibility="Hidden"
			ItemsSource="{Binding}"
			IsEnabled="{Binding Path=IsEnabled, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpListBoxMruFiles}}}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Label>
						<Hyperlink
							IsEnabled="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}">
							<!--Unknown connection ID: 2-->
							<StackPanel
								Orientation="Horizontal"
								Tag="{Binding XPath=@Path}">
								<TextBlock
									Background="#00FFFFFF"
									Text="{Binding XPath=@Index}" />
								<TextBlock
									Background="#00FFFFFF"
									Margin="10,0,0,0"
									Text="{Binding XPath=@Name}" />
							</StackPanel>
							<ToolTipService.ToolTip>
								<ToolTip>
									<ContentControl.Content>
										<TextBlock
											TextWrapping="Wrap"
											Text="{Binding XPath=@Path}" />
									</ContentControl.Content>
								</ToolTip>
							</ToolTipService.ToolTip>
						</Hyperlink>
					</Label>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
	</Grid>
</UserControl>
