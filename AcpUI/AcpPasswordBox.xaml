<UserControl
	x:Class="AcpUI.AcpPasswordBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common" xmlns:igEditors="http://infragistics.com/Editors">
	<!--Unknown connection ID: 1-->
	<PasswordBox
		Name="MyPasswordBox"
		PasswordChar="*"
		ContextMenu="{x:Null}"
		MaxLength="{Binding Path=MaxPasswordLength, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordBox}}}"
		IsEnabled="{Binding Path=IsEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordBox}}}"
		Visibility="{Binding Path=Visibility, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordBox}}}"
		Background="{Binding Path=Background, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordBox}}}"
		Foreground="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpPasswordBox}}}" />
</UserControl>
