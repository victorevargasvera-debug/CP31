<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Infragistics.Controls.Barcodes">
	<Style
		TargetType="{x:Type local:XamGridBarcode}"
		x:Key="GridBarcodeBase">
		<Setter
			Property="Background"
			Value="#FFFFFFFF" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:XamGridBarcode}">
					<Grid
						Name="RootGrid">
						<local:BarcodeGrid
							Name="BarcodeGrid" />
						<TextBlock
							Name="ErrorTextBlock"
							TextWrapping="Wrap"
							Visibility="Collapsed" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type local:XamMaxiCodeBarcode}"
		x:Key="{x:Type local:XamMaxiCodeBarcode}">
		<Setter
			Property="Background"
			Value="#FFFFFFFF" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:XamMaxiCodeBarcode}">
					<Grid
						Name="RootGrid">
						<local:MaxiCodeModulesPanel
							Name="ModulesPanel" />
						<TextBlock
							Name="ErrorTextBlock"
							TextWrapping="Wrap"
							Visibility="Collapsed" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type local:XamCode39Barcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamCode39Barcode}" />
	<Style
		TargetType="{x:Type local:XamCode128Barcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamCode128Barcode}" />
	<Style
		TargetType="{x:Type local:XamEanUpcBarcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamEanUpcBarcode}" />
	<Style
		TargetType="{x:Type local:XamGs1DataBarBarcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamGs1DataBarBarcode}" />
	<Style
		TargetType="{x:Type local:XamIntelligentMailBarcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamIntelligentMailBarcode}" />
	<Style
		TargetType="{x:Type local:XamInterleaved2Of5Barcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamInterleaved2Of5Barcode}" />
	<Style
		TargetType="{x:Type local:XamPdf417Barcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamPdf417Barcode}" />
	<Style
		TargetType="{x:Type local:XamQRCodeBarcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamQRCodeBarcode}" />
	<Style
		TargetType="{x:Type local:XamRoyalMailBarcode}"
		BasedOn="{StaticResource GridBarcodeBase}"
		x:Key="{x:Type local:XamRoyalMailBarcode}" />
</ResourceDictionary>
