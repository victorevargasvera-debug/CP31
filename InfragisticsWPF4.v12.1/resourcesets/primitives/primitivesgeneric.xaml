	<Style
		TargetType="{x:Type igWindows:ToolWindow}"
		x:Key="{x:Type igWindows:ToolWindow}">
		<Setter
			Property="Background"
			Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowBackgroundFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="15" />
		<Setter
			Property="BorderThickness"
			Value="{Binding Path=PreferredBorderThickness, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igWindows:ToolWindow}">
					<AdornerDecorator>
						<Grid
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True">
							<Border
								Name="windowOuterBorder"
								BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveOuterBorderFillKey}"
								BorderThickness="1,1,1,1" />
							<Border
								Name="windowInnerBorder"
								BorderThickness="1,1,1,1"
								BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveInnerBorderFillKey}"
								Margin="1,1,1,1" />
							<Border
								Name="windowCenterBorder"
								Margin="2,2,2,2"
								Background="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCenterFillKey}">
								<Grid
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
									<Grid.RowDefinitions>
										<RowDefinition
											Name="captionRow"
											Height="Auto" />
										<RowDefinition
											Name="contentRow"
											Height="*" />
									</Grid.RowDefinitions>
									<igWindows:CardPanel
										Name="PART_Caption"
										Background="{DynamicResource PrimitivesBrushKeys.ToolWindowInactiveCaptionFillKey}"
										Visibility="{TemplateBinding CaptionVisibility}">
										<DockPanel
											Name="captionPanel"
											Margin="6,6,6,2">
											<Button
												Command="{x:Static igWindows:ToolWindow.CloseCommand}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Style="{StaticResource ToolWindowCloseButtonStyle}" />
											<Button
												Name="MaximizeButton"
												Command="{x:Static igWindows:ToolWindow.MaximizeCommand}"
												Visibility="{TemplateBinding igWindows:MaximizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Margin="1,0"
												Style="{StaticResource ToolWindowMaximizeButtonStyle}"
												ToolTip="{StaticResource maximizeToolTip}" />
											<Button
												Name="MinimizeButton"
												Command="{x:Static igWindows:ToolWindow.MinimizeCommand}"
												Visibility="{TemplateBinding igWindows:MinimizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Style="{StaticResource ToolWindowMinimizeButtonStyle}"
												ToolTip="{StaticResource minimizeToolTip}" />
											<TextBlock
												Name="txtCaption"
												Text="{TemplateBinding igWindows:Title}"
												IsHitTestVisible="False"
												TextTrimming="CharacterEllipsis"
												Foreground="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCaptionTextFillKey}"
												FontFamily="{DynamicResource SystemFonts.SmallCaptionFontFamilyKey}"
												FontSize="{DynamicResource SystemFonts.SmallCaptionFontSizeKey}"
												FontStyle="{DynamicResource SystemFonts.SmallCaptionFontStyleKey}"
												FontWeight="{DynamicResource SystemFonts.SmallCaptionFontWeightKey}"
												TextDecorations="{DynamicResource SystemFonts.SmallCaptionFontTextDecorationsKey}" />
										</DockPanel>
									</igWindows:CardPanel>
									<Grid
										Name="Content"
										Background="{TemplateBinding Background}"
										Margin="6,0,6,6"
										Row="1">
										<ContentPresenter
											Name="PART_Content"
											Grid.Row="1"
											Margin="{TemplateBinding Padding}"
											HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											ContentSource="Content" />
										<Grid
											Name="PART_ResizeGrip"
											RowSpan="2"
											Background="#00FFFFFF"
											HorizontalAlignment="Right"
											VerticalAlignment="Bottom"
											Visibility="Collapsed">
											<ResizeGrip
												IsTabStop="False"
												IsHitTestVisible="False" />
										</Grid>
									</Grid>
								</Grid>
							</Border>
							<Grid
								Name="resizeAreas"
								Visibility="Collapsed"
								FlowDirection="LeftToRight">
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTop"
									BorderLocation="Top" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderLeft"
									BorderLocation="Left" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottom"
									BorderLocation="Bottom" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderRight"
									BorderLocation="Right" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTopLeft"
									BorderLocation="TopLeft" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTopRight"
									BorderLocation="TopRight" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottomLeft"
									BorderLocation="BottomLeft" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottomRight"
									BorderLocation="BottomRight" />
							</Grid>
						</Grid>
					</AdornerDecorator>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igWindows:ToolWindow.WindowState"
							Value="Minimized">
							<Setter
								TargetName="MinimizeButton"
								Value="{x:Static igWindows:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MinimizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreUpToolTip}" />
							<Setter
								TargetName="MinimizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<Trigger
							Property="igWindows:ToolWindow.WindowState"
							Value="Maximized">
							<Setter
								TargetName="MaximizeButton"
								Value="{x:Static igWindows:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MaximizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreDownToolTip}" />
							<Setter
								TargetName="MaximizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Visible" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_Content"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="captionRow"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="contentRow"
								Property="Height"
								Value="0" />
							<Setter
								TargetName="captionPanel"
								Property="Margin"
								Value="6,0" />
							<Setter
								TargetName="txtCaption"
								Property="VerticalAlignment"
								Value="Center" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Maximized" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
						<Trigger
							Property="igWindows:ToolWindow.IsActive"
							Value="True">
							<Setter
								TargetName="txtCaption"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionTextFillKey}"
								Property="Foreground" />
							<Setter
								TargetName="windowOuterBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowInnerBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowCenterBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="PART_Caption"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionFillKey}"
								Property="Background" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResize" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_ResizeGrip"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<Trigger
							Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
							Value="True">
							<Setter
								TargetName="PART_Caption"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0,0,0,0" />
							<Setter
								TargetName="windowOuterBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="windowInnerBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Background"
								Value="#00FFFFFF" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Border.Padding"
								Value="0,0,0,0" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Margin"
								Value="0,0,0,0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="6" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Maximized" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowCenterBorder"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="windowInnerBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="windowOuterBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igWindows:ToolWindow.IsActive"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource SystemColors.ActiveBorderBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type tiles:TileDragIndicator}"
		x:Key="{x:Type tiles:TileDragIndicator}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type tiles:TileDragIndicator}">
					<ContentPresenter />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
