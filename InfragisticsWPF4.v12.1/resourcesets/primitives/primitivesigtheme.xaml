	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{StaticResource PagerScrollBtnBase}"
		x:Key="{x:Static controls:XamTabControl.ScrollDownButtonStyleKey}">
		<Setter
			Property="ContentTemplate">
