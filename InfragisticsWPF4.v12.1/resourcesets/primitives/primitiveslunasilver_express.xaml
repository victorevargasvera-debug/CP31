<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ig="clr-namespace:Infragistics.Windows" xmlns:controls="clr-namespace:Infragistics.Windows.Controls" xmlns:igWindows="clr-namespace:Infragistics.Windows.Controls" xmlns:looks="clr-namespace:Infragistics.Windows.Looks" xmlns:themes="clr-namespace:Infragistics.Windows.Themes" xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="PrimitivesGeneric_Express.xaml" />
		<ResourceDictionary
			Source="PrimitivesLunaSilver_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		BasedOn="{x:Static themes:PrimitivesGeneric.SortIndicator}"
		TargetType="{x:Type controls:SortIndicator}"
		x:Key="{x:Type controls:SortIndicator}">
		<Setter
			Property="Visibility"
			Value="Visible" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey {x:Type controls:SortIndicator}, SortIndicatorBackground}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type controls:SortIndicator}">
					<Polygon
						Name="Arrow"
						Points="0,0 10,0 5,5"
						StrokeEndLineCap="Round"
						StrokeStartLineCap="Round"
						StrokeLineJoin="Round"
						Fill="{TemplateBinding Background}"
						VerticalAlignment="Center"
						HorizontalAlignment="Stretch"
						Width="Auto"
						Height="Auto" />
					<ControlTemplate.Triggers>
						<Trigger
							Property="controls:SortIndicator.SortStatus"
							Value="Descending">
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="controls:SortIndicator.SortStatus"
							Value="Ascending">
							<Setter
								TargetName="Arrow"
								Property="Polygon.Points"
								Value="0,5 10,5 5,0" />
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="HorizontalAlignment"
			Value="Left" />
		<Setter
			Property="VerticalAlignment"
			Value="Center" />
	</Style>
	<Style
		BasedOn="{x:Static themes:PrimitivesGeneric.ExpanderBar}"
		TargetType="{x:Type controls:ExpanderBar}"
		x:Key="{x:Type controls:ExpanderBar}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type controls:ExpanderBar}">
					<Grid>
						<Rectangle
							Name="bgRect"
							Stroke="{TemplateBinding BorderBrush}"
							StrokeThickness="1"
							Fill="{TemplateBinding Background}" />
						<Border
							Margin="0,0,0,0"
							Background="#FFE0DFE3"
							BorderBrush="#FF919B9C"
							BorderThickness="0,0,0,1" />
						<Border
							Name="border"
							BorderBrush="#FF919B9C"
							BorderThickness="0,0,0,1"
							Visibility="Collapsed">
							<Border.Background>
								<LinearGradientBrush
									EndPoint="0,1"
									StartPoint="0,0">
									<GradientStop
										Color="#FFFFD58C"
										Offset="0" />
									<GradientStop
										Color="#FFFFAD55"
										Offset="1" />
								</LinearGradientBrush>
							</Border.Background>
						</Border>
						<Border
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							BorderBrush="#FFFFFFFF"
							BorderThickness="0,1,0,0" />
					</Grid>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="bgRect"
								Property="Fill"
								Value="{Binding Path=BackgroundHover, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="bgRect"
								Property="Stroke"
								Value="{Binding Path=BorderHoverBrush, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="border"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
