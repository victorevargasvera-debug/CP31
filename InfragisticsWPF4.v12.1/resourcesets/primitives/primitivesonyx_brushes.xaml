<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Infragistics.Windows.Controls" xmlns:igWindows="clr-namespace:Infragistics.Windows.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:themes="clr-namespace:Infragistics.Windows.Themes">
	<LinearGradientBrush
		x:Freeze="true"
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey {x:Type controls:IGControlBase}, CarouselItemSelected}">
		<GradientStop
			Color="#FF969696"
			Offset="0.985" />
		<GradientStop
			Color="#FFF5F5F5"
			Offset="0" />
	</LinearGradientBrush>
	<SolidColorBrush
		x:Freeze="true"
		themes:ResourceWasher.WashGroup="BaseColor"
		Color="Transparent"
		x:Key="{x:Static igWindows:PrimitivesBrushKeys.TabControlTabStripCenterFillKey}" />
	<LinearGradientBrush
		x:Freeze="true"
		StartPoint="0.5,0"
		EndPoint="0.5,1"
		x:Key="{x:Static igWindows:PrimitivesBrushKeys.DropIndicatorFillKey}">
		<GradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop
					Color="#FF5D5D5D"
					Offset="0" />
				<GradientStop
					Color="#FF3C3C3C"
					Offset="1" />
			</GradientStopCollection>
		</GradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush
		x:Freeze="true"
		Color="#FFB0AFA0"
		x:Key="{x:Static igWindows:PrimitivesBrushKeys.DropTargetStrokeKey}" />
</ResourceDictionary>
