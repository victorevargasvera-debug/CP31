<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.SystemCertificates.List.SystemCertificateListPageTbl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:ACPUCLContactFeatureNS="clr-namespace:SpecialFeatures.SystemCertificates.List" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.System_Certificate_List_Table_View_ID}">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpVoiceAnnRecNavToolBar
			Name="RecNavToolbarPageSystemCertificateTbl"
			Grid.Row="0"
			TableMode="True"
			MyRecordsetDataSource="{Binding Path=DataContext, RelativeSource={RelativeSource Self}}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpRtdButtonVisibilityConverter
				x:Key="acpRtdButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCopyButtonVisibilityConverter
				x:Key="acpCopyButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverterForEmptyTbl
				x:Key="acpXamDataPresenterVisibilityConverterForEmptyTbl" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<AcpUICommonNS:ParentControlVisibilityConverter
				x:Key="parentControlVisibilityConverter" />
			<AcpUICommonNS:ComparatorControlVisibilityConverter
				x:Key="comparatorControlVisibilityConverter" />
			<AcpUICommonNS:AcpRecNavToolbarTableModeConverter
				x:Key="acpRecNavToolbarTableModeConverter" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetSystemCertificateListRecSet">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>4228</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="SystemCertificateNameCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpTableTextBox
								Text="{Binding Path=Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633Value, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyBLObject="{Binding Path=Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633Object, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpTextBox.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633Object"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpTextBox.IsAcpEditable>
								<AcpUINS:AcpTextBox.IsAcpApplicable>
									<MultiBinding
										Converter="{StaticResource CellVisibilityStatus}">
										<MultiBinding.Bindings>
											<Binding
												Path="Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633_Visible"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
											<Binding
												Path="Record.DataItem.General.SecSysCertGeneralKeyofSystemCertificates_A43633_Applicable"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										</MultiBinding.Bindings>
									</MultiBinding>
								</AcpUINS:AcpTextBox.IsAcpApplicable>
							</AcpUINS:AcpTableTextBox>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="SystemCertificateFileName_A43634CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 4-->
							<AcpUINS:AcpTextBoxFileBrowser
								Name="systemCertificateFileBrowser"
								Text="{Binding Path=Record.DataItem.General.SecSysCertGeneralCertificateFilename_A43634Value, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyBLObject="{Binding Path=Record.DataItem.General.SecSysCertGeneralCertificateFilename_A43634Object, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.SecSysCertGeneralCertificateFilename_A43634_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.SecSysCertGeneralCertificateFilename_A43634_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.SecSysCertGeneralCertificateFilename_A43634Object"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
							</AcpUINS:AcpTextBoxFileBrowser>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 5-->
		<AcpUINS:AcpXamDataPresenter
			Name="SystemCertificateListDataPresenter"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1"
			Header="{x:Static CommonResxNS:AppResources.System_Cerfiticate_List_ID}">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibilityConverterForEmptyTbl}"
					ConverterParameter="1"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Path="DataContext.HasDiffs"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Source="{StaticResource GetSystemCertificateListRecSet}"
						Path="IsEmpty" />
					<Binding
						Source="{StaticResource GetSystemCertificateListRecSet}"
						Path="TemplateNode.General.SecSysCertGeneralCertificateFilename_A43634_Visible" />
					<Binding
						ElementName="System_Certificate_FileName_A43634_col"
						Path="Visibility" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<!--Unknown connection ID: 6-->
						<igcontrols:UnboundField
							x:Name="System_Certificate_Name_col"
							Label="{x:Static CommonResxNS:AppResources.System_Certificate_Name_ID}"
							BindingPath="General.SecSysCertGeneralKeyofSystemCertificates_A43633Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetSystemCertificateListRecSet}, Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource SystemCertificateNameCellStyle}"
									CellWidth="300"
									CellMinWidth="300" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
						<!--Unknown connection ID: 7-->
						<igcontrols:UnboundField
							x:Name="System_Certificate_FileName_A43634_col"
							Label="{x:Static CommonResxNS:AppResources.System_Certificate_Filename_ID}"
							BindingPath="General.SecSysCertGeneralCertificateFilename_A43634Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetSystemCertificateListRecSet}, Path=General.SecSysCertGeneralCertificateFilename_A43634_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource SystemCertificateFileName_A43634CellStyle}"
									CellWidth="300"
									CellMinWidth="300" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
