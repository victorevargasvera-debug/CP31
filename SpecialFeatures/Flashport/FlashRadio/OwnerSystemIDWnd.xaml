<Window
	x:Class="SpecialFeatures.Flashport.FlashRadio.OwnerSystemIDWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpecialFeatures.Flashport.FlashRadio" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:AcpSecurityLibNS="clr-namespace:AcpSecurityLib;assembly=AcpSecurityLib"
	Name="myOwnerSystemIDWindow"
	Title="{x:Static CommonResxNS:AppResources.Radio_Owner_System_ID_Initialization}"
	Height="267"
	Width="462"
	MinWidth="462"
	ResizeMode="CanMinimize"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	SizeToContent="WidthAndHeight"
	BorderBrush="#FF5D636C"
	BorderThickness="1">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="../../Styles/ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<LinearGradientBrush
				StartPoint="0.0338026,-0.0020342"
				EndPoint="0.0338026,0.998692"
				x:Key="MyBrush1234">
				<GradientStop
					Color="#FF1C2027"
					Offset="0" />
				<GradientStop
					Color="#FF5C626B"
					Offset="0.0859826" />
				<GradientStop
					Color="#FF9CA4B0"
					Offset="0.0863636" />
				<GradientStop
					Color="#FF5D636C"
					Offset="0.462964" />
				<GradientStop
					Color="#FF1E2228"
					Offset="0.463636" />
				<GradientStop
					Color="#FF4C4C4C"
					Offset="1" />
			</LinearGradientBrush>
			<local:HasItemsToImageConverter
				x:Key="HasItemsToImageConverter" />
			<local:HasItemsToMessageConverter
				x:Key="HasItemsToMessageConverter" />
			<local:SelectedItemConverter
				x:Key="SelectedItemConverter" />
			<AcpSecurityLibNS:KeyTypeConverter
				x:Key="keyTypeConverter" />
			<ObjectDataProvider
				MethodName="GetLoadedASKWithoutDefault"
				ObjectType="{x:Type local:MyDataSource}"
				x:Key="LoadedASKs" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Control.Background>
		<LinearGradientBrush
			EndPoint="0.5,0.99"
			StartPoint="0.5,0.105">
			<GradientStop
				Color="#FFA6A9AF"
				Offset="0.545" />
			<GradientStop
				Color="#FFC2C5CC"
				Offset="1" />
			<GradientStop
				Color="#FF8F939B"
				Offset="0" />
		</LinearGradientBrush>
	</Control.Background>
	<DockPanel
		Background="{DynamicResource BrushBackgroundSilver}"
		HorizontalAlignment="Stretch">
		<!--Unknown connection ID: 2-->
		<Label
			Name="operationLabel"
			DockPanel.Dock="Top"
			FontSize="16"
			HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Center"
			BorderThickness="0,0,0,0"
			Background="{DynamicResource MyBrush1234}"
			Foreground="#FFD0D0D0"
			Content=""
			BorderBrush="{x:Null}">
			<UIElement.OpacityMask>
				<RadialGradientBrush>
					<Brush.RelativeTransform>
						<TransformGroup>
							<ScaleTransform
								CenterX="0.5"
								CenterY="0.5"
								ScaleX="1.557"
								ScaleY="1.557" />
							<SkewTransform
								AngleX="0"
								AngleY="0"
								CenterX="0.5"
								CenterY="0.5" />
							<RotateTransform
								Angle="0"
								CenterX="0.5"
								CenterY="0.5" />
							<TranslateTransform
								X="0"
								Y="0" />
						</TransformGroup>
					</Brush.RelativeTransform>
					<GradientStop
						Color="#FF000000"
						Offset="0.529" />
					<GradientStop
						Color="#00000000"
						Offset="0.959" />
				</RadialGradientBrush>
			</UIElement.OpacityMask>
		</Label>
		<!--Unknown connection ID: 3-->
		<Grid
			Name="Main"
			DockPanel.Dock="Top"
			Height="140">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="40*" />
				<ColumnDefinition
					Width="50*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="97*"
					MinHeight="18" />
				<RowDefinition
					Height="60.966*"
					MinHeight="18" />
			</Grid.RowDefinitions>
			<Label
				FontSize="12"
				Foreground="#FF2D2D2D"
				FontFamily="Verdana"
				Grid.Row="0"
				Grid.Column="0"
				Content="{x:Static CommonResxNS:AppResources.Enter_Owner_System_ID}"
				Margin="10,0,0,0"
				TabIndex="1"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 4-->
			<ComboBox
				Name="CmboOwnerSystem"
				SelectedIndex="-1"
				Height="24"
				Grid.Row="0"
				Grid.Column="1"
				Margin="0,0,25,0"
				VerticalAlignment="Center"
				ItemsSource="{Binding Source={StaticResource LoadedASKs}}"
				FocusVisualStyle="{x:Null}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel
							Orientation="Horizontal">
							<TextBlock
								Width="50"
								Margin="2,0,0,0"
								Text="{Binding SystemIDHex}" />
							<TextBlock
								Width="150"
								Margin="0,0,2,0"
								Text="{Binding Type, Converter={StaticResource keyTypeConverter}}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ComboBox>
			<!--Unknown connection ID: 5-->
			<StackPanel
				Name="stackPanelError"
				Orientation="Horizontal"
				IsEnabled="True"
				Grid.ColumnSpan="2"
				Grid.Row="1">
				<!--Unknown connection ID: 6-->
				<Image
					Name="imageError"
					Margin="10,0,0,0"
					Width="16"
					Height="16"
					VerticalAlignment="Top"
					Source="{Binding ElementName=CmboOwnerSystem, Path=HasItems, Converter={StaticResource HasItemsToImageConverter}, Mode=OneWay}" />
				<!--Unknown connection ID: 7-->
				<TextBlock
					Name="textBoxError"
					Margin="5,0,0,0"
					Height="50"
					Width="400"
					TextWrapping="WrapWithOverflow"
					Foreground="#FF2D2D2D"
					FontStyle="Italic"
					FontFamily="Verdana"
					FontWeight="Bold"
					Background="#00FFFFFF"
					Text="{Binding ElementName=CmboOwnerSystem, Path=HasItems, Converter={StaticResource HasItemsToMessageConverter}, Mode=OneWay}" />
			</StackPanel>
		</Grid>
		<!--Unknown connection ID: 8-->
		<Button
			Style="{StaticResource AnotherB}"
			DockPanel.Dock="Right"
			HorizontalAlignment="Right"
			Width="75"
			Height="23"
			Margin="10,10,25,20"
			VerticalAlignment="Bottom"
			Background="{DynamicResource SilverButton}"
			Foreground="#FFFFFFFF"
			FontFamily="Verdana"
			FontSize="11"
			Content="{x:Static CommonResxNS:AppResources.Cancel_Id}"
			TabIndex="4" />
		<!--Unknown connection ID: 9-->
		<Button
			Style="{StaticResource AnotherB}"
			DockPanel.Dock="Right"
			HorizontalAlignment="Right"
			Width="90"
			Height="23"
			Margin="10,10,10,20"
			VerticalAlignment="Bottom"
			Background="{DynamicResource Brush1234}"
			Foreground="#FFFFFFFF"
			FontFamily="Verdana"
			FontSize="11"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch"
			Content="{x:Static CommonResxNS:AppResources.OK_Id}"
			TabIndex="3"
			IsEnabled="{Binding ElementName=CmboOwnerSystem, Path=SelectedItem, Converter={StaticResource SelectedItemConverter}, Mode=OneWay}" />
	</DockPanel>
</Window>
