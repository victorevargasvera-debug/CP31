<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.Flashport.RadioConfiguration.PageRadioConfiguration" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
	Focusable="True" xmlns:radioconfiguration="clr-namespace:SpecialFeatures.Flashport.RadioConfiguration"
	Title="{Binding Path=UIName}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpUICommonNS:MultiValueToColorConverter
				x:Key="MultiValueToColor" />
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="RadioCfgFeaturesFeatureNameCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).RadioConfigFeatureNameValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioCfgFeaturesTable}"
								MyBLObject="{Binding Path=(Value).RadioConfigFeatureName, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).RadioConfigFeatureName_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).RadioConfigFeatureName_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).RadioConfigFeatureName_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).RadioConfigFeatureName_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="RadioCfgCurrentFlashcodeCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).RadioConfigCurrentFlashcodeValueValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioCfgFeaturesTable}"
								MyBLObject="{Binding Path=(Value).RadioConfigCurrentFlashcodeValue, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).RadioConfigCurrentFlashcodeValue_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).RadioConfigCurrentFlashcodeValue_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).RadioConfigCurrentFlashcodeValue_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).RadioConfigCurrentFlashcodeValue_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 2-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<DockPanel
		LastChildFill="False">
		<WrapPanel
			DockPanel.Dock="Top">
			<!--Unknown connection ID: 3-->
			<AcpUICommonNS:AcpThemeBase
				Name="ThemeBaseObj" />
			<TextBlock
				Margin="25 3 0 0"
				Visibility="Visible">
				<!--Unknown connection ID: 4-->
				<Hyperlink
					Name="HLinkRadioCfgGeneral"
					Tag="ExpanderRadioCfgGeneral">
					<TextBlock
						TextDecorations="Underline"
						Text="{Binding Path=General.UIName}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource MultiValueToColor}">
								<Binding
									Source="false" />
								<Binding
									Path="ThemeName"
									ElementName="ThemeBaseObj" />
							</MultiBinding>
						</TextBlock.Foreground>
					</TextBlock>
				</Hyperlink>
			</TextBlock>
			<TextBlock
				Margin="25 3 0 0"
				Visibility="{Binding ElementName=ExpanderRadioCfgFeatures, Path=IsAcpVisible, Converter={StaticResource BooleanToVisibility}}">
				<!--Unknown connection ID: 5-->
				<Hyperlink
					Name="HLinkRadioCfgFeatures"
					Tag="ExpanderRadioCfgFeatures">
					<TextBlock
						TextDecorations="Underline"
						Text="{Binding Path=RadioConfigurationFeatures.UIName}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource MultiValueToColor}">
								<Binding
									Source="false" />
								<Binding
									Path="ThemeName"
									ElementName="ThemeBaseObj" />
							</MultiBinding>
						</TextBlock.Foreground>
					</TextBlock>
				</Hyperlink>
			</TextBlock>
		</WrapPanel>
		<DockPanel
			Height="20"
			Background="#00FFFFFF"
			Dock="Top">
			<Rectangle
				Height="2"
				RadiusX="20"
				RadiusY="20"
				Stroke="#FF000000"
				Fill="#FF808080"
				VerticalAlignment="Center" />
		</DockPanel>
		<ScrollViewer
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			DockPanel.Dock="Top">
			<!--Unknown connection ID: 6-->
			<StackPanel
				Name="MyStackPanel"
				Width="Auto"
				Height="Auto">
				<!--Unknown connection ID: 7-->
				<AcpUINS:AcpExpander
					Name="ExpanderRadioCfgGeneral"
					Width="Auto"
					IsAcpVisible="True"
					Header="{Binding Path=General.UIName}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 8-->
						<AcpUINS:AcpGroupBox
							Name="GrpBoxExpanderRadioCfgGeneralPseudo0"
							IsAcpVisible="True"
							BorderBrush="#FF000000"
							Grid.Row="0"
							Grid.Column="0"
							BorderThickness="0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<!--Unknown connection ID: 9-->
								<Grid
									Name="StdGrpBoxExpanderRadioCfgGeneralPseudo0"
									Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="Auto" />
										<ColumnDefinition
											Width="300" />
										<ColumnDefinition
											Width="200" />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>
									<!--Unknown connection ID: 10-->
									<AcpUINS:AcpTextBox
										Name="RadioConfigCurrentModelNumberValue"
										VerticalAlignment="Center"
										Grid.Row="0"
										Grid.Column="2"
										Foreground="#FF000000"
										Text="{Binding Path=General.RadioConfigCurrentModelNumberValue}"
										MyExpander="{Binding ElementName=GrpBoxExpanderRadioCfgGeneralPseudo0}"
										MyBLObject="{Binding Path=General.RadioConfigCurrentModelNumber}"
										MyLabelCtrl="{Binding ElementName=LblRadioConfigCurrentModelNumber}"
										IsAcpValid="{Binding Path=General.RadioConfigCurrentModelNumber_Valid, Mode=OneWay}"
										IsAcpApplicable="{Binding Path=General.RadioConfigCurrentModelNumber_Applicable, Mode=OneWay}"
										IsAcpEditable="{Binding Path=General.RadioConfigCurrentModelNumber_Editable, Mode=OneWay}"
										IsAcpVisible="{Binding Path=General.RadioConfigCurrentModelNumber_Visible, Mode=OneWay}" />
									<!--Unknown connection ID: 11-->
									<AcpUINS:AcpLabel
										Name="LblRadioConfigCurrentModelNumber"
										VerticalAlignment="Center"
										Grid.Row="0"
										Grid.Column="1"
										HelpText="{x:Static CommonResxNS:AppResources.Factory_Order_Number}"
										Content="{Binding Path=General.RadioConfigCurrentModelNumber_UILabel}"
										MyParentCtrl="{Binding ElementName=RadioConfigCurrentModelNumberValue}"
										IsAcpValid="{Binding ElementName=RadioConfigCurrentModelNumberValue, Path=IsAcpValid}"
										IsAcpApplicable="{Binding ElementName=RadioConfigCurrentModelNumberValue, Path=IsAcpApplicable}"
										IsAcpVisible="{Binding ElementName=RadioConfigCurrentModelNumberValue, Path=IsAcpVisible}" />
									<!--Unknown connection ID: 12-->
									<AcpUINS:AcpTextBox
										Name="RadioConfigCurrentFlashcodeValue"
										VerticalAlignment="Center"
										Grid.Row="1"
										Grid.Column="2"
										Foreground="#FF000000"
										Text="{Binding Path=General.RadioConfigCurrentFlashcodeValue}"
										MyExpander="{Binding ElementName=GrpBoxExpanderRadioCfgGeneralPseudo0}"
										MyBLObject="{Binding Path=General.RadioConfigCurrentFlashcode}"
										MyLabelCtrl="{Binding ElementName=LblRadioConfigCurrentFlashcode}"
										IsAcpValid="{Binding Path=General.RadioConfigCurrentFlashcode_Valid, Mode=OneWay}"
										IsAcpApplicable="{Binding Path=General.RadioConfigCurrentFlashcode_Applicable, Mode=OneWay}"
										IsAcpEditable="{Binding Path=General.RadioConfigCurrentFlashcode_Editable, Mode=OneWay}"
										IsAcpVisible="{Binding Path=General.RadioConfigCurrentFlashcode_Visible, Mode=OneWay}" />
									<!--Unknown connection ID: 13-->
									<AcpUINS:AcpLabel
										Name="LblRadioConfigCurrentFlashcode"
										VerticalAlignment="Center"
										Grid.Row="1"
										Grid.Column="1"
										HelpText="{x:Static CommonResxNS:AppResources.Factory_Order_Number}"
										Content="{Binding Path=General.RadioConfigCurrentFlashcode_UILabel}"
										MyParentCtrl="{Binding ElementName=RadioConfigCurrentFlashcodeValue}"
										IsAcpValid="{Binding ElementName=RadioConfigCurrentFlashcodeValue, Path=IsAcpValid}"
										IsAcpApplicable="{Binding ElementName=RadioConfigCurrentFlashcodeValue, Path=IsAcpApplicable}"
										IsAcpVisible="{Binding ElementName=RadioConfigCurrentFlashcodeValue, Path=IsAcpVisible}" />
								</Grid>
							</Grid>
						</AcpUINS:AcpGroupBox>
					</Grid>
				</AcpUINS:AcpExpander>
				<!--Unknown connection ID: 14-->
				<AcpUINS:AcpExpander
					Name="ExpanderRadioCfgFeatures"
					Width="Auto"
					Header="{Binding Path=RadioConfigurationFeatures.UIName}"
					IsAcpVisible="{Binding Path=RadioConfigurationFeatures.IsVisible, Mode=OneWay}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 15-->
						<AcpUINS:AcpXamDataPresenter
							Name="ExpanderRadioCfgFeaturesTable"
							KeyboardNavigation.AcceptsReturn="True"
							Grid.Row="1"
							igcontrols:DataSource="{Binding RadioConfigurationFeatures.EmbeddedRecset}">
							<igcontrols:DataPresenterBase.FieldLayouts>
								<igcontrols:FieldLayout>
									<igcontrols:FieldLayout.Fields>
										<igcontrols:UnboundField
											Name="{x:Static CommonResxNS:AppResources.Enabled_Features}"
											BindingPath="RadioConfigurationFeaturesInnerSection"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource RadioCfgFeaturesFeatureNameCellStyle}"
													CellMinWidth="200" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
									</igcontrols:FieldLayout.Fields>
								</igcontrols:FieldLayout>
							</igcontrols:DataPresenterBase.FieldLayouts>
						</AcpUINS:AcpXamDataPresenter>
					</Grid>
				</AcpUINS:AcpExpander>
			</StackPanel>
		</ScrollViewer>
		<Grid
			DockPanel.Dock="Bottom">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 16-->
			<Button
				Name="buttonClose"
				Content="{x:Static CommonResxNS:AppResources.Close_Id}"
				Grid.Column="0"
				Grid.Row="0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Width="75"
				Margin="45,10,5,10" />
			<!--Unknown connection ID: 17-->
			<Button
				Name="buttonHelp"
				Content="{x:Static CommonResxNS:AppResources.Help_Id}"
				Grid.Column="1"
				Grid.Row="0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Width="75"
				Margin="45,10,5,10" />
		</Grid>
	</DockPanel>
</AcpUINS:AcpPageFeature>
