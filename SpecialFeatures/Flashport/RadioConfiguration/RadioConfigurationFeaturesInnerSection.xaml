<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.Flashport.RadioConfiguration.PageRadioConfigurationFeaturesInnerSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:radioconfiguration="clr-namespace:SpecialFeatures.Flashport.RadioConfiguration"
	Title="{Binding Path=UIName}">
	<DockPanel>
		<ScrollViewer>
			<StackPanel
				Width="Auto"
				Height="Auto">
				<!--Unknown connection ID: 1-->
				<Grid
					Name="grid"
					RenderTransformOrigin="0.5,0.5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<!--Unknown connection ID: 2-->
					<AcpUINS:AcpTextBox
						Name="FkeyConfigFeatureName"
						VerticalAlignment="Center"
						Grid.Row="0"
						Grid.Column="2"
						Foreground="#FF000000"
						Text="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureNameValue}"
						MyExpander="{Binding ElementName=ExpanderRadioCfgFeaturesTable}"
						MyBLObject="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName}"
						MyLabelCtrl="{Binding ElementName=LblRadioCfgFeaturesFeatureName}"
						IsAcpValid="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName_Valid, Mode=OneWay}"
						IsAcpApplicable="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName_Applicable, Mode=OneWay}"
						IsAcpEditable="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName_Editable, Mode=OneWay}"
						IsAcpVisible="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName_Visible, Mode=OneWay}" />
					<!--Unknown connection ID: 3-->
					<AcpUINS:AcpLabel
						Name="LblRadioCfgFeaturesFeatureName"
						VerticalAlignment="Center"
						Grid.Row="0"
						Grid.Column="1"
						HelpText="{x:Static CommonResxNS:AppResources.Feature_Name}"
						Content="{Binding Path=RadioConfigurationFeaturesInnerSection.FkeyConfigFeatureName_UILabel}"
						MyParentCtrl="{Binding ElementName=FkeyConfigFeatureName}"
						IsAcpValid="{Binding ElementName=FkeyConfigFeatureName, Path=IsAcpValid}"
						IsAcpApplicable="{Binding ElementName=FkeyConfigFeatureName, Path=IsAcpApplicable}"
						IsAcpVisible="{Binding ElementName=FkeyConfigFeatureName, Path=IsAcpVisible}" />
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</AcpUINS:AcpPageFeature>
