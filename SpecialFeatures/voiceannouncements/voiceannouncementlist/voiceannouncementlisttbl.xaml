<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.VoiceAnnouncements.List.VoiceAnnouncementListPageTbl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:ACPUCLContactFeatureNS="clr-namespace:SpecialFeatures.VoiceAnnouncements.List" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.Voice_Announcement_List_Table_View}">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpVoiceAnnRecNavToolBar
			Name="RecNavToolbarPageVoiceAnnouncementTbl"
			Grid.Row="0"
			TableMode="True"
			MyRecordsetDataSource="{Binding Path=DataContext, RelativeSource={RelativeSource Self}}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpRtdButtonVisibilityConverter
				x:Key="acpRtdButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCopyButtonVisibilityConverter
				x:Key="acpCopyButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverterForEmptyTbl
				x:Key="acpXamDataPresenterVisibilityConverterForEmptyTbl" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<AcpUICommonNS:ParentControlVisibilityConverter
				x:Key="parentControlVisibilityConverter" />
			<AcpUICommonNS:ComparatorControlVisibilityConverter
				x:Key="comparatorControlVisibilityConverter" />
			<AcpUICommonNS:AcpRecNavToolbarTableModeConverter
				x:Key="acpRecNavToolbarTableModeConverter" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetVAListRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2300</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetComparatorRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetComparatorParentFeature">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2301</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="VoiceFileName_A21220CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpTextBoxFileBrowser
								Text="{Binding Path=Record.DataItem.General.VoiceFileName_A21220Value, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyBLObject="{Binding Path=Record.DataItem.General.VoiceFileName_A21220Object, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.VoiceFileName_A21220_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=Record.DataItem.General.VoiceFileName_A21220_Visible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.VoiceFileName_A21220_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.VoiceFileName_A21220Object"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
							</AcpUINS:AcpTextBoxFileBrowser>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 4-->
		<AcpUINS:AcpXamDataPresenter
			Name="VoiceAnnouncementListDataPresenter"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1"
			Header="{x:Static CommonResxNS:AppResources.Voice_Announcement_List}">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibilityConverterForEmptyTbl}"
					ConverterParameter="1"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Path="DataContext.HasDiffs"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Source="{StaticResource GetVAListRecset}"
						Path="IsEmpty" />
					<Binding
						Source="{StaticResource GetVAListRecset}"
						Path="TemplateNode.General.VoiceFileName_A21220_Visible" />
					<Binding
						ElementName="Voice_FileName_A21220_col"
						Path="Visibility" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<!--Unknown connection ID: 5-->
						<igcontrols:UnboundField
							x:Name="Voice_FileName_A21220_col"
							Label="{x:Static CommonResxNS:AppResources.Voice_Filename}"
							BindingPath="General.VoiceFileName_A21220Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetVAListRecset}, Path=General.VoiceFileName_A21220_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource VoiceFileName_A21220CellStyle}"
									CellWidth="300"
									CellMinWidth="300"
									LabelClickAction="SortByOneFieldOnly" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
