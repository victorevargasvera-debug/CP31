<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.CloneWiFi.PageCloneWiFiView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:AcpBLNS="clr-namespace:AcpBusinessLayer;assembly=AcpBusinessLayer" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:src="clr-namespace:ConstraintHelper" xmlns:SpecialFeatureNS="clr-namespace:SpecialFeatures.CloneWiFi;assembly=SpecialFeatures" xmlns:ResourceNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:DataWideRecsetNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.DataWide" xmlns:ConfiguredNetworksListInnerNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.DataWide" xmlns:NATListInnerNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.DataWide" xmlns:DataUserListInnerNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.DataWide" xmlns:QuickTextMessageListInnerNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.DataWide" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static ResourceNS:AppResources.WiFi_Password_Validation}"
	Focusable="True">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="DataWideWiFiNetworkSSID_42519CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableViewOnlyCtrl
								Content="{Binding Path=Value, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="DataWideWiFiNetworkEncryptedNetworkPassword_42517CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpPasswordEyeBox
								MaxPasswordLength="63"
								IsDigitOnly="False"
								PIN="{Binding Path=(Value).Content, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).IsValid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<RoutedCommand
				x:Key="F1Help" />
			<RoutedCommand
				x:Key="Cancel" />
			<RoutedCommand
				x:Key="OK" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.InputBindings>
		<KeyBinding
			Key="F1"
			Command="{Binding HelpCommand}" />
	</UIElement.InputBindings>
	<StackPanel>
		<!--Unknown connection ID: 2-->
		<Label
			Name="LblCloneWiFiDescription"
			Content="{x:Static ResourceNS:AppResources.WiFi_Password_Validation_Description}"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Height="40"
			Margin="30,10,5,10" />
		<!--Unknown connection ID: 3-->
		<AcpUINS:AcpXamDataPresenter
			Name="ExpanderWifiConfiguredNetworksList"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			KeyboardNavigation.AcceptsReturn="True"
			Header="{x:Static ResourceNS:AcgResources.ID_CONFIGUREDNETWORKSLIST}"
			igcontrols:DataSource="{Binding ItemSource}">
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<!--Unknown connection ID: 4-->
						<igcontrols:UnboundField
							x:Name="DataWideFeatureName_Col"
							Label="{x:Static ResourceNS:AcgResources.ID_FEATURENAME}"
							BindingPath="FeatureName"
							BindingMode="OneWay"
							Width="150">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource DataWideWiFiNetworkSSID_42519CellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
						<!--Unknown connection ID: 5-->
						<igcontrols:UnboundField
							x:Name="DataWideWiFiNetworkSSID_42519_Col"
							Label="{x:Static ResourceNS:AcgResources.ID_NETWORKSSID}"
							BindingPath="SSID"
							BindingMode="OneWay"
							Width="200">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource DataWideWiFiNetworkSSID_42519CellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
						<!--Unknown connection ID: 6-->
						<igcontrols:UnboundField
							x:Name="DataWideWiFiNetworkEncryptedNetworkPassword_42517_Col"
							Label="{x:Static ResourceNS:AcgResources.ID_ENCRYPTEDNETWORKPASSWORD}"
							BindingPath="PWD"
							BindingMode="OneWay"
							Width="200">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource DataWideWiFiNetworkEncryptedNetworkPassword_42517CellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
		<!--Unknown connection ID: 7-->
		<Label
			Name="LblCloneWiFiWarning"
			Content="{x:Static ResourceNS:AppResources.Clone_WiFi_Warning}"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Height="40"
			Margin="30,10,5,10"
			Visibility="Hidden" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 8-->
			<Button
				Name="buttonOK"
				Content="{x:Static ResourceNS:AppResources.OK_Id}"
				Grid.Column="0"
				Grid.Row="0"
				HorizontalAlignment="Right"
				Width="95"
				Margin="50,15,5,10"
				Command="{Binding OKCommand}" />
			<!--Unknown connection ID: 9-->
			<Button
				Name="buttonCancel"
				Content="{x:Static ResourceNS:AppResources.Cancel_Id}"
				Grid.Column="1"
				Grid.Row="0"
				HorizontalAlignment="Center"
				Width="95"
				Margin="50,15,5,10"
				Command="{Binding CancelCommand}" />
			<!--Unknown connection ID: 10-->
			<Button
				Name="buttonHelp"
				Content="{x:Static ResourceNS:AppResources.Help_Id}"
				Grid.Column="2"
				Grid.Row="0"
				HorizontalAlignment="Left"
				Width="95"
				Margin="50,15,5,10"
				Command="{Binding HelpCommand}" />
		</Grid>
	</StackPanel>
</AcpUINS:AcpPageFeature>
