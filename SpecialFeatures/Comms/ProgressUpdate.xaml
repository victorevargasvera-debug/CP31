<Window
	x:Class="SpecialFeatures.Comms.ProgressUpdate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:SpecialFeatures.Comms" xmlns:converters="clr-namespace:SpecialFeatures.Flashport.FlashRadio" xmlns:SPFProgrammungUI="clr-namespace:SpecialFeatures.Comms" xmlns:src="clr-namespace:SpecialFeatures.FileOperations" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title=""
	Width="550"
	Background="{DynamicResource BrushBackgroundBlue}"
	Height="380"
	WindowStyle="ToolWindow">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\FileOperations\BusyIndicator.xaml" />
				<ResourceDictionary
					Source="..\Styles\ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<LinearGradientBrush
				EndPoint="0.5,0.99"
				StartPoint="0.5,0.105"
				x:Key="BrushBackgroundSilver">
				<GradientStop
					Color="#FFA6A9AF"
					Offset="0.545" />
				<GradientStop
					Color="#FFC2C5CC"
					Offset="1" />
				<GradientStop
					Color="#FF8F939B"
					Offset="0" />
			</LinearGradientBrush>
			<LinearGradientBrush
				EndPoint="0.641,1.196"
				StartPoint="0.641,-0.095"
				x:Key="fgdsd">
				<GradientStop
					Color="#FFBDC2C9"
					Offset="0" />
				<GradientStop
					Color="#FFDEE0E4"
					Offset="0.0859826" />
				<GradientStop
					Color="#FFFFFFFF"
					Offset="0.0863636" />
				<GradientStop
					Color="#FFD9E1EE"
					Offset="0.462964" />
				<GradientStop
					Color="#FFB3C3DE"
					Offset="0.463636" />
				<GradientStop
					Color="#FFFFFFFF"
					Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush
				EndPoint="0.641,1.196"
				StartPoint="0.641,-0.095"
				x:Key="Brush1 is mouse over">
				<GradientStop
					Color="#FFBDC2C9"
					Offset="0" />
				<GradientStop
					Color="#FFDEE0E4"
					Offset="0.0859826" />
				<GradientStop
					Color="#FFB5B5B5"
					Offset="0.0863636" />
				<GradientStop
					Color="#FFB7C1D3"
					Offset="0.396" />
				<GradientStop
					Color="#FF8390A8"
					Offset="0.859" />
				<GradientStop
					Color="#FFFFFFFF"
					Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0.640625,-0.0270241"
				EndPoint="0.640625,1.08108"
				x:Key="click gdent">
				<GradientStop
					Color="#FF57411E"
					Offset="0" />
				<GradientStop
					Color="#FF886D42"
					Offset="0.0859826" />
				<GradientStop
					Color="#FFB99A67"
					Offset="0.0863636" />
				<GradientStop
					Color="#FFAC8142"
					Offset="0.462964" />
				<GradientStop
					Color="#FFA0681E"
					Offset="0.463636" />
				<GradientStop
					Color="#FFF7931E"
					Offset="0.868182" />
				<GradientStop
					Color="#FF474747"
					Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0.527778,-0.0153843"
				EndPoint="0.527778,1"
				x:Key="Grey">
				<GradientStop
					Color="#FF1C2027"
					Offset="0" />
				<GradientStop
					Color="#FF5C626B"
					Offset="0.0859826" />
				<GradientStop
					Color="#FF9CA4B0"
					Offset="0.0863636" />
				<GradientStop
					Color="#FF5D636C"
					Offset="0.462964" />
				<GradientStop
					Color="#FF1E2228"
					Offset="0.463636" />
				<GradientStop
					Color="#FF4C4C4C"
					Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush
				EndPoint="0.527778,1"
				StartPoint="0.527778,-0.0153843"
				x:Key="Enabled">
				<GradientStop
					Color="#FFBBBBBB"
					Offset="0" />
				<GradientStop
					Color="#FFB9B9B9"
					Offset="0.0859826" />
				<GradientStop
					Color="#95A8A8A8"
					Offset="0.091" />
				<GradientStop
					Color="#FF8C8C8C"
					Offset="0.462964" />
				<GradientStop
					Color="#FF808080"
					Offset="0.469" />
				<GradientStop
					Color="#FF4C4C4C"
					Offset="1" />
			</LinearGradientBrush>
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{x:Null}"
				x:Key="Button&quot;OK&quot;">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Grid
								Width="84.583"
								Height="21.167">
								<Rectangle
									Name="rectangle"
									OpacityMask="#FF000000"
									HorizontalAlignment="Right"
									Margin="0,-0.001,0,0"
									Width="84.583"
									StrokeThickness="1"
									RadiusX="2.252"
									RadiusY="2.252"
									Fill="{DynamicResource Grey}"
									Stroke="{x:Null}">
									<UIElement.BitmapEffect>
										<DropShadowBitmapEffect
											Opacity="0.515" />
									</UIElement.BitmapEffect>
								</Rectangle>
								<Rectangle
									Name="rectangle1"
									OpacityMask="#FF000000"
									RenderTransformOrigin="0.5,0.5"
									Margin="0,2.332,2.923,1.5"
									Stroke="#FF555555"
									StrokeThickness="1"
									RadiusX="2.252"
									RadiusY="2.252"
									HorizontalAlignment="Right"
									Width="78.916"
									Fill="{x:Null}">
									<UIElement.RenderTransform>
										<TransformGroup>
											<ScaleTransform
												ScaleX="-1"
												ScaleY="1" />
											<SkewTransform
												AngleX="0"
												AngleY="0" />
											<RotateTransform
												Angle="0" />
											<TranslateTransform
												X="0"
												Y="0" />
										</TransformGroup>
									</UIElement.RenderTransform>
								</Rectangle>
								<Label
									HorizontalAlignment="Center"
									FontFamily="Tahoma"
									FontSize="12"
									HorizontalContentAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									Foreground="#FFFFFFFF"
									Margin="0,-1.835,0,0"
									Content="{x:Static CommonResxNS:AppResources.Close_Id}" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsFocused"
									Value="True" />
								<Trigger
									Property="Button.IsDefaulted"
									Value="True" />
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="rectangle"
										Value="{DynamicResource Brush1 is mouse over}"
										Property="Fill" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="rectangle"
										Value="{DynamicResource click gdent}"
										Property="Fill" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="rectangle"
										Value="{DynamicResource Enabled}"
										Property="Fill" />
									<Setter
										TargetName="rectangle1"
										Property="Stroke"
										Value="#FF929292" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<StackPanel
		Orientation="Vertical"
		Height="Auto"
		Background="{DynamicResource BrushBackgroundBlue}">
		<!--Unknown connection ID: 2-->
		<Grid
			Name="Header"
			Margin="0,0,30,0"
			Width="Auto"
			Height="64">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="5*" />
				<ColumnDefinition
					Width="50*" />
				<ColumnDefinition
					Width="30*" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<Rectangle
				Name="Divider_Copy"
				Margin="0,10.668,-30,-14.757"
				Grid.ColumnSpan="3">
				<Shape.Fill>
					<LinearGradientBrush
						StartPoint="0.0338026,-0.0020342"
						EndPoint="0.0338026,0.998692">
						<GradientStop
							Color="#FF1C2027"
							Offset="0.494" />
						<GradientStop
							Color="#38000000"
							Offset="0.514" />
						<GradientStop
							Color="#00575757"
							Offset="0.992" />
						<GradientStop
							Color="#33F5F5F5"
							Offset="0.449" />
						<GradientStop
							Color="#00BBBBBB"
							Offset="0" />
					</LinearGradientBrush>
				</Shape.Fill>
			</Rectangle>
			<!--Unknown connection ID: 4-->
			<Label
				Name="ViewboxTitle"
				Grid.Column="1"
				Grid.ColumnSpan="3"
				Width="Auto"
				Foreground="#FFFFFFFF"
				FontSize="20"
				FontStyle="Normal"
				FontFamily="Tahoma"
				FontWeight="Normal"
				VerticalAlignment="Top"
				Content="{x:Static CommonResxNS:AppResources.Read_Write_Radio_Progress}"
				Height="45"
				VerticalContentAlignment="Center" />
		</Grid>
		<!--Unknown connection ID: 5-->
		<GroupBox
			Name="GrpbxProgress"
			Margin="9,5,9,5"
			Header="{x:Static CommonResxNS:AppResources.Radio_IO_Progress}"
			Foreground="#FF323232"
			Height="Auto"
			Width="Auto">
			<StackPanel
				Orientation="Vertical"
				Margin="0,9,0,0">
				<!--Unknown connection ID: 6-->
				<StackPanel
					Name="stackMoreInfo"
					Orientation="Vertical">
					<!--Unknown connection ID: 7-->
					<Label
						Name="ConnectingToRadioLabel"
						HorizontalContentAlignment="Stretch">
						<Grid
							HorizontalAlignment="Stretch"
							Height="122">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="auto"
									MinWidth="35" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<!--Unknown connection ID: 8-->
							<src:BusyIndicator
								Name="ConnectingToRadioIndicator"
								Width="15"
								Height="15"
								Grid.Row="0"
								Grid.Column="0"
								BusyState="NOT_BUSY"
								Style="{DynamicResource SingleSpin}"
								Margin="5,5,15,5"
								AutomationProperties.ItemStatus="{Binding Path=BusyState, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
							<!--Unknown connection ID: 9-->
							<TextBlock
								Name="ConnectText"
								Grid.Row="0"
								Grid.Column="1"
								VerticalAlignment="Center">
								<Run
									Text="{x:Static CommonResxNS:AppResources.Connecting_To_Radio}" />
							</TextBlock>
							<!--Unknown connection ID: 10-->
							<src:BusyIndicator
								Name="ReadingRadioInformationIndicator"
								Width="15"
								Height="15"
								Grid.Row="1"
								Grid.Column="0"
								BusyState="NOT_BUSY"
								Style="{DynamicResource SingleSpin}"
								Margin="5,5,15,5"
								AutomationProperties.ItemStatus="{Binding Path=BusyState, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
							<!--Unknown connection ID: 11-->
							<TextBlock
								Name="RadioInfoText"
								Grid.Row="1"
								Grid.Column="1"
								VerticalAlignment="Center">
								<Run
									Text="{x:Static CommonResxNS:AppResources.Reading_Radio_Information}" />
							</TextBlock>
							<!--Unknown connection ID: 12-->
							<src:BusyIndicator
								Name="CodeplugIndicator"
								Width="15"
								Height="15"
								Grid.Row="2"
								Grid.Column="0"
								BusyState="NOT_BUSY"
								Style="{DynamicResource SingleSpin}"
								Margin="5,5,15,5"
								AutomationProperties.ItemStatus="{Binding Path=BusyState, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
							<!--Unknown connection ID: 13-->
							<TextBlock
								Name="CodeplugText"
								Grid.Row="2"
								Grid.Column="1"
								VerticalAlignment="Center">
								<Run
									Text="{x:Static CommonResxNS:AppResources.Codeplug_Id}" />
							</TextBlock>
							<!--Unknown connection ID: 14-->
							<src:BusyIndicator
								Name="VerificationIndicator"
								Style="{DynamicResource SingleSpin}"
								Width="15"
								Height="15"
								Grid.Column="0"
								BusyState="NOT_BUSY"
								Margin="5,5,15,5"
								Grid.Row="3"
								AutomationProperties.ItemStatus="{Binding Path=BusyState, Mode=OneWay, RelativeSource={RelativeSource Self}}" />
							<!--Unknown connection ID: 15-->
							<TextBlock
								Name="VerificationText"
								Grid.Row="3"
								Grid.Column="1"
								VerticalAlignment="Center">
								<Run
									Text="{x:Static CommonResxNS:AppResources.Verification_ID}" />
							</TextBlock>
						</Grid>
					</Label>
				</StackPanel>
				<!--Unknown connection ID: 16-->
				<TextBox
					Name="ProgText"
					VerticalScrollBarVisibility="Auto"
					HorizontalContentAlignment="Center"
					IsReadOnly="true"
					Foreground="#FFFFFFFF"
					FontSize="12"
					FontStyle="Italic"
					FontFamily="Verdana"
					FontWeight="Bold"
					Text="{x:Static CommonResxNS:AppResources.Read_Write_Radio_Status}"
					Background="#00FFFFFF"
					BorderThickness="0"
					TextWrapping="Wrap"
					ClipToBounds="False"
					VerticalContentAlignment="Center"
					Height="50"
					Margin="0,0,0,0" />
				<!--Unknown connection ID: 17-->
				<ProgressBar
					Name="progressBar2"
					Background="#FFEAA10D"
					Value="80"
					Orientation="Horizontal"
					Height="9.277"
					Padding="0"
					Margin="0,8,0,5"
					Width="493.75">
					<UIElement.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="9"
							Opacity="0.245"
							Direction="280" />
					</UIElement.BitmapEffect>
				</ProgressBar>
			</StackPanel>
		</GroupBox>
		<!--Unknown connection ID: 18-->
		<Button
			Name="CloseBtn"
			Content="{x:Static CommonResxNS:AppResources.Close_Id}"
			DockPanel.Dock="Right"
			HorizontalAlignment="Center"
			Width="90"
			Height="30"
			Margin="10,3,10,10"
			VerticalAlignment="Bottom" />
	</StackPanel>
</Window>
