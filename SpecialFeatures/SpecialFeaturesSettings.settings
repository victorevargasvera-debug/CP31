<?xml version='1.0' encoding='utf-8'?>
<SettingsFile CurrentProfile="(Default)" GeneratedClassNamespace="SpecialFeatures" GeneratedClassName="SpecialFeaturesSettings" xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings">
  <Profiles />
  <Settings>
    <Setting Name="VA_WAV_FILE_LOCATION" Type="System.String" Scope="User">
      <Value Profile="(Default)">Please select wav file location.</Value>
    </Setting>
    <Setting Name="VA_MVA_FILE_LOCATION" Type="System.String" Scope="User">
      <Value Profile="(Default)">Please select voice file storage location.</Value>
    </Setting>
    <Setting Name="VA_DOWNLOAD_FILE_LOCATION" Type="System.String" Scope="User">
      <Value Profile="(Default)">Please select voice file download location.</Value>
    </Setting>
    <Setting Name="OTAP_CPS_SESSION_INACTIVITY_TIMER" Type="System.String" Scope="User">
      <Value Profile="(Default)">3</Value>
    </Setting>
    <Setting Name="OTAP_BATCH_RADIO_LIST_LOCATION" Type="System.String" Scope="User">
      <Value Profile="(Default)">Please select the location for Radio List.</Value>
    </Setting>
    <Setting Name="OTAP_BATCH_NUM_RETRIES_FOR_FAILED_RADIOS" Type="System.String" Scope="User">
      <Value Profile="(Default)">2</Value>
    </Setting>
    <Setting Name="OTAP_BATCH_WRITE_PROTECT_RADIOS" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="OTAP_BATCH_ENABLE_ARS_SERVER_IP_ADDRESS" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="OTAP_ARS_IP_ADDRESS" Type="System.String" Scope="User">
      <Value Profile="(Default)">0.0.0.0</Value>
    </Setting>
    <Setting Name="OTAP_ARS_IP_CHKBOX" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
  </Settings>
</SettingsFile>