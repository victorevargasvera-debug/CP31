<Window
	x:Class="SpecialFeatures.FileOperations.BrowseForFileDialogBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title=""
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="Manual"
	WindowStyle="None"
	SizeToContent="WidthAndHeight"
	BorderBrush="#FF5D636C"
	BorderThickness="1"
	Left="300"
	Top="200" xmlns:fileoperations="clr-namespace:SpecialFeatures.FileOperations">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<LinearGradientBrush
				StartPoint="0.0338026,-0.0020342"
				EndPoint="0.0338026,0.998692"
				x:Key="MyBrush1234">
				<GradientStop
					Color="#FFE3F5FD"
					Offset="0.07" />
				<GradientStop
					Color="#FFC1D9F3"
					Offset="0.096" />
				<GradientStop
					Color="#FF85AAC4"
					Offset="0.448" />
				<GradientStop
					Color="#FF648DAE"
					Offset="0.468" />
				<GradientStop
					Color="#FF07090B"
					Offset="0.984" />
				<GradientStop
					Color="#FFB2D4F0"
					Offset="0.004" />
				<GradientStop
					Color="#FF4288BA"
					Offset="0.828" />
			</LinearGradientBrush>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Control.Background>
		<LinearGradientBrush
			EndPoint="0.5,0.99"
			StartPoint="0.5,0.105">
			<GradientStop
				Color="#FFA6A9AF"
				Offset="0.545" />
			<GradientStop
				Color="#FFC2C5CC"
				Offset="1" />
			<GradientStop
				Color="#FF8F939B"
				Offset="0" />
		</LinearGradientBrush>
	</Control.Background>
	<StackPanel>
		<!--Unknown connection ID: 2-->
		<Label
			Name="operationLabel"
			FontSize="16"
			HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Center"
			BorderThickness="0,0,0,0"
			Background="{DynamicResource MyBrush1234}"
			Foreground="#FFD0D0D0"
			Content=""
			BorderBrush="{x:Null}">
			<UIElement.OpacityMask>
				<RadialGradientBrush>
					<Brush.RelativeTransform>
						<TransformGroup>
							<ScaleTransform
								CenterX="0.5"
								CenterY="0.5"
								ScaleX="1.557"
								ScaleY="1.557" />
							<SkewTransform
								AngleX="0"
								AngleY="0"
								CenterX="0.5"
								CenterY="0.5" />
							<RotateTransform
								Angle="0"
								CenterX="0.5"
								CenterY="0.5" />
							<TranslateTransform
								X="0"
								Y="0" />
						</TransformGroup>
					</Brush.RelativeTransform>
					<GradientStop
						Color="#FF000000"
						Offset="0.529" />
					<GradientStop
						Color="#FF000000"
						Offset="0.959" />
				</RadialGradientBrush>
			</UIElement.OpacityMask>
		</Label>
		<!--Unknown connection ID: 3-->
		<Frame
			Name="BrowseForFileMainFrame"
			Source="BrowseForFileLauncher.xaml"
			NavigationUIVisibility="Hidden"
			MinWidth="350" />
	</StackPanel>
</Window>
