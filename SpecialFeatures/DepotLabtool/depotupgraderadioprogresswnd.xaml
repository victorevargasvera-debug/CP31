<Window
	x:Class="SpecialFeatures.DepotLabtool.DepotPageUpgradeRadioProgressWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	WindowStartupLocation="CenterScreen"
	Title="{x:Static CommonResxNS:AppResources.Upgrade_Radio}"
	Height="191"
	Width="570"
	ResizeMode="NoResize"
	WindowStyle="None"
	ShowInTaskbar="False" xmlns:depotlabtool="clr-namespace:SpecialFeatures.DepotLabtool">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<LinearGradientBrush
				EndPoint="0.5,0.99"
				StartPoint="0.5,0.105"
				x:Key="BrushBackgroundSilver">
				<GradientStop
					Color="#FFA6A9AF"
					Offset="0.545" />
				<GradientStop
					Color="#FFC2C5CC"
					Offset="1" />
				<GradientStop
					Color="#FF8F939B"
					Offset="0" />
			</LinearGradientBrush>
			<LinearGradientBrush
				StartPoint="0.0338026,-0.0020342"
				EndPoint="0.0338026,0.998692"
				x:Key="MyBrush1234">
				<GradientStop
					Color="#FF1C2027"
					Offset="0" />
				<GradientStop
					Color="#FF5C626B"
					Offset="0.0859826" />
				<GradientStop
					Color="#FF9CA4B0"
					Offset="0.0863636" />
				<GradientStop
					Color="#FF5D636C"
					Offset="0.462964" />
				<GradientStop
					Color="#FF1E2228"
					Offset="0.463636" />
				<GradientStop
					Color="#FF4C4C4C"
					Offset="1" />
			</LinearGradientBrush>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Control.Background>
		<LinearGradientBrush
			EndPoint="0.5,0.99"
			StartPoint="0.5,0.105">
			<GradientStop
				Color="#FFA6A9AF"
				Offset="0.545" />
			<GradientStop
				Color="#FFC2C5CC"
				Offset="1" />
			<GradientStop
				Color="#FF8F939B"
				Offset="0" />
		</LinearGradientBrush>
	</Control.Background>
	<StackPanel
		Orientation="Vertical"
		Height="137"
		Background="{DynamicResource BrushBackgroundSilver}"
		Width="524">
		<!--Unknown connection ID: 2-->
		<GroupBox
			Name="GrpbxProgress"
			Margin="9,5,9,5"
			Header="{x:Static CommonResxNS:AppResources.Upgrade_Radio_Progress}"
			Foreground="#FF323232"
			Height="Auto"
			Width="Auto">
			<StackPanel
				Orientation="Vertical"
				Margin="0,9,0,0">
				<!--Unknown connection ID: 3-->
				<StackPanel
					Name="stackMoreInfo"
					Orientation="Vertical">
					<!--Unknown connection ID: 4-->
					<Label
						Name="ConnectingToRadioLabel"
						HorizontalContentAlignment="Stretch" />
				</StackPanel>
				<!--Unknown connection ID: 5-->
				<ProgressBar
					Name="progressBar2"
					Style="{DynamicResource ProgressBarStyle19867}"
					Background="#FFEAA10D"
					Value="80"
					Orientation="Horizontal"
					Height="9.277"
					Padding="0"
					Margin="0,8,0,5"
					Width="493.75">
					<UIElement.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="9"
							Opacity="0.245"
							Direction="280" />
					</UIElement.BitmapEffect>
				</ProgressBar>
				<!--Unknown connection ID: 6-->
				<TextBox
					Name="ProgText"
					VerticalScrollBarVisibility="Auto"
					HorizontalContentAlignment="Center"
					IsReadOnly="true"
					Foreground="#FFFFFFFF"
					FontSize="12"
					FontStyle="Italic"
					FontFamily="Verdana"
					FontWeight="Bold"
					Text=""
					Background="#00FFFFFF"
					BorderThickness="0"
					TextWrapping="Wrap"
					ClipToBounds="False"
					VerticalContentAlignment="Center"
					Height="29"
					Margin="0,0,0,0" />
			</StackPanel>
		</GroupBox>
		<!--Unknown connection ID: 7-->
		<Button
			Name="CloseBtn"
			Style="{StaticResource AnotherB}"
			DockPanel.Dock="Right"
			HorizontalAlignment="Center"
			Width="90"
			Height="30"
			Margin="10,3,10,10"
			VerticalAlignment="Bottom"
			Background="{DynamicResource SilverButton}"
			Foreground="#FFFF7F50"
			FontFamily="Tahoma"
			FontSize="14"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch"
			Content="{x:Static CommonResxNS:AppResources.Close_Id}"
			IsEnabled="True" />
	</StackPanel>
</Window>
