<Window
	x:Class="SpecialFeatures.ReadWritePassword.PromptReadWritePassword" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpecialFeatures.ReadWritePassword" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Background="{DynamicResource BrushBackgroundBlue}"
	WindowStyle="ToolWindow"
	Title="{x:Static CommonResxNS:AppResources.Enter_Read_Write_Password}"
	Width="453"
	Height="296">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\FileOperations\BusyIndicator.xaml" />
				<ResourceDictionary
					Source="..\Styles\ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 1-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<Grid
		Background="{DynamicResource BrushBackgroundBlue}">
		<!--Unknown connection ID: 2-->
		<PasswordBox
			Name="CodeplugPasswordBox"
			Height="23"
			Margin="200,96,32,0"
			VerticalAlignment="Top"
			PasswordChar="*"
			TabIndex="1" />
		<!--Unknown connection ID: 3-->
		<Label
			Name="CodeplugPasswordText"
			Height="Auto"
			Margin="8,15,0,0"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Width="Auto"
			Target="{Binding}" />
		<!--Unknown connection ID: 4-->
		<Label
			Name="SerialNumberText"
			Height="Auto"
			Margin="8,49,0,0"
			Content="{x:Static CommonResxNS:AppResources.Serial_Number}"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Width="Auto" />
		<!--Unknown connection ID: 5-->
		<Label
			Name="SerialNumberValue"
			Height="Auto"
			Margin="192,49,0,0"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Width="Auto" />
		<!--Unknown connection ID: 6-->
		<Button
			Name="OKButton"
			Height="23"
			Margin="21,0,0,46"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Left"
			Width="74"
			Content="{x:Static CommonResxNS:AppResources.OK_Id}"
			TabIndex="3" />
		<!--Unknown connection ID: 7-->
		<Button
			Name="CancelButton"
			Height="23"
			HorizontalAlignment="Right"
			Margin="0,0,212,46"
			VerticalAlignment="Bottom"
			Width="75"
			Content="{x:Static CommonResxNS:AppResources.Cancel_Id}"
			TabIndex="4" />
		<!--Unknown connection ID: 8-->
		<Label
			Name="label1"
			Content="{x:Static CommonResxNS:AppResources.Codeplug_Password_Without_Colon}"
			Height="Auto"
			HorizontalAlignment="Left"
			Margin="11,96,0,0"
			VerticalAlignment="Top"
			Width="Auto" />
		<!--Unknown connection ID: 9-->
		<CheckBox
			Name="RememberPasswordSession"
			Content="{x:Static CommonResxNS:AppResources.Remember_My_Password_For_This_CPS_Session}"
			Height="21"
			HorizontalAlignment="Left"
			Margin="8,144,0,0"
			VerticalAlignment="Top"
			TabIndex="2" />
		<!--Unknown connection ID: 10-->
		<Button
			Name="promptPasswdHelpButton"
			Content="{x:Static CommonResxNS:AppResources.Help_Id}"
			Height="23"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Width="75"
			Margin="0,0,89,46"
			TabIndex="5" />
	</Grid>
</Window>
