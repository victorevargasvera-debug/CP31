<Window
	x:Class="SpecialFeatures.ReadWritePassword.InitReadWritePassword" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpecialFeatures.ReadWritePassword" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{DynamicResource BrushBackgroundBlue}"
	WindowStyle="ToolWindow"
	Title="{x:Static CommonResxNS:AppResources.Initialize_Read_Write_Password}"
	Height="296"
	Width="453">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\FileOperations\BusyIndicator.xaml" />
				<ResourceDictionary
					Source="..\Styles\ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 1-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<Grid
		Background="{DynamicResource BrushBackgroundBlue}">
		<!--Unknown connection ID: 2-->
		<PasswordBox
			Name="ConfirmpasswordBox"
			Margin="190,98,26,0"
			Height="23"
			Width="265"
			MaxLength="16"
			PasswordChar="*"
			VerticalAlignment="Top"
			TabIndex="2" />
		<!--Unknown connection ID: 3-->
		<PasswordBox
			Name="EnterPasswordBox"
			Margin="190,54,26,0"
			Height="23"
			Width="265"
			MaxLength="16"
			PasswordChar="*"
			VerticalAlignment="Top"
			TabIndex="1" />
		<!--Unknown connection ID: 4-->
		<Button
			Name="Okbutton"
			Height="23"
			Margin="14,0,0,37"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Left"
			Width="83"
			TabIndex="4"
			Content="{x:Static CommonResxNS:AppResources.OK_Id}" />
		<!--Unknown connection ID: 5-->
		<Button
			Name="CancelButton"
			Height="23"
			HorizontalAlignment="Left"
			Margin="164,0,0,37"
			VerticalAlignment="Bottom"
			Width="83"
			TabIndex="5"
			Content="{x:Static CommonResxNS:AppResources.Cancel_Id}" />
		<!--Unknown connection ID: 6-->
		<Label
			Name="ConfirmPasswordText"
			Height="Auto"
			Margin="14,98,0,0"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Width="Auto"
			Content="{x:Static CommonResxNS:AppResources.Confirm_Password}" />
		<!--Unknown connection ID: 7-->
		<Label
			Name="EnterPasswordText"
			Height="Auto"
			HorizontalAlignment="Left"
			Margin="14,54,0,0"
			VerticalAlignment="Top"
			Width="Auto"
			Content="{x:Static CommonResxNS:AppResources.Password_Colon}" />
		<!--Unknown connection ID: 8-->
		<Label
			Name="label1"
			Content="{x:Static CommonResxNS:AppResources.Please_Initialize_The_Password}"
			Height="Auto"
			HorizontalAlignment="Left"
			Margin="12,12,0,0"
			VerticalAlignment="Top"
			Width="Auto" />
		<!--Unknown connection ID: 9-->
		<CheckBox
			Name="RememberPasswordSession"
			Content="{x:Static CommonResxNS:AppResources.Remember_My_Password_For_This_CPS_Session}"
			Height="23"
			HorizontalAlignment="Left"
			Margin="14,153,0,0"
			VerticalAlignment="Top"
			TabIndex="3" />
		<!--Unknown connection ID: 10-->
		<Button
			Name="initialPasswdHelpButton"
			Content="{x:Static CommonResxNS:AppResources.Help_Id}"
			Height="23"
			HorizontalAlignment="Right"
			Margin="0,0,26,37"
			VerticalAlignment="Bottom"
			Width="83"
			TabIndex="6" />
	</Grid>
</Window>
