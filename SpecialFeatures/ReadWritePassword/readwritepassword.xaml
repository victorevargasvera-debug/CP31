<Window
	x:Class="SpecialFeatures.ReadWritePassword.ReadWriteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Name="ReadWritePassword"
	Background="{DynamicResource BrushBackgroundBlue}"
	WindowStyle="ToolWindow"
	ResizeMode="NoResize"
	Title="{x:Static CommonResxNS:AppResources.Read_Write_Password}"
	Height="266"
	Width="574" xmlns:readwritepassword="clr-namespace:SpecialFeatures.ReadWritePassword">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\Styles\ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 2-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<Grid
		Background="{DynamicResource BrushBackgroundBlue}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="370*" />
			<ColumnDefinition
				Width="182*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0.796*" />
			<RowDefinition
				Height="0.204*" />
		</Grid.RowDefinitions>
		<GroupBox
			Height="126.759"
			HorizontalAlignment="Stretch"
			Margin="10,10,10,0"
			VerticalAlignment="Top"
			Header="{x:Static CommonResxNS:AppResources.Prompt_For_Password_When_Attempting_To}">
			<StackPanel
				HorizontalAlignment="Stretch"
				Height="Auto">
				<!--Unknown connection ID: 3-->
				<CheckBox
					Name="checkRead"
					Height="23"
					Margin="16,10,10,0"
					VerticalAlignment="Top"
					IsThreeState="False"
					Content="{x:Static CommonResxNS:AppResources.Blank_Read_Radio}" />
				<!--Unknown connection ID: 4-->
				<CheckBox
					Name="checkWrite"
					Height="23"
					Margin="16,10,10,0"
					IsThreeState="False"
					Content="{x:Static CommonResxNS:AppResources.Blank_Write_Radio}" />
				<!--Unknown connection ID: 5-->
				<CheckBox
					Name="checkSave"
					Height="23"
					Margin="16,10,10,0"
					IsThreeState="False"
					Content="{x:Static CommonResxNS:AppResources.Blank_Read_File}" />
			</StackPanel>
		</GroupBox>
		<!--Unknown connection ID: 6-->
		<TextBlock
			Name="PasswordNote"
			Height="46.301"
			Margin="12,0,8,45"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Bottom"
			Grid.ColumnSpan="2"
			AllowDrop="False"
			Text="{x:Static CommonResxNS:AppResources.Note_Changes_Take_Effect_Only_Codeplug_Saved_Written}"
			TextWrapping="Wrap"
			Padding="0,3,0,0"
			Grid.RowSpan="2" />
		<!--Unknown connection ID: 7-->
		<Button
			Width="85"
			Grid.Row="1"
			Margin="217,0,0,11"
			HorizontalAlignment="Left"
			Content="{x:Static CommonResxNS:AppResources.OK_Id}"
			VerticalAlignment="Bottom"
			Height="25.072" />
		<!--Unknown connection ID: 8-->
		<Button
			Name="CancelButton"
			Width="85"
			Grid.Row="1"
			Margin="0,0,127,11"
			HorizontalAlignment="Right"
			IsCancel="True"
			Content="{x:Static CommonResxNS:AppResources.Cancel_Id}"
			VerticalAlignment="Bottom"
			Height="25.072"
			Grid.ColumnSpan="2" />
		<!--Unknown connection ID: 9-->
		<Button
			Name="passwdWindowHelpbutton"
			Grid.Row="1"
			Margin="0,0,11,11.476"
			Content="{x:Static CommonResxNS:AppResources.Help_Id}"
			VerticalAlignment="Bottom"
			Grid.Column="1"
			HorizontalAlignment="Right"
			Width="78.673"
			Height="25.072" />
		<!--Unknown connection ID: 10-->
		<Button
			Name="ModifyButton"
			Grid.Column="1"
			Height="23.934"
			Width="173"
			Content="{x:Static CommonResxNS:AppResources.Initialize_Permissions}"
			Margin="0,20,11,0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top" />
		<!--Unknown connection ID: 11-->
		<Button
			Name="ChangePasswordButton"
			Grid.Column="1"
			Height="23.934"
			Width="173"
			Content="{x:Static CommonResxNS:AppResources.Change_Password}"
			Margin="0,60,11,0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top" />
	</Grid>
</Window>
