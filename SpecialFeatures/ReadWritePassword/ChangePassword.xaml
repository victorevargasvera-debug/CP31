<Window
	x:Class="SpecialFeatures.ReadWritePassword.ChangePassword" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpecialFeatures.ReadWritePassword" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Name="changePassword"
	Background="{DynamicResource BrushBackgroundBlue}"
	WindowStyle="ToolWindow"
	Title="{x:Static CommonResxNS:AppResources.Change_Read_Write_Password}"
	Height="296"
	Width="453">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="..\FileOperations\BusyIndicator.xaml" />
				<ResourceDictionary
					Source="..\Styles\ResourceSpecialFeatures.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 2-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<!--Unknown connection ID: 3-->
	<Grid
		Name="windowGrid"
		Background="{DynamicResource BrushBackgroundBlue}">
		<StackPanel
			Width="Auto"
			Height="Auto">
			<Grid
				Height="210 "
				Width="400">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="172*" />
					<ColumnDefinition
						Width="269*" />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 4-->
				<Label
					Name="CurrentPasswordText"
					Height="Auto"
					VerticalAlignment="Top"
					Grid.RowSpan="2"
					Margin="0,30,0,0"
					Content="{x:Static CommonResxNS:AppResources.Current_Password}" />
				<!--Unknown connection ID: 5-->
				<Label
					Name="NewPasswordText"
					Grid.Row="1"
					Height="Auto"
					VerticalAlignment="Top"
					Margin="-1,29,2,0"
					Grid.RowSpan="2"
					Content="{x:Static CommonResxNS:AppResources.New_Password_Colon}" />
				<!--Unknown connection ID: 6-->
				<Label
					Name="ConfirmPasswordText"
					Grid.Row="2"
					Height="Auto"
					Margin="0,30,1,-1"
					Content="{x:Static CommonResxNS:AppResources.Confirm_Password}" />
				<!--Unknown connection ID: 7-->
				<PasswordBox
					Name="CurrentPasswordBox"
					Grid.Column="1"
					Height="23"
					VerticalAlignment="Top"
					Margin="0,30,0,0"
					PasswordChar="*" />
				<!--Unknown connection ID: 8-->
				<PasswordBox
					Name="NewPasswordBox"
					Grid.Row="1"
					Grid.Column="1"
					Height="23"
					VerticalAlignment="Top"
					Margin="0,28,0,0"
					PasswordChar="*" />
				<!--Unknown connection ID: 9-->
				<PasswordBox
					Name="ConfirmPasswordBox"
					Grid.Row="2"
					Grid.Column="1"
					Height="23"
					VerticalAlignment="Top"
					Margin="-1,30,0,0"
					PasswordChar="*" />
			</Grid>
			<Grid
				Height="40"
				Width="400">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 10-->
				<Button
					Name="OK"
					Grid.Column="0"
					Height="23"
					Width="75"
					Content="{x:Static CommonResxNS:AppResources.OK_Id}" />
				<!--Unknown connection ID: 11-->
				<Button
					Name="Cancel"
					Grid.Column="1"
					Height="23"
					Width="75"
					IsCancel="True"
					Content="{x:Static CommonResxNS:AppResources.Cancel_Id}" />
				<!--Unknown connection ID: 12-->
				<Button
					Name="changePasswdHelpbutton"
					Grid.Column="2"
					Content="{x:Static CommonResxNS:AppResources.Help_Id}"
					Height="23"
					Width="75" />
			</Grid>
		</StackPanel>
	</Grid>
</Window>
