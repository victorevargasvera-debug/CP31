<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.DVRSFiles.List.DVRSFileListPageTbl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpBLNS="clr-namespace:AcpBusinessLayer;assembly=AcpBusinessLayer" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:igwindows="http://infragistics.com/Windows" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:DVRSFileListNS="clr-namespace:SpecialFeatures.DVRSFiles.List" xmlns:srcFeat="clr-namespace:ConstraintHelper;assembly=AllFeatures" xmlns:ResourceNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
	Title="{x:Static ResourceNS:AppResources.DVRS_File_List_Table_View_ID}">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpVoiceAnnRecNavToolBar
			Name="RecNavToolbarPageDVRSFileTbl"
			TableMode="True"
			MyRecordsetDataSource="{Binding ElementName=DVRSFileListDataPresenter, Path=DataSource}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibilityConverter" />
			<AcpUICommonNS:EditabilityInComparatorCustomModesConverter
				x:Key="editabilityInComparatorCustomModesConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverterForEmptyTbl
				x:Key="acpXamDataPresenterVisibilityConverterForEmptyTbl" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetDVRSFileListRecSet">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>4234</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetComparatorRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetComparatorParentFeature">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>4234</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetEmbeddedNodeExpanderDVRSFileListTableView">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>4234</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10893</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<AcpUICommonNS:ClmVisibilityStausConverter
				x:Key="ClmVisibilityStatus" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="DVRSConfigDVRSFileName_A43736CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpTextBoxFileBrowser
								Name="dvrsFileBrowser"
								Text="{Binding Path=Record.DataItem.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736Value, Mode=TwoWay, Source={StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}}"
								MyBLObject="{Binding Path=Record.DataItem.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736Object, Mode=OneWay, Source={StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}}"
								IsAcpValid="{Binding Path=Record.DataItem.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736_Valid, Mode=TwoWay, Source={StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}}">
								<AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736_Editable"
											Source="{StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}" />
										<Binding
											Path="Record.DataItem.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736Object"
											Source="{StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}" />
									</MultiBinding>
								</AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
							</AcpUINS:AcpTextBoxFileBrowser>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 4-->
		<AcpUINS:AcpXamDataPresenter
			Name="DVRSFileListDataPresenter"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1"
			Header="{x:Static ResourceNS:AppResources.DVRS_File_List_ID}">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibilityConverter}"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Path="DataContext.HasDiffs"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Source="{StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}"
						Path="TemplateNode.DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736_Visible" />
					<Binding
						ElementName="DVRS_FileName_A43736_col"
						Path="Visibility" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<!--Unknown connection ID: 5-->
						<igcontrols:UnboundField
							x:Name="DVRS_FileName_A43736_col"
							Label="{x:Static ResourceNS:AppResources.DVRS_Filename_ID}"
							BindingPath="DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetEmbeddedNodeExpanderDVRSFileListTableView}, Path=DVRSFileListInnerSection.DVRSConfigDVRSFileName_A43736_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource DVRSConfigDVRSFileName_A43736CellStyle}"
									CellWidth="300"
									CellMinWidth="300" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
