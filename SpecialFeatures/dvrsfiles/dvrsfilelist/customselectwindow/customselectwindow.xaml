<Window
	x:Class="SpecialFeatures.DVRSFiles.List.CustomSelectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:DVRSFileList="clr-namespace:SpecialFeatures.DVRSFiles.List"
	Width="376"
	Height="402"
	WindowStartupLocation="CenterOwner">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<DVRSFileList:DownloadStatusesConverter
				x:Key="downloadStatusesConverter" />
			<CollectionViewSource
				Source="{Binding Path=DVRSFileItems, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
				x:Key="listingDataView" />
			<DataTemplate
				DataType="{x:Type DVRSFileList:DVRSFileItem}"
				x:Key="{DataTemplateKey {x:Type DVRSFileList:DVRSFileItem}}">
				<Grid
					Name="grid1"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Top"
					Margin="1,1,1,0">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="29*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock
						Name="textBlockFileName"
						Margin="1,0,0,0"
						Grid.Column="0"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						TextWrapping="Wrap"
						Text="{Binding Path=FileName}" />
					<Label
						Name="DownloadingStatusLabel"
						Margin="0,0,1,0"
						Grid.Column="1"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"
						HorizontalContentAlignment="Right"
						VerticalContentAlignment="Center"
						Content="{Binding Path=DownloadStatus, Converter={StaticResource downloadStatusesConverter}}" />
				</Grid>
				<DataTemplate.Triggers>
					<DataTrigger
						Value="Downloaded"
						Binding="{Binding Path=DownloadStatus}">
						<DataTrigger.Setters>
							<Setter
								TargetName="textBlockFileName"
								Property="Foreground"
								Value="#FF008000" />
							<Setter
								TargetName="DownloadingStatusLabel"
								Property="Foreground"
								Value="#FF008000" />
						</DataTrigger.Setters>
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 2-->
		<ListBox
			Name="DVRSFileListBox"
			Margin="12,12,12,47"
			HorizontalContentAlignment="Stretch"
			ItemsSource="{Binding Source={StaticResource listingDataView}}" />
		<!--Unknown connection ID: 3-->
		<Button
			Name="OKButton"
			Content="OK"
			Margin="0,0,107,11"
			Height="30"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Right"
			Width="75" />
		<!--Unknown connection ID: 4-->
		<Button
			Name="CancelButton"
			Content="Cancel"
			Height="29"
			HorizontalAlignment="Right"
			Margin="0,0,12,12"
			VerticalAlignment="Bottom"
			Width="75" />
	</Grid>
</Window>
