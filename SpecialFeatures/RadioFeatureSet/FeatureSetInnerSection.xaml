<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.RadioFeatureSet.PageFeatureSetInnerSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:radiofeatureset="clr-namespace:SpecialFeatures.RadioFeatureSet"
	Title="{Binding Path=UIName}">
	<DockPanel>
		<ScrollViewer>
			<StackPanel
				Width="Auto"
				Height="Auto">
				<!--Unknown connection ID: 1-->
				<Grid
					Name="grid"
					RenderTransformOrigin="0.5,0.5">
					<!--Unknown connection ID: 2-->
					<Grid
						Name="StdGridGeneralGrp"
						Column="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="200" />
							<ColumnDefinition
								Width="200" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 3-->
						<AcpUINS:AcpTextBox
							Name="FeatureSetPurchasedFeatureName"
							VerticalAlignment="Center"
							Grid.Row="0"
							Grid.Column="2"
							Foreground="#FF000000"
							Text="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureNameValue}"
							MyExpander="{Binding ElementName=ExpanderRadioFeatureSetUsedTable}"
							MyBLObject="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName}"
							MyLabelCtrl="{Binding ElementName=LblFeatureSetPurchasedFeatureName}"
							IsAcpValid="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName_Valid, Mode=OneWay}"
							IsAcpApplicable="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName_Applicable, Mode=OneWay}"
							IsAcpEditable="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName_Editable, Mode=OneWay}"
							IsAcpVisible="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName_Visible, Mode=OneWay}" />
						<!--Unknown connection ID: 4-->
						<AcpUINS:AcpLabel
							Name="LblFeatureSetPurchasedFeatureName"
							VerticalAlignment="Center"
							Grid.Row="0"
							Grid.Column="1"
							HelpText="{x:Static CommonResxNS:AppResources.Purchased_Feature_Name}"
							Content="{Binding Path=FeatureSetInnerSection.FeatureSetPurchasedFeatureName_UILabel}"
							MyParentCtrl="{Binding ElementName=FeatureSetPurchasedFeatureName}"
							IsAcpValid="{Binding ElementName=FeatureSetPurchasedFeatureName, Path=IsAcpValid}"
							IsAcpApplicable="{Binding ElementName=FeatureSetPurchasedFeatureName, Path=IsAcpApplicable}"
							IsAcpVisible="{Binding ElementName=FeatureSetPurchasedFeatureName, Path=IsAcpVisible}" />
						<!--Unknown connection ID: 5-->
						<AcpUINS:AcpTextBox
							Name="FeatureSetEnabledInUsedFlashcode"
							VerticalAlignment="Center"
							Grid.Row="1"
							Grid.Column="2"
							Text="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcodeValue}"
							MyExpander="{Binding ElementName=ExpanderRadioFeatureSetUsedTable}"
							MyBLObject="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode}"
							MyLabelCtrl="{Binding ElementName=LblFeatureSetEnabledInUsedFlashcode}"
							IsAcpValid="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode_Valid, Mode=OneWay}"
							IsAcpApplicable="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode_Applicable, Mode=OneWay}"
							IsAcpEditable="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode_Editable, Mode=OneWay}"
							IsAcpVisible="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode_Visible, Mode=OneWay}" />
						<!--Unknown connection ID: 6-->
						<AcpUINS:AcpLabel
							Name="LblFeatureSetEnabledInUsedFlashcode"
							VerticalAlignment="Center"
							Grid.Row="1"
							Grid.Column="1"
							HelpText="{x:Static CommonResxNS:AppResources.Enabled_in_Used_FLASHcode}"
							Content="{Binding Path=FeatureSetInnerSection.FeatureSetEnabledInUsedFlashcode_UILabel}"
							MyParentCtrl="{Binding ElementName=FeatureSetEnabledInUsedFlashcode}"
							IsAcpValid="{Binding ElementName=FeatureSetEnabledInUsedFlashcode, Path=IsAcpValid}"
							IsAcpApplicable="{Binding ElementName=FeatureSetEnabledInUsedFlashcode, Path=IsAcpApplicable}"
							IsAcpVisible="{Binding ElementName=FeatureSetEnabledInUsedFlashcode, Path=IsAcpVisible}" />
					</Grid>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</AcpUINS:AcpPageFeature>
