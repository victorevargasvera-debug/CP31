<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.RadioFeatureSet.PageRadioFeatureSet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:csla="clr-namespace:SpecialFeatures.RadioFeatureSet" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Focusable="True"
	Title="{Binding Path=UIName}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpUICommonNS:MultiValueToColorConverter
				x:Key="MultiValueToColor" />
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="FeatureSetPurchasedFeatureNameCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).FeatureSetPurchasedFeatureNameValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioFeatureSetUsedTable}"
								MyBLObject="{Binding Path=(Value).FeatureSetPurchasedFeatureName, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).FeatureSetPurchasedFeatureName_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).FeatureSetPurchasedFeatureName_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).FeatureSetPurchasedFeatureName_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).FeatureSetPurchasedFeatureName_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="FeatureSetEnabledInUsedFlashcodeCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcodeValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioFeatureSetUsedTable}"
								MyBLObject="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcode, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcode_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcode_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcode_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).FeatureSetEnabledInUsedFlashcode_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="ExtendedFeatureSetPurchasedFeatureNameCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).ExtendedFeatureSetFeatureNameValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioExtendedFeatureSetUsed}"
								MyBLObject="{Binding Path=(Value).ExtendedFeatureSetFeatureName, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).ExtendedFeatureSetFeatureName_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).ExtendedFeatureSetFeatureName_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).ExtendedFeatureSetFeatureName_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).ExtendedFeature_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="ExtendedFeatureSetEnabledCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableTextBox
								Foreground="#FF000000"
								Text="{Binding Path=(Value).ExtendedFeatureSetEnabledValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderRadioExtendedFeatureSetUsed}"
								MyBLObject="{Binding Path=(Value).ExtendedFeatureSetEnabled, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).ExtendedFeatureSetEnabled_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).ExtendedFeatureSetEnabled_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).ExtendedFeatureSetEnabled_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).ExtendedFeature_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<RoutedCommand
				x:Key="F1Help" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 2-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<DockPanel
		LastChildFill="False">
		<WrapPanel
			DockPanel.Dock="Top">
			<!--Unknown connection ID: 3-->
			<AcpUICommonNS:AcpThemeBase
				Name="ThemeBaseObj" />
			<TextBlock
				Margin="25 3 0 0"
				Visibility="Visible">
				<!--Unknown connection ID: 4-->
				<Hyperlink
					Name="HLinkRadioFeatureSetGeneral"
					Tag="ExpanderRadioFeatureSetGeneral">
					<TextBlock
						TextDecorations="Underline"
						Text="{Binding Path=General.UIName}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource MultiValueToColor}">
								<Binding
									Source="false" />
								<Binding
									Path="ThemeName"
									ElementName="ThemeBaseObj" />
							</MultiBinding>
						</TextBlock.Foreground>
					</TextBlock>
				</Hyperlink>
			</TextBlock>
			<TextBlock
				Margin="25 3 0 0"
				Visibility="Visible">
				<!--Unknown connection ID: 5-->
				<Hyperlink
					Name="HLinkRadioFeatureSetUsed"
					Tag="ExpanderRadioFeatureSetUsed">
					<TextBlock
						TextDecorations="Underline"
						Text="{Binding Path=FeatureSet.UIName}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource MultiValueToColor}">
								<Binding
									Source="false" />
								<Binding
									Path="ThemeName"
									ElementName="ThemeBaseObj" />
							</MultiBinding>
						</TextBlock.Foreground>
					</TextBlock>
				</Hyperlink>
			</TextBlock>
			<TextBlock
				Margin="25 3 0 0"
				Visibility="{Binding ElementName=ExpanderRadioExtendedFeatureSetUsed, Path=IsAcpVisible, Converter={StaticResource BooleanToVisibility}}">
				<!--Unknown connection ID: 6-->
				<Hyperlink
					Name="HLinkRadioExtendedFeatureSetUsed"
					Tag="ExpanderRadioExtendedFeatureSetUsed">
					<TextBlock
						TextDecorations="Underline"
						Text="{Binding Path=ExtendedFeatureSet.UIName}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource MultiValueToColor}">
								<Binding
									Source="false" />
								<Binding
									Path="ThemeName"
									ElementName="ThemeBaseObj" />
							</MultiBinding>
						</TextBlock.Foreground>
					</TextBlock>
				</Hyperlink>
			</TextBlock>
		</WrapPanel>
		<DockPanel
			Height="20"
			Background="#00FFFFFF"
			Dock="Top">
			<Rectangle
				Height="2"
				RadiusX="20"
				RadiusY="20"
				Stroke="#FF000000"
				Fill="#FF808080"
				VerticalAlignment="Center" />
		</DockPanel>
		<ScrollViewer
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			DockPanel.Dock="Top">
			<!--Unknown connection ID: 7-->
			<StackPanel
				Name="MyStackPanel"
				Width="Auto"
				Height="Auto">
				<!--Unknown connection ID: 8-->
				<AcpUINS:AcpExpander
					Name="ExpanderRadioFeatureSetGeneral"
					Width="Auto"
					IsAcpVisible="True"
					Header="{Binding Path=General.UIName}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 9-->
						<AcpUINS:AcpGroupBox
							Name="GrpBoxExpanderRadioFeatureSetGeneralPseudo0"
							IsAcpVisible="True"
							BorderBrush="#FF000000"
							Grid.Row="0"
							Grid.Column="0"
							BorderThickness="0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<!--Unknown connection ID: 10-->
								<Grid
									Name="StdGrpBoxExpanderRadioFeatureSetGeneralPseudo0"
									Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="300" />
										<ColumnDefinition
											Width="200" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>
									<!--Unknown connection ID: 11-->
									<AcpUINS:AcpLabel
										Name="LblFeatureSetGeneralPurchasedFLASHcode"
										VerticalAlignment="Center"
										Grid.Row="0"
										Grid.Column="0"
										HelpText="{x:Static CommonResxNS:AppResources.Purchased_FLASHcode}"
										Content="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode_UILabel}"
										MyParentCtrl="{Binding ElementName=FeatureSetGeneralPurchasedFLASHcode}"
										IsAcpValid="{Binding ElementName=FeatureSetGeneralPurchasedFLASHcode, Path=IsAcpValid}"
										IsAcpApplicable="{Binding ElementName=FeatureSetGeneralPurchasedFLASHcode, Path=IsAcpApplicable}"
										IsAcpVisible="{Binding ElementName=FeatureSetGeneralPurchasedFLASHcode, Path=IsAcpVisible}" />
									<!--Unknown connection ID: 12-->
									<AcpUINS:AcpTextBox
										Name="FeatureSetGeneralPurchasedFLASHcode"
										VerticalAlignment="Center"
										Grid.Row="0"
										Grid.Column="1"
										Foreground="#FF000000"
										Text="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcodeValue}"
										MyExpander="{Binding ElementName=GrpBoxExpanderRadioFeatureSetGeneralPseudo0}"
										MyBLObject="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode}"
										MyLabelCtrl="{Binding ElementName=LblFeatureSetGeneralPurchasedFLASHcode}"
										IsAcpValid="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode_Valid, Mode=OneWay}"
										IsAcpApplicable="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode_Applicable, Mode=OneWay}"
										IsAcpEditable="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode_Editable, Mode=OneWay}"
										IsAcpVisible="{Binding Path=General.FeatureSetGeneralPurchasedFLASHcode_Visible, Mode=OneWay}" />
									<!--Unknown connection ID: 13-->
									<AcpUINS:AcpLabel
										Name="LblFeatureSetGeneralUsedFLASHcode"
										VerticalAlignment="Center"
										Grid.Row="1"
										Grid.Column="0"
										HelpText="{x:Static CommonResxNS:AppResources.Used_FLASHcode}"
										Content="{Binding Path=General.FeatureSetGeneralUsedFLASHcode_UILabel}"
										MyParentCtrl="{Binding ElementName=FeatureSetGeneralUsedFLASHcode}"
										IsAcpValid="{Binding ElementName=FeatureSetGeneralUsedFLASHcode, Path=IsAcpValid}"
										IsAcpApplicable="{Binding ElementName=FeatureSetGeneralUsedFLASHcode, Path=IsAcpApplicable}"
										IsAcpVisible="{Binding ElementName=FeatureSetGeneralUsedFLASHcode, Path=IsAcpVisible}" />
									<!--Unknown connection ID: 14-->
									<AcpUINS:AcpTextBox
										Name="FeatureSetGeneralUsedFLASHcode"
										VerticalAlignment="Center"
										Grid.Row="1"
										Grid.Column="1"
										Foreground="#FF000000"
										Text="{Binding Path=General.FeatureSetGeneralUsedFLASHcodeValue, Mode=TwoWay}"
										MyExpander="{Binding ElementName=GrpBoxExpanderRadioFeatureSetGeneralPseudo0}"
										MyBLObject="{Binding Path=General.FeatureSetGeneralUsedFLASHcode}"
										MyLabelCtrl="{Binding ElementName=LblFeatureSetGeneralUsedFLASHcode}"
										IsAcpValid="{Binding Path=General.FeatureSetGeneralUsedFLASHcode_Valid, Mode=OneWay}"
										IsAcpApplicable="{Binding Path=General.FeatureSetGeneralUsedFLASHcode_Applicable, Mode=OneWay}"
										IsAcpEditable="{Binding Path=General.FeatureSetGeneralUsedFLASHcode_Editable, Mode=OneWay}"
										IsAcpVisible="{Binding Path=General.FeatureSetGeneralUsedFLASHcode_Visible, Mode=OneWay}" />
								</Grid>
							</Grid>
						</AcpUINS:AcpGroupBox>
					</Grid>
				</AcpUINS:AcpExpander>
				<!--Unknown connection ID: 15-->
				<AcpUINS:AcpExpander
					Name="ExpanderRadioFeatureSetUsed"
					Width="Auto"
					IsAcpVisible="True"
					Header="{Binding Path=FeatureSet.UIName}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 16-->
						<AcpUINS:AcpXamDataPresenter
							Name="ExpanderRadioFeatureSetUsedTable"
							KeyboardNavigation.AcceptsReturn="True"
							Grid.Row="1"
							MyExpander="{Binding ElementName=ExpanderRadioFeatureSetUsed}"
							igcontrols:DataSource="{Binding FeatureSet.EmbeddedRecset}">
							<igcontrols:DataPresenterBase.FieldLayouts>
								<igcontrols:FieldLayout>
									<igcontrols:FieldLayout.Fields>
										<igcontrols:UnboundField
											Name="{x:Static CommonResxNS:AppResources.Purchased_Feature_Name}"
											BindingPath="FeatureSetInnerSection"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource FeatureSetPurchasedFeatureNameCellStyle}"
													CellWidth="300"
													CellMinWidth="300" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
										<igcontrols:UnboundField
											Name="{x:Static CommonResxNS:AppResources.Enabled_in_Used_FLASHcode}"
											BindingPath="FeatureSetInnerSection"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource FeatureSetEnabledInUsedFlashcodeCellStyle}"
													CellWidth="200"
													CellMinWidth="200" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
									</igcontrols:FieldLayout.Fields>
								</igcontrols:FieldLayout>
							</igcontrols:DataPresenterBase.FieldLayouts>
						</AcpUINS:AcpXamDataPresenter>
					</Grid>
				</AcpUINS:AcpExpander>
				<!--Unknown connection ID: 17-->
				<AcpUINS:AcpExpander
					Name="ExpanderRadioExtendedFeatureSetUsed"
					Width="Auto"
					Header="{Binding Path=ExtendedFeatureSet.UIName}"
					IsAcpVisible="{Binding Path=ExtendedFeatureSet.IsVisible_EmbeddedRecset, Mode=OneWay}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 18-->
						<AcpUINS:AcpXamDataPresenter
							Name="ExpanderRadioExtendedFeatureSetUsedTable"
							KeyboardNavigation.AcceptsReturn="True"
							Grid.Row="1"
							MyExpander="{Binding ElementName=ExpanderRadioExtendedFeatureSetUsed}"
							igcontrols:DataSource="{Binding ExtendedFeatureSet.EmbeddedRecset}">
							<igcontrols:DataPresenterBase.FieldLayouts>
								<igcontrols:FieldLayout>
									<igcontrols:FieldLayout.Fields>
										<igcontrols:UnboundField
											Name="{x:Static CommonResxNS:AppResources.Extended_Feature_Name}"
											BindingPath="ExtendedFeatureSetInnerSection"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource ExtendedFeatureSetPurchasedFeatureNameCellStyle}"
													CellWidth="300"
													CellMinWidth="300" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
										<igcontrols:UnboundField
											Name="{x:Static CommonResxNS:AppResources.Used_In_Codeplug}"
											BindingPath="ExtendedFeatureSetInnerSection"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource ExtendedFeatureSetEnabledCellStyle}"
													CellWidth="200"
													CellMinWidth="200" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
									</igcontrols:FieldLayout.Fields>
								</igcontrols:FieldLayout>
							</igcontrols:DataPresenterBase.FieldLayouts>
						</AcpUINS:AcpXamDataPresenter>
					</Grid>
				</AcpUINS:AcpExpander>
				<Grid
					DockPanel.Dock="Top"
					ClipToBounds="False">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
					</Grid.RowDefinitions>
					<!--Unknown connection ID: 19-->
					<Button
						Name="buttonClose"
						Content="{x:Static CommonResxNS:AppResources.Close_Id}"
						Grid.Column="0"
						Grid.Row="0"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Width="75"
						Margin="45,10,5,10"
						ClipToBounds="False" />
					<!--Unknown connection ID: 20-->
					<Button
						Name="buttonHelp"
						Content="{x:Static CommonResxNS:AppResources.Help_Id}"
						Grid.Column="1"
						Grid.Row="0"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Width="75"
						Margin="45,10,5,10"
						ClipToBounds="False" />
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</AcpUINS:AcpPageFeature>
