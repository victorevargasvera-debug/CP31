<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.Ucl.HotList.UclQCIICallHotListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.QCII_Call_Hot_Lists}" xmlns:hotlist="clr-namespace:SpecialFeatures.Ucl.HotList">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="ContactAliasCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableComboBox
								Height="23.2766666666667"
								DisplayMemberPath="ItemName"
								SelectedValuePath="ItemName"
								MyBLObject="{Binding Path=(Value).ContactAliasObject, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								ItemsSource="{Binding Path=(Value).ContactAliasObject.Items, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								SelectedValue="{Binding Path=(Value).ContactAlias_UIValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).ContactAlias_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).ContactAlias_Applicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).ContactAlias_Editable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).ContactAlias_Visible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="CallIDCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<AcpUINS:AcpTableComboBox
								Height="23.2766666666667"
								DisplayMemberPath="ItemName"
								SelectedValuePath="ItemName"
								MyBLObject="{Binding Path=(Value).CallIDObject, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								ItemsSource="{Binding Path=(Value).CallIDObject.Items, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								SelectedValue="{Binding Path=(Value).CallID_UIValue, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=(Value).CallID_Valid, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=(Value).CallID_Applicable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpEditable="{Binding Path=(Value).CallID_Editable, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=(Value).CallID_Visible, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpRecNavToolbar
			Name="RecNavToolbarUclQCIICallHotList"
			DockPanel.Dock="Top"
			Background="{DynamicResource LightBrush}"
			MyRecordsetDataSource="{Binding Path=DataContext, RelativeSource={RelativeSource Self}}" />
		<!--Unknown connection ID: 3-->
		<AcpUINS:AcpListBox
			Name="LstBoxUclContact"
			DockPanel.Dock="Left"
			SelectionMode="Multiple"
			HorizontalAlignment="Left"
			Margin="-1,1,0,2"
			Width="Auto"
			BorderThickness="0,0,0,0"
			Background="{x:Null}">
			<AcpUINS:AcpListBoxItemExp
				MyExpander="{Binding ElementName=ExpQCIICallHotList}"
				Content="{Binding Path=MyExpander.Header, RelativeSource={RelativeSource Self}}" />
		</AcpUINS:AcpListBox>
		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel
				Width="Auto"
				Height="Auto">
				<!--Unknown connection ID: 4-->
				<AcpUINS:AcpExpander
					Name="ExpQCIICallHotList"
					Visibility="Collapsed"
					Header="{x:Static CommonResxNS:AppResources.QCII_Call_Hot_List}"
					ExpandDirection="Down"
					Margin="0,0,0,0"
					VerticalAlignment="Top">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="200" />
							<ColumnDefinition
								Width="200" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<!--Unknown connection ID: 5-->
						<AcpUINS:AcpTextBox
							Name="TxtBoxHotListAlias"
							Grid.Row="0"
							Grid.Column="1"
							Height="23.2766666666667"
							MyBLObject="{Binding Path=QCIICallHotList.HotListAliasObject}"
							MyLabelCtrl="{Binding ElementName=LblHotListAlias}"
							Text="{Binding Path=QCIICallHotList.HotListAlias}"
							IsAcpValid="{Binding Path=QCIICallHotList.HotListAlias_Valid}"
							IsAcpApplicable="{Binding Path=QCIICallHotList.HotListAlias_Applicable}"
							IsAcpEditable="{Binding Path=QCIICallHotList.HotListAlias_Editable}"
							IsAcpVisible="{Binding Path=QCIICallHotList.HotListAlias_Visible}" />
						<!--Unknown connection ID: 6-->
						<AcpUINS:AcpLabel
							Name="LblHotListAlias"
							Grid.Row="0"
							Grid.Column="0"
							Height="23.2766666666667"
							MyParentCtrl="{Binding ElementName=TxtBoxHotListAlias}"
							IsAcpValid="{Binding ElementName=TxtBoxHotListAlias, Path=IsAcpValid}"
							IsAcpApplicable="{Binding ElementName=TxtBoxHotListAlias, Path=IsAcpApplicable}">Hot List Alias</AcpUINS:AcpLabel>
						<!--Unknown connection ID: 7-->
						<AcpUINS:AcpChildRecNavToolbar
							Name="RecNavToolbarQCIICallHotListHotList"
							Background="{DynamicResource LightBrush}"
							Grid.Row="1"
							Grid.ColumnSpan="3"
							MyRecordsetDataSource="{Binding ElementName=QCIICallHotListDataPresenter, Path=DataSource}" />
						<!--Unknown connection ID: 8-->
						<AcpUINS:AcpXamDataPresenter
							Name="QCIICallHotListDataPresenter"
							Grid.Row="2"
							Grid.ColumnSpan="3"
							Header="{x:Static CommonResxNS:AppResources.QCII_Conventional_Hot_List}"
							igcontrols:DataSource="{Binding QCIICallHotList.QCIICallHotListRecset}">
							<igcontrols:DataPresenterBase.FieldLayouts>
								<igcontrols:FieldLayout>
									<igcontrols:FieldLayout.Fields>
										<igcontrols:UnboundField
											Label="{x:Static CommonResxNS:AppResources.Contact_Alias}"
											BindingPath="HotListQCII"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource ContactAliasCellStyle}" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
										<igcontrols:UnboundField
											Label="{x:Static CommonResxNS:AppResources.Call_ID}"
											BindingPath="HotListQCII"
											BindingMode="OneWay">
											<igcontrols:Field.Settings>
												<igcontrols:FieldSettings
													CellValuePresenterStyle="{StaticResource CallIDCellStyle}" />
											</igcontrols:Field.Settings>
										</igcontrols:UnboundField>
									</igcontrols:FieldLayout.Fields>
								</igcontrols:FieldLayout>
							</igcontrols:DataPresenterBase.FieldLayouts>
						</AcpUINS:AcpXamDataPresenter>
					</Grid>
				</AcpUINS:AcpExpander>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</AcpUINS:AcpPageFeature>
