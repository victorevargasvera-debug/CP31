<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.Ucl.HotList.UclMDCCallHotListTblView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.MDC_Conventional_Hot_List_Table_View}" xmlns:hotlist="clr-namespace:SpecialFeatures.Ucl.HotList">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpRecNavToolbar
			Name="RecNavToolbarPageUclMDCHotList"
			Grid.Row="0"
			TableMode="True"
			MyRecordsetDataSource="{Binding ElementName=UclMDCHotList, Path=DataSource}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpRtdButtonVisibilityConverter
				x:Key="acpRtdButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCopyButtonVisibilityConverter
				x:Key="acpCopyButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibityConverter" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<AcpUICommonNS:ParentControlVisibilityConverter
				x:Key="parentControlVisibilityConverter" />
			<AcpUICommonNS:ComparatorControlVisibilityConverter
				x:Key="comparatorControlVisibilityConverter" />
			<AcpUICommonNS:AcpRecNavToolbarTableModeConverter
				x:Key="acpRecNavToolbarTableModeConverter" />
			<AcpUICommonNS:AcpRecNavToolbarVisibilityConverter
				x:Key="acpRecNavToolbarVisibityConverter" />
			<AcpUICommonNS:TableViewVisibilityConverter
				x:Key="tableViewVisibityConverter" />
			<AcpUICommonNS:SRecViewVisibilityConverter
				x:Key="sRecViewVisibityConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<AcpUICommonNS:ClmVisibilityStausConverter
				x:Key="ClmVisibilityStatus" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<AcpUICommonNS:DateTimeFormatConverter
				x:Key="dateTimeFormatter" />
			<AcpUICommonNS:ParentContainerVisibilityConverter
				x:Key="groupboxVisibilityConverter" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetParentRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2212</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetChildRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2212</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10419</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="HotListAliasCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpTableTextBox
								Text="{Binding Path=Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Value, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpMDCCallHotList}"
								MyBLObject="{Binding Path=Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Object, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Applicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Visible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpTextBox.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Object"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpTextBox.IsAcpEditable>
							</AcpUINS:AcpTableTextBox>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 4-->
		<AcpUINS:AcpXamDataPresenter
			Name="UclMDCHotList"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibityConverter}"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Source="{StaticResource GetParentRecset}"
						Path="_HasDiffs" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="FieldLayouts[0].Fields[0].Visibility"
						RelativeSource="{RelativeSource Self}" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<igcontrols:UnboundField
							Name="{x:Static CommonResxNS:AppResources.Hot_List_Alias}"
							BindingPath="MDCCallHotList.UclMDCCnvHotList_HotListAlias_A00045Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetParentRecset}, Path=MDCCallHotList.UclMDCCnvHotList_HotListAlias_A00045_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource HotListAliasCellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
