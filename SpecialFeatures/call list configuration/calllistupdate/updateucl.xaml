<Window
	x:Class="SpecialFeatures.UCL.CallListUpdate.UpdateUCL" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLNS="clr-namespace:AcpBusinessLayer;assembly=AcpBusinessLayer" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:dc="clr-namespace:DevComponents.WpfEditors;assembly=AcpWpfEditors" xmlns:CallListUpdateNS="clr-namespace:SpecialFeatures.UCL.CallListUpdate" xmlns:TrkCallList="clr-namespace:SpecialFeatures.Ucl.Contact" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.Import_Call_List_From_Console}"
	Height="Auto"
	Width="Auto"
	MaxWidth="630"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen"
	Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Frame, ResourceId={x:Static AcpUINS:AcpColorKeys.FrameContentAreaPopupDialogueBackground}}}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<RoutedCommand
				x:Key="F1Help" />
			<AcpUICommonNS:EditabilityToOpacityConverter
				x:Key="editabilityToOpacity" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.CommandBindings>
		<!--Unknown connection ID: 2-->
		<CommandBinding
			Command="{StaticResource F1Help}" />
	</UIElement.CommandBindings>
	<UIElement.InputBindings>
		<KeyBinding
			Command="{StaticResource F1Help}"
			Key="F1" />
	</UIElement.InputBindings>
	<DockPanel
		Width="auto"
		Height="auto"
		VerticalAlignment="Stretch"
		HorizontalAlignment="Stretch">
		<Grid
			Height="auto"
			Width="auto"
			DockPanel.Dock="Top"
			ShowGridLines="False"
			VerticalAlignment="Stretch"
			HorizontalAlignment="Stretch"
			DataContext="{Binding}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="180" />
				<ColumnDefinition
					Width="180" />
				<ColumnDefinition
					Width="180" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="20" />
				<RowDefinition
					Height="60" />
				<RowDefinition
					Height="60" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 3-->
			<AcpUINS:AcpLabel
				Name="lbAliasesListFilePath"
				Grid.Row="0"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Content="{x:Static CommonResxNS:AppResources.Aliases_List_File_Path}"
				Height="23"
				HorizontalAlignment="Left"
				Margin="4,0,0,0"
				VerticalAlignment="Center"
				Width="Auto" />
			<!--Unknown connection ID: 4-->
			<AcpUINS:AcpTextBox
				Name="txtboxAliasesListFilePath"
				Grid.Row="1"
				Grid.ColumnSpan="2"
				Grid.RowSpan="1"
				Height="40"
				HorizontalAlignment="Left"
				Margin="6,2,0,0"
				VerticalAlignment="Top"
				Width="360"
				HorizontalScrollBarVisibility="Visible"
				ToolTip="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Text}" />
			<!--Unknown connection ID: 5-->
			<Button
				Name="btnAliasesListFilePathBrowse"
				Grid.Row="1"
				Grid.Column="2"
				Margin="0,0,0,0"
				Content="{x:Static CommonResxNS:AppResources.Browse_Suspension}"
				Height="23"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Width="80" />
			<!--Unknown connection ID: 6-->
			<GroupBox
				Name="groupBoxSysInfo"
				Grid.Row="3"
				Grid.RowSpan="3"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Width="auto"
				Height="auto"
				Header="{x:Static CommonResxNS:AppResources.Trunking_System_Information}"
				HorizontalAlignment="Left"
				Margin="6,2,6,0">
				<Grid
					Row="3"
					RowSpan="3"
					Column="0"
					ColumnSpan="3"
					Height="auto"
					Width="auto">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="240" />
						<ColumnDefinition
							Width="100" />
						<ColumnDefinition
							Width="240" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="30" />
						<RowDefinition
							Height="30" />
						<RowDefinition
							Height="30" />
						<RowDefinition
							Height="30" />
					</Grid.RowDefinitions>
					<!--Unknown connection ID: 7-->
					<AcpUINS:AcpLabel
						Name="lbSysType"
						Grid.Row="0"
						Grid.Column="0"
						Content="{x:Static CommonResxNS:AppResources.System_Type}"
						Height="28"
						HorizontalAlignment="Left"
						Margin="4,2,0,0"
						VerticalAlignment="Top" />
					<!--Unknown connection ID: 8-->
					<AcpUINS:AcpComboBox
						Name="comboSysType"
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170"
						SelectedIndex="0"
						ItemsSource="{Binding SysTypeList}"
						SelectedItem="{Binding TypeSelection}" />
					<!--Unknown connection ID: 9-->
					<AcpUINS:AcpLabel
						Name="lbSystemName"
						Grid.Row="1"
						Grid.Column="0"
						Content="{x:Static CommonResxNS:AppResources.System_Name}"
						Height="28"
						HorizontalAlignment="Left"
						Margin="4,2,0,0"
						VerticalAlignment="Top" />
					<!--Unknown connection ID: 10-->
					<AcpUINS:AcpComboBox
						Name="comboSysName"
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170"
						ItemsSource="{Binding lstSystemName}"
						SelectedItem="{Binding NameSelection}" />
					<!--Unknown connection ID: 11-->
					<AcpUINS:AcpLabel
						Name="LblTrkSysSystemID"
						Grid.Row="2"
						Grid.Column="0"
						Content="{x:Static CommonResxNS:AcgResources.ID_SYSTEMID}"
						Margin="4,2,0,0"
						Height="28"
						HorizontalAlignment="Left"
						VerticalAlignment="Top" />
					<!--Unknown connection ID: 12-->
					<AcpUINS:AcpTextBox
						Name="txSystemID"
						Grid.Row="2"
						IsEnabled="False"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170"
						Text="{Binding Systemid}" />
					<!--Unknown connection ID: 13-->
					<Grid
						Name="txspCustomSystemId"
						Row="2"
						Column="1"
						ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="5*" />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="5*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<!--Unknown connection ID: 14-->
						<AcpUINS:AcpTextBox
							Name="SystemidDec"
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="2"
							MaskType="{}{number:0-268435455}"
							Text="{Binding SystemidDecValue, Mode=Twoway}" />
						<AcpUINS:AcpLabel
							Grid.Row="0"
							Grid.Column="1"
							Grid.RowSpan="2"
							ContextMenu="{x:Null}">-</AcpUINS:AcpLabel>
						<!--Unknown connection ID: 15-->
						<AcpUINS:AcpTextBox
							Name="SystemidHex"
							Grid.Row="0"
							Grid.Column="2"
							Grid.RowSpan="2"
							MaskType="{}{char:7:0-9a-fA-F}"
							Text="{Binding SystemidHexValue, Mode=Twoway}" />
						<!--Unknown connection ID: 16-->
						<RepeatButton
							Name="UpClickSystemid"
							Grid.Row="0"
							Grid.Column="3"
							Height="11.63833333333335"
							Width="20"
							Delay="500"
							Interval="10"
							HorizontalAlignment="Right">
							<Image
								Source="../../icons/SpinnerArrowUp.png"
								Opacity="{Binding ElementName=UpClickSystemid, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
						</RepeatButton>
						<!--Unknown connection ID: 17-->
						<RepeatButton
							Name="DownClickSystemid"
							Grid.Row="1"
							Grid.Column="3"
							Height="11.63833333333335"
							Width="20"
							Delay="500"
							Interval="10"
							HorizontalAlignment="Right">
							<Image
								Source="../../icons/SpinnerArrowDown.png"
								Opacity="{Binding ElementName=DownClickSystemid, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
						</RepeatButton>
					</Grid>
					<!--Unknown connection ID: 18-->
					<AcpUINS:AcpLabel
						Name="LblTrkSysHomeWACNID"
						Grid.Row="3"
						Grid.Column="0"
						Content="{x:Static CommonResxNS:AcgResources.ID_HOMEWACNID}"
						Margin="4,2,0,0"
						Height="28"
						HorizontalAlignment="Left"
						VerticalAlignment="Top" />
					<!--Unknown connection ID: 19-->
					<AcpUINS:AcpTextBox
						Name="txWACNID"
						Grid.Row="3"
						IsEnabled="False"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170"
						Text="{Binding Wacnid}" />
					<!--Unknown connection ID: 20-->
					<Grid
						Name="txspCustomWACNID"
						Row="3"
						Column="1"
						ColumnSpan="2"
						Height="23"
						HorizontalAlignment="left"
						Margin="6,2,0,0"
						VerticalAlignment="Top"
						Width="170">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="5*" />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="5*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<!--Unknown connection ID: 21-->
						<AcpUINS:AcpTextBox
							Name="CustomWACNIDDec"
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="2"
							MaskType="{}{number:0-268435455}"
							Text="{Binding WacnidDecValue, Mode=Twoway}" />
						<AcpUINS:AcpLabel
							Grid.Row="0"
							Grid.Column="1"
							Grid.RowSpan="2"
							ContextMenu="{x:Null}">-</AcpUINS:AcpLabel>
						<!--Unknown connection ID: 22-->
						<AcpUINS:AcpTextBox
							Name="CustomWACNIDHex"
							Grid.Row="0"
							Grid.Column="2"
							Grid.RowSpan="2"
							MaskType="{}{char:7:0-9a-fA-F}"
							Text="{Binding WacnidHexValue, Mode=Twoway}" />
						<!--Unknown connection ID: 23-->
						<RepeatButton
							Name="UpClickCustomWACNID"
							Grid.Row="0"
							Grid.Column="3"
							Height="11.63833333333335"
							Width="20"
							Delay="500"
							Interval="10"
							HorizontalAlignment="Right">
							<Image
								Source="../../icons/SpinnerArrowUp.png"
								Opacity="{Binding ElementName=UpClickCustomWACNID, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
						</RepeatButton>
						<!--Unknown connection ID: 24-->
						<RepeatButton
							Name="DownClickCustomWACNID"
							Grid.Row="1"
							Grid.Column="3"
							Height="11.63833333333335"
							Width="20"
							Delay="500"
							Interval="10"
							HorizontalAlignment="Right">
							<Image
								Source="../../icons/SpinnerArrowDown.png"
								Opacity="{Binding ElementName=DownClickCustomWACNID, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
						</RepeatButton>
					</Grid>
				</Grid>
			</GroupBox>
			<Grid
				Row="7"
				Column="0"
				ColumnSpan="3"
				Height="40"
				HorizontalAlignment="left">
				<Grid.RowDefinitions>
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="60" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 25-->
				<AcpUINS:AcpCheckBox
					Name="ckDeleteExtra"
					Margin="35,5,0,0"
					Grid.Row="0"
					Grid.Column="0"
					Width="15"
					HorizontalAlignment="Left"
					VerticalAlignment="Top" />
				<!--Unknown connection ID: 26-->
				<AcpUINS:AcpLabel
					Name="lbDeleteExtra"
					Grid.Row="0"
					Grid.Column="1"
					Content="{x:Static CommonResxNS:AppResources.Delete_Extra_CallIDs_Or_Contacts}"
					HorizontalAlignment="Left"
					VerticalAlignment="Top" />
			</Grid>
			<!--Unknown connection ID: 27-->
			<AcpUINS:AcpLabel
				Name="lbNoteToUser"
				Grid.Row="8"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Content="{x:Static CommonResxNS:AppResources.Update_Call_List_Option}"
				Height="60"
				HorizontalAlignment="Left"
				Margin="33,0,0,0"
				VerticalAlignment="Top" />
			<!--Unknown connection ID: 28-->
			<Button
				Name="btnImport"
				Grid.Row="9"
				Grid.Column="0"
				Content="{x:Static CommonResxNS:AppResources.Import_ID_Button}"
				Height="23"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Width="100" />
			<!--Unknown connection ID: 29-->
			<Button
				Name="btnCancel"
				Grid.Row="9"
				Grid.Column="1"
				Content="{x:Static CommonResxNS:AppResources.Cancel_Id}"
				Height="23"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Width="100" />
			<!--Unknown connection ID: 30-->
			<Button
				Name="btnHelp"
				Grid.Row="9"
				Grid.Column="2"
				Content="{x:Static CommonResxNS:AppResources.Help_Id}"
				Height="23"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Width="100" />
		</Grid>
	</DockPanel>
</Window>
