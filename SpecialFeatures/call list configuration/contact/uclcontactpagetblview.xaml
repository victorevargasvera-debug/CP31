<AcpUINS:AcpPageFeature
	x:Class="SpecialFeatures.Ucl.Contact.UclContactPageTblView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:ACPUCLContactFeatureNS="clr-namespace:SpecialFeatures.Ucl.Contact" xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.Unified_Call_List_Table_View}">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpRecNavToolbar
			Name="RecNavToolbarPageUclContact"
			Grid.Row="0"
			TableMode="True"
			MaskMaxLength="5"
			DefaultMaskType="nnnnn"
			MyRecordsetDataSource="{Binding ElementName=UclContactList, Path=DataSource}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpRtdButtonVisibilityConverter
				x:Key="acpRtdButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCopyButtonVisibilityConverter
				x:Key="acpCopyButtonVisibilityConverter" />
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibityConverter" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<AcpUICommonNS:ParentControlVisibilityConverter
				x:Key="parentControlVisibilityConverter" />
			<AcpUICommonNS:ComparatorControlVisibilityConverter
				x:Key="comparatorControlVisibilityConverter" />
			<AcpUICommonNS:AcpRecNavToolbarTableModeConverter
				x:Key="acpRecNavToolbarTableModeConverter" />
			<AcpUICommonNS:AcpRecNavToolbarVisibilityConverter
				x:Key="acpRecNavToolbarVisibityConverter" />
			<AcpUICommonNS:TableViewVisibilityConverter
				x:Key="tableViewVisibityConverter" />
			<AcpUICommonNS:SRecViewVisibilityConverter
				x:Key="sRecViewVisibityConverter" />
			<AcpUICommonNS:AcpFlyInButtonVisibilityConverter
				x:Key="flyInVisibilityConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<AcpUICommonNS:ClmVisibilityStausConverter
				x:Key="ClmVisibilityStatus" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<AcpUICommonNS:DateTimeFormatConverter
				x:Key="dateTimeFormatter" />
			<AcpUICommonNS:ParentContainerVisibilityConverter
				x:Key="groupboxVisibilityConverter" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetParentRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetComparatorRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetComparatorParentFeature">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetTrunkingRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10401</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetTrunkingT2Recset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10411</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetAstroRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10403</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetMDCRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10405</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetPhoneRecset">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2200</sys:Int32>
					<sys:Int32>0</sys:Int32>
					<sys:Int32>10413</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="FlyIn">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpFlyInButton
								ToolTip="{x:Static CommonResxNS:AppResources.Fly_In}"
								Width="30"
								Height="27"
								Foreground="#FF000000"
								ShowDiffIcon="{Binding Path=Record.DataItem._HasDiffs, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="ContactAliasCellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 4-->
							<AcpUINS:AcpTableTextBox
								MaxLength="14"
								MyExpander="{Binding ElementName=ExpGeneral}"
								Text="{Binding Path=Record.DataItem.General.UclGen_ContactAlias_A00009Value, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyBLObject="{Binding Path=Record.DataItem.General.UclGen_ContactAlias_A00009Object, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpApplicable="{Binding Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Applicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpVisible="{Binding Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Visible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpTextBox.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.UclGen_ContactAlias_A00009_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.UclGen_ContactAlias_A00009Object"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpTextBox.IsAcpEditable>
							</AcpUINS:AcpTableTextBox>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 5-->
		<AcpUINS:AcpXamDataPresenter
			Name="UclContactList"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibityConverter}"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Source="{StaticResource GetParentRecset}"
						Path="_HasDiffs" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="FieldLayouts[0].Fields[0].Visibility"
						RelativeSource="{RelativeSource Self}" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<igcontrols:UnboundField
							Name="{x:Static CommonResxNS:AppResources.Contact_Name}"
							BindingPath="General.UclGen_ContactAlias_A00009Object"
							BindingMode="OneWay"
							Visibility="{Binding Source={StaticResource GetParentRecset}, Path=General.UclGen_ContactAlias_A00009_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource ContactAliasCellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
