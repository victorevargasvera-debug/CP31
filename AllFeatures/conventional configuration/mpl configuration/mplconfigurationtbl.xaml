<AcpUINS:AcpPageFeature
	x:Class="Motorola.MackinawCPS.CoreFeatures.MPLConfiguration.PageMPLConfigurationTbl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpBLNS="clr-namespace:AcpBusinessLayer;assembly=AcpBusinessLayer" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer" xmlns:igcontrols="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:igwindows="http://infragistics.com/Windows" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:MPLConfigurationNS="clr-namespace:Motorola.MackinawCPS.CoreFeatures.MPLConfiguration" xmlns:src="clr-namespace:ConstraintHelper" xmlns:ResourceNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
	Title="{x:Static ResourceNS:AcgResources.ID_MPLCONFIGURATIONTABLEVIEW}">
	<AcpUINS:AcpPageFeature.PageRecNavToolbar>
		<!--Unknown connection ID: 2-->
		<AcpUINS:AcpRecNavToolbar
			Name="RecNavToolbarPageMPLConfiguration"
			TableMode="True"
			MyRecordsetDataSource="{Binding ElementName=MPLConfigurationList, Path=DataSource}" />
	</AcpUINS:AcpPageFeature.PageRecNavToolbar>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter
				x:Key="acpCustomViewCheckBoxVisibilityConverter" />
			<AcpUICommonNS:EditabilityConverter
				x:Key="editabilityConverter" />
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
			<AcpUICommonNS:AcpXamDataPresenterVisibilityConverter
				x:Key="acpXamDataPresenterVisibilityConverter" />
			<AcpUICommonNS:EditabilityInComparatorCustomModesConverter
				x:Key="editabilityInComparatorCustomModesConverter" />
			<ObjectDataProvider
				MethodName="GetRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetParentFeature">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2078</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetComparatorRecordset"
				ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}"
				x:Key="GetComparatorParentFeature">
				<ObjectDataProvider.MethodParameters>
					<sys:Int32>2078</sys:Int32>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
			<ObjectDataProvider
				MethodName="GetMPLConfiguration"
				ObjectType="{x:Type MPLConfigurationNS:MPLConfiguration}"
				x:Key="GetFeatureNode" />
			<AcpBLConverterNS:InvertBoolConverter
				x:Key="InvertBoolConverter" />
			<AcpUICommonNS:ClmVisibilityStausConverter
				x:Key="ClmVisibilityStatus" />
			<AcpUICommonNS:CellVisibilityStausConverter
				x:Key="CellVisibilityStatus" />
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="MplCfgGeneralMPLSelectMode_A8549CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 3-->
							<AcpUINS:AcpTableComboBox
								DisplayMemberPath="ItemName"
								SelectedValuePath="ItemName"
								ItemsSource="{Binding Path=Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549.Items, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								SelectedValue="{Binding Path=Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549_UIValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderMPLConfigurationGeneral}"
								MyBLObject="{Binding Path=Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpComboBox.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpComboBox.IsAcpEditable>
								<AcpUINS:AcpComboBox.IsAcpApplicable>
									<MultiBinding
										Converter="{StaticResource CellVisibilityStatus}">
										<MultiBinding.Bindings>
											<Binding
												Path="Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549_Visible"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
											<Binding
												Path="Record.DataItem.General.MplCfgGeneralMPLSelectMode_A8549_Applicable"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										</MultiBinding.Bindings>
									</MultiBinding>
								</AcpUINS:AcpComboBox.IsAcpApplicable>
							</AcpUINS:AcpTableComboBox>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type igcontrols:CellValuePresenter}"
				BasedOn="{StaticResource MyCellValuePresenter}"
				x:Key="MplCfgGeneralPresetMPLEntry_A8739CellStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<!--Unknown connection ID: 4-->
							<AcpUINS:AcpTableComboBox
								DisplayMemberPath="ItemName"
								SelectedValuePath="ItemName"
								ItemsSource="{Binding Path=Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739.Items, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								SelectedValue="{Binding Path=Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739_UIValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								MyExpander="{Binding ElementName=ExpanderMPLConfigurationGeneral}"
								MyBLObject="{Binding Path=Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}"
								IsAcpValid="{Binding Path=Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739_Valid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}}">
								<AcpUINS:AcpComboBox.IsAcpEditable>
									<MultiBinding
										Mode="OneWay"
										Converter="{StaticResource editabilityConverter}">
										<Binding
											Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
											Path="AppMode" />
										<Binding
											Path="Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739_Editable"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										<Binding
											Path="Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739"
											RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
									</MultiBinding>
								</AcpUINS:AcpComboBox.IsAcpEditable>
								<AcpUINS:AcpComboBox.IsAcpApplicable>
									<MultiBinding
										Converter="{StaticResource CellVisibilityStatus}">
										<MultiBinding.Bindings>
											<Binding
												Path="Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739_Visible"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
											<Binding
												Path="Record.DataItem.General.MplCfgGeneralPresetMPLEntry_A8739_Applicable"
												RelativeSource="{RelativeSource AncestorType={x:Type igcontrols:CellValuePresenter}}" />
										</MultiBinding.Bindings>
									</MultiBinding>
								</AcpUINS:AcpComboBox.IsAcpApplicable>
							</AcpUINS:AcpTableComboBox>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 5-->
		<AcpUINS:AcpXamDataPresenter
			Name="MPLConfigurationList"
			KeyboardNavigation.AcceptsReturn="True"
			Grid.Row="1">
			<AcpUINS:AcpXamDataPresenter.IsAcpVisible>
				<MultiBinding
					Converter="{StaticResource acpXamDataPresenterVisibilityConverter}"
					Mode="OneWay">
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppMode" />
					<Binding
						Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}"
						Path="AppHideMatches" />
					<Binding
						Source="{StaticResource GetParentFeature}"
						Path="_HasDiffs" />
					<Binding
						Path="IsAcpVisible"
						RelativeSource="{RelativeSource Self}" />
					<Binding
						Path="FieldLayouts[0].Fields[0].Visibility"
						RelativeSource="{RelativeSource Self}" />
				</MultiBinding>
			</AcpUINS:AcpXamDataPresenter.IsAcpVisible>
			<igcontrols:DataPresenterBase.FieldLayouts>
				<igcontrols:FieldLayout>
					<igcontrols:FieldLayout.Fields>
						<igcontrols:UnboundField
							Name="{x:Static ResourceNS:AcgResources.ID_MPLSELECTMODE}"
							BindingPath="General.MplCfgGeneralMPLSelectMode_A8549"
							BindingMode="OneWay"
							ToolTip="{Binding Path=Name, RelativeSource={RelativeSource Self}}"
							Visibility="{Binding Source={StaticResource GetFeatureNode}, Path=General.MplCfgGeneralMPLSelectMode_A8549_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource MplCfgGeneralMPLSelectMode_A8549CellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
						<igcontrols:UnboundField
							Name="{x:Static ResourceNS:AcgResources.ID_PRESETMPLENTRY}"
							BindingPath="General.MplCfgGeneralPresetMPLEntry_A8739"
							BindingMode="OneWay"
							ToolTip="{Binding Path=Name, RelativeSource={RelativeSource Self}}"
							Visibility="{Binding Source={StaticResource GetFeatureNode}, Path=General.MplCfgGeneralPresetMPLEntry_A8739_Visible, Converter={StaticResource BooleanToVisibility}}">
							<igcontrols:Field.Settings>
								<igcontrols:FieldSettings
									CellValuePresenterStyle="{StaticResource MplCfgGeneralPresetMPLEntry_A8739CellStyle}" />
							</igcontrols:Field.Settings>
						</igcontrols:UnboundField>
					</igcontrols:FieldLayout.Fields>
				</igcontrols:FieldLayout>
			</igcontrols:DataPresenterBase.FieldLayouts>
		</AcpUINS:AcpXamDataPresenter>
	</Grid>
</AcpUINS:AcpPageFeature>
