	<Style
		TargetType="{x:Type Button}"
		x:Key="{x:Static igEditors:XamMonthCalendar.TodayButtonStyleKey}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="Margin"
			Value="3" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="HorizontalAlignment"
			Value="Center" />
		<Setter
			Property="Command"
			Value="{x:Static igEditors:MonthCalendarCommands.Today}" />
		<Setter
			Property="Content">
			<Setter.Value>
				<MultiBinding
					Mode="OneWay"
					Converter="{StaticResource StrFormatConv}">
