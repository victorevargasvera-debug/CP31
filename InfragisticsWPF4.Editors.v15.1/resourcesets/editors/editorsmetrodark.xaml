	<Style
		TargetType="{x:Type ToggleButton}"
		x:Key="ComboEditor_DropDownButtonStyle">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="5,0,5,0" />
		<Setter
			Property="MinWidth"
			Value="30" />
		<Setter
			Property="MinHeight"
			Value="30" />
		<Setter
			Property="HorizontalAlignment"
			Value="Right" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="ButtonBase.ClickMode"
			Value="Press" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ToggleButton}">
					<Grid
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="30"
								SharedSizeGroup="ComboBoxButton" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Grid.ColumnSpan="2"
							Fill="{StaticResource TransparentBrush}" />
						<Path
							Name="glyph"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Width="10"
							Height="6"
							SnapsToDevicePixels="True"
							Fill="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}"
							Stretch="Fill"
							Data="M0,0 C0,0 7,0 7,0 C7,0 3.5,3.5 3.5,3.5 C3.5,3.5 0,0 0,0"
							Grid.Column="1" />
						<Rectangle
							Width="1"
							HorizontalAlignment="Left"
							Margin="-1,5,0,5"
							Fill="{StaticResource DropDownSeparatorFill}" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="FrameworkElement.Tag"
							Value="MouseOverControlTrue">
							<Setter
								TargetName="glyph"
								Property="Fill"
								Value="{StaticResource DropdownBtnGlyphHoverFill}" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<Setter
								TargetName="glyph"
								Property="Fill"
								Value="{StaticResource DropdownBtnGlyphPressedFill}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="ToggleButton.IsChecked"
									Value="False" />
								<Condition
