			Property="igEditors:CalendarItemGroup.ScrollNextButtonVisibility"
			Value="{Binding (igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemGroup.ScrollPreviousButtonVisibility"
			Value="{Binding (igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemGroup}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}">
						<DockPanel
							LastChildFill="True"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<igEditors:CalendarItemGroupTitle
								Name="groupTitle"
								DockPanel.Dock="Top"
								MinHeight="30" />
							<igEditors:CalendarItemAreaPanel />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Days">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding FirstDateOfGroup, ConverterParameter=y, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Months">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding FirstDateOfGroup, ConverterParameter=yyyy, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Years">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Decades">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Centuries">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.FirstDateOfGroup"
							Value="{x:Null}">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{x:Null}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemArea}"
		x:Key="CalendarItemAreaBase">
		<Setter
			Property="igEditors:CalendarItemArea.DayOfWeekHeaderVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DayOfWeekHeaderVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemArea.WeekNumberVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).WeekNumberVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemArea}"
					Triggers="">
					<AdornerDecorator>
						<Border
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True"
							Padding="{TemplateBinding Padding}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<ItemsControl
									Name="daysOfWeek"
									Grid.Column="1"
									Visibility="{TemplateBinding igEditors:DayOfWeekHeaderVisibility}"
									Focusable="False"
									Background="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}"
									Height="30"
									Margin="6,4"
									ItemsSource="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												igPrim:Rows="1"
												igPrim:Columns="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek.Count, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<igEditors:CalendarDayOfWeek
												DataContext="{Binding}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<igWindows:CardPanel
									Name="weekNumbers"
									Grid.Column="0"
									Margin="0,6"
									Grid.Row="1"
									Visibility="{TemplateBinding igEditors:WeekNumberVisibility}">
									<Border
										BorderThickness="0,0,1,0"
										Background="{StaticResource CalendarWeekNumberBaseBackground}"
										BorderBrush="{StaticResource CalendarWeekNumberBaseStroke}" />
									<igEditors:CalendarWeekNumber
										DataContext="52"
										Visibility="Hidden"
										IsHitTestVisible="False" />
									<ItemsControl
										Name="weekNumberItems"
										Focusable="False"
										Background="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}"
										ItemsSource="{Binding Path=WeekNumbers, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<igWindows:UniformGridEx
													igPrim:Rows="6"
													igPrim:Columns="1"
													igPrim:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<igEditors:CalendarWeekNumber
													DataContext="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</igWindows:CardPanel>
								<ItemsControl
									Name="itemsList"
									Margin="6"
									Grid.Column="1"
									Grid.Row="1"
									KeyboardNavigation.DirectionalNavigation="None"
									Focusable="False"
									BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.CalendarSeparatorStrokeKey}"
									BorderThickness="0"
									ItemsSource="{Binding Path=Items, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												igPrim:FirstColumn="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemColumnOffset, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:Rows="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemRows, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:Columns="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemColumns, RelativeSource={x:Static RelativeSource.Self}}" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
							</Grid>
						</Border>
					</AdornerDecorator>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemArea}"
		BasedOn="{StaticResource CalendarItemAreaBase}"
		x:Key="{x:Type igEditors:CalendarItemArea}">
		<Setter
			Property="Margin"
			Value="0,5,0,0" />
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMonthCalendar}"
		x:Key="{x:Type igEditors:XamMonthCalendar}">
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="FontSize"
			Value="14.667" />
		<Setter
			Property="FontFamily"
			Value="Segoe UI" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMonthCalendar}">
					<Border
						BorderThickness="1"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}"
						BorderBrush="{StaticResource CalendarBorderBrush}"
						Background="{StaticResource CalendarBackgroundBrush}">
						<DockPanel
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<Button
								DockPanel.Dock="Bottom"
								Style="{DynamicResource igEditors:XamMonthCalendar.TodayButtonStyleKey}"
								Visibility="{TemplateBinding igEditors:TodayButtonVisibility}" />
							<igEditors:CalendarItemGroupPanel
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
