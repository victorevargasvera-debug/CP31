								Value="{StaticResource RepeatBtnHoverBackgroundBrush}" />
						</Trigger>
						<Trigger
							Property="Thumb.IsDragging"
							Value="True">
							<Setter
								TargetName="ThumbBackground"
								Property="Fill"
