						<Rectangle
							Name="ThumbBackground"
							RadiusX="1"
							RadiusY="1"
							Margin="0"
							Stroke="{StaticResource RepeatBtnBorderBrush}"
							Fill="{StaticResource RepeatBtnNormalBackgroundBrush}" />
						<Path
							Width="7"
							Height="8"
							Data="M0,6 C0,6 0,7 0,7 C0,7 8,7 8,7 C8,7 8,6 8,6 C8,6 0,6 0,6 M0,4 C0,4 0,5 0,5 C0,5 8,5 8,5 C8,5 8,4 8,4 C8,4 0,4 0,4 M0,2 C0,2 0,3 0,3 C0,3 8,3 8,3 C8,3 8,2 8,2 C8,2 0,2 0,2 M0,0 C0,0 0,1 0,1 C0,1 8,1 8,1 C8,1 8,0 8,0 C8,0 0,0 0,0"
							RenderTransformOrigin="0.5,0.5"
							Stretch="Uniform"
