				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{x:Null}" />
				<Setter
					Property="BorderBrush"
					Value="{x:Null}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
