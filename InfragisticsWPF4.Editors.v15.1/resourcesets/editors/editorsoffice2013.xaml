								Command="{x:Static igEditors:MonthCalendarCommands.ScrollPreviousGroup}"
								Style="{DynamicResource igEditors:XamMonthCalendar.ScrollPreviousRepeatButtonStyleKey}"
								Visibility="{Binding ScrollPreviousButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}" />
							<RepeatButton
								Name="nextMonth"
								DockPanel.Dock="Right"
								Focusable="False"
								Command="{x:Static igEditors:MonthCalendarCommands.ScrollNextGroup}"
								Style="{DynamicResource igEditors:XamMonthCalendar.ScrollNextRepeatButtonStyleKey}"
								Visibility="{Binding ScrollNextButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}" />
							<Button
								Name="headerContent"
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								Focusable="False"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								Command="{x:Static igEditors:MonthCalendarCommands.ZoomOutCalendarMode}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Content="{TemplateBinding Content}"
								FontFamily="{TemplateBinding FontFamily}"
								FontSize="{TemplateBinding FontSize}"
								FontWeight="{TemplateBinding FontWeight}"
								Style="{StaticResource BorderlessButtonStyle}"
								CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="headerContent"
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarNavGlyphHoverFillKey}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemGroupTitle}"
		BasedOn="{StaticResource CalendarItemGroupTitleBase}"
		x:Key="{x:Type igEditors:CalendarItemGroupTitle}" />
	<Style
		TargetType="{x:Type igEditors:CalendarItemGroup}"
		x:Key="{x:Type igEditors:CalendarItemGroup}">
		<Setter
			Property="Background"
			Value="{StaticResource TransparentBrush}" />
		<Setter
			Property="igEditors:CalendarItemGroup.ScrollNextButtonVisibility"
			Value="{Binding (igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemGroup.ScrollPreviousButtonVisibility"
			Value="{Binding (igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemGroup}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}">
						<DockPanel
							LastChildFill="True"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<igEditors:CalendarItemGroupTitle
								Name="groupTitle"
								DockPanel.Dock="Top" />
							<igEditors:CalendarItemAreaPanel />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Days">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding FirstDateOfGroup, ConverterParameter=y, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Months">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding FirstDateOfGroup, ConverterParameter=yyyy, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Years">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Decades">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Centuries">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.FirstDateOfGroup"
							Value="{x:Null}">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{x:Null}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemArea}"
		x:Key="CalendarItemAreaBase">
		<Setter
			Property="igEditors:CalendarItemArea.DayOfWeekHeaderVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DayOfWeekHeaderVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemArea.WeekNumberVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).WeekNumberVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemArea}">
					<AdornerDecorator>
						<Border
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True"
							Padding="{TemplateBinding Padding}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<ItemsControl
									Name="daysOfWeek"
									Grid.Column="1"
									Visibility="{TemplateBinding igEditors:DayOfWeekHeaderVisibility}"
									Focusable="False"
									Background="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}"
									Margin="6,4,6,2"
									ItemsSource="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												igPrim:Rows="1"
												igPrim:Columns="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek.Count, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<igEditors:CalendarDayOfWeek
												DataContext="{Binding}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<igWindows:CardPanel
									Name="weekNumbers"
									Grid.Column="0"
									Margin="1,0"
									Grid.Row="1"
									Visibility="{TemplateBinding igEditors:WeekNumberVisibility}">
									<Border
										BorderThickness="0,0,1,0"
										Background="{StaticResource CalendarWeekNumberBaseBackgroundBrush}"
										BorderBrush="{StaticResource CalendarWeekNumberBaseBorderBrush}" />
									<igEditors:CalendarWeekNumber
										DataContext="52"
										Visibility="Hidden"
										IsHitTestVisible="False" />
									<ItemsControl
										Name="weekNumberItems"
										Focusable="False"
										ItemsSource="{Binding Path=WeekNumbers, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<igWindows:UniformGridEx
													igPrim:Rows="6"
													igPrim:Columns="1"
													igPrim:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<igEditors:CalendarWeekNumber
													DataContext="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</igWindows:CardPanel>
								<ItemsControl
									Name="itemsList"
									Grid.Column="1"
									Grid.Row="1"
									KeyboardNavigation.DirectionalNavigation="None"
									Focusable="False"
									BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.CalendarSeparatorStrokeKey}"
									BorderThickness="0"
									ItemsSource="{Binding Path=Items, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												igPrim:FirstColumn="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemColumnOffset, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:Rows="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemRows, RelativeSource={x:Static RelativeSource.Self}}"
												igPrim:Columns="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemColumns, RelativeSource={x:Static RelativeSource.Self}}" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
							</Grid>
						</Border>
					</AdornerDecorator>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemArea}"
		BasedOn="{StaticResource CalendarItemAreaBase}"
		x:Key="{x:Type igEditors:CalendarItemArea}">
		<Setter
			Property="Margin"
			Value="0,5,0,0" />
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMonthCalendar}"
		x:Key="{x:Type igEditors:XamMonthCalendar}">
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="FontSize"
			Value="12" />
		<Setter
			Property="FontFamily"
			Value="Segoe UI" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMonthCalendar}">
					<Border
						BorderThickness="0"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}"
						BorderBrush="{StaticResource CalendarBorderBrush}"
						Background="{StaticResource CalendarBackgroundBrush}">
						<DockPanel
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<Border
								Height="40"
								BorderThickness="0,1,0,0"
								DockPanel.Dock="Bottom"
								Visibility="{TemplateBinding igEditors:TodayButtonVisibility}"
								BorderBrush="{StaticResource CalendarSeparatorBorderBrush}">
								<Button
									DockPanel.Dock="Bottom"
									Style="{DynamicResource igEditors:XamMonthCalendar.TodayButtonStyleKey}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="5"
									Visibility="{TemplateBinding igEditors:TodayButtonVisibility}" />
							</Border>
							<igEditors:CalendarItemGroupPanel
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
