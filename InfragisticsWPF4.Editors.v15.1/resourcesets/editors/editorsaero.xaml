		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamComboEditor}"
		x:Key="{x:Type igEditors:XamComboEditor}">
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="2,2,2,2" />
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="igEditors:XamComboEditor.DropDownButtonStyle"
			Value="{StaticResource ComboEditor_DropDownButtonStyle}" />
		<Setter
			Property="igEditors:XamComboEditor.DropDownButtonDisplayMode"
			Value="Always" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamComboEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border
								Grid.Column="0"
								Padding="{TemplateBinding Padding}"
								Margin="1,0,0,0">
								<ContentPresenter
									Name="PART_Content"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									Content="{Binding Path=DisplayValue, RelativeSource={x:Static RelativeSource.TemplatedParent}, ConverterParameter={x:Static sys:String.Empty}, Mode=OneWay, Converter={StaticResource nullToParameterConverter}}" />
							</Border>
							<ToggleButton
								Name="PART_DropDownButton"
								Grid.Column="1"
								Focusable="False"
								Width="{DynamicResource SystemParameters.VerticalScrollBarWidthKey}"
								ClickMode="Press"
								Style="{TemplateBinding igEditors:DropDownButtonStyle}"
								Visibility="{TemplateBinding igEditors:DropDownButtonVisibility}"
								IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
								IsEnabled="{Binding Path=IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource complementConverter}}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:XamComboEditor.DisplayValueSource"
							Value="Value">
							<Setter
								TargetName="PART_Content"
								Value="{DynamicResource igEditors:XamComboEditor.DisplayValueTemplateKey}"
								Property="ContentTemplate" />
						</Trigger>
						<Trigger
							Property="igEditors:ValueEditor.IsEmbedded"
							Value="False">
							<Setter
								TargetName="MainBorder"
								Property="Border.CornerRadius"
								Value="2" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igEditors:ValueEditor.EditTemplate">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamComboEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<ComboBox
							Name="PART_FocusSite"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
							IsReadOnly="{TemplateBinding igEditors:ReadOnly}"
							Background="#00FFFFFF"
							BorderBrush="#00FFFFFF"
							BorderThickness="0,0,0,0"
							ContextMenu="{TemplateBinding ContextMenu}"
							Style="{TemplateBinding igEditors:ComboBoxStyle}"
							IsEditable="{TemplateBinding igEditors:IsEditable}"
							MaxDropDownHeight="{TemplateBinding igEditors:MaxDropDownHeight}"
							InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
							InputMethod.IsInputMethodEnabled="{TemplateBinding IsInputMethodEnabled}"
							IsDropDownOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
							SelectedValuePath="{Binding Path=ItemsProvider.ValuePath, RelativeSource={RelativeSource TemplatedParent}}"
							DisplayMemberPath="{Binding Path=ItemsProvider.DisplayMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
							igEditors:XamComboEditor.ComboEditor="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:ValueEditor.IsInEditMode"
							Value="True">
							<Setter
								Property="IsTabStop"
								Value="False" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{x:Null}" />
				<Setter
					Property="BorderBrush"
					Value="{x:Null}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="False">
				<Setter
					Property="Foreground"
					Value="#000000" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="UIElement.IsMouseOver"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.EditorsHottrackBorderFillKey}" />
			</MultiTrigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorBorderBrushKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId=TextEditorBackgroundDisabled, TypeInTargetAssembly={x:Type igEditors:XamTextEditor}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorForegroundKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<DataTemplate
		DataType="{x:Type igEditors:ComboBoxDataItem}"
		x:Key="{DataTemplateKey {x:Type igEditors:ComboBoxDataItem}}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Name="TextBlock"
				Grid.Column="1"
				Grid.Row="0"
				Text="{Binding Path=DisplayText}" />
			<Image
				Stretch="Uniform"
				StretchDirection="Both"
				Grid.Column="0"
				Grid.Row="0"
				Height="{Binding ElementName=TextBlock, Path=ActualHeight}"
				Source="{Binding Path=Image}" />
		</Grid>
	</DataTemplate>
	<Style
		TargetType="{x:Type igEditors:XamDateTimeEditor}"
		BasedOn="{StaticResource XamDateTimeEditorBaseStyle}"
		x:Key="{x:Type igEditors:XamDateTimeEditor}">
		<Setter
			Property="igEditors:XamDateTimeEditor.DropDownButtonDisplayMode"
			Value="Always" />
		<Setter
			Property="igEditors:XamDateTimeEditor.DropDownButtonStyle"
			Value="{StaticResource ComboEditor_DropDownButtonStyle}" />
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMaskedEditor}"
		x:Key="XamMaskedEditorBaseStyle">
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="igEditors:XamMaskedEditor.SpinButtonStyle"
			Value="{StaticResource spinButtonStyle}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMaskedEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel>
							<Grid
								Name="PART_SpinButtons"
								DockPanel.Dock="Right"
								Visibility="{TemplateBinding igEditors:SpinButtonVisibilityResolved}"
								Margin="0,1">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="*" />
									<RowDefinition
										Height="1" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>
								<RepeatButton
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									IsHitTestVisible="False"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.IncreaseGlyphKey}" />
								<RepeatButton
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									IsHitTestVisible="False"
									Grid.Row="2"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.DecreaseGlyphKey}" />
							</Grid>
							<igWindows:SimpleTextBlock
								Name="TextBlock"
								Margin="{TemplateBinding Padding}"
								Text="{TemplateBinding igEditors:DisplayText}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:ValueEditor.IsEmbedded"
							Value="False">
							<Setter
								Property="Padding"
								Value="4,2,4,2" />
							<Setter
								Property="igWindows:SimpleTextBlock.OptimizeWidthMeasurement"
								Value="False" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igEditors:ValueEditor.EditTemplate">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMaskedEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel>
							<Grid
								Name="PART_SpinButtons"
								DockPanel.Dock="Right"
								Visibility="{TemplateBinding igEditors:SpinButtonVisibilityResolved}"
								Margin="0,1">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="*" />
									<RowDefinition
										Height="1" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>
								<RepeatButton
									Name="spinUp"
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.IncreaseGlyphKey}" />
								<RepeatButton
									Name="spinDown"
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									Grid.Row="2"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.DecreaseGlyphKey}" />
							</Grid>
							<igWindows:CardPanel
								Name="PART_FocusSite">
								<igEditors:SectionsList
									Name="SectionsList"
									Margin="{TemplateBinding Padding}"
									Foreground="{TemplateBinding Foreground}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									FlowDirection="LeftToRight"
									InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
									InputMethod.IsInputMethodEnabled="{TemplateBinding IsInputMethodEnabled}"
									ItemsSource="{Binding Path=Sections, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
								<TextBox
									Name="PART_InputTextBox"
									Visibility="Collapsed"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Background="#00FFFFFF"
									BorderBrush="#00FFFFFF"
									BorderThickness="0,0,0,0"
									Foreground="{TemplateBinding Foreground}"
									InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
									TextAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource horizToTextAlignmentConverter}}" />
							</igWindows:CardPanel>
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:XamMaskedEditor.SpinButtonVisibilityResolved"
							Value="Visible">
							<Setter
								TargetName="spinUp"
								Value="{x:Static igEditors:MaskedEditorCommands.SpinUp}"
								Property="Command" />
							<Setter
								TargetName="spinDown"
								Value="{x:Static igEditors:MaskedEditorCommands.SpinDown}"
								Property="Command" />
						</Trigger>
						<Trigger
							Property="igEditors:ValueEditor.IsEmbedded"
							Value="False" />
						<Trigger
							Property="igEditors:ValueEditor.IsInEditMode"
							Value="True">
							<Setter
								Property="IsTabStop"
								Value="False" />
						</Trigger>
						<Trigger
							Property="igEditors:XamMaskedEditor.IsTextBoxEntryEnabled"
							Value="True">
							<Setter
								TargetName="SectionsList"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="PART_InputTextBox"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="True">
				<Setter
					Property="BorderThickness"
					Value="0" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{x:Null}" />
				<Setter
					Property="BorderBrush"
					Value="{x:Null}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="False">
				<Setter
					Property="Foreground"
					Value="{DynamicResource SystemColors.WindowTextBrushKey}" />
			</Trigger>
			<Trigger
				Property="igEditors:ValueEditor.IsInEditMode"
				Value="True">
				<Setter
					Property="FrameworkElement.FocusVisualStyle">
					<Setter.Value>
						<Style />
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorBorderBrushKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId=TextEditorBackgroundDisabled, TypeInTargetAssembly={x:Type igEditors:XamTextEditor}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorForegroundKey}" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="UIElement.IsMouseOver"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.EditorsHottrackBorderFillKey}" />
			</MultiTrigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMaskedEditor}"
		BasedOn="{StaticResource XamMaskedEditorBaseStyle}"
		x:Key="{x:Type igEditors:XamMaskedEditor}" />
	<Style
		TargetType="{x:Type igEditors:XamNumericEditor}"
		BasedOn="{StaticResource {x:Type igEditors:XamMaskedEditor}}"
		x:Key="{x:Type igEditors:XamNumericEditor}" />
	<Style
		TargetType="{x:Type igEditors:XamCurrencyEditor}"
		BasedOn="{StaticResource {x:Type igEditors:XamMaskedEditor}}"
		x:Key="{x:Type igEditors:XamCurrencyEditor}" />
