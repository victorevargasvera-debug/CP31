<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igWindows="http://infragistics.com/Windows" xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors" xmlns:luna="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:igThemes="http://infragistics.com/Themes" xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="EditorsLunaNormal.xaml" />
		<ResourceDictionary
			Source="../EditorsBrushes/EditorsPrintBasic_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<ControlTemplate
		TargetType="{x:Type igEditors:CalendarItem}"
		x:Key="CalendarItemInner">
		<Border
			Name="OuterBorder"
			SnapsToDevicePixels="True"
			HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
			VerticalAlignment="{TemplateBinding VerticalAlignment}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			CornerRadius="{DynamicResource igEditors:CalendarItem.CornerRadiusKey}"
			Background="{TemplateBinding Background}">
			<Border
				Name="InnerBorder"
				BorderThickness="1"
				CornerRadius="{Binding Path=CornerRadius, ElementName=OuterBorder}">
				<ContentPresenter
					HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
					VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					TextBlock.Foreground="{TemplateBinding Foreground}"
					Margin="{TemplateBinding Padding}" />
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="False" />
					<Condition
						Property="UIElement.IsMouseOver"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverFillKey}"
					Property="Background" />
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverForegroundKey}"
					Property="Foreground" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverFillKey}"
					Property="Background" />
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverForegroundKey}"
					Property="Foreground" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:CalendarItem.IsSelected"
				Value="True">
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemSelectedFillKey}"
					Property="Background" />
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemSelectedOuterBorderFillKey}"
					Property="BorderBrush" />
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemSelectedForegroundKey}"
					Property="Foreground" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsSelectionActive"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Value="{DynamicResource SystemColors.ControlLightBrushKey}"
					Property="Background" />
				<Setter
					Value="{DynamicResource SystemColors.WindowTextBrushKey}"
					Property="Foreground" />
			</MultiTrigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Value="{DynamicResource SystemColors.GrayTextBrushKey}"
					Property="Foreground" />
			</Trigger>
			<Trigger
				Property="igEditors:CalendarItem.IsToday"
				Value="True">
				<Setter
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayForegroundKey}"
					Property="Foreground" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type igEditors:CalendarItem}"
		x:Key="CalendarItemBase">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource SystemColors.WindowTextBrushKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Content"
			Value="{Binding Path=StartDate, ConverterParameter=MMM, RelativeSource={x:Static RelativeSource.Self}, Converter={StaticResource FormattableToStr}}" />
		<Setter
			Property="Padding"
			Value="4,1,4,1" />
		<Setter
			Property="Template"
			Value="{StaticResource CalendarItemInner}" />
		<Style.Triggers>
			<Trigger
				Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
				Value="Years">
				<Setter
					Property="Content"
					Value="{Binding Path=StartDate, ConverterParameter=yyyy, RelativeSource={x:Static RelativeSource.Self}, Converter={StaticResource FormattableToStr}}" />
			</Trigger>
			<Trigger
				Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
				Value="Decades">
				<Setter
					Property="Content">
					<Setter.Value>
						<MultiBinding
							ConverterParameter="{}{0:yyyy}-&#xA;{1:yyyy}"
							Converter="{StaticResource StrFormatConv}">
							<Binding
								Path="StartDate"
								RelativeSource="{x:Static RelativeSource.Self}" />
							<Binding
								Path="EndDate"
								RelativeSource="{x:Static RelativeSource.Self}" />
						</MultiBinding>
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger
				Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
				Value="Centuries">
				<Setter
					Property="Content">
					<Setter.Value>
						<MultiBinding
							ConverterParameter="{}{0:yyyy}-&#xA;{1:yyyy}"
							Converter="{StaticResource StrFormatConv}">
							<Binding
								Path="StartDate"
								RelativeSource="{x:Static RelativeSource.Self}" />
							<Binding
								Path="EndDate"
								RelativeSource="{x:Static RelativeSource.Self}" />
						</MultiBinding>
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger
				Property="igEditors:CalendarItem.IsToday"
				Value="True">
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayForegroundKey}" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="True" />
					<Condition
						Property="IsEnabled"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayFillKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayForegroundKey}" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="False" />
					<Condition
						Property="IsEnabled"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayFillKey}" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="True" />
					<Condition
						Property="UIElement.IsMouseOver"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverFillKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemHoverForegroundKey}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:CalendarItem.IsLeadingOrTrailingItem"
				Value="True">
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarOtherDayForegroundKey}" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:CalendarItem.IsToday"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsSelected"
						Value="True" />
					<Condition
						Property="igEditors:CalendarItem.IsLeadingOrTrailingItem"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayFillKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayTodayForegroundKey}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:CalendarItem.IsActive"
				Value="True">
				<Setter
					Property="KeyboardNavigation.IsTabStop"
					Value="True" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItem}"
		BasedOn="{StaticResource CalendarItemBase}"
		x:Key="{x:Type igEditors:CalendarItem}" />
	<Style
		TargetType="{x:Type igEditors:CalendarDay}"
		BasedOn="{StaticResource CalendarItemBase}"
		x:Key="CalendarDayBase">
		<Setter
			Property="Content"
			Value="{Binding Path=StartDate, ConverterParameter=%d, RelativeSource={x:Static RelativeSource.Self}, Converter={StaticResource FormattableToStr}}" />
		<Style.Triggers>
			<Trigger
				Property="igEditors:CalendarDay.IsWorkday"
				Value="True">
				<Setter
					Property="FontWeight"
					Value="Bold" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarDay}"
		BasedOn="{StaticResource CalendarDayBase}"
		x:Key="{x:Type igEditors:CalendarDay}" />
</ResourceDictionary>
