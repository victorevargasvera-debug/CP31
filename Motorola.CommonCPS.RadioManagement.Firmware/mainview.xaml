<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Firmware.FirmwareMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prism="http://www.codeplex.com/prism" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Firmware" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="uscFirmwares">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
		<KeyBinding
			Key="M"
			Modifiers="Control+Shift"
			Command="{Binding CommandProxy.PrepareImportFirmwaresCommand}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Firmware;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RegionToStringConverter
				x:Key="RegionToStringConverter" />
			<converters:SmaDateToStringConverter
				x:Key="SmaDateToStringConverter" />
			<converters:BoolToVisibilityConverter
				x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		BorderBrush="#FFD3D3D3"
		BorderThickness="1">
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrFirmwares"
			Margin="10"
			igDP:GroupByAreaLocation="None"
			AdditionalButtonVisibility="Visible"
			ContextMenu="{StaticResource CutCopyPasteDeleteContextMenu}"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			ImportCommand="{Binding CommandProxy.PrepareImportFirmwaresCommand}"
			DeleteCommand="{Binding CommandProxy.DeleteFirmwaresCommand}"
			infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
			infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
			CRUDToolBarVisibility="{Binding Path=CRUDToolbarVisibility, Converter={StaticResource BoolToVisibilityConverter}}">
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="Name"
							Label="{x:Static resourceRepository:Resources.General_Name}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Version"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Codeplug"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Codeplug}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.General_Product_Identifier}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="TargetModel"
							Label="{x:Static resourceRepository:Resources.Model}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Region"
							Label="{x:Static resourceRepository:Resources.RMC_Region_Title}"
							Converter="{StaticResource RegionToStringConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Size"
							Label="{x:Static resourceRepository:Resources.RMC_PM_SizeKB}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ImportTime"
							Label="{x:Static resourceRepository:Resources.RMC_PM_ImportedTime}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="References"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Radios}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ReferencesInTemplate"
							Label="{x:Static resourceRepository:Resources.RMC_PM_Template_Radios}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Comments"
							Label="{x:Static resourceRepository:Resources.General_Comments}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.ValueConstraint">
												<Setter.Value>
													<igEditors:ValueConstraint
														MaxLength="1024" />
												</Setter.Value>
											</Setter>
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RDate"
							Label="{x:Static resourceRepository:Resources.RMC_RDate}"
							Converter="{StaticResource SmaDateToStringConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
	</Border>
</UserControl>
