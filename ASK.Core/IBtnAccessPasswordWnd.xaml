<Window
	x:Class="ASK.Core.IBtnAccessPasswordWnd" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:res="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Width="400"
	Height="120" xmlns:core="clr-namespace:ASK.Core">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="55*" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			Margin="10,20,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 1-->
			<Label
				Name="a"
				Grid.Column="0"
				Margin="40,0,5,0"
				HorizontalAlignment="Left"
				Content="{x:Static res:Resources.Password_Id}" />
			<!--Unknown connection ID: 2-->
			<PasswordBox
				Name="b"
				Grid.Column="1"
				HorizontalAlignment="Left"
				Height="23"
				Width="180" />
		</Grid>
		<StackPanel
			Grid.Row="2"
			Orientation="Horizontal"
			HorizontalAlignment="Center"
			Margin="0,12,0,0">
			<!--Unknown connection ID: 3-->
			<Button
				Name="c"
				IsDefault="True"
				Height="23"
				Width="80"
				Margin="10,0,0,0"
				Content="{x:Static res:Resources.OK_Id}" />
			<!--Unknown connection ID: 4-->
			<Button
				Name="d"
				IsEnabled="True"
				Height="23"
				Width="80"
				Margin="10,0,0,0"
				IsCancel="True"
				Content="{x:Static res:Resources.Cancel_Id}" />
		</StackPanel>
	</Grid>
</Window>
