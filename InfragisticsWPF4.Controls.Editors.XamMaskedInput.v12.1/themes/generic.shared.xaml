<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Infragistics.Controls.Editors" xmlns:localPrim="clr-namespace:Infragistics.Controls.Editors.Primitives" xmlns:ig="http://schemas.infragistics.com/xaml" xmlns:igBase="clr-namespace:Infragistics.Controls" xmlns:igPrim="http://schemas.infragistics.com/xaml/primitives" xmlns:igPrimLocal="clr-namespace:Infragistics.Controls.Primitives" xmlns:igEditors="clr-namespace:Infragistics.Controls.Editors" xmlns:igEditorsPrim="clr-namespace:Infragistics.Controls.Editors.Primitives" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<LinearGradientBrush
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="SilverlightDarkBrush">
		<GradientStop
			Color="#FFA3AEB9"
			Offset="0" />
		<GradientStop
			Color="#FF8399A9"
			Offset="0.375" />
		<GradientStop
			Color="#FF718597"
			Offset="0.375" />
		<GradientStop
			Color="#FF617584"
			Offset="1" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#FF6DBDD1"
		x:Key="FocusBorderFillKey" />
	<igEditorsPrim:HorizontalToTextAlignmentConverter
		x:Key="horizToTextAlignmentConverter" />
	<DataTemplate
		x:Key="IncreaseGlyphKey">
		<Path
			Width="7"
			Height="4"
			Data="M0,3 C0,3 0,4 0,4 C0,4 3,4 3,4 C3,4 3,3 3,3 C3,3 4,3 4,3 C4,3 4,4 4,4 C4,4 7,4 7,4 C7,4 7,3 7,3 C7,3 6,3 6,3 C6,3 6,2 6,2 C6,2 5,2 5,2 C5,2 5,1 5,1 C5,1 4,1 4,1 C4,1 4,0 4,0 C4,0 3,0 3,0 C3,0 3,1 3,1 C3,1 2,1 2,1 C2,1 2,2 2,2 C2,2 1,2 1,2 C1,2 1,3 1,3 C1,3 0,3 0,3"
			Fill="#FF000000" />
	</DataTemplate>
	<DataTemplate
		x:Key="DecreaseGlyphKey">
		<Path
			Width="7"
			Height="4"
			Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1"
			Fill="#FF000000" />
	</DataTemplate>
	<Style
		TargetType="{x:Type RepeatButton}"
		x:Key="spinButtonStyle">
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="3,1" />
		<Setter
			Property="IsTabStop"
			Value="False" />
		<Setter
			Property="igPrim:XamlHelper.Focusable"
			Value="False" />
	</Style>
	<Style
		TargetType="{x:Type TextBox}"
		x:Key="maskedInputTextBoxStyle">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="0" />
	</Style>
	<Style
		TargetType="{x:Type local:XamMaskedInput}"
		x:Key="MaskedInputStyle">
		<Setter
			Property="Background"
			Value="#FFFFFFFF" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Setter
			Property="igPrim:XamlHelper.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="local:XamMaskedInput.SpinButtonStyle"
			Value="{StaticResource spinButtonStyle}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource SilverlightDarkBrush}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:XamMaskedInput}">
					<Border
						Name="MainBorder">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="MouseOver">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="OverBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="PART_InputTextBox">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="0.25" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Normal" />
								<VisualState
									x:Name="ReadOnly" />
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="FocusStates">
								<VisualState
									x:Name="Unfocused" />
								<VisualState
									x:Name="Focused">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="OverBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Border
								Name="BgBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Grid.ColumnSpan="1"
								Visibility="Visible"
								CornerRadius="2"
								Margin="0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid>
										<igEditorsPrim:MaskedInputTextBox
											Name="PART_InputTextBox"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
											VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
											Foreground="{TemplateBinding Foreground}"
											InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
											Margin="{TemplateBinding Padding}"
											VerticalAlignment="Stretch"
											igPrim:XamlHelper.Focusable="{TemplateBinding igPrim:Focusable}"
											IsTabStop="{TemplateBinding IsTabStop}"
											Style="{StaticResource maskedInputTextBoxStyle}"
											TextAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, Converter={StaticResource horizToTextAlignmentConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
										<Border
											Name="OverBorder"
											BorderThickness="1"
											CornerRadius="1"
											Opacity="0"
											Grid.ColumnSpan="2"
											BorderBrush="{StaticResource FocusBorderFillKey}" />
									</Grid>
									<Grid
										Name="PART_SpinButtons"
										Column="1"
										Visibility="{TemplateBinding local:SpinButtonVisibilityResolved}"
										Margin="1">
										<Grid.RowDefinitions>
											<RowDefinition
												Height="*" />
											<RowDefinition
												Height="1" />
											<RowDefinition
												Height="*" />
										</Grid.RowDefinitions>
										<RepeatButton
											Name="spinUp"
											Style="{TemplateBinding local:SpinButtonStyle}"
											ContentTemplate="{StaticResource IncreaseGlyphKey}">
											<ig:Commanding.Command>
												<igEditorsPrim:MaskedInputCommandSource
													ig:EventName="Click"
													CommandId="SpinUp" />
											</ig:Commanding.Command>
										</RepeatButton>
										<RepeatButton
											Name="spinDown"
											Style="{TemplateBinding local:SpinButtonStyle}"
											Grid.Row="2"
											ContentTemplate="{StaticResource DecreaseGlyphKey}">
											<ig:Commanding.Command>
												<igEditorsPrim:MaskedInputCommandSource
													ig:EventName="Click"
													CommandId="SpinDown" />
											</ig:Commanding.Command>
										</RepeatButton>
									</Grid>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type local:XamMaskedInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type local:XamMaskedInput}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
	</Style>
	<Style
		TargetType="{x:Type local:XamNumericInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type local:XamNumericInput}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Right" />
	</Style>
	<Style
		TargetType="{x:Type local:XamCurrencyInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type local:XamCurrencyInput}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Right" />
	</Style>
</ResourceDictionary>
