<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMWaitingIndicator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls"
	Name="RmWaitingIndicator">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type Canvas}"
				x:Key="CanvasStyle">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
			</Style>
			<Style
				TargetType="{x:Type Rectangle}"
				x:Key="RectangleStyle">
				<Setter
					Property="Width"
					Value="35" />
				<Setter
					Property="Height"
					Value="100" />
				<Setter
					Property="Canvas.Left"
					Value="190" />
				<Setter
					Property="Canvas.Top"
					Value="0" />
				<Setter
					Property="Rectangle.RadiusX"
					Value="10" />
				<Setter
					Property="Rectangle.RadiusY"
					Value="10" />
			</Style>
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="PercentsStyle">
				<Setter
					Property="FontSize"
					Value="20" />
				<Setter
					Property="BorderThickness"
					Value="0" />
				<Setter
					Property="BorderBrush"
					Value="#00FFFFFF" />
				<Setter
					Property="TextBoxBase.IsReadOnly"
					Value="True" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Background="#02FFFFFF">
		<Viewbox
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Height="50"
			Width="50">
			<Canvas
				RenderTransformOrigin="0.5,0.5"
				Style="{StaticResource CanvasStyle}"
				Width="400"
				Height="400">
				<Viewbox
					Canvas.Left="120"
					Canvas.Top="139"
					Height="118"
					Width="155">
					<!--Unknown connection ID: 2-->
					<TextBox
						Name="PercentsTextBox"
						Style="{StaticResource PercentsStyle}"
						Text="0%"
						Background="{x:Null}"
						Visibility="{Binding Path=PercentVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:RMWaitingIndicator}}}" />
				</Viewbox>
				<!--Unknown connection ID: 3-->
				<Canvas
					Name="RotationCanvas"
					RenderTransformOrigin="0.5,0.5"
					Style="{StaticResource CanvasStyle}">
					<Rectangle
						Style="{StaticResource RectangleStyle}"
						Opacity="0.08"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}" />
					<Rectangle
						Opacity="0.16"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="30"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.26"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="60"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.34"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="90"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.42"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="120"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.5"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="150"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.58"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="180"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.66"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="210"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.76"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="240"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.84"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="270"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Opacity="0.92"
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="300"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<Rectangle
						Style="{StaticResource RectangleStyle}"
						Fill="{Binding ProgressBrush, ElementName=RmWaitingIndicator, FallbackValue=AliceBlue}">
						<UIElement.RenderTransform>
							<RotateTransform
								Angle="330"
								CenterX="10"
								CenterY="200" />
						</UIElement.RenderTransform>
					</Rectangle>
					<UIElement.RenderTransform>
						<!--Unknown connection ID: 4-->
						<RotateTransform
							x:Name="SpinnerRotate"
							Angle="0"
							CenterX="200"
							CenterY="200" />
					</UIElement.RenderTransform>
				</Canvas>
			</Canvas>
		</Viewbox>
	</Border>
</UserControl>
