<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.ProgressIndicator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type Ellipse}"
				x:Key="EllipseStyle">
				<Style.Setters>
					<Setter
						Property="Width"
						Value="3" />
					<Setter
						Property="Height"
						Value="3" />
					<Setter
						Property="Margin"
						Value="5" />
					<Setter
						Property="Fill"
						Value="#FF000000" />
				</Style.Setters>
			</Style>
			<Storyboard
				x:Key="elementStoryboard">
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="(UIElement.Opacity)">
					<EasingDoubleKeyFrame
						KeyTime="0:0:0"
						Value="1" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.25"
						Value="0.5" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.5"
						Value="0" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.75"
						Value="0.5" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:1"
						Value="1" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<StackPanel
		Name="StackPanel"
		HorizontalAlignment="Center"
		Orientation="Horizontal">
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
		<Ellipse
			Style="{StaticResource EllipseStyle}" />
	</StackPanel>
</UserControl>
