<local:RMFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMFeatureSetsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<local:BindingProxy
				Data="{Binding Path=DataContext.Data, RelativeSource={RelativeSource AncestorType={x:Type local:RMFeatureSetsEditor}}}"
				x:Key="RadioBase" />
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<converters:ProductFamilyIdentifierToVisibilityConverter
				x:Key="ProductFamilyIdentifierToVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 1-->
		<local:RMDataGrid
			Name="dgrMismatchOptions"
			InitializeRecord="dgrMismatchOptions_InitializeRecord"
			Margin="10"
			MinHeight="200"
			MaxHeight="400"
			BorderBrush="{StaticResource BrushGray}"
			BorderThickness="1"
			igDP:GroupByAreaLocation="None"
			IsBindingViewCache="False"
			CustomizedTotalCount="{Binding Data.UIRadioFeatureSet}"
			igDP:DataSource="{Binding Data.UIRadioFeatureSet, Converter={StaticResource GridViewSourceConverter}}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto"
					LabelClickAction="Nothing" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							BindingType="Unbound">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource MissmatchCellValuePresenterStyle}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureName"
							Label="{x:Static resourceRepository:Resources.RMC_Model_FeatureOptionStatus_FeatureName}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
											<Setter
												Property="FrameworkElement.ToolTip"
												Value="{Binding DataItem.Tooltips}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureStatus"
							Label="{x:Static resourceRepository:Resources.RMC_Model_FeatureOptionStatus_FeatureStatus}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
											<Setter
												Property="FrameworkElement.ToolTip"
												Value="{Binding DataItem.Tooltips}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureCounts"
							Label="{x:Static resourceRepository:Resources.RMC_Model_FeatureOptionStatus_FeatureCounts}"
							Visibility="{Binding Source={StaticResource RadioBase}, Path=Data.ProductFamily, Converter={StaticResource ProductFamilyIdentifierToVisibilityConverter}}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
											<Setter
												Property="FrameworkElement.ToolTip"
												Value="{Binding DataItem.Tooltips}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</local:RMDataGrid>
	</Grid>
</local:RMFieldEditor>
