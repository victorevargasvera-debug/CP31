<local:RMFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMCollectionSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls"
	Height="24">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="2*" />
			<ColumnDefinition
				Width="0.1*" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<local:RMTextBlock
			Text="{Binding Path=Label, RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}" />
	</Grid>
</local:RMFieldEditor>
