<local:RMCellPresentableFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMListFieldEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="fedList"
	DataContextChanged="fedList_DataContextChanged"
	Height="Auto">
	<!--Unknown connection ID: 2-->
	<Grid
		Name="grdMain">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="1*" />
			<ColumnDefinition
				Width="0.05*" />
			<ColumnDefinition />
			<ColumnDefinition
				Width="21" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 3-->
		<local:RMTextBlock
			Name="tblLabel"
			Style="{StaticResource FieldEditorTextBlockStyle}"
			Text="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}"
			AutomationProperties.ItemStatus="{Binding Path=Foreground, RelativeSource={RelativeSource Self}}" />
		<Grid
			Column="2">
			<!--Unknown connection ID: 4-->
			<local:RMComboBox
				Name="cbbList"
				SelectionChanged="cbbList_SelectionChanged"
				GotFocus="cbbList_GotFocus"
				MaxDropDownHeight="350"
				ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
				ItemTemplate="{StaticResource ComboBoxItemTemplate}"
				Style="{StaticResource FieldEditorComboBoxStyle}"
				ItemsSource="{Binding Items}"
				SelectedIndex="{Binding SelectedIndex, Delay=50}"
				AutomationProperties.ItemStatus="{Binding IsValid}">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource FieldPropertiesToIsEnableConverter}">
						<Binding
							Path="IsEditable" />
						<Binding
							Path="IsMVODynamic" />
						<Binding
							Path="UseMVODefault" />
					</MultiBinding>
				</UIElement.IsEnabled>
			</local:RMComboBox>
			<!--Unknown connection ID: 5-->
			<Border
				Name="borderfreeze"
				Background="#00FFFFFF"
				Visibility="Collapsed" />
			<Border
				Background="{StaticResource BrushGray}"
				Visibility="{Binding Path=IsValueVisible, Converter={StaticResource BoolToVisibilityInverseConverter}}">
				<TextBlock
					Text="{x:Static resourceRepository:Resources.RMC_Tooltip_MVOdefaultvalueAssigned}"
					VerticalAlignment="Center"
					HorizontalAlignment="Center" />
			</Border>
		</Grid>
		<!--Unknown connection ID: 6-->
		<local:RMButton
			Name="btnLock"
			Click="btnLock_Click"
			Grid.Column="3"
			Margin="1,0,0,0"
			Width="20"
			IsEnabled="{Binding IsEditable}"
			Visibility="{Binding Path=IsMVODynamic, Converter={StaticResource BoolToVisibilityConverter}}"
			Tag="{Binding UseMVODefault, Mode=TwoWay}">
			<Control.Template>
				<ControlTemplate>
					<Image>
						<Image.Source>
							<MultiBinding
								Converter="{StaticResource BoolToLockIconPathConverter}">
								<Binding
									Path="UseMVODefault" />
								<Binding
									Path="IsEditable" />
								<Binding
									RelativeSource="{RelativeSource Self}" />
							</MultiBinding>
						</Image.Source>
					</Image>
				</ControlTemplate>
			</Control.Template>
		</local:RMButton>
	</Grid>
</local:RMCellPresentableFieldEditor>
