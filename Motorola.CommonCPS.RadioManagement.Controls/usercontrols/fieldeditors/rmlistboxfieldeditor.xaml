<local:RMRelocatableFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMListBoxFieldEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Themes/Generic.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:SetsCountToVisibilityConverter
				x:Key="SetsCountToVisibilityConverter" />
			<Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource DataGridButtonStyle}"
				x:Key="ButtonDeleteStyle">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type Button}">
							<Grid>
								<Rectangle
									Name="rectangle"
									Fill="{StaticResource CRUDButtonNormal}" />
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition
											Height="1*" />
										<RowDefinition
											Name="iconRow"
											Height="3*" />
										<RowDefinition
											Height="1*" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="1*" />
										<ColumnDefinition
											Name="iconColumn"
											Width="3*" />
										<ColumnDefinition
											Width="1*" />
									</Grid.ColumnDefinitions>
									<ContentPresenter
										Grid.Row="1"
										Grid.Column="1"
										Content="{StaticResource IconDelete}" />
								</Grid>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsFocused"
									Value="True" />
								<Trigger
									Property="Button.IsDefaulted"
									Value="True" />
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="rectangle"
										Property="Fill"
										Value="{StaticResource CRUDButtonOver}" />
								</Trigger>
								<Trigger
									Property="IsPressed"
									Value="True">
									<Setter
										TargetName="rectangle"
										Property="Fill"
										Value="{StaticResource CRUDButtonPressed}" />
									<Setter
										TargetName="iconRow"
										Property="Height"
										Value="2*" />
									<Setter
										TargetName="iconColumn"
										Property="Width"
										Value="2*" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="rectangle"
										Property="Fill"
										Value="{StaticResource CRUDButtonDisabled}" />
									<Setter
										Property="Foreground"
										Value="{StaticResource CRUDButtonDisabledForeground}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type local:RMAnchor}"
				x:Key="anchorNoBorderStyle">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<ContentPresenter
								Content="{TemplateBinding Content}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<Border
		Name="borderInvalid"
		BorderThickness="1"
		Style="{StaticResource InvalidBorderStyle}"
		Margin="0,0,0,10">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 2-->
			<local:RMAnchor
				Name="rarsetEditor"
				Style="{StaticResource anchorNoBorderStyle}"
				Caption="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}}">
				<UIElement.Visibility>
					<MultiBinding
						Converter="{StaticResource SetsCountToVisibilityConverter}">
						<Binding
							Path="EmbeddedSetCategory.Sets.Count"
							RelativeSource="{RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}" />
						<Binding
							Path="EmbeddedSetCategory.Sets"
							RelativeSource="{RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}" />
					</MultiBinding>
				</UIElement.Visibility>
				<!--Unknown connection ID: 3-->
				<ItemsControl
					Name="iclSets"
					Grid.Row="1"
					VerticalAlignment="Center"
					Height="Auto"
					Width="Auto"
					Grid.IsSharedSizeScope="True"
					AllowDrop="False"
					ScrollViewer.VerticalScrollBarVisibility="Hidden"
					ScrollViewer.CanContentScroll="False"
					ScrollViewer.HorizontalScrollBarVisibility="Hidden"
					ScrollViewer.IsDeferredScrollingEnabled="True"
					ItemsSource="{Binding EmbeddedSetCategory.Sets, RelativeSource={RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}}" />
			</local:RMAnchor>
			<Grid
				Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 4-->
				<Button
					Name="btnAdd"
					Style="{StaticResource DataGridButtonStyle}"
					Content="{StaticResource IconAdd}"
					HorizontalAlignment="Left"
					Padding="0"
					Command="{Binding Path=SetPresenter.AddEmbeddedSetCommand, RelativeSource={RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}}"
					CommandParameter="{Binding Path=EmbeddedSetCategory, RelativeSource={RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}}" />
				<local:RMTextBlock
					Grid.Column="1"
					Margin="5,0,0,0"
					VerticalAlignment="Center"
					Text="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:RMListBoxFieldEditor}}}" />
			</Grid>
		</Grid>
	</Border>
</local:RMRelocatableFieldEditor>
