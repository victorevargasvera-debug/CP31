<local:RMCellPresentableFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMPasswordFieldEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="fedPassword"
	Height="Auto">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<local:BoolToLockIconPathConverter
				x:Key="BoolToLockIconPathConverter" />
			<local:StringFieldInfoInsertedToMaskConverter
				x:Key="StringFieldInfoInsertedToMaskConverter" />
			<local:FieldPropertiesToIsEnableConverter
				x:Key="FieldPropertiesToIsEnableConverter" />
			<Style
				BasedOn="{StaticResource PasswordStyle}"
				TargetType="{x:Type igEditors:XamMaskedEditor}"
				x:Key="PasswordEditorStyle">
				<Style.Triggers>
					<DataTrigger
						Value="False"
						Binding="{Binding Path=IsValid, RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}">
						<Setter
							Property="Foreground"
							Value="{StaticResource Brush_Invalid}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 2-->
	<Grid
		Name="grdMain">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="1*" />
			<ColumnDefinition
				Width="0.05*" />
			<ColumnDefinition />
			<ColumnDefinition
				Width="21" />
		</Grid.ColumnDefinitions>
		<local:RMTextBlock
			Style="{StaticResource FieldEditorTextBlockStyle}"
			Text="{Binding Path=Label, RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}"
			IsEnabled="{Binding IsApplicable}" />
		<!--Unknown connection ID: 3-->
		<Border
			Name="borderInvalid"
			Grid.Column="2"
			BorderThickness="1"
			Style="{StaticResource InvalidBorderStyle}">
			<Grid>
				<!--Unknown connection ID: 4-->
				<local:RMPasswordBox
					Name="msiPassword"
					Password="{Binding Path=Text, UpdateSourceTrigger=LostFocus}"
					IsShowingEyeButton="{Binding Path=IsShowingEyeButton, RelativeSource={RelativeSource AncestorType={x:Type local:RMPasswordFieldEditor}}}">
					<UIElement.IsEnabled>
						<MultiBinding
							Converter="{StaticResource FieldPropertiesToIsEnableConverter}">
							<Binding
								Path="IsEditable" />
							<Binding
								Path="IsMVODynamic" />
							<Binding
								Path="UseMVODefault" />
						</MultiBinding>
					</UIElement.IsEnabled>
					<local:RMPasswordBox.Mask>
						<MultiBinding
							Converter="{StaticResource StringFieldInfoInsertedToMaskConverter}">
							<Binding
								ElementName="fedPassword"
								Path="Mask" />
							<Binding
								Path="MaxLength" />
						</MultiBinding>
					</local:RMPasswordBox.Mask>
				</local:RMPasswordBox>
				<!--Unknown connection ID: 5-->
				<Border
					Name="borderfreeze"
					Background="#00FFFFFF"
					Visibility="Collapsed" />
				<Border
					Background="{StaticResource BrushGray}"
					Visibility="{Binding Path=IsValueVisible, Converter={StaticResource BoolToVisibilityInverseConverter}}">
					<TextBlock
						Text="{x:Static resourceRepository:Resources.RMC_Tooltip_MVOdefaultvalueAssigned}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center" />
				</Border>
			</Grid>
		</Border>
		<!--Unknown connection ID: 6-->
		<local:RMButton
			Name="btnLock"
			Click="btnLock_Click"
			Grid.Column="3"
			Margin="1,0,0,0"
			Width="20"
			IsEnabled="{Binding IsEditable}"
			Visibility="{Binding Path=IsMVODynamic, Converter={StaticResource BoolToVisibilityConverter}}"
			Tag="{Binding UseMVODefault, Mode=TwoWay}">
			<Control.Template>
				<ControlTemplate>
					<Image>
						<Image.Source>
							<MultiBinding
								Converter="{StaticResource BoolToLockIconPathConverter}">
								<Binding
									Path="UseMVODefault" />
								<Binding
									Path="IsEditable" />
								<Binding
									RelativeSource="{RelativeSource Self}" />
							</MultiBinding>
						</Image.Source>
					</Image>
				</ControlTemplate>
			</Control.Template>
		</local:RMButton>
	</Grid>
</local:RMCellPresentableFieldEditor>
