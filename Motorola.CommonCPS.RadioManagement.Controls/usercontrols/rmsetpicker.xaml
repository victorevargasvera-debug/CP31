<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMSetPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="20" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<local:RMButton
				Content="{x:Static resourceRepository:Resources.General_OK}" />
			<local:RMButton
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.General_Cancel}" />
		</Grid>
	</Grid>
</UserControl>
