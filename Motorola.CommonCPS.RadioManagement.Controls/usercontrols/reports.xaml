<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.Reports" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:igDock="http://infragistics.com/DockManager" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:rr="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
		<KeyBinding
			Gesture="CTRL+P"
			Command="{Binding PrintReportCommand}"
			CommandParameter="{Binding ElementName=wbReports}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Background="{StaticResource MainWindowBackgroundColor}">
		<!--Unknown connection ID: 1-->
		<igDock:XamDockManager
			Name="dmgDockManager"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			FlyoutAnimation="None"
			Background="#00FFFFFF"
			Theme="IGTheme"
			UnpinnedTabHoverAction="None">
			<igDock:XamDockManager.Panes>
				<igDock:SplitPane
					Width="350"
					MaxWidth="600"
					MinWidth="250">
					<!--Unknown connection ID: 2-->
					<igDock:ContentPane
						Name="cpnReportsList"
						Margin="0,0,10,0"
						Header="{x:Static rr:Resources.RMC_Radio_ReportList_Header}"
						AllowClose="False"
						AllowDocking="False"
						AllowFloatingOnly="False"
						CloseButtonVisibility="Collapsed"
						WindowPositionMenuVisibility="Collapsed">
						<!--Unknown connection ID: 3-->
						<ListBox
							Name="ReportsOptionsListBox"
							Grid.Column="0"
							Style="{StaticResource IGListBoxStyle}"
							SelectedIndex="0"
							ItemsSource="{Binding ReportTypeSelections}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<controls:RMTextBlock
										Margin="2"
										Text="{Binding Name}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ListBox>
					</igDock:ContentPane>
				</igDock:SplitPane>
			</igDock:XamDockManager.Panes>
			<!--Unknown connection ID: 4-->
			<igDock:XamDockManager
				Name="dmgDockManagerReport"
				FlyoutAnimation="None"
				Background="#00FFFFFF"
				Theme="IGTheme"
				UnpinnedTabHoverAction="None">
				<Border
					Background="#FFFFFFFF"
					BorderBrush="#FFD3D3D3"
					BorderThickness="1">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<WrapPanel
							Grid.Row="0"
							HorizontalAlignment="Right"
							Margin="0,10,10,10">
							<Button
								Style="{StaticResource EditorButtonStyle}"
								Content="{x:Static rr:Resources.General_Print}"
								Command="{Binding PrintReportCommand}"
								CommandParameter="{Binding ElementName=wbReports}" />
							<Button
								Style="{StaticResource EditorButtonStyle}"
								Content="{x:Static rr:Resources.RMC_Action_Save}"
								Command="{Binding SaveReportCommand}" />
						</WrapPanel>
						<!--Unknown connection ID: 5-->
						<WebBrowser
							Name="wbReports"
							Grid.Row="1"
							AllowDrop="False"
							controls:WebBrowserUtility.BindableSource="{Binding HtmlSource}" />
					</Grid>
				</Border>
			</igDock:XamDockManager>
		</igDock:XamDockManager>
	</Border>
</UserControl>
