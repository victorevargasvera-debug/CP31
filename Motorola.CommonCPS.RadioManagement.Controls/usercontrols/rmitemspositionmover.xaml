<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMItemsPositionMover" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls"
	Name="itemsMover">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 2-->
		<ListView
			Name="lbItems"
			AllowDrop="True"
			Width="200"
			ItemsSource="{Binding Items}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Label
						Content="{Binding Name}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListView>
		<Grid
			Column="1"
			Width="100">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 3-->
			<local:RMButton
				Name="btnUp"
				Click="btnUp_Click"
				Width="30"
				VerticalAlignment="Bottom">
				<Path
					Fill="#FFFFFFFF"
					Data="M0,6 L12,6 L6,0" />
			</local:RMButton>
			<!--Unknown connection ID: 4-->
			<local:RMButton
				Name="btnDown"
				Click="btnDown_Click"
				Grid.Row="2"
				Width="30"
				VerticalAlignment="Top">
				<Path
					Fill="#FFFFFFFF"
					Data="M0,0 L6,6 L12,0" />
			</local:RMButton>
		</Grid>
	</Grid>
</UserControl>
