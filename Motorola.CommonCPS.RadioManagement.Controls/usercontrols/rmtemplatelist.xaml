<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMTemplateList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:TemplateListWorkModeToBoolConverter
				x:Key="TemplateListWorkModeToBoolConverter" />
			<converters:StringValueToVisibilityConverter
				x:Key="StringValueToVisibilityConverter" />
			<converters:DMR3ProductFamilyToVALPEnable
				x:Key="DMR3ProductFamilyToVALPEnable" />
			<local:LpErrorToForegroundConverter
				x:Key="LpErrorToForegroundConverter" />
			<converters:TrimValueConverter
				x:Key="TrimValueConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 2-->
		<local:RMDataGrid
			Name="dgrTemplates"
			EditModeEnding="dgrTemplates_EditModeEnding"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			CRUDToolBarVisibility="Visible"
			AutoSaveCustomizations="True"
			igDP:DataSource="{Binding Path=Templates, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
			SearchCommand="{Binding SearchCommand}"
			AddCommand="{Binding Path=AddTemplatesCommand, RelativeSource={RelativeSource AncestorType={x:Type local:RMTemplateList}}}"
			DeleteCommand="{Binding Path=DeleteTemplatesCommand, RelativeSource={RelativeSource AncestorType={x:Type local:RMTemplateList}}}"
			EditCommand="{Binding Path=EditTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type local:RMTemplateList}}}"
			ContextMenu="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RMTemplateList}}}">
			<igDP:DataPresenterBase.FieldLayoutSettings>
				<igDP:FieldLayoutSettings
					HighlightAlternateRecords="True"
					AllowClipboardOperations="Copy"
					AllowDelete="False"
					AllowFieldMoving="WithinLogicalRow"
					AutoGenerateFields="False"
					CopyFieldLabelsToClipboard="False"
					DataErrorDisplayMode="ErrorIconAndHighlight"
					SupportDataErrorInfo="CellsOnly" />
			</igDP:DataPresenterBase.FieldLayoutSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="Name"
							Label="{x:Static resourceRepository:Resources.General_Template}"
							Converter="{StaticResource TrimValueConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="{Binding Path=WorkMode, Converter={StaticResource TemplateListWorkModeToBoolConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
											<Setter
												Property="igEditors:ValueEditor.ValueConstraint">
												<Setter.Value>
													<igEditors:ValueConstraint
														MaxLength="320" />
												</Setter.Value>
											</Setter>
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.General_Model_Number}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FirmwareVersion"
							Label="{x:Static resourceRepository:Resources.RMC_Template_FWVersion}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="LanguagePacksInfo"
							Label="{x:Static resourceRepository:Resources.General_LanguagePacks}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
									<igDP:FieldSettings.CellValuePresenterStyle>
										<Style
											BasedOn="{StaticResource CellValuePresenterStyle}"
											TargetType="{x:Type igDP:CellValuePresenter}">
											<Style.Setters>
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate>
															<Border
																BorderThickness="{TemplateBinding BorderThickness}"
																BorderBrush="{TemplateBinding BorderBrush}"
																Background="{TemplateBinding Background}">
																<TextBlock
																	Margin="{TemplateBinding Padding}"
																	VerticalAlignment="Center"
																	HorizontalAlignment="Center"
																	Visibility="{Binding Path=DataRecord.DataItem.LanguagePacksInfo, Converter={StaticResource StringValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																	<local:RMHyperlink
																		Name="lbtDetails"
																		Command="{Binding Path=DataContext.PrepareShowTemplateLanguagePacksDetailInfoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
																		CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}"
																		Foreground="{Binding Path=DataRecord.DataItem.LPError, Converter={StaticResource LpErrorToForegroundConverter}, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}"
																		ToolTip="{Binding Path=DataRecord.DataItem.LPError, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																		<TextBlock
																			Text="{Binding Path=DataRecord.DataItem.LanguagePacksInfo, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
																	</local:RMHyperlink>
																</TextBlock>
															</Border>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style.Setters>
										</Style>
									</igDP:FieldSettings.CellValuePresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="VAFiles"
							Label="{x:Static resourceRepository:Resources.RMC_VoiceFiles}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
									<igDP:FieldSettings.CellValuePresenterStyle>
										<Style
											BasedOn="{StaticResource CellValuePresenterStyle}"
											TargetType="{x:Type igDP:CellValuePresenter}">
											<Style.Setters>
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate>
															<Border
																BorderThickness="{TemplateBinding BorderThickness}"
																BorderBrush="{TemplateBinding BorderBrush}"
																Background="{TemplateBinding Background}">
																<TextBlock
																	Margin="{TemplateBinding Padding}"
																	VerticalAlignment="Center"
																	HorizontalAlignment="Center"
																	Visibility="{Binding Path=DataRecord.DataItem.VAFiles, Converter={StaticResource StringValueToVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																	<local:RMHyperlink
																		Name="lbtDetails"
																		IsEnabled="{Binding Path=DataRecord.DataItem.ProductFamily, Converter={StaticResource DMR3ProductFamilyToVALPEnable}, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}"
																		Command="{Binding Path=DataContext.PrepareShowTemplateVADetailInfoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
																		CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																		<TextBlock
																			Text="{Binding Path=DataRecord.DataItem.VAFiles, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
																	</local:RMHyperlink>
																</TextBlock>
															</Border>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style.Setters>
										</Style>
									</igDP:FieldSettings.CellValuePresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="CodeplugVersion"
							Label="{x:Static resourceRepository:Resources.JobHistory_Template_CPG_Version}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModifiedDate"
							Label="{x:Static resourceRepository:Resources.RMC_PM_ImportedTime}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioReferencedCount"
							Label="{x:Static resourceRepository:Resources.RMC_Referenced_Count}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="DVRSHashCode"
							Label="{x:Static resourceRepository:Resources.RMC_DVRSHashCode}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="DVRSFileVersion"
							Label="DVRS File Version">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:ComboBoxField
							Name="DVRSFile"
							Label="{x:Static resourceRepository:Resources.General_DVRS_File}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamComboEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="{Binding Path=WorkMode, Converter={StaticResource TemplateListWorkModeToBoolConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
											<Setter
												Property="igEditors:XamComboEditor.ItemsSource"
												Value="{Binding Path=DataRecord.DataItem.DVRSFiles, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
											<Setter
												Property="igEditors:XamComboEditor.DisplayMemberPath"
												Value="PackageName" />
											<Setter
												Property="IsEnabled"
												Value="{Binding Path=DataRecord.DataItem.IsSelected, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
											<Setter
												Property="igEditors:XamComboEditor.SelectedItem"
												Value="{Binding Path=DataRecord.DataItem.DVRSFile, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
											<Setter
												Property="igEditors:XamComboEditor.DropDownResizeMode"
												Value="None" />
											<Setter
												Property="Foreground"
												Value="{Binding Path=DataRecord.DataItem.DVRSFileError, Converter={StaticResource LpErrorToForegroundConverter}, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
											<Setter
												Property="FrameworkElement.ToolTip"
												Value="{Binding Path=DataRecord.DataItem.DVRSFileError, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:ComboBoxField>
						<igDP:Field
							Name="Comments"
							Label="{x:Static resourceRepository:Resources.General_Comments}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.ValueConstraint">
												<Setter.Value>
													<igEditors:ValueConstraint
														MaxLength="1024" />
												</Setter.Value>
											</Setter>
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="{Binding Path=WorkMode, Converter={StaticResource TemplateListWorkModeToBoolConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</local:RMDataGrid>
	</Grid>
</UserControl>
