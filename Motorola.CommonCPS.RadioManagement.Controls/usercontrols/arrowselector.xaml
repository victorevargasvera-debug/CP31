<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.ArrowSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type Button}"
				x:Key="{x:Type Button}">
				<Style.Triggers>
					<Trigger
						Property="UIElement.IsMouseOver"
						Value="True">
						<Setter
							Property="Background"
							Value="#FFFF0000" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 1-->
		<Button
			Name="tb"
			Content="-&gt;"
			Width="Auto" />
		<!--Unknown connection ID: 2-->
		<Popup
			Name="popup"
			StaysOpen="False">
			<!--Unknown connection ID: 3-->
			<ListBox
				Name="list"
				Height="300"
				ItemsSource="{Binding Path=Choices}" />
		</Popup>
	</Grid>
</UserControl>
