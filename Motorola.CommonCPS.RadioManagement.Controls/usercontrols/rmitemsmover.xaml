<local:RMCellPresentableFieldEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMItemsMover" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Name="itemsMover"
	DataContextChanged="UserControl_DataContextChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:BoolToSelectionModeConverter
				x:Key="BoolToSelectionModeConverter" />
			<local:ListFieldItemToForegroundConverter
				x:Key="ListFieldItemToForegroundConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="10"
		Height="380">
		<local:PushBindingManager.PushBindings>
			<local:PushBinding
				Path="IsUIControlVisible"
				TargetProperty="IsVisible" />
		</local:PushBindingManager.PushBindings>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="30" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="140" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="100" />
		</Grid.ColumnDefinitions>
		<Label
			Grid.Row="0"
			Grid.Column="0"
			Content="{Binding ElementName=itemsMover, Path=AvailableListBoxLabel}" />
		<Label
			Grid.Row="0"
			Grid.Column="2"
			Content="{Binding ElementName=itemsMover, Path=SelectedListBoxLabel}" />
		<!--Unknown connection ID: 2-->
		<ListBox
			Name="lbItems"
			Grid.Row="1"
			Grid.Column="0"
			AllowDrop="True"
			MinWidth="220"
			ItemsSource="{Binding Items}"
			SelectionMode="{Binding ElementName=itemsMover, Path=IsMultipleSelectionAllowed, Converter={StaticResource BoolToSelectionModeConverter}, Mode=OneWay}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<local:RMTextBlock
						Text="{Binding Name}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource ListFieldItemToForegroundConverter}">
								<Binding
									Path="IsApplicable" />
								<Binding
									Path="IsValid" />
							</MultiBinding>
						</TextBlock.Foreground>
					</local:RMTextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<Grid
			Row="1"
			Column="1"
			VerticalAlignment="Center"
			HorizontalAlignment="Center">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<local:RMButton
				Name="btnAddAll"
				Content="{x:Static resourceRepository:Resources.RMC_ItemMover_AddAll}"
				Grid.Row="0"
				Command="{Binding AddAllCommand}"
				Visibility="{Binding ElementName=itemsMover, Path=IsBatchOperationAllowed, Converter={StaticResource BoolToVisibilityConverter}}" />
			<!--Unknown connection ID: 4-->
			<local:RMButton
				Name="btnAdd"
				Content="{x:Static resourceRepository:Resources.RMC_ItemMover_Add}"
				Grid.Row="2"
				Command="{Binding AddCommand}" />
			<!--Unknown connection ID: 5-->
			<local:RMButton
				Name="btnRemove"
				Content="{x:Static resourceRepository:Resources.RMC_ItemMover_Remove}"
				Grid.Row="4"
				Command="{Binding RemoveCommand}" />
			<!--Unknown connection ID: 6-->
			<local:RMButton
				Name="btnRemoveAll"
				Content="{x:Static resourceRepository:Resources.RMC_ItemMover_RemoveAll}"
				Grid.Row="6"
				Command="{Binding RemoveAllCommand}"
				Visibility="{Binding ElementName=itemsMover, Path=IsBatchOperationAllowed, Converter={StaticResource BoolToVisibilityConverter}}" />
		</Grid>
		<!--Unknown connection ID: 7-->
		<ListBox
			Name="lbSelectedItems"
			Grid.Row="1"
			Grid.Column="2"
			AllowDrop="True"
			MinWidth="220"
			ItemsSource="{Binding SelectedItems}"
			SelectedIndex="{Binding SelectedIndex}"
			SelectionMode="{Binding ElementName=itemsMover, Path=IsMultipleSelectionAllowed, Converter={StaticResource BoolToSelectionModeConverter}, Mode=OneWay}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<local:RMTextBlock
						Text="{Binding Name}">
						<TextBlock.Foreground>
							<MultiBinding
								Converter="{StaticResource ListFieldItemToForegroundConverter}">
								<Binding
									Path="IsApplicable" />
								<Binding
									Path="IsValid" />
							</MultiBinding>
						</TextBlock.Foreground>
					</local:RMTextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ListBox>
		<Grid
			Row="1"
			Column="3"
			Width="100">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 8-->
			<local:RMButton
				Name="btnUp"
				Width="30"
				VerticalAlignment="Bottom"
				Command="{Binding MoveItemUpCommand}"
				Visibility="{Binding ElementName=itemsMover, Path=PositionMoverVisibility, Converter={StaticResource BoolToVisibilityConverter}}">
				<Path
					Fill="#FFFFFFFF"
					Data="M0,6 L12,6 L6,0" />
			</local:RMButton>
			<!--Unknown connection ID: 9-->
			<local:RMButton
				Name="btnDown"
				Grid.Row="2"
				Width="30"
				VerticalAlignment="Top"
				Command="{Binding MoveItemDownCommand}"
				Visibility="{Binding ElementName=itemsMover, Path=PositionMoverVisibility, Converter={StaticResource BoolToVisibilityConverter}}">
				<Path
					Fill="#FFFFFFFF"
					Data="M0,0 L6,6 L12,0" />
			</local:RMButton>
		</Grid>
	</Grid>
</local:RMCellPresentableFieldEditor>
