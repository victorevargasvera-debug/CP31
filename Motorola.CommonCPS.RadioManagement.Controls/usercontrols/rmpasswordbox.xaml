<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMPasswordBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls"
	Name="userControl"
	Height="24">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<i:Interaction.Triggers>
		<i:EventTrigger
			EventName="MouseEnter">
			<ei:GoToStateAction
				StateName="MouseOver"
				i:TargetObject="{Binding ElementName=userControl}" />
		</i:EventTrigger>
		<i:EventTrigger
			EventName="MouseLeave">
			<ei:GoToStateAction
				StateName="Normal"
				i:TargetObject="{Binding ElementName=userControl}" />
		</i:EventTrigger>
		<i:EventTrigger
			EventName="GotFocus">
			<ei:GoToStateAction
				StateName="Focused"
				i:TargetObject="{Binding ElementName=userControl}" />
		</i:EventTrigger>
		<i:EventTrigger
			EventName="LostFocus">
			<ei:GoToStateAction
				StateName="Unfocused"
				i:TargetObject="{Binding ElementName=userControl}" />
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<Validation.ErrorTemplate>
		<ControlTemplate>
			<StackPanel
				Orientation="Horizontal">
				<Image
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Icons/Error_red_16x16.png"
					Height="16"
					Width="16"
					Margin="-24,0,0,0"
					ToolTip="{Binding ElementName=AdornedElementPlaceholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
				<AdornedElementPlaceholder
					Name="AdornedElementPlaceholder" />
			</StackPanel>
		</ControlTemplate>
	</Validation.ErrorTemplate>
	<Grid>
		<VisualStateManager.VisualStateGroups>
			<!--Unknown connection ID: 2-->
			<VisualStateGroup
				x:Name="CommonStates">
				<!--Unknown connection ID: 3-->
				<VisualState
					x:Name="MouseOver">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetProperty="(UIElement.Opacity)"
							Storyboard.TargetName="OverBorder">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="1" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<!--Unknown connection ID: 4-->
				<VisualState
					x:Name="Disabled">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetProperty="(UIElement.Opacity)"
							Storyboard.TargetName="msiPassword">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="0.25" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<!--Unknown connection ID: 5-->
				<VisualState
					x:Name="Normal" />
				<!--Unknown connection ID: 6-->
				<VisualState
					x:Name="ReadOnly" />
			</VisualStateGroup>
			<!--Unknown connection ID: 7-->
			<VisualStateGroup
				x:Name="FocusStates">
				<!--Unknown connection ID: 8-->
				<VisualState
					x:Name="Unfocused" />
				<!--Unknown connection ID: 9-->
				<VisualState
					x:Name="Focused">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetProperty="(UIElement.Opacity)"
							Storyboard.TargetName="FocusBorder">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="1" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<!--Unknown connection ID: 10-->
		<Border
			Name="MainBorder">
			<!--Unknown connection ID: 11-->
			<Border
				Name="grdBorder"
				BorderThickness="1"
				CornerRadius="2"
				BorderBrush="{StaticResource BrushBorder}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="1" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid
						Margin="-1"
						ColumnSpan="3">
						<!--Unknown connection ID: 12-->
						<Border
							Name="OverBorder"
							BorderThickness="1"
							CornerRadius="2"
							Opacity="0"
							BorderBrush="{StaticResource InputFocusedBorderBrush}" />
						<!--Unknown connection ID: 13-->
						<Border
							Name="FocusBorder"
							BorderThickness="1"
							CornerRadius="2"
							Opacity="0"
							BorderBrush="{StaticResource InputFocusedBorderBrush}" />
					</Grid>
					<!--Unknown connection ID: 14-->
					<igEditors:XamMaskedEditor
						Name="msiPassword"
						IsAlwaysInEditMode="True"
						Style="{StaticResource PasswordStyle}"
						BorderThickness="0"
						Background="{Binding Path=PasswordBackground, RelativeSource={RelativeSource AncestorType={x:Type local:RMPasswordBox}}}"
						Text="{Binding Path=Password, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type local:RMPasswordBox}}}" />
					<!--Unknown connection ID: 15-->
					<igEditors:XamMaskedEditor
						Name="msiClearText"
						IsReadOnly="True"
						Visibility="Collapsed"
						Background="{StaticResource BrushControlBackground}"
						PromptChar=""
						ContextMenu="{StaticResource CutCopyPasteContextMenu}"
						InputMethod.IsInputMethodEnabled="False"
						BorderThickness="0"
						Text="{Binding Path=Password, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
					<!--Unknown connection ID: 16-->
					<Button
						Name="btnShowPassword"
						IsTabStop="False"
						Grid.Column="2"
						ClickMode="Press"
						Background="#FFFFFFFF"
						Height="22"
						Width="22"
						BorderBrush="#00FFFFFF"
						Style="{x:Null}"
						FocusVisualStyle="{x:Null}">
						<StackPanel>
							<!--Unknown connection ID: 17-->
							<Grid
								Name="imgWhiteEye">
								<Path
									Stretch="Uniform"
									Fill="#FF000000"
									Data="M0,0 M512,512 M326.971,309.228 C326.971,348.424 295.196,380.198 256,380.198 C216.804,380.198 185.03,348.424 185.03,309.228 C185.03,288.031 194.323,269.004 209.057,256 C221.567,244.958 238.001,238.257 256,238.257 C273.999,238.257 290.433,244.958 302.944,256 C317.678,269.004 326.971,288.031 326.971,309.228 M480,309.228 L397.941,309.228 C397.941,309.228 389.069,282.614 366.891,256 C344.713,229.386 309.228,202.772 256,202.772 C202.773,202.772 167.287,229.386 145.109,256 C122.931,282.614 114.059,309.228 114.059,309.228 L32,309.228 C32,309.228 40.8368,285.816 59.6176,256 C92.5377,203.738 156.011,131.802 256,131.802 C355.989,131.802 419.462,203.738 452.382,256 C471.163,285.816 480,309.228 480,309.228" />
							</Grid>
							<!--Unknown connection ID: 18-->
							<Grid
								Name="imgBlackEye"
								Visibility="Collapsed">
								<Path
									Stretch="Uniform"
									Fill="#FF000000"
									Data="M0,0 L512,0 L512,512 L0,512 L0,0 M256,238.258 C295.196,238.258 326.971,270.032 326.971,309.228 C326.971,348.424 295.196,380.198 256,380.198 C216.804,380.198 185.03,348.424 185.03,309.228 C185.03,270.032 216.804,238.258 256,238.258 M256,131.802 C413.033,131.802 480,309.228 480,309.228 L397.941,309.228 C397.941,309.228 362.456,202.772 256,202.772 C149.545,202.772 114.059,309.228 114.059,309.228 L32,309.228 C32,309.228 98.9674,131.802 256,131.802" />
							</Grid>
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</Border>
	</Grid>
</UserControl>
