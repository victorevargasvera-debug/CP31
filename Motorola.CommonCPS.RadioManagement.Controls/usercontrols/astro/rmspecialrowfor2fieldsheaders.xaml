<local:RMSpecialEditorHeader
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMSpecialRowFor2FieldsHeaders" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:MultiFieldsIsVisibleConverter
				x:Key="multiFieldsIsVisibleConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<Grid
		Name="Grid1"
		DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="{Binding Path=Header3Visibility, Converter={StaticResource VisibilityToGridWidthConverter}}" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 2-->
		<local:RMTextBlock
			Name="TB1"
			Grid.Column="0"
			Margin="26,0,0,0"
			Text="{Binding Header1}" />
		<!--Unknown connection ID: 3-->
		<local:RMTextBlock
			Name="TB2"
			Grid.Column="1"
			Margin="26,0,0,0"
			Text="{Binding Header2}"
			Visibility="{Binding Path=Header2Visibility}" />
		<!--Unknown connection ID: 4-->
		<local:RMTextBlock
			Name="TB3"
			Grid.Column="2"
			Margin="26,0,0,0"
			Text="{Binding Header3}"
			Visibility="{Binding Path=Header3Visibility}" />
	</Grid>
</local:RMSpecialEditorHeader>
