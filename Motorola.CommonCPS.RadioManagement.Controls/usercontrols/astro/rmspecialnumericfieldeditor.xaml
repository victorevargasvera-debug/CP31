<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMSpecialNumericFieldEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ig="http://schemas.infragistics.com/xaml" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Height="22">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:BoolToLockIconPathConverter
				x:Key="BoolToLockIconPathConverter" />
			<local:DecimalToHexConverter
				x:Key="DecimalToHexConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<Grid
		Name="grdMain"
		ShowGridLines="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="1*" />
			<ColumnDefinition
				Width="20" />
		</Grid.ColumnDefinitions>
		<Grid
			Column="0">
			<Grid
				IsEnabled="True"
				ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 2-->
				<local:RMNumericInput
					Name="nmiNumber"
					PreviewKeyUp="nmiNumber_PreviewKeyUp"
					TextChanged="nmiNumber_TextChanged"
					Grid.Column="0"
					ig:Mask="{}{number:0-268435455}"
					Visibility="Visible"
					ig:InvalidValueBehavior="RevertValue"
					ig:ValueTypeName="Decimal"
					Style="{StaticResource FieldEditorNumericInputStyle}"
					Validation.ErrorTemplate="{x:Null}"
					ig:Value="{Binding Path=Value, UpdateSourceTrigger=LostFocus}" />
				<Border
					Grid.Column="1"
					Background="{StaticResource BrushControlForeground}"
					Height="1"
					Margin="5"
					Width="5" />
				<!--Unknown connection ID: 3-->
				<local:RMMaskedInput
					Name="msiNumber"
					PreviewKeyDown="msiNumber_PreviewKeyDown"
					TextChanged="msiNumber_TextChanged"
					ValueChanged="OnMsiValueChanged"
					Grid.Column="2"
					HorizontalContentAlignment="Right"
					ig:Text="1"
					Visibility="Visible"
					ig:InvalidValueBehavior="RevertValue"
					Style="{StaticResource FieldEditorMaskedInputStyle}"
					ig:Mask="{}{char:7:0-9a-fA-F}" />
				<!--Unknown connection ID: 4-->
				<Grid
					Name="grdButtons"
					Column="3"
					Margin="10,0,0,0"
					Visibility="Visible">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition
							Height="1" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<!--Unknown connection ID: 5-->
					<RepeatButton
						Name="rbtIncrease"
						ContentTemplate="{StaticResource IncreaseGlyphKey}"
						Style="{StaticResource SpinButtonStyle}" />
					<!--Unknown connection ID: 6-->
					<RepeatButton
						Name="rbtDecrease"
						Grid.Row="2"
						ContentTemplate="{StaticResource DecreaseGlyphKey}"
						Height="10"
						Style="{StaticResource SpinButtonStyle}" />
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
