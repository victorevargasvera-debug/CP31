<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMWiFiPasswordList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:EditCharacterConverter
				x:Key="EditCharacterConverter" />
			<converters:DisplayTextConverter
				x:Key="DisplayTextConverter" />
			<converters:BoolToVisibilityConverter
				x:Key="BoolToVisibilityConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 1-->
		<local:RMDataGrid
			Name="dgrWiFiPassword"
			SearchVisibility="Collapsed"
			StatusbarVisibility="Collapsed"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding Path=WiFiNetworks, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
			<igDP:DataPresenterBase.FieldLayoutSettings>
				<igDP:FieldLayoutSettings
					HighlightAlternateRecords="True"
					AllowClipboardOperations="Copy"
					AllowDelete="False"
					AllowFieldMoving="WithinLogicalRow"
					AutoFitMode="Always"
					AutoGenerateFields="False"
					CopyFieldLabelsToClipboard="False"
					DataErrorDisplayMode="ErrorIconAndHighlight"
					SupportDataErrorInfo="CellsOnly" />
			</igDP:DataPresenterBase.FieldLayoutSettings>
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					AllowEdit="False"
					CellClickAction="SelectRecord"
					AllowResize="True" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="NetworkSSID"
							Label="{x:Static resourceRepository:Resources.WiFi_Network_SSID}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="NetworkPWD"
							Label="{x:Static resourceRepository:Resources.WiFi_Encrypted_Network_Password}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="True">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamMaskedEditor}">
											<Style.Resources>
												<ResourceDictionary>
													<Style
														TargetType="{x:Type igEditors:DisplayCharacterPresenter}"
														x:Key="{x:Type igEditors:DisplayCharacterPresenter}">
														<Setter
															Property="Template">
															<Setter.Value>
																<ControlTemplate
																	TargetType="{x:Type igEditors:DisplayCharacterPresenter}">
																	<Grid>
																		<local:RMTextBlock
																			Text="{Binding ConverterParameter=C, Path=DisplayCharacter.DrawString, Converter={StaticResource EditCharacterConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
																		<Rectangle
																			Fill="{DynamicResource SystemColors.HighlightBrushKey}"
																			Opacity="0.5" />
																	</Grid>
																</ControlTemplate>
															</Setter.Value>
														</Setter>
													</Style>
												</ResourceDictionary>
											</Style.Resources>
											<Setter
												Property="igEditors:XamMaskedEditor.PromptChar"
												Value="" />
											<Setter
												Property="igEditors:ValueEditor.InvalidValueBehavior"
												Value="RetainValue" />
											<Setter
												Property="igEditors:TextEditorBase.ValueToDisplayTextConverter"
												Value="{StaticResource DisplayTextConverter}" />
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
											<Style.Triggers>
												<DataTrigger
													Value="False"
													Binding="{Binding Path=Record.DataItem.IsValid, RelativeSource={RelativeSource AncestorType={x:Type igDP:CellValuePresenter}}}">
													<Setter
														Property="Foreground"
														Value="#FFFF0000" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</local:RMDataGrid>
	</Grid>
</UserControl>
