								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="Auto" />
										</Grid.ColumnDefinitions>
										<Image
											MaxHeight="16"
											MaxWidth="24"
											Source="{Binding Path=RowData.TypeIcon, Converter={StaticResource BitmapToBitmapSourceConverter}}" />
										<Image
											Grid.Column="1"
											Margin="5,0,0,0"
											Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Icons/Error_red_16x16.png"
											Height="16"
											Width="16"
											ToolTip="{x:Static resourceRepository:Resources.RMC_Tooltip_InvalidSet}"
											Visibility="{Binding Path=RowData.IsValid, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
									</Grid>
								</DataTemplate>
							</ig:UnboundColumn.ItemTemplate>
						</ig:UnboundColumn>
						<ig:UnboundColumn
							Key="ContactName"
							HeaderText="{x:Static resourceRepository:Resources.RMC_RMContactList_ContactName}"
							ItemTemplate="{StaticResource StringEditorDataTemplate}"
							ValueConverter="{StaticResource UnboundColumnValueConverter}"
							ValueConverterParameter="UclGen_ContactAlias_A00009"
							SortComparer="{StaticResource ContactNameSortComparer}"
							HorizontalContentAlignment="Stretch">
							<ig:UnboundColumn.EditorTemplate>
								<DataTemplate>
									<local:RMStringFieldEditor
										IsEditorOnly="True"
										Height="24"
										Margin="4,0,4,0"
										DataContext="{Binding Value}" />
								</DataTemplate>
							</ig:UnboundColumn.EditorTemplate>
						</ig:UnboundColumn>
					</ig:XamGrid.Columns>
				</ig:XamGrid>
			</Grid>
		</Grid>
	</Border>
</local:RMContactList>
