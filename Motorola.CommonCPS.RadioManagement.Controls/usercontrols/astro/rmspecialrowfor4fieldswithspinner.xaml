<local:RMSpecialEditor
	x:Class="Motorola.CommonCPS.RadioManagement.Controls.RMSpecialRowFor4FieldswithSpinner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:MultiFieldsIsVisibleConverter
				x:Key="multiFieldsIsVisibleConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.Visibility>
		<MultiBinding
			Converter="{StaticResource multiFieldsIsVisibleConverter}">
			<Binding
				Path="ComboBox1.IsVisible"
				RelativeSource="{RelativeSource Self}" />
			<Binding
				Path="ComboBox2.IsVisible"
				RelativeSource="{RelativeSource Self}" />
			<Binding
				Path="ComboBox3.IsVisible"
				RelativeSource="{RelativeSource Self}" />
			<Binding
				Path="Spin1.IsVisible"
				RelativeSource="{RelativeSource Self}" />
		</MultiBinding>
	</UIElement.Visibility>
	<!--Unknown connection ID: 1-->
	<Grid
		Name="Grid1"
		DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RMFieldEditor}}}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 2-->
		<local:RMTextBlock
			Name="TB1"
			Grid.Column="0"
			Margin="6,6,20,6"
			HorizontalAlignment="Right"
			VerticalAlignment="Center"
			Text="{Binding Header1}" />
		<!--Unknown connection ID: 3-->
		<local:RMListFieldEditor
			Name="CB1"
			Grid.Column="1"
			Margin="6"
			IsEditorOnly="True"
			IsSortRequired="True"
			DataContext="{Binding ComboBox1}" />
		<!--Unknown connection ID: 4-->
		<local:RMNumericFieldEditor
			Name="NI1"
			Grid.Column="2"
			Margin="6"
			IsEditorOnly="True"
			DataContext="{Binding Spin1}" />
		<!--Unknown connection ID: 5-->
		<local:RMListFieldEditor
			Name="CB2"
			Grid.Column="3"
			Margin="6"
			IsEditorOnly="True"
			DataContext="{Binding ComboBox2}" />
		<!--Unknown connection ID: 6-->
		<local:RMListFieldEditor
			Name="CB3"
			Grid.Column="4"
			Margin="6"
			IsEditorOnly="True"
			DataContext="{Binding ComboBox3}" />
	</Grid>
</local:RMSpecialEditor>
