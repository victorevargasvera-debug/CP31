											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="contentControl" />
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="SelectionStates">
								<VisualState
									x:Name="Unselected" />
								<VisualState
									x:Name="Selected" />
								<VisualState
									x:Name="SelectedUnfocused" />
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="FocusStates">
								<VisualState
									x:Name="Focused">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1.0"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="FocusVisualElement" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Unfocused" />
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="LayoutStates">
								<VisualState
									x:Name="AfterLoaded" />
								<VisualState
									x:Name="BeforeLoaded" />
								<VisualState
									x:Name="BeforeUnloaded" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Rectangle
							Name="fillColor"
							IsHitTestVisible="False"
							Opacity="0"
							RadiusY="1"
							RadiusX="1"
							StrokeThickness="{TemplateBinding BorderThickness}"
							Fill="{StaticResource DropDown_Hover}"
							Stroke="{StaticResource DropDownStroke_Hover}" />
						<Rectangle
							Name="FocusVisualElement"
							RadiusY="1"
							RadiusX="1"
							Visibility="Visible"
							Opacity="0"
							StrokeThickness="{TemplateBinding BorderThickness}"
							Stroke="{StaticResource CellItemActiveBorderBrush}" />
						<ContentControl
							Name="contentControl"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Margin="{TemplateBinding Padding}"
							Foreground="{TemplateBinding Foreground}">
							<ContentPresenter
								Name="contentPresenter" />
						</ContentControl>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
