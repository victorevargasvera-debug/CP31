									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Pressed">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="pressed" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="disabled" />
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="CheckStates">
