	<Style
		TargetType="{x:Type Slider}"
		x:Key="IGSliderStyle2">
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="RangeBase.Maximum"
			Value="10" />
		<Setter
			Property="RangeBase.Minimum"
			Value="0" />
		<Setter
			Property="RangeBase.Value"
			Value="0" />
		<Setter
			Property="IsTabStop"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Slider}">
					<Grid
						Name="Root">
						<FrameworkElement.Resources>
							<ResourceDictionary>
								<ControlTemplate
									x:Key="RepeatButtonTemplate">
									<Grid
										Name="Root"
										Background="#00FFFFFF"
										Opacity="0" />
								</ControlTemplate>
							</ResourceDictionary>
						</FrameworkElement.Resources>
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="Normal" />
								<VisualState
									x:Name="MouseOver" />
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetProperty="Visibility"
											Storyboard.TargetName="HorizontalTrackRectangleDisabledOverlay">
											<DiscreteObjectKeyFrame
												KeyTime="0">
												<ObjectKeyFrame.Value>
													<Visibility>Visible</Visibility>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetProperty="Visibility"
											Storyboard.TargetName="ThumbDisabledOverlay">
											<DiscreteObjectKeyFrame
												KeyTime="0">
												<ObjectKeyFrame.Value>
													<Visibility>Visible</Visibility>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetProperty="Visibility"
											Storyboard.TargetName="VerticalTrackRectangleDisabledOverlay">
											<DiscreteObjectKeyFrame
												KeyTime="0">
												<ObjectKeyFrame.Value>
													<Visibility>Visible</Visibility>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid
							Name="HorizontalTemplate"
							Background="{TemplateBinding Background}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Rectangle
								Name="TrackRectangle"
								Grid.ColumnSpan="3"
								Grid.Column="0"
								Height="4"
								Margin="5,0,5,0"
								RadiusY="1"
								RadiusX="1"
								StrokeThickness="1"
								Fill="{StaticResource SliderTrackFill}"
								Stroke="{StaticResource SliderTrackBorderFill}" />
							<Rectangle
								Name="HorizontalTrackRectangleDisabledOverlay"
								Grid.ColumnSpan="3"
								Grid.Column="0"
								Fill="#FFFFFFFF"
								Height="3"
								Margin="5,0,5,0"
								Opacity=".55"
								RadiusY="1"
								RadiusX="1"
								Visibility="Collapsed" />
							<RepeatButton
								Name="HorizontalTrackLargeChangeDecreaseRepeatButton"
								Grid.Column="0"
								Height="18"
								IsTabStop="False"
								Template="{StaticResource RepeatButtonTemplate}" />
							<Thumb
								Name="HorizontalThumb"
								Grid.Column="1"
								Height="18"
								IsTabStop="True"
								Width="11"
								Style="{StaticResource IGThumbStyle}" />
