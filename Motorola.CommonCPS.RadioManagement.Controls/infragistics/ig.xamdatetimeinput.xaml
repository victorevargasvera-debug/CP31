			</igPrimLocal:FixedValueConverter.SourceValue>
			<igPrimLocal:FixedValueConverter.DestinationValue>
				<sys:Boolean>True</sys:Boolean>
			</igPrimLocal:FixedValueConverter.DestinationValue>
