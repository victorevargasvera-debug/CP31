<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:igPrim="http://schemas.infragistics.com/xaml/primitives" xmlns:igEditors="http://schemas.infragistics.com/xaml" xmlns:igEditorsPrim="http://schemas.infragistics.com/xaml/primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="Theme.Colors.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<SolidColorBrush
		Color="{StaticResource Color_001}"
		x:Key="ForegroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_011}"
		x:Key="LightForegroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_021}"
		x:Key="TransparentBrush" />
	<LinearGradientBrush
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="ButtonBackgroundBrush">
		<GradientStop
			Color="{StaticResource Color_004}" />
		<GradientStop
			Offset="1"
			Color="{StaticResource Color_002}" />
	</LinearGradientBrush>
	<LinearGradientBrush
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="ButtonArrowHoverBackgroundBrush">
		<GradientStop
			Color="{StaticResource Color_014}" />
		<GradientStop
			Offset="1"
			Color="{StaticResource Color_016}" />
	</LinearGradientBrush>
	<LinearGradientBrush
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="ButtonArrowPressedBackgroundBrush">
		<GradientStop
			Offset="1"
			Color="{StaticResource Color_014}" />
		<GradientStop
			Color="{StaticResource Color_016}" />
	</LinearGradientBrush>
	<LinearGradientBrush
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="ButtonArrowDisabledBackgroundBrush">
		<GradientStop
			Color="{StaticResource Color_008}" />
		<GradientStop
			Offset="1"
			Color="{StaticResource Color_006}" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="{StaticResource Color_016}"
		x:Key="ButtonArrowHoverBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_016}"
		x:Key="ButtonArrowPressedBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_002}"
		x:Key="ButtonBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_007}"
		x:Key="ButtonArrowDisabledBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_006}"
		x:Key="InputBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_014}"
		x:Key="InputFocusedBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_000}"
		x:Key="InputForegroundBrush" />
	<LinearGradientBrush
		StartPoint="0.505,0.469"
		EndPoint="0.505,-0.023"
		x:Key="InputTextBoxBackgroundBrush">
		<GradientStop
			Offset="0.377"
			Color="{StaticResource Color_011}" />
		<GradientStop
			Offset="1"
			Color="{StaticResource Color_009}" />
	</LinearGradientBrush>
	<RadialGradientBrush
		RadiusX="0.916"
		RadiusY="1.667"
		Center="0.72,0.528"
		GradientOrigin="0.72,0.528"
		x:Key="InputInnerShadowBackgroundBrush">
		<GradientStop
			Offset="0.679"
			Color="{StaticResource Color_026}" />
		<GradientStop
			Offset="0.913"
			Color="{StaticResource Color_027}" />
	</RadialGradientBrush>
	<igEditorsPrim:HorizontalToTextAlignmentConverter
		x:Key="HorizToTextAlignmentConverter" />
	<DataTemplate
		x:Key="IncreaseGlyphKey">
		<Path
			Width="7"
			Height="4"
			Data="M0,3 C0,3 0,4 0,4 C0,4 3,4 3,4 C3,4 3,3 3,3 C3,3 4,3 4,3 C4,3 4,4 4,4 C4,4 7,4 7,4 C7,4 7,3 7,3 C7,3 6,3 6,3 C6,3 6,2 6,2 C6,2 5,2 5,2 C5,2 5,1 5,1 C5,1 4,1 4,1 C4,1 4,0 4,0 C4,0 3,0 3,0 C3,0 3,1 3,1 C3,1 2,1 2,1 C2,1 2,2 2,2 C2,2 1,2 1,2 C1,2 1,3 1,3 C1,3 0,3 0,3"
			Fill="{StaticResource LightForegroundBrush}" />
	</DataTemplate>
	<DataTemplate
		x:Key="DecreaseGlyphKey">
		<Path
			Width="7"
			Height="4"
			Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1"
			Fill="{StaticResource LightForegroundBrush}" />
	</DataTemplate>
	<ControlTemplate
		TargetType="{x:Type RepeatButton}"
		x:Key="RepeatButtonTemplate">
		<Grid>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup
					x:Name="CommonStates">
					<VisualState
						x:Name="Normal" />
					<VisualState
						x:Name="MouseOver">
						<Storyboard>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Fill">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowHoverBackgroundBrush}" />
							</ObjectAnimationUsingKeyFrames>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Stroke">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowHoverBorderBrush}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</VisualState>
					<VisualState
						x:Name="Pressed">
						<Storyboard>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Fill">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowPressedBackgroundBrush}" />
							</ObjectAnimationUsingKeyFrames>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Stroke">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowPressedBorderBrush}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</VisualState>
					<VisualState
						x:Name="Disabled">
						<Storyboard>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Fill">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowDisabledBackgroundBrush}" />
							</ObjectAnimationUsingKeyFrames>
							<ObjectAnimationUsingKeyFrames
								Storyboard.TargetName="Bd"
								Storyboard.TargetProperty="Stroke">
								<DiscreteObjectKeyFrame
									KeyTime="0"
									Value="{StaticResource ButtonArrowDisabledBorderBrush}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</VisualState>
				</VisualStateGroup>
				<VisualStateGroup
					x:Name="FocusStates">
					<VisualState
						x:Name="Focused" />
					<VisualState
						x:Name="Unfocused" />
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
			<Rectangle
				Name="Bd"
				RadiusY="2"
				RadiusX="2"
				StrokeThickness="1"
				Stroke="{StaticResource ButtonBorderBrush}"
				Fill="{StaticResource ButtonBackgroundBrush}" />
			<ContentControl
				IsTabStop="{TemplateBinding IsTabStop}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Foreground="{StaticResource LightForegroundBrush}">
				<ContentPresenter
					Name="contentPresenter"
					ContentTemplate="{TemplateBinding ContentTemplate}"
					Content="{TemplateBinding Content}"
					HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
					Margin="{TemplateBinding Padding}"
					VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
			</ContentControl>
		</Grid>
	</ControlTemplate>
	<Style
		TargetType="{x:Type RepeatButton}"
		x:Key="SpinButtonStyle">
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="3,1" />
		<Setter
			Property="IsTabStop"
			Value="False" />
		<Setter
			Property="igPrim:XamlHelper.Focusable"
			Value="False" />
		<Setter
			Property="Template"
			Value="{StaticResource RepeatButtonTemplate}" />
	</Style>
	<Style
		TargetType="{x:Type TextBox}"
		x:Key="MaskedInputTextBoxStyle">
		<Setter
			Property="Foreground"
			Value="{StaticResource ForegroundBrush}" />
		<Setter
			Property="Background"
			Value="{StaticResource TransparentBrush}" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource TransparentBrush}" />
		<Setter
			Property="BorderThickness"
			Value="0" />
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMaskedInput}"
		x:Key="MaskedInputStyle">
		<Setter
			Property="Background"
			Value="{StaticResource InputTextBoxBackgroundBrush}" />
		<Setter
			Property="Foreground"
			Value="{StaticResource InputForegroundBrush}" />
		<Setter
			Property="igPrim:XamlHelper.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="igEditors:XamMaskedInput.SpinButtonStyle"
			Value="{StaticResource SpinButtonStyle}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource InputBorderBrush}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMaskedInput}">
					<igEditorsPrim:ValidationDecorator
						Name="MainBorder">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="MouseOver">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="OverBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="PART_InputTextBox">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="0.25" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Normal" />
								<VisualState
									x:Name="ReadOnly" />
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="FocusStates">
								<VisualState
									x:Name="Unfocused" />
								<VisualState
									x:Name="Focused">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="FocusBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border
								Name="BgBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="2">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid
										Margin="-1"
										ColumnSpan="2">
										<Border
											Name="OverBorder"
											BorderThickness="1"
											CornerRadius="2"
											Opacity="0"
											BorderBrush="{StaticResource InputFocusedBorderBrush}" />
										<Border
											Name="FocusBorder"
											BorderThickness="1"
											CornerRadius="2"
											Opacity="0"
											BorderBrush="{StaticResource InputFocusedBorderBrush}" />
										<Rectangle
											Name="innerShadow"
											Width="20"
											StrokeThickness="0"
											HorizontalAlignment="Left"
											Margin="1,1,0,1"
											RadiusX="2"
											RadiusY="2"
											Fill="{StaticResource InputInnerShadowBackgroundBrush}" />
									</Grid>
									<igEditorsPrim:MaskedInputTextBox
										Name="PART_InputTextBox"
										Grid.Column="0"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
										VerticalAlignment="Stretch"
										Foreground="{TemplateBinding Foreground}"
										InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
										Margin="{TemplateBinding Padding}"
										XamlHelper.Focusable="{TemplateBinding Focusable}"
										IsTabStop="{TemplateBinding IsTabStop}"
										Style="{StaticResource MaskedInputTextBoxStyle}"
										TextAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, Converter={StaticResource HorizToTextAlignmentConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
									<Grid
										Name="PART_SpinButtons"
										Column="1"
										Visibility="{TemplateBinding igEditors:SpinButtonVisibilityResolved}"
										Margin="0,1,1,1">
										<Grid.RowDefinitions>
											<RowDefinition
												Height="*" />
											<RowDefinition
												Height="1" />
											<RowDefinition
												Height="*" />
										</Grid.RowDefinitions>
										<RepeatButton
											Name="spinUp"
											Style="{TemplateBinding igEditors:SpinButtonStyle}"
											ContentTemplate="{StaticResource IncreaseGlyphKey}">
											<igEditors:Commanding.Command>
												<igEditorsPrim:MaskedInputCommandSource
													igEditors:EventName="Click"
													CommandId="SpinUp" />
											</igEditors:Commanding.Command>
										</RepeatButton>
										<RepeatButton
											Name="spinDown"
											Style="{TemplateBinding igEditors:SpinButtonStyle}"
											Grid.Row="2"
											ContentTemplate="{StaticResource DecreaseGlyphKey}">
											<igEditors:Commanding.Command>
												<igEditorsPrim:MaskedInputCommandSource
													igEditors:EventName="Click"
													CommandId="SpinDown" />
											</igEditors:Commanding.Command>
										</RepeatButton>
									</Grid>
								</Grid>
							</Border>
						</Grid>
					</igEditorsPrim:ValidationDecorator>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMaskedInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type igEditors:XamMaskedInput}" />
	<Style
		TargetType="{x:Type igEditors:XamNumericInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type igEditors:XamNumericInput}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Right" />
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamCurrencyInput}"
		BasedOn="{StaticResource MaskedInputStyle}"
		x:Key="{x:Type igEditors:XamCurrencyInput}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Right" />
	</Style>
</ResourceDictionary>
