	<Style
		TargetType="{x:Type local:RMDateInput}"
		BasedOn="{StaticResource XamDateTimeInput}"
		x:Key="{x:Type local:RMDateInput}">
		<Setter
			Property="Validation.ErrorTemplate">
			<Setter.Value>
				<ControlTemplate>
					<StackPanel
						Orientation="Horizontal">
						<Image
							Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Icons/Error_red_16x16.png"
							Height="16"
							Width="16"
							Margin="-24,0,0,0"
							ToolTip="{Binding ElementName=AdornedElementPlaceholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
						<AdornedElementPlaceholder
							Name="AdornedElementPlaceholder" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:RMDateInput}">
					<Border
						Name="MainBorder">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="FocusStates">
								<VisualState
									x:Name="FocusedDropDown" />
								<VisualState
									x:Name="Unfocused" />
								<VisualState
									x:Name="Focused">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="FocusBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="MouseOver">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="OverBorder">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="PART_InputTextBox">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="0.25" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Normal" />
								<VisualState
									x:Name="ReadOnly" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid
							Name="MainGrid"
							Width="Auto">
							<Grid
								Height="Auto"
								Width="Auto">
								<Border
									Name="BgBorder"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									Grid.ColumnSpan="1"
									Visibility="Visible"
									CornerRadius="2"
									Margin="0"
									Background="{StaticResource BrushControlBackground}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="Auto" />
										</Grid.ColumnDefinitions>
										<Grid
											Margin="-1"
											ColumnSpan="3">
											<Border
												Name="OverBorder"
												BorderThickness="1"
												CornerRadius="2"
												Opacity="0"
												BorderBrush="{StaticResource InputFocusedBorderBrush}" />
											<Border
												Name="FocusBorder"
												BorderThickness="1"
												CornerRadius="2"
												Opacity="0"
												BorderBrush="{StaticResource InputFocusedBorderBrush}" />
										</Grid>
										<Grid
											Column="0">
											<local:RMMaskedInputTextBox
												Name="PART_InputTextBox"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
												VerticalAlignment="Stretch"
												Margin="{TemplateBinding Padding}"
												Foreground="{TemplateBinding Foreground}"
												InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
												Style="{StaticResource MaskedInputTextBoxStyle}"
												TextAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, Converter={StaticResource HorizToTextAlignmentConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>
										<Grid
											Name="PART_SpinButtons"
											Column="1"
											Visibility="{TemplateBinding ig:SpinButtonVisibilityResolved}"
											Margin="0,1,1,1">
											<Grid.RowDefinitions>
												<RowDefinition
													Height="*" />
												<RowDefinition
													Height="1" />
												<RowDefinition
													Height="*" />
											</Grid.RowDefinitions>
											<RepeatButton
												Name="spinUp"
												Style="{TemplateBinding ig:SpinButtonStyle}"
												ContentTemplate="{StaticResource IncreaseGlyphKey}">
												<igEditors:Commanding.Command>
													<igPrim:MaskedInputCommandSource
														igEditors:EventName="Click"
														CommandId="SpinUp" />
												</igEditors:Commanding.Command>
											</RepeatButton>
											<RepeatButton
												Name="spinDown"
												Style="{TemplateBinding ig:SpinButtonStyle}"
												Grid.Row="2"
												ContentTemplate="{StaticResource DecreaseGlyphKey}">
												<igEditors:Commanding.Command>
													<igPrim:MaskedInputCommandSource
														igEditors:EventName="Click"
														CommandId="SpinDown" />
												</igEditors:Commanding.Command>
											</RepeatButton>
										</Grid>
										<ToggleButton
											Name="PART_DropDownButton"
											Grid.Column="2"
											Grid.RowSpan="3"
											ClickMode="Press"
											Style="{TemplateBinding ig:DropDownButtonStyle}"
											Visibility="{TemplateBinding ig:DropDownButtonVisibility}"
											igPrim:XamlHelper.Focusable="False"
											IsTabStop="False"
											Margin="0,1,1,1"
											IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
											IsEnabled="{Binding IsReadOnly, Converter={StaticResource complementConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
									</Grid>
								</Border>
								<Popup
									Name="PART_Popup">
									<Border
										BorderThickness="1"
										Padding="1"
										Background="{Binding [WindowBrush], Source={StaticResource SRP}}"
										BorderBrush="{Binding [WindowFrameBrush], Source={StaticResource SRP}}">
										<igEditors:XamCalendar
											Name="PART_Calendar"
											MinDate="{TemplateBinding ComputedMinDate}"
											MaxDate="{TemplateBinding ComputedMaxDate}"
											MinCalendarMode="{TemplateBinding ComputedMinCalendarMode}"
											SelectionMode="SingleDate"
											SelectedDate="{Binding DateValue, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
								</Popup>
							</Grid>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
