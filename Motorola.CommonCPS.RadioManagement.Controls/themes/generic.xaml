	<Style
		TargetType="{x:Type local:RMActionMenu}"
		BasedOn="{StaticResource IGToggleButtonStyle}"
		x:Key="{x:Type local:RMActionMenu}">
		<Setter
			Property="Foreground"
			Value="{StaticResource BrushControlForeground}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ToggleButton}">
					<Grid>
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="MouseOver">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="hover" />
										<ColorAnimation
											Storyboard.TargetName="contentPresenter"
											Storyboard.TargetProperty="(TextElement.Foreground).Color"
											Duration="0"
											To="{StaticResource Color_Control_Background}" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Pressed">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="pressed" />
										<ColorAnimation
											Storyboard.TargetName="contentPresenter"
											Storyboard.TargetProperty="(TextElement.Foreground).Color"
											To="{StaticResource Color_Control_Background}" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="disabled" />
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="CheckStates">
								<VisualState
									x:Name="Checked">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="checked" />
										<ColorAnimation
											Storyboard.TargetName="contentPresenter"
											Storyboard.TargetProperty="(TextElement.Foreground).Color"
											Duration="0"
											To="{StaticResource Color_Control_Background}" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Unchecked" />
								<VisualState
									x:Name="Indeterminate" />
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="FocusStates">
								<VisualState
									x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Border
							Name="hover"
							BorderThickness="{TemplateBinding BorderThickness}"
							Opacity="0"
							BorderBrush="{StaticResource Cyan2}"
							Background="{StaticResource Button_Hover}" />
						<Border
							Name="pressed"
							BorderThickness="{TemplateBinding BorderThickness}"
							Opacity="0"
							BorderBrush="{StaticResource Cyan2}"
							Background="{StaticResource Button_Pressed}" />
						<Border
							Name="disabled"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="3"
							Opacity="0"
							BorderBrush="{StaticResource DisabledColor}"
							Background="{StaticResource Button_Disabled}" />
						<Border
							Name="checked"
							BorderThickness="{TemplateBinding BorderThickness}"
							Opacity="0"
							BorderBrush="{StaticResource Button_ChkdStroke}"
							Background="{StaticResource Button_Chkd}" />
						<Rectangle
							Name="FocusVisualElement"
							IsHitTestVisible="False"
							Margin="0"
							Opacity="0"
							Stroke="#FF3AB5E9"
							StrokeThickness="1" />
						<ContentPresenter
							Name="contentPresenter"
							HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
							VerticalAlignment="{TemplateBinding VerticalAlignment}"
							Margin="{TemplateBinding Padding}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
