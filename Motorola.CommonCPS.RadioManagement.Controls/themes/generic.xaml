										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="pressed" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Disabled">
									<Storyboard>
										<DoubleAnimation
											Duration="0"
											To=".55"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="contentPresenter" />
										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="disabled" />
