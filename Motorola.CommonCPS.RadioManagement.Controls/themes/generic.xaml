										<DoubleAnimation
											Duration="0"
											To="1"
											Storyboard.TargetProperty="(UIElement.Opacity)"
											Storyboard.TargetName="focused" />
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Unfocused" />
