<UserControl
	x:Class="ControlHeadGraphicView.acpcontrol.AcpTextBoxSpinner_G" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI" xmlns:igEditors="http://infragistics.com/Editors" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:ctrl="clr-namespace:ControlHeadGraphicView.acpcontrol" xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="AcpTextBoxSpinner_G_Style.xaml" />
				<ResourceDictionary
					Source="AcpTextBox_G_Style.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="5*" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 1-->
		<ctrl:AcpTextBox_G
			Name="AcpTextBoxMember"
			LostFocus="OnLostFocus"
			Grid.Row="0"
			Grid.Column="0"
			Grid.RowSpan="2"
			MaskType="{Binding Path=MaskTypeSpinner, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ctrl:AcpTextBoxSpinner_G}}}"
			Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ctrl:AcpTextBoxSpinner_G}}}"
			IsAcpValid="{Binding Path=IsAcpValid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ctrl:AcpTextBoxSpinner_G}}}"
			IsAcpApplicable="{Binding Path=IsAcpApplicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ctrl:AcpTextBoxSpinner_G}}}"
			IsAcpEditable="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ctrl:AcpTextBoxSpinner_G}}}" />
		<!--Unknown connection ID: 2-->
		<RepeatButton
			Name="UpClick"
			Grid.Column="1"
			Height="11.63833333333335"
			Width="20"
			Delay="500"
			Interval="10"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			ToolTip="{x:Static CommonResxNS:AppResources.Increment_Id}">
			<Image
				Source="../icons/SpinnerArrowUp.png"
				Opacity="{Binding ElementName=UpClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
		</RepeatButton>
		<!--Unknown connection ID: 3-->
		<RepeatButton
			Name="DownClick"
			Grid.Row="1"
			Grid.Column="1"
			Height="11.63833333333335"
			Width="20"
			Delay="500"
			Interval="10"
			HorizontalAlignment="Right"
			ToolTip="{x:Static CommonResxNS:AppResources.Decrement_Id}">
			<Image
				Source="../icons/SpinnerArrowDown.png"
				Opacity="{Binding ElementName=DownClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}" />
		</RepeatButton>
	</Grid>
</UserControl>
