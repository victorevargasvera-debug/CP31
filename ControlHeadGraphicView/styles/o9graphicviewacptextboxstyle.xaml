<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igEditors="http://infragistics.com/Editors" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:local="clr-namespace:ControlHeadGraphicView">
	<Style
		TargetType="{x:Type AcpUINS:AcpTextBox}"
		x:Key="O9GraphicViewAcpTextBoxStyle">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static local:O9GraphicViewControlColorKeys.AcpTextBoxBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static local:O9GraphicViewControlColorKeys.AcpTextBoxForeground}}}" />
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static local:O9GraphicViewControlColorKeys.AcpTextBoxInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Hidden" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static local:O9GraphicViewControlColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static local:O9GraphicViewControlColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
			</MultiDataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
