									Storyboard.TargetName="prompt1"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="prompt2"
