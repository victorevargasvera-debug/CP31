							Height="8"
							Data="M8,4.457 C8,4.457 5,4.457 5,4.457 C5,4.457 7.5,6.987 7.5,6.987 C7.5,6.987 5.5,8 5.5,8 C5.5,8 4,5.469 4,5.469 C4,5.469 2.5,8 2.5,8 C2.5,8 0.5,6.987 0.5,6.987 C0.5,6.987 3,4.457 3,4.457 C3,4.457 0,4.457 0,4.457 C0,4.457 0.5,1.927 0.5,1.927 C0.5,1.927 3,2.433 3,2.433 C3,2.433 2.759,0 2.759,0 C2.759,0 5.273,0 5.273,0 C5.273,0 5,2.433 5,2.433 C5,2.433 7.5,1.927 7.5,1.927 C7.5,1.927 8,4.457 8,4.457"
							Fill="{TemplateBinding Foreground}" />
