	<Style
		TargetType="{x:Type igDP:FieldChooser}"
		x:Key="{x:Type igDP:FieldChooser}">
		<Style.Resources>
			<ResourceDictionary>
				<DataTemplate
					DataType="{x:Type igDP:FieldChooserEntry}">
					<DockPanel>
						<editors:XamCheckEditor
							Name="checkBox"
							DockPanel.Dock="Left"
							IsThreeState="False"
							Value="{Binding Path=IsVisible, Mode=TwoWay}" />
						<igDP:LabelPresenter
							Name="label"
							IsInFieldChooser="True"
							HorizontalContentAlignment="Left"
							VerticalContentAlignment="Center"
							Margin="5,0,0,0"
							DockPanel.Dock="Left"
							Field="{Binding Path=Field}"
							IsSelectedInFieldChooser="{Binding Path=IsSelected}">
							<UIElement.InputBindings>
								<MouseBinding
									MouseAction="LeftDoubleClick"
									Command="{x:Static igDP:FieldChooserCommands.ToggleVisibility}" />
							</UIElement.InputBindings>
						</igDP:LabelPresenter>
					</DockPanel>
					<DataTemplate.Triggers>
						<DataTrigger
							Value="true"
							Binding="{Binding Path=DisplayHiddenFieldsOnly, RelativeSource={RelativeSource AncestorType={x:Type igDP:FieldChooser}}}">
							<Setter
								TargetName="checkBox"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
				<DataTemplate
					DataType="{x:Type igDP:FieldChooserGroup}">
					<StackPanel
						Name="panel"
						ToolTip="{Binding FieldLayout.ToolTip}">
						<TextBlock
							Name="fieldLayoutDescription"
							Text="{Binding Path=FieldLayout.Description}" />
						<StackPanel
							Name="filterPanel"
							Orientation="Horizontal"
							Visibility="Collapsed">
							<Rectangle
								Width="20" />
							<TextBlock
								Text="{Binding Path=FieldFilter.Description}" />
						</StackPanel>
					</StackPanel>
					<DataTemplate.Triggers>
						<DataTrigger
							Value="true"
							Binding="{Binding Path=HasFieldFilter}">
							<Setter
								TargetName="panel"
								Property="FrameworkElement.ToolTip"
								Value="{Binding FieldFilter.ToolTip}" />
							<Setter
								TargetName="filterPanel"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="fieldLayoutDescription"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</ResourceDictionary>
		</Style.Resources>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:FieldChooser}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<DockPanel
								Visibility="{TemplateBinding igDP:FieldGroupSelectorVisibilityResolved}">
								<editors:XamCheckEditor
									Name="toggleAllCheckBox"
									DockPanel.Dock="Left"
									IsThreeState="False"
									Margin="4,0,0,0"
									Value="{Binding Path=AllCurrentFieldsVisible, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}"
									Visibility="{Binding Path=DisplayHiddenFieldsOnly, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=OneWay, Converter={StaticResource NotBoolToVisConverter}}" />
								<editors:XamComboEditor
									Name="fieldGroupSelector"
									DockPanel.Dock="Right"
									ItemsSource="{TemplateBinding igDP:FieldGroups}"
									DisplayValueSource="Value"
									HorizontalAlignment="Stretch"
									ValueType="{x:Type igDP:FieldChooserGroup}"
									Value="{Binding Path=CurrentFieldGroup, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}" />
							</DockPanel>
							<igWindows:CardPanel
								Grid.Row="1">
								<ListBox
									Name="PART_FieldsListBox"
									ItemsSource="{TemplateBinding igDP:CurrentFields}"
									SelectionMode="Single"
									HorizontalContentAlignment="Stretch"
									SelectedItem="{Binding Path=SelectedField, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}">
									<ItemsControl.ItemContainerStyle>
										<Style
											TargetType="{x:Type ListBoxItem}">
											<Setter
												Property="FrameworkElement.FocusVisualStyle"
												Value="{x:Null}" />
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type ListBoxItem}">
														<Border
															Background="{TemplateBinding Background}"
															BorderBrush="{TemplateBinding BorderBrush}"
															BorderThickness="{TemplateBinding BorderThickness}"
															Padding="{TemplateBinding Padding}"
															SnapsToDevicePixels="True">
															<ContentPresenter
																HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
														</Border>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</ItemsControl.ItemContainerStyle>
									<UIElement.InputBindings>
										<KeyBinding
											Key="Space"
											Command="{x:Static igDP:FieldChooserCommands.ToggleVisibility}" />
									</UIElement.InputBindings>
								</ListBox>
								<Border
									Name="highlightBorder"
									BorderThickness="2"
									BorderBrush="#00FFFFFF"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch" />
							</igWindows:CardPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:FieldChooser.IsDraggingItem"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="igDP:FieldChooser.IsDraggingItemFromDataPresenter"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="igDP:FieldChooser.IsDragItemOver"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<DataTrigger
							Value="0"
							Binding="{Binding Path=CurrentFields.Count, RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="toggleAllCheckBox"
								Property="IsEnabled"
								Value="False" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
