	<igDP:TextAlignmentToHorizontalAlignmentConverter
		x:Key="textAlignmentToHorizontalAlignmentConverter" />
	<igWindows:NotBoolToVisibilityConverter
		x:Key="NotBoolToVisConverter" />
	<igWindows:StringFormatConverter
		x:Key="stringFormatConverter" />
	<igWindows:NullToFalseConverter
		x:Key="nullToFalseConverter" />
	<Storyboard
		x:Freeze="true"
		x:Key="ExpandLabel">
		<DoubleAnimationUsingKeyFrames
			Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
			BeginTime="0:0:0">
			<DiscreteDoubleKeyFrame
				KeyTime="0:0:0"
				Value="1" />
		</DoubleAnimationUsingKeyFrames>
	</Storyboard>
	<Storyboard
		x:Freeze="true"
		x:Key="CollapseLabel">
		<DoubleAnimationUsingKeyFrames
			Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
			BeginTime="0:0:00">
			<DiscreteDoubleKeyFrame
				KeyTime="0:0:0"
				Value="0" />
		</DoubleAnimationUsingKeyFrames>
	</Storyboard>
	<Style
		TargetType="{x:Type ContentControl}"
		x:Key="LabelContentStyle">
		<Setter
			Property="Padding"
			Value="10,3,10,3" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ContentControl}">
					<ContentPresenter
						Margin="{TemplateBinding Padding}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
						Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="{ComponentResourceKey {x:Type igDP:XamDataGrid}, GrayForegroundStyle}">
		<Setter
			Property="Foreground"
			Value="#FF333333" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey {x:Type igDP:XamDataGrid}, BlackForegroundStyle}">
		<Setter
			Property="Foreground"
			Value="#FF000000" />
	</Style>
	<BooleanToVisibilityConverter
		x:Key="BoolToVisConverter" />
	<Style
		TargetType="{x:Type Border}"
		x:Key="{ComponentResourceKey {x:Type igDP:XamDataGrid}, RecordSeparatorStyle}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey ResourceId=SummaryCommandButtonsBackgroundHover, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="HorizontalAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalAlignment"
			Value="Stretch" />
		<Setter
			Property="Height"
			Value="6" />
		<Setter
			Property="BorderThickness"
			Value="0,1,0,1" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey ResourceId=SummaryCommandButtonsBorder, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
	</Style>
	<Style
		TargetType="{x:Type igDP:XamDataGrid}"
		x:Key="{x:Type igDP:XamDataGrid}">
		<Setter
			Property="Background"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.BaseBackgroundKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:XamDataGrid}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<Grid
							Name="PART_ContentSiteGrid" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igDP:CellPresenter}"
		x:Key="{x:Type igDP:CellPresenter}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:CellPresenter}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
						<igDP:CellPresenterLayoutElement
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<DataTemplate
		x:Key="{x:Static igDP:DataPresenterBase.DataErrorContentTemplateKey}">
		<Border
			Name="Bd">
			<DockPanel
				Name="panel">
				<igWindows:AutomationControl
					Name="errorIcon"
					DockPanel.Dock="Left"
					Visibility="Collapsed"
					Margin="2,0"
					Style="{DynamicResource igDP:DataPresenterBase.DataErrorIconStyleKey}" />
				<ContentPresenter
					ContentTemplate="{Binding Path=Content.Host.ContentTemplate, RelativeSource={x:Static RelativeSource.Self}}"
					DataContext="{Binding Path=Content.Host.DataContext, RelativeSource={x:Static RelativeSource.Self}}" />
			</DockPanel>
		</Border>
		<DataTemplate.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="true"
						Binding="{Binding Path=Host.HasDataError}" />
					<Condition
						Value="true"
						Binding="{Binding Path=Host.IsDataErrorDisplayModeIcon}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="errorIcon"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="errorIcon"
					Property="FrameworkElement.ToolTip"
					Value="{Binding Path=Host.DataError}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="true"
						Binding="{Binding Path=Host.HasDataError}" />
					<Condition
						Value="true"
						Binding="{Binding Path=Host.IsDataErrorDisplayModeHighlight}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="Bd"
					Value="{DynamicResource igDP:DataPresenterBrushKeys.DataErrorHighlightBackgroundBrushKey}"
					Property="Background" />
				<Setter
					TargetName="Bd"
					Value="{DynamicResource igDP:DataPresenterBrushKeys.DataErrorHighlightBorderBrushKey}"
					Property="BorderBrush" />
				<Setter
					TargetName="Bd"
					Property="BorderThickness"
					Value="1" />
				<Setter
					TargetName="Bd"
					Property="Border.CornerRadius"
					Value="1" />
				<Setter
					TargetName="panel"
					Property="FrameworkElement.ToolTip"
					Value="{Binding Path=Host.DataError}" />
			</MultiDataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
