	</Style>
	<Style
		TargetType="{x:Type igDP:CellValuePresenter}"
		x:Key="{x:Type igDP:CellValuePresenter}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundHover"
			Value="#00FFFFFF" />
		<Setter
			Property="igDP:CellValuePresenter.BorderHoverBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundActive">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FF85A2B2" />
					<GradientStop
						Offset="1.1"
						Color="#00FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderActiveBrush"
			Value="#00151C55" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundSelected">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFCAEBFF" />
					<GradientStop
						Offset="1.1"
						Color="#00FFFFFF" />
					<GradientStop
						Color="#83CAEBFF"
						Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderSelectedBrush"
			Value="#FF666666" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundFieldSelected">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFDDDDDD" />
					<GradientStop
						Offset="1.1"
						Color="#00FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderFieldSelectedBrush"
			Value="#FF666666" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundPrimary"
			Value="#7FE9E9E9" />
		<Setter
			Property="igDP:CellValuePresenter.BorderPrimaryBrush"
			Value="#FFE9E9E9" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundStyle">
			<Setter.Value>
				<Style />
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.ForegroundActiveStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundAlternateStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundPrimaryStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundSelectedStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundFieldSelectedStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundHoverStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.CornerRadius"
			Value="0" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="Padding"
			Value="2,0,0,0" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:CellValuePresenter}">
					<igWindows:CardPanel>
						<Border
							Name="MainBorder"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}" />
						<Rectangle
							Name="Active"
							Fill="{TemplateBinding igDP:BackgroundActive}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Width="Auto"
							Height="Auto"
							SnapsToDevicePixels="True"
							Opacity="1"
							Visibility="Collapsed"
							StrokeThickness="1"
							Stroke="{TemplateBinding igDP:BorderActiveBrush}" />
						<ContentPresenter
							Name="PART_EditorSite"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Margin="{TemplateBinding Padding}"
							Style="{TemplateBinding igDP:ForegroundStyle}" />
					</igWindows:CardPanel>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:DataItemPresenter.HighlightAsPrimary"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundPrimary, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderPrimaryBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundPrimaryStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsFieldSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundFieldSelected, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderFieldSelectedBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundFieldSelectedStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundSelected, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderSelectedBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundSelectedStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsActive"
							Value="True">
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundActiveStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="Active"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
								<Condition
									Property="igDP:CellValuePresenter.IsSelected"
									Value="False" />
								<Condition
									Property="igDP:CellValuePresenter.IsFieldSelected"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundHover, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderHoverBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundHoverStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<DataTrigger
							Value="True"
							Binding="{Binding Path=Field.IsFixedStateChanging, RelativeSource={RelativeSource Self}}">
							<Setter
								Property="Background"
								Value="#AA8DBAEB" />
							<Setter
								Property="BorderBrush"
								Value="#AA8DBAEB" />
						</DataTrigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsDataErrorTemplateActive"
							Value="True">
							<Setter
								TargetName="PART_EditorSite"
								Value="{DynamicResource igDP:DataPresenterBase.DataErrorContentTemplateKey}"
								Property="ContentTemplate" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igDP:CellValuePresenter.IsRecordSelected"
				Value="True">
				<Setter
					Property="igDP:CellValuePresenter.ForegroundStyle"
					Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
			</Trigger>
			<Trigger
				Property="igDP:CellValuePresenter.IsMouseOverRecord"
				Value="True">
				<Setter
					Property="igDP:CellValuePresenter.ForegroundStyle"
					Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igDP:DataRecordPresenter}"
		x:Key="{x:Type igDP:DataRecordPresenter}">
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="igDP:DataRecordPresenter.HeaderAreaBackground"
			Value="{DynamicResource {ComponentResourceKey ResourceId=LabelBackground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:RecordPresenter.NestedContentBackground"
			Value="#00FFFFFF" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#FFCCCCCC" />
		<Setter
			Property="Margin"
			Value="0" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:DataRecordPresenter}">
					<igWindows:CardPanel
						Name="baseGrid"
						RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
						Background="{TemplateBinding Background}">
						<Border
							Name="addRowFooter"
							Visibility="Collapsed"
							BorderBrush="{TemplateBinding BorderBrush}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Width="Auto"
							Height="Auto"
							BorderThickness="{TemplateBinding BorderThickness}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							Background="{DynamicResource {ComponentResourceKey ResourceId=AddRowBackground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
						<Grid
							Margin="0"
							RenderTransform="{TemplateBinding igDP:ScrollableElementTransform}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>
							<Border
								Name="OrientationHorizontalSep"
								BorderThickness="0,0,1,0"
								Grid.ColumnSpan="6"
								Background="#FFFAFAFA"
								BorderBrush="#FFE7E7E7"
								Visibility="Collapsed" />
							<igWindows:ExpansionIndicator
								Name="ExpansionIndicator"
								Panel.ZIndex="1"
								RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
								Grid.Row="3"
								Grid.Column="1"
								Command="{x:Static igDP:DataPresenterCommands.ToggleRecordIsExpanded}"
								CommandParameter="{TemplateBinding igDP:Record}"
								ToggleMode="Manual"
								Visibility="{Binding Path=ExpansionIndicatorVisibility, RelativeSource={RelativeSource TemplatedParent}}"
								IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
							<igWindows:CardPanel
								Name="SpacerFill"
								RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
								Grid.Row="1"
								Grid.Column="1"
								Grid.ColumnSpan="6"
								Visibility="Visible">
								<Rectangle
									Name="fill"
									Margin="0,0,0,0"
									Fill="{TemplateBinding igDP:HeaderAreaBackground}" />
								<Rectangle
									Name="lightLine"
									Fill="#3FFFFFFF"
									VerticalAlignment="Top"
									Margin="0,1,0,0"
									Width="Auto"
									Height="1" />
								<Rectangle
									Name="darkLine"
									Fill="#66000000"
									VerticalAlignment="Top"
									Margin="0,0,0,0"
									Width="Auto"
									Height="1" />
							</igWindows:CardPanel>
							<ContentPresenter
								Name="PART_HeaderContentSite"
								Grid.Row="1"
								Grid.Column="3"
								Content="{TemplateBinding igDP:HeaderContent}"
								Visibility="Visible"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
							<Border
								Name="RecordSeparator"
								Grid.Row="2"
								Grid.Column="1"
								Visibility="Collapsed"
								RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
								Grid.ColumnSpan="6"
								Style="{DynamicResource {ComponentResourceKey ResourceId=RecordSeparatorStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<ContentPresenter
								Name="PART_RecordContentSite"
								Grid.Row="3"
								Grid.Column="3"
								Content="{TemplateBinding DataContext}"
								ContentTemplate="{TemplateBinding igDP:RecordContentAreaTemplate}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
							<Border
								Name="PART_NestedContentSite"
								Grid.Row="5"
								Grid.Column="3"
								Visibility="Visible"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
								Background="{TemplateBinding igDP:NestedContentBackground}">
								<ContentControl
									Name="contentControl"
									RenderTransform="{TemplateBinding igDP:ScrollableElementTransform}"
									Content="{TemplateBinding igDP:NestedContent}"
									Margin="2,0,0,0" />
							</Border>
						</Grid>
					</igWindows:CardPanel>
					<ControlTemplate.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="True"
									Binding="{Binding Path=FieldLayout.AutoFitToWidth, RelativeSource={RelativeSource Self}}" />
								<Condition
									Value="Vertical"
									Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_HeaderContentSite"
								Property="ColumnSpan"
								Value="3" />
							<Setter
								TargetName="PART_RecordContentSite"
								Property="ColumnSpan"
