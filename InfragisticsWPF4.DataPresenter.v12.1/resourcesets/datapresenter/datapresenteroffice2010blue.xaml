<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006" xmlns:igWindows="http://infragistics.com/Windows" xmlns:editors="http://infragistics.com/Editors" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter" xmlns:themes="clr-namespace:Infragistics.Windows.Themes">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="DataPresenterGeneric.xaml" />
		<ResourceDictionary
			Source="DataPresenterOffice2k7Blue.xaml" />
		<ResourceDictionary
			Source="../DataPresenterBrushes/DataPresenterOffice2010Blue_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		BasedOn="{x:Static themes:DataPresenterGeneric.DataRecordCellArea}"
		TargetType="{x:Type igDP:DataRecordCellArea}"
		x:Key="{x:Type igDP:DataRecordCellArea}">
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundHover"
			Value="{StaticResource NewBrush1}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderHoverBrush"
			Value="{StaticResource Brush_1000}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundActive"
			Value="{StaticResource NewBrush2}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderActiveBrush"
			Value="{StaticResource Brush_1001}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundAlternate"
			Value="{StaticResource Brush_1002}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundSelected"
			Value="{StaticResource NewBrush3}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundActiveStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundSelectedStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundHoverStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=GrayForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,1" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource Brush_1003}" />
		<Setter
			Property="igDP:DataRecordCellArea.CornerRadius"
			Value="0,0,0,0" />
	</Style>
	<Style
		TargetType="{x:Type igDP:SummaryButton}"
		x:Key="{x:Type igDP:SummaryButton}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:SummaryButton}"
					Triggers="">
					<Grid
						Name="grid"
						Visibility="Visible">
						<StackPanel
							Name="stackPanel"
							HorizontalAlignment="Center"
							VerticalAlignment="Stretch"
							Orientation="Horizontal"
							Margin="0,0,3,0"
							Visibility="Visible"
							Background="{StaticResource Brush_1004}">
							<Border
								Name="border1"
								Width="1"
								Margin="0,1,5,2"
								BorderThickness="1,0,0,0"
								Height="Auto"
								BorderBrush="{StaticResource Brush_1005}" />
							<Path
								Name="path"
								Stretch="Fill"
								Data="M0,0 C0,0 5,0 5,0 C5,0 5,1 5,1 C5,1 2,1 2,1 C2,1 4,3.5 4,3.5 C4,3.5 2,6 2,6 C2,6 5,6 5,6 C5,6 5,7 5,7 C5,7 0,7 0,7 C0,7 0,6 0,6 C0,6 2,3.5625 2,3.5625 C2,3.5625 0,1 0,1 C0,1 0,0 0,0"
								Fill="{TemplateBinding Foreground}"
								Width="5"
								Height="7"
								HorizontalAlignment="Stretch"
								StrokeThickness="0"
								Stroke="{x:Null}" />
						</StackPanel>
						<Popup
							Name="PART_Popup"
							AllowsTransparency="True"
							Placement="Bottom"
							VerticalOffset="2"
							HorizontalOffset="0"
							StaysOpen="False"
							PopupAnimation="{DynamicResource SystemParameters.ComboBoxPopupAnimationKey}"
							SnapsToDevicePixels="True"
							IsOpen="{Binding Path=IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
							<Border
								Name="border"
								KeyboardNavigation.DirectionalNavigation="Contained"
								KeyboardNavigation.TabNavigation="Contained"
								FocusManager.IsFocusScope="True"
								BorderThickness="1,1,1,1"
								CornerRadius="3,3,3,3"
								BorderBrush="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonPopupBorder, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}"
								Background="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonPopupBackground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}">
								<Grid
									Width="Auto"
									Height="Auto">
									<Border
										Width="28"
										HorizontalAlignment="Left"
										BorderThickness="0,0,1,0"
										CornerRadius="3,0,0,0"
										Background="{StaticResource Brush_1006}"
										BorderBrush="{StaticResource Brush_1008}" />
									<StackPanel
										Margin="5,5,5,5">
										<igDP:SummaryCalculatorSelectionControl
											Name="CalculatorSelectionControl"
											Field="{TemplateBinding Field}" />
										<Grid
											Width="Auto"
											Height="Auto">
											<Border
												Margin="-5,0,-5,-5"
												CornerRadius="0,0,3,3"
												Background="{StaticResource Brush_1007}" />
											<Rectangle
												Name="rectangle1"
												Width="Auto"
												Height="1"
												Margin="-5,1,-5,0"
												VerticalAlignment="Top"
												Fill="{StaticResource Brush_1009}"
												Stroke="{x:Null}" />
											<StackPanel
												Orientation="Horizontal"
												HorizontalAlignment="Right"
												Margin="0,5,0,0">
												<Button
													Name="RowSummaryOkButton"
													Content="Ok"
													IsDefault="True"
													Height="12"
													Margin="0,0,5,0"
													Width="13"
													Style="{DynamicResource {ComponentResourceKey ResourceId=RowSummaryOkButton, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
												<Button
													Name="RowSummaryCancelButton"
													Content="Cancel"
													IsCancel="True"
													Height="12"
													Width="13"
													Style="{DynamicResource {ComponentResourceKey ResourceId=RowSummaryCancelButton, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
											</StackPanel>
										</Grid>
									</StackPanel>
								</Grid>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Background"
			Value="{x:Null}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonForeground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
	</Style>
</ResourceDictionary>
