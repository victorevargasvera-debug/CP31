	<Style
		TargetType="{x:Type RepeatButton}"
		x:Key="VerticalScrollBarButton">
		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="IsTabStop"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Background="#00FFFFFF">
						<Border
							Name="ButtonBackground"
							Visibility="Collapsed"
							BorderThickness="1"
							CornerRadius="1"
							Background="{StaticResource RepeatBtnHoverBackgroundBrush}"
							BorderBrush="{StaticResource RepeatBtnHoverBorderBrush}">
							<Rectangle
								Name="highlight"
								Visibility="Collapsed"
								Stroke="{StaticResource RepeatBtnHoverHighlightBrush}" />
						</Border>
						<ContentPresenter />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="ButtonBackground"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="highlight"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="ButtonBackground"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="ButtonBackground"
								Property="Background"
								Value="{StaticResource RepeatBtnPressedBackgroundBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
