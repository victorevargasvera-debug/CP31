					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="grid1">
						<Rectangle
							Margin="-5"
							Fill="{StaticResource TransparentBrush}" />
						<Path
							Name="Arrow"
							Data="F1 M541.537,173.589 L531.107,173.589 L536.322,167.49 L541.537,173.589"
							Height="6"
