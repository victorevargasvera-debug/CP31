							Fill="{StaticResource ArrowNormalFill}" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Arrow"
								Property="Fill"
								Value="{StaticResource ArrowHoverFill}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="Arrow"
								Property="Fill"
								Value="{StaticResource ArrowPressedFill}" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								TargetName="Arrow"
								Property="Fill"
