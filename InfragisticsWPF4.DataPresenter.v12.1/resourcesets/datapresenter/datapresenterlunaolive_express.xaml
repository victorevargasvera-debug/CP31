		<Setter
			Property="igDP:CellValuePresenter.BorderHoverBrush"
			Value="#00EDEDED" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundActive">
			<Setter.Value>
				<LinearGradientBrush
					EndPoint="0,1"
					StartPoint="0,0">
					<GradientStop
						Color="#59FFFFFF"
						Offset="0" />
					<GradientStop
						Color="#00FFFFFF"
