<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.RadioLicense.FeaturesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:igEditors="http://infragistics.com/Editors" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:radiolicense="clr-namespace:Motorola.CommonCPS.RadioManagement.RadioLicense">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.RMRLS;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<controls:RMDataGrid
		Name="dgrFeatureList"
		igDP:GroupByAreaLocation="None"
		CRUDToolBarVisibility="Visible"
		igDP:DataSource="{Binding Items}"
		SearchCommand="{Binding SearchCommand}"
		infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
		infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
		AddCommand="{Binding PrepareRegisterRadioLicenseDialogCommand}">
		<igDP:DataPresenterBase.FieldLayouts>
			<igDP:FieldLayout>
				<igDP:FieldLayout.Fields>
					<igDP:Field
						Name="FeatureName"
						Label="{x:Static resourceRepository:Resources.RMC_Model_RadioLicenseFeatureViewBase_FeatureName}"
						Column="0">
						<igDP:Field.Settings>
							<igDP:FieldSettings>
								<igDP:FieldSettings.EditorStyle>
									<Style
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						Name="RadioCount"
						Label="{x:Static resourceRepository:Resources.RMC_Model_RadioLicenseFeatureViewBase_RadioCount}"
						Column="1">
						<igDP:Field.Settings>
							<igDP:FieldSettings
								EditAsType="{x:Type sys:Int32}">
								<igDP:FieldSettings.EditorStyle>
									<Style
										TargetType="{x:Type igEditors:XamTextEditor}">
										<Setter
											Property="igEditors:ValueEditor.IsReadOnly"
											Value="True" />
									</Style>
								</igDP:FieldSettings.EditorStyle>
							</igDP:FieldSettings>
						</igDP:Field.Settings>
					</igDP:Field>
					<igDP:Field
						BindingType="Unbound"
						Name="Actions"
						Label="{x:Static resourceRepository:Resources.RMC_General_Actions}"
						Column="2">
						<igDP:Field.Settings>
							<igDP:FieldSettings
								CellValuePresenterStyle="{StaticResource ShowDetailsStyle}"
								LabelClickAction="Nothing"
								LabelTextAlignment="Center" />
						</igDP:Field.Settings>
					</igDP:Field>
				</igDP:FieldLayout.Fields>
			</igDP:FieldLayout>
		</igDP:DataPresenterBase.FieldLayouts>
	</controls:RMDataGrid>
</UserControl>
