<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.RadioLicense.RadiosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igEditors="http://infragistics.com/Editors" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:radiolicense="clr-namespace:Motorola.CommonCPS.RadioManagement.RadioLicense">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.RMRLS;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:RegionToStringConverter
				x:Key="RegionToStringConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 1-->
		<controls:RMDataGrid
			Name="dgrASTRORadioLicenses"
			Grid.Column="1"
			igDP:GroupByAreaLocation="None"
			CRUDToolBarVisibility="Visible"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			Visibility="{Binding AstroRadioLicenseVisibility}"
			infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
			AddCommand="{Binding PrepareRegisterRadioLicenseDialogCommand}">
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_SerialNumber}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_ModelNumber}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_RadioAlias}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FlashCode"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_FLASHcode}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureCount"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_FeatureCount}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									EditAsType="{x:Type sys:Int32}">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							BindingType="Unbound"
							Name="Actions"
							Label="{x:Static resourceRepository:Resources.RMC_General_Actions}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource ShowDetailsStyle}"
									LabelClickAction="Nothing"
									LabelTextAlignment="Center" />
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrPCRRadioLicenses"
			Grid.Column="1"
			igDP:GroupByAreaLocation="None"
			CRUDToolBarVisibility="Visible"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:PCR]}"
			infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
			infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
			AddCommand="{Binding PrepareRegisterRadioLicenseDialogCommand}">
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_PCRRadioLicenseRadioView_SerialNumber}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_PCRRadioLicenseRadioView_ModelNumber}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicenseRadioView_RadioAlias}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Region"
							Label="{x:Static resourceRepository:Resources.RMC_Region_Title}"
							Converter="{StaticResource RegionToStringConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureCount"
							Label="{x:Static resourceRepository:Resources.RMC_Model_PCRRadioLicenseRadioView_FeatureCount}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									EditAsType="{x:Type sys:Int32}">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							BindingType="Unbound"
							Name="Actions"
							Label="{x:Static resourceRepository:Resources.RMC_General_Actions}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource ShowDetailsStyle}"
									LabelClickAction="Nothing"
									LabelTextAlignment="Center" />
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
	</Grid>
</UserControl>
