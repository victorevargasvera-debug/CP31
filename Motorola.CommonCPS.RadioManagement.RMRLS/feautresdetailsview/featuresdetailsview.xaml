<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.RadioLicense.FeaturesDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:igEditors="http://infragistics.com/Editors" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:radiolicense="clr-namespace:Motorola.CommonCPS.RadioManagement.RadioLicense">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
		<KeyBinding
			Key="O"
			Modifiers="Control"
			Command="{Binding RestoreRadioLicenseCommand}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:RegionToStringConverter
				x:Key="RegionToStringConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<!--Unknown connection ID: 1-->
		<controls:RMDataGrid
			Name="dgrASTRORadios"
			igDP:GroupByAreaLocation="None"
			CRUDToolBarVisibility="Visible"
			ContextMenu="{StaticResource RadioLicencesGridContextMenu}"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			Visibility="{Binding AstroRadioLicenseVisibility}"
			infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
			infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
			AddCommand="{Binding PrepareRegisterRadioLicenseDialogCommand}">
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_SerialNumber}"
							Column="0">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_RadioAlias}"
							Column="1">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_ModelNumber}"
							Column="2">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FlashCode"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_FLASHCode}"
							Column="3">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="FeatureStatus"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_FeatureStatus}"
							Column="4">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Comments"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ASTRORadioLicense_Comments}"
							Column="5">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.ValueConstraint">
												<Setter.Value>
													<igEditors:ValueConstraint
														MaxLength="1024" />
												</Setter.Value>
											</Setter>
											<Setter
												Property="Background"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderBrush"
												Value="#00FFFFFF" />
											<Setter
												Property="BorderThickness"
												Value="0" />
											<Setter
												Property="Foreground"
												Value="#FF000000" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
	</Grid>
</UserControl>
