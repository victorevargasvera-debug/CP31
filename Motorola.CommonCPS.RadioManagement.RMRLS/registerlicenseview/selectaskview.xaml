<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.RadioLicense.SelectASKView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Name="uscRadios"
	Height="450"
	Width="600" xmlns:radiolicense="clr-namespace:Motorola.CommonCPS.RadioManagement.RadioLicense">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrRadios"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding SelectASKForCFSContext.Radios, Converter={StaticResource GridViewSourceConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.General_Serial_Number}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.General_RadioAlias}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							BindingType="Unbound"
							Name="ASK"
							Label="{x:Static resourceRepository:Resources.RMC_SelectASKView_ASKKey}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamComboEditor}">
											<Setter
												Property="infrastructure:FieldSelectedChanged.Command"
												Value="{Binding ElementName=uscRadios, Path=DataContext.ApplyASKToRadioCommand}" />
											<Setter
												Property="igEditors:XamComboEditor.ItemsSource"
												Value="{Binding ElementName=uscRadios, Path=DataContext.SelectASKForCFSContext.LoadedASKs}" />
											<Setter
												Property="igEditors:XamComboEditor.DisplayMemberPath"
												Value="SystemIDHex" />
											<Setter
												Property="igEditors:XamComboEditor.ValuePath"
												Value="SystemIDHex" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectASKForCFSCommand}" />
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				Command="{Binding CancelCommand}" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="4"
			Error="{Binding SelectASKForCFSContext.ExceptionMessage}" />
	</Grid>
</UserControl>
