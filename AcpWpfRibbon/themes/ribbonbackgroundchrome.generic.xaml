<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type dc:RibbonBackgroundChrome}"
		x:Key="{x:Type dc:RibbonBackgroundChrome}">
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId=Office2007, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}" />
		<Style.Triggers>
			<Trigger
				Property="dc:RibbonBackgroundChrome.EffectiveStyle"
				Value="Office2010">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=Office2010, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<ControlTemplate
		TargetType="{x:Type dc:RibbonBackgroundChrome}"
		x:Key="{ComponentResourceKey {x:Type dc:RibbonBackgroundChrome}, Office2010}">
		<Grid
			SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="{TemplateBinding dc:QatRightPosition}" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<DockPanel
				LastChildFill="True"
				Grid.ColumnSpan="3"
				Grid.Row="0">
				<Border
					Name="TitleBar"
					Height="{TemplateBinding dc:TotalTitleChromeHeight}"
					VerticalAlignment="Top"
					BorderThickness="0,0,0,0"
					CornerRadius="5,5,0,0"
					DockPanel.Dock="Top"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBottomBorder}}}" />
				<Border
					Name="TabBackground"
					BorderThickness="0,0,0,0"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabsBorder}}}" />
			</DockPanel>
			<Image
				Name="WinIcon"
				Margin="0,6,0,0"
				Width="16"
				Height="16"
				Visibility="Visible"
				Grid.Column="0"
				Grid.Row="0"
				VerticalAlignment="Top"
				HorizontalAlignment="Left" />
			<Separator
				Margin="20,7,4,0"
				Height="15"
				Grid.Column="0"
				Grid.Row="0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Style="{DynamicResource {ComponentResourceKey {x:Type dc:Ribbon}, Office2010TitleSeparator}}" />
			<dc:TitlePanel
				Name="PART_TitleContent"
				Grid.Column="1"
				Grid.Row="0"
				HorizontalAlignment="Stretch" />
			<StackPanel
				Orientation="Horizontal"
				Grid.Column="2"
				Grid.Row="0"
				Margin="0,2,0,0">
				<Button
					Name="PART_SysMinimizeButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:MinimizeButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=MinimizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Border
						Margin="0,4,0,0"
						BorderThickness="1"
						CornerRadius="1"
						Width="11"
						Height="5"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
				</Button>
				<Button
					Name="PART_SysMaximizeButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:MaximizeButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=MaximizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Border
						BorderThickness="1"
						CornerRadius="1"
						Width="11"
						Height="9"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
						<Border
							Width="5"
							Height="3"
							Margin="2"
							BorderThickness="1"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
					</Border>
				</Button>
				<Button
					Name="PART_SysRestoreButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:RestoreButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=RestoreButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Grid
						Width="12"
						Height="11">
						<Border
							VerticalAlignment="Top"
							HorizontalAlignment="Left"
							Margin="4,0,0,0"
							BorderThickness="1"
							CornerRadius="1"
							Width="8"
							Height="8"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
							<Border
								Width="4"
								Height="3"
								Margin="1,2,1,1"
								BorderThickness="1"
								Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
								BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						</Border>
						<Border
							VerticalAlignment="Top"
							HorizontalAlignment="Left"
							Margin="0,3,0,0"
							BorderThickness="1"
							CornerRadius="1"
							Width="8"
							Height="8"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
							<Border
								Width="4"
								Height="3"
								Margin="1,2,1,1"
								BorderThickness="1"
								Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
								BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						</Border>
					</Grid>
				</Button>
				<Button
					Name="PART_SysCloseButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:CloseButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton2010Close, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=CloseButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Canvas
						Width="11"
						Height="9"
						SnapsToDevicePixels="True">
						<Path
							SnapsToDevicePixels="True"
							Width="11"
							Height="9"
							StrokeThickness="1"
							Data="M0.5,0.5 L3,0.5 L5,2 L7,0.5 L9,0.5 L10,1 L7,4 L10,7 L9,8.5 L7,8.5 L5,6 L3,8.5 L1,8.5 L0,7.5 L3,4 L0,1 L0.5,0.5"
							Stroke="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
							Fill="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" />
					</Canvas>
				</Button>
			</StackPanel>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="dc:RibbonBackgroundChrome.IsActive"
				Value="False">
				<Setter
					TargetName="TitleBar"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBottomBorder}}}" />
				<Setter
					TargetName="TitleBar"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBackground}}}" />
			</Trigger>
			<Trigger
				Property="dc:RibbonBackgroundChrome.IsGlassEnabled"
				Value="True">
				<Setter
					TargetName="TitleBar"
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					TargetName="TitleBar"
					Property="BorderThickness"
					Value="0" />
				<Setter
					TargetName="TabBackground"
					Property="BorderThickness"
					Value="0" />
				<Setter
					TargetName="TabBackground"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabBackgroundOnGlass}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type dc:RibbonBackgroundChrome}"
		x:Key="{ComponentResourceKey {x:Type dc:RibbonBackgroundChrome}, Office2007}">
		<Grid
			SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="{TemplateBinding dc:QatRightPosition}" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
			</Grid.RowDefinitions>
			<DockPanel
				LastChildFill="True"
				Grid.ColumnSpan="3"
				Grid.Row="0">
				<Border
					Name="TitleBar"
					Height="{TemplateBinding dc:TotalTitleChromeHeight}"
					VerticalAlignment="Top"
					BorderThickness="0,0,0,1"
					CornerRadius="5,5,0,0"
					DockPanel.Dock="Top"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBottomBorder}}}" />
				<Border
					Name="TabBackground"
					BorderThickness="0,1,0,0"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabsBorder}}}" />
			</DockPanel>
			<Image
				Name="WinIcon"
				Width="16"
				Height="16"
				Visibility="Collapsed"
				Grid.Column="0"
				Grid.Row="0" />
			<dc:TitlePanel
				Name="PART_TitleContent"
				Grid.Column="1"
				Grid.Row="0"
				HorizontalAlignment="Stretch" />
			<StackPanel
				Orientation="Horizontal"
				Grid.Column="2"
				Grid.Row="0"
				Margin="0,2,0,0">
				<Button
					Name="PART_SysMinimizeButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:MinimizeButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=MinimizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Canvas
						Width="9"
						Height="9">
						<Line
							X1="0"
							Y1="6"
							X2="8"
							Y2="6"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						<Line
							X1="0"
							Y1="7"
							X2="8"
							Y2="7"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Line
							X1="0"
							Y1="8"
							X2="8"
							Y2="8"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
					</Canvas>
				</Button>
				<Button
					Name="PART_SysMaximizeButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:MaximizeButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=MaximizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Canvas
						Width="9"
						Height="9">
						<Line
							X1="0"
							Y1="1.5"
							X2="9"
							Y2="1.5"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						<Rectangle
							Canvas.Top="2"
							Canvas.Left="0"
							StrokeThickness="1"
							Width="9"
							Height="6"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Line
							X1="1"
							Y1="3"
							X2="8"
							Y2="3"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Line
							X1="1"
							Y1="4"
							X2="8"
							Y2="4"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
						<Line
							X1="0"
							Y1="8"
							X2="9"
							Y2="8"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
					</Canvas>
				</Button>
				<Button
					Name="PART_SysRestoreButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:RestoreButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=RestoreButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Canvas
						Width="9"
						Height="8">
						<Line
							X1="2"
							Y1="1.5"
							X2="9"
							Y2="1.5"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						<Rectangle
							Canvas.Top="2"
							Canvas.Left="6"
							StrokeThickness="1"
							Width="3"
							Height="5"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Line
							X1="3"
							Y1="3"
							X2="8"
							Y2="3"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
						<Line
							X1="2"
							Y1="7"
							X2="8"
							Y2="7"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
						<Line
							X1="0"
							Y1="2.5"
							X2="7"
							Y2="2.5"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
						<Rectangle
							Canvas.Top="3"
							Canvas.Left="0"
							StrokeThickness="1"
							Width="7"
							Height="5"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Line
							X1="1"
							Y1="4"
							X2="6"
							Y2="4"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
						<Line
							X1="0"
							Y1="8"
							X2="6"
							Y2="8"
							StrokeThickness="1"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
					</Canvas>
				</Button>
				<Button
					Name="PART_SysCloseButton"
					VerticalAlignment="Top"
					Visibility="{TemplateBinding dc:CloseButtonVisibility}"
					Focusable="False"
					ToolTipService.ShowOnDisabled="True"
					Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
					<FrameworkElement.ToolTip>
						<ToolTip
							Content="{DynamicResource {ComponentResourceKey ResourceId=CloseButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}" />
					</FrameworkElement.ToolTip>
					<Canvas
						Width="11"
						Height="9"
						SnapsToDevicePixels="True">
						<Path
							StrokeThickness="1"
							Data="M0,8 L4,8 L5,6 L7,8 L11,8"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}" />
						<Path
							Data="M1,0 L4,0 L5,2 L7,0 L10,0 L7,4 L7,5 L10,8 L7,8 L5,6 L4,8 L1,8 L4,5 L4,4"
							Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}" />
						<Path
							StrokeThickness="1"
							Data="M1,0.5 L4,0.5 L5,2.5 L7,0.5 L10,0.5"
							Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}" />
					</Canvas>
				</Button>
			</StackPanel>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="dc:RibbonBackgroundChrome.IsActive"
				Value="False">
				<Setter
					TargetName="TitleBar"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBottomBorder}}}" />
				<Setter
					TargetName="TitleBar"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBackground}}}" />
			</Trigger>
			<Trigger
				Property="dc:RibbonBackgroundChrome.IsGlassEnabled"
				Value="True">
				<Setter
					TargetName="TitleBar"
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					TargetName="TitleBar"
					Property="BorderThickness"
					Value="0" />
				<Setter
					TargetName="TabBackground"
					Property="BorderThickness"
					Value="0" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type Button}"
		x:Key="{ComponentResourceKey {x:Type dc:RibbonBackgroundChrome}, TitleButton}">
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="PART_SysButtonBorder"
						BorderThickness="1"
						Background="#00FFFFFF"
						BorderBrush="#00FFFFFF"
						CornerRadius="3"
						IsHitTestVisible="True">
						<Border
							Name="PART_SysButtonBorderInner"
							CornerRadius="3"
							BorderThickness="1"
							Padding="6,5,6,5">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								RecognizesAccessKey="False"
								Content="{TemplateBinding Content}" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="PART_SysButtonBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonHoverBackground}}}" />
							<Setter
								TargetName="PART_SysButtonBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonHoverBorder}}}" />
							<Setter
								TargetName="PART_SysButtonBorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonHoverBorderInner}}}" />
							<Setter
								TargetName="PART_SysButtonBorderInner"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonHoverInnerLight}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="PART_SysButtonBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonPressedBackground}}}" />
							<Setter
								TargetName="PART_SysButtonBorder"
