<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<dcc:IsStringTypeConverter
		x:Key="IsStringTypeConverter" />
	<Style
		TargetType="{x:Type dc:PaneItem}"
		x:Key="{x:Type dc:PaneItem}">
		<Style.Triggers>
			<Trigger
				Property="dc:PaneItem.SmallState"
				Value="True">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate>
							<Border
								Name="ItemBorder"
								Padding="{TemplateBinding Padding}"
								Cursor="Hand"
								Background="#00FFFFFF">
								<Grid>
									<ContentPresenter
										Name="PaneImageSmallPresenter"
										ContentSource="ImageSmall"
										Margin="1"
										VerticalAlignment="Center"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Content="{TemplateBinding dc:ImageSmall}" />
									<ContentPresenter
										Name="PaneImagePresenter"
										ContentSource="Image"
										Margin="1"
										VerticalAlignment="Center"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Visibility="Collapsed"
										Width="16"
										Height="16"
										Content="{TemplateBinding dc:Image}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="dc:PaneItem.ImageSmall"
									Value="{x:Null}">
									<Setter
										TargetName="PaneImageSmallPresenter"
										Property="Visibility"
										Value="Collapsed" />
									<Setter
										TargetName="PaneImagePresenter"
										Property="Visibility"
										Value="Visible" />
								</Trigger>
								<Trigger
									SourceName="ItemBorder"
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										TargetName="ItemBorder"
										Property="Background"
										Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}" />
								</Trigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition
											Property="UIElement.IsMouseCaptured"
											Value="True" />
										<Condition
											Property="UIElement.IsMouseOver"
											Value="True" />
									</MultiTrigger.Conditions>
									<Setter
										TargetName="ItemBorder"
										Property="Background"
										Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}" />
								</MultiTrigger>
								<Trigger
									Property="dc:PaneItem.IsSelected"
									Value="True">
									<Setter
										TargetName="ItemBorder"
										Property="Background"
										Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}" />
								</Trigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition
											Property="dc:PaneItem.IsSelected"
											Value="True" />
										<Condition
											SourceName="ItemBorder"
											Property="UIElement.IsMouseOver"
											Value="True" />
									</MultiTrigger.Conditions>
									<Setter
										TargetName="ItemBorder"
										Property="Background"
										Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBackground}}}" />
								</MultiTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Padding"
			Value="3" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:PaneItem}">
					<Border
						Name="ItemBorder"
						Cursor="Hand"
						BorderThickness="0,0,0,1"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBorder}}}">
						<Border
							Name="ItemBorderInner"
							BorderThickness="1"
							Padding="{TemplateBinding Padding}"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBorderInner}}}">
							<DockPanel
								LastChildFill="True">
								<ContentPresenter
									Name="PaneImage"
									ContentSource="Image"
									Margin="1"
									DockPanel.Dock="Left"
									VerticalAlignment="Center"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Content="{TemplateBinding dc:Image}" />
								<ContentPresenter
									Name="PART_HeaderContentHost"
									Margin="2,0,0,0"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									VerticalAlignment="Center"
									ContentSource="Header" />
							</DockPanel>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="ItemBorder"
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}" />
							<Setter
								TargetName="ItemBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBorder}}}" />
							<Setter
								TargetName="ItemBorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverForeground}}}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseCaptured"
									Value="True" />
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}" />
							<Setter
								TargetName="ItemBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBorder}}}" />
							<Setter
								TargetName="ItemBorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownForeground}}}" />
						</MultiTrigger>
						<Trigger
							Property="dc:PaneItem.IsSelected"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}" />
							<Setter
								TargetName="ItemBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBorder}}}" />
							<Setter
								TargetName="ItemBorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedForeground}}}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dc:PaneItem.IsSelected"
									Value="True" />
								<Condition
									SourceName="ItemBorder"
									Property="UIElement.IsMouseOver"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBackground}}}" />
							<Setter
								TargetName="ItemBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBorder}}}" />
							<Setter
								TargetName="ItemBorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverForeground}}}" />
						</MultiTrigger>
						<DataTrigger
							Value="true"
							Binding="{Binding Path=(HeaderedContentControl.Header), RelativeSource={RelativeSource self}, Converter={StaticResource IsStringTypeConverter}}">
							<Setter
								TargetName="PART_HeaderContentHost"
								Property="ContentTemplate">
								<Setter.Value>
									<DataTemplate>
										<FrameworkTemplate.Resources>
											<ResourceDictionary>
												<Style
													TargetType="{x:Type TextBlock}"
													x:Key="{x:Type TextBlock}">
													<Style.Triggers>
														<Trigger
															Property="IsEnabled"
															Value="False">
															<Setter
																Property="Foreground"
																Value="{DynamicResource ResourceKey={x:Static SystemColors.GrayTextBrushKey}}" />
														</Trigger>
													</Style.Triggers>
												</Style>
											</ResourceDictionary>
										</FrameworkTemplate.Resources>
										<TextBlock
											TextTrimming="CharacterEllipsis"
											FontWeight="Bold"
											Text="{Binding}" />
									</DataTemplate>
								</Setter.Value>
							</Setter>
						</DataTrigger>
						<Trigger
							Property="dc:PaneItem.PaneExpanded"
							Value="false">
							<Setter
								TargetName="PART_HeaderContentHost"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
