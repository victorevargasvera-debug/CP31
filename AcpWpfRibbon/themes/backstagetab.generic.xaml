<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfRibbon" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:BackstageTab}"
		x:Key="{x:Type dc:BackstageTab}">
		<Setter
			Property="Padding"
			Value="22,8,0,8" />
		<Setter
			Property="Margin"
			Value="0,1,0,1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="ClipToBounds"
			Value="True" />
		<Setter
			Property="FontSize"
			Value="14" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="HorizontalAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="BorderThickness"
			Value="0,1,0,1" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBorder}}}" />
		<Setter
			Property="dc:BackstageTab.InnerBorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBorderInner}}}" />
		<Setter
			Property="dc:BackstageTab.InnerBorderThickness"
			Value="0,1,0,1" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalForeground}}}" />
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:BackstageTab}">
					<Border
						Name="TabBorder"
						ContextMenu="{TemplateBinding dc:TabContextMenu}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						BorderThickness="{TemplateBinding BorderThickness}"
						ToolTip="{TemplateBinding dc:TabToolTip}">
						<Border
							Name="TabBorderInner"
							BorderBrush="{TemplateBinding dc:InnerBorderBrush}"
							BorderThickness="{TemplateBinding dc:InnerBorderThickness}"
							Padding="{TemplateBinding Padding}">
							<DockPanel
								LastChildFill="True">
								<Path
									Name="SelectMark"
									DockPanel.Dock="Right"
									Fill="#FFFFFFFF"
									Data="M0,0.5 L1,1 L1,0"
									Margin="0,2,0,-2"
									VerticalAlignment="Center"
									HorizontalAlignment="Center"
									Stretch="Fill"
									Width="6"
									Height="11"
									Visibility="Hidden" />
								<ContentPresenter
									Name="PART_HeaderContentHost"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									VerticalAlignment="Center"
									Content="{TemplateBinding Header}" />
							</DockPanel>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBackground}}}" />
							<Setter
								Property="dc:BackstageTab.InnerBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBorderInner}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBorder}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverForeground}}}" />
						</Trigger>
						<Trigger
							Property="TabItem.IsSelected"
							Value="True">
							<Setter
								TargetName="SelectMark"
								Property="Visibility"
								Value="Visible" />
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBorder}}}" />
							<Setter
								Property="dc:BackstageTab.InnerBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
