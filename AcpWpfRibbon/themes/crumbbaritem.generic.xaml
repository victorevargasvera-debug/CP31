<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<dcc:BoolToVisibilityConverter
		x:Key="BoolToVisibilityConverter" />
	<Style
		TargetType="{x:Type dc:CrumbBarItem}"
		x:Key="{x:Type dc:CrumbBarItem}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:CrumbBarItem}">
					<dc:PixelSnap>
						<dc:ButtonBorder
							Name="PART_ItemBorder"
							BorderThickness="1,1,1,1"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							CornerRadius="2"
							Padding="{TemplateBinding Padding}"
							ColorClass="{x:Static CrumbBarColors.MenuItemClass}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										SharedSizeGroup="MenuIconColumnGroup"
										Width="Auto"
										MinWidth="24" />
									<ColumnDefinition
										Width="4" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<dc:PixelSnap
									Grid.Column="0">
									<ContentPresenter
										Name="PART_ItemImage"
										Grid.Column="0"
										ContentSource="Image"
										VerticalAlignment="Center"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Content="{TemplateBinding dc:Image}" />
								</dc:PixelSnap>
								<dc:PixelSnap
									Grid.Column="2">
									<ContentPresenter
										Name="PART_ItemContent"
										HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										ContentTemplate="{TemplateBinding ContentTemplate}"
										RecognizesAccessKey="True"
										Content="{TemplateBinding Header}"
										Margin="3,1,3,0"
										Grid.Column="2" />
								</dc:PixelSnap>
							</Grid>
						</dc:ButtonBorder>
					</dc:PixelSnap>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="true">
							<Setter
								TargetName="PART_ItemBorder"
								Property="dc:ButtonBorder.ButtonState"
								Value="Hover" />
						</Trigger>
						<Trigger
							Property="dc:CrumbBarItem.IsSelected"
							Value="True">
							<Setter
								TargetName="PART_ItemContent"
								Property="FontWeight"
								Value="Bold" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
