<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type Expander}"
		x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, Expander}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource SystemColors.ControlTextBrush}" />
		<Setter
			Property="Background"
			Value="#FFFFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Expander}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="true">
						<DockPanel>
							<ToggleButton
								Name="HeaderSite"
								DockPanel.Dock="Top"
								MinWidth="0"
								MinHeight="0"
								Content="{TemplateBinding Header}"
								ContentTemplate="{TemplateBinding HeaderTemplate}"
								ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId=ExpanderTitleTop}}"
								IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
							<ContentPresenter
								Name="ExpandSite"
								DockPanel.Dock="Bottom"
								Visibility="Collapsed"
								Focusable="false"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								Margin="{TemplateBinding Padding}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="Expander.IsExpanded"
							Value="true">
							<Setter
								TargetName="ExpandSite"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="false">
							<Setter
								Value="{DynamicResource SystemColors.GrayTextBrush}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type ToggleButton}"
		x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, ExpanderTitleTop}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalBorder}}}" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalForeground}}}" />
		<Setter
			Property="FontWeight"
			Value="Bold" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ToggleButton}">
					<Border
						BorderThickness="0,0,0,1"
						Background="{TemplateBinding Background}"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalBorderContent}}}">
						<Border
							BorderThickness="1,1,0,0"
							BorderBrush="{TemplateBinding BorderBrush}">
							<DockPanel
								LastChildFill="True">
								<Border
									DockPanel.Dock="Right"
									Margin="0,0,9,0">
									<Canvas
										Width="8"
										Height="7">
										<Path
											Name="Arr1"
											Data="M0,0 L3.5,3 L7,0"
											Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalExpandForeground}}}" />
										<Path
											Name="Arr2"
											Data="M0,4 L3.5,7 L7,4"
											Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderNormalExpandForeground}}}" />
										<UIElement.Effect>
											<DropShadowEffect
												Color="White"
												ShadowDepth="0"
												BlurRadius="5"
												Opacity=".7" />
										</UIElement.Effect>
									</Canvas>
								</Border>
								<ContentPresenter
									Margin="8,0,0,0"
									Focusable="False"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
							</DockPanel>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.ExpanderMouseOverBackground}}}" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<Setter
								TargetName="Arr1"
								Property="Data"
								Value="M0,3 L3.5,0 L7,3" />
							<Setter
								TargetName="Arr2"
								Property="Data"
								Value="M0,7 L3.5,4 L7,7" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
