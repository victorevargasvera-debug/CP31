<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type dc:NavigationPaneCustomizeButton}"
		x:Key="{x:Type dc:NavigationPaneCustomizeButton}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalForeground}}}" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Padding"
			Value="7" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="ItemBorder"
						Background="#00FFFFFF"
						Cursor="Hand"
						Padding="{TemplateBinding Padding}">
						<Canvas
							Width="5"
							Height="5">
							<Path
								Data="M0,1 L5,1 L2.5,4"
								Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemCustomizeForegroundHighlight}}}" />
							<Path
								Data="M0,0 L5,0 L2.5,3"
								Fill="{TemplateBinding Foreground}" />
						</Canvas>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}" />
						</Trigger>
						<Trigger
							Property="dc:NavigationPaneCustomizeButton.IsCustomizeMenuOpen"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ContextMenu
		Style="{DynamicResource {ComponentResourceKey ResourceId=FlatContextMenu, TypeInTargetAssembly=dc:Ribbon}}"
		x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPaneCustomizeContextMenu}">
		<MenuItem
			Header="{x:Static dc:NavigationPane.SystemShowMoreButtonsMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=FlatMenuItem, TypeInTargetAssembly=dc:Ribbon}}">
			<MenuItem.Icon>
				<Image
					Source="images/NavPaneShowMore.png"
					Stretch="None" />
			</MenuItem.Icon>
		</MenuItem>
		<MenuItem
			Header="{x:Static dc:NavigationPane.SystemShowFewerButtonsMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=FlatMenuItem, TypeInTargetAssembly=dc:Ribbon}}">
			<MenuItem.Icon>
				<Image
					Source="images/NavPaneShowLess.png"
					Stretch="None" />
			</MenuItem.Icon>
		</MenuItem>
	</ContextMenu>
</ResourceDictionary>
