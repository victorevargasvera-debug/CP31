<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type DevCo:ContextGroup}"
		x:Key="{x:Type DevCo:ContextGroup}">
		<Style.Triggers>
			<Trigger
				Property="DevCo:ContextGroup.IsSimpleContent"
				Value="True">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=ContextGroupContentLabel, TypeInTargetAssembly=DevCo:ContextGroup}}" />
			</Trigger>
		</Style.Triggers>
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeBorder}}}" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeForeground}}}" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId=ContextGroupContentObject, TypeInTargetAssembly=DevCo:ContextGroup}}" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type DevCo:ContextGroup}"
		x:Key="{ComponentResourceKey {x:Type DevCo:ContextGroup}, ContextGroupContentObject}">
		<Border
			BorderThickness="1,0,1,0"
			BorderBrush="{TemplateBinding BorderBrush}">
			<DockPanel
				LastChildFill="True">
				<Border
					Height="20"
					DockPanel.Dock="Bottom" />
				<Border
					Background="{TemplateBinding Background}">
					<ContentPresenter
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding Content}"
						Margin="3,5,3,0"
						TextElement.Foreground="{TemplateBinding Foreground}"
						VerticalAlignment="Center" />
				</Border>
			</DockPanel>
		</Border>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type DevCo:ContextGroup}"
		x:Key="{ComponentResourceKey {x:Type DevCo:ContextGroup}, ContextGroupContentLabel}">
		<Border
			BorderThickness="1,0,1,0"
			BorderBrush="{TemplateBinding BorderBrush}">
			<DockPanel
				LastChildFill="True">
				<Border
					Height="20"
					DockPanel.Dock="Bottom" />
				<Border
					Background="{TemplateBinding Background}">
					<Label
						Name="PART_LabelContent"
						Foreground="{TemplateBinding Foreground}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Margin="3,5,3,0"
						VerticalAlignment="Center"
						Content="{TemplateBinding Content}" />
				</Border>
			</DockPanel>
		</Border>
	</ControlTemplate>
</ResourceDictionary>
