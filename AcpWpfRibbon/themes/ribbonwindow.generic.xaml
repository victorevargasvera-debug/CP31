<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type DevCo:RibbonWindow}"
		x:Key="{x:Type DevCo:RibbonWindow}">
		<Setter
			Property="Window.SizeToContent"
			Value="Manual" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<DevCo:WindowBorder
						Name="PART_WindowBorder"
						CornerRadius="5"
						BorderThickness="1,1,1,1"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.WindowActiveBorder}}}"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.WindowBackground}}}">
						<Grid>
							<AdornerDecorator>
								<ContentPresenter
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Content="{TemplateBinding Content}" />
							</AdornerDecorator>
							<ResizeGrip
								Name="WindowResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="false" />
						</Grid>
					</DevCo:WindowBorder>
					<ControlTemplate.Triggers>
						<Trigger
							Property="DevCo:RibbonWindow.IsUsingGlass"
							Value="True">
							<Setter
								TargetName="PART_WindowBorder"
								Property="Border.CornerRadius"
								Value="0" />
						</Trigger>
						<Trigger
							Property="Window.IsActive"
							Value="False">
							<Setter
								TargetName="PART_WindowBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.WindowInactiveBorder}}}" />
						</Trigger>
						<Trigger
							Property="DevCo:RibbonWindow.IsUsingGlass"
							Value="True">
							<Setter
								TargetName="PART_WindowBorder"
								Property="Border.CornerRadius"
								Value="0" />
							<Setter
								TargetName="PART_WindowBorder"
								Property="BorderBrush"
								Value="{x:Null}" />
							<Setter
								TargetName="PART_WindowBorder"
								Property="BorderThickness"
								Value="0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="Window.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="Window.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="WindowResizeGrip"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
