<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<dcc:IsStringTypeConverter
		x:Key="IsStringTypeConverter" />
	<Style
		TargetType="{x:Type dc:NavigationPane}"
		x:Key="{x:Type dc:NavigationPane}">
		<Style.Triggers>
			<Trigger
				Property="dc:NavigationPane.IsExpanded"
				Value="false">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate>
							<Border
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}">
								<DockPanel
									Name="PART_DockPanel"
									LastChildFill="true">
									<Border
										BorderThickness="0,0,0,1"
										BorderBrush="{TemplateBinding BorderBrush}"
										DockPanel.Dock="Top">
										<Border
											BorderThickness="1,1,0,0"
											Padding="4"
											BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"
											Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBackground}}}">
											<Button
												Name="ExpandButton"
												DockPanel.Dock="Right"
												Command="dc:NavigationPane.Expand"
												Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId=NavPaneExpandButton}}">
												<Canvas
													Width="8"
													Height="7">
													<Path
														Data="M0,0 L4,3.5 L0,7"
														Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}" />
													<Path
														Data="M4,0 L8,3.5 L4,7"
														Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}" />
													<UIElement.Effect>
														<DropShadowEffect
															Color="White"
															ShadowDepth="0"
															BlurRadius="5"
															Opacity=".7" />
													</UIElement.Effect>
												</Canvas>
											</Button>
										</Border>
									</Border>
									<Border
										DockPanel.Dock="Bottom"
										BorderThickness="0,1,0,0"
										BorderBrush="{TemplateBinding BorderBrush}">
										<dc:NavigationPanePanel
											Name="PART_ItemPanel"
											IsItemsHost="True"
											LargeItemsCount="{TemplateBinding LargeItemsCount}"
											PaneExpanded="{TemplateBinding IsExpanded}"
											ClipToBounds="True"
											SmallItemsBackground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}" />
									</Border>
									<dc:NavigationPaneSplitter
										Name="npsplitter"
										DockPanel.Dock="Bottom"
										PanePanel="{Binding ElementName=PART_ItemPanel}" />
									<Popup
										Name="PART_Popup"
										Placement="Bottom"
										Focusable="False"
										AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
										PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}">
										<WinTheme:SystemDropShadowChrome
											Name="PopupShadow">
											<Border
												Name="PopupBorder"
												BorderThickness="1"
												Padding="4"
												BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPanePopupBorder}}}"
												Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPanePopupBackground}}}">
												<ContentPresenter
													Name="PART_NavPaneContentPresenter"
													VerticalAlignment="Stretch"
													ContentSource="SelectedContent"
													SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
													ContentTemplate="{TemplateBinding dc:SelectedContentTemplate}"
													Content="{TemplateBinding dc:SelectedContent}" />
											</Border>
										</WinTheme:SystemDropShadowChrome>
									</Popup>
									<ToggleButton
										Name="PART_PopupToggle"
										Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId=NavPanePopupButton}}">
										<TextBlock
											FontWeight="Bold"
											FontSize="15"
											VerticalAlignment="Center"
											HorizontalAlignment="Center"
											SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
											TextTrimming="CharacterEllipsis"
											Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}"
											Text="{Binding Path=SystemText.CollapsedPaneText, RelativeSource={RelativeSource TemplatedParent}}">
											<FrameworkElement.LayoutTransform>
												<RotateTransform
													Angle="-90" />
											</FrameworkElement.LayoutTransform>
										</TextBlock>
									</ToggleButton>
								</DockPanel>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									SourceName="PART_Popup"
									Property="Popup.HasDropShadow"
									Value="True">
									<Setter
										TargetName="PopupShadow"
										Property="Margin"
										Value="0,0,5,5" />
									<Setter
										TargetName="PopupShadow"
										Property="WinTheme:SystemDropShadowChrome.Color"
										Value="#71000000" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel
							Name="PART_DockPanel"
							LastChildFill="true">
							<Border
								BorderThickness="0,0,0,1"
								BorderBrush="{TemplateBinding BorderBrush}"
								DockPanel.Dock="Top">
								<Border
									BorderThickness="1,1,0,0"
									Padding="4"
									BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"
									Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBackground}}}">
									<DockPanel
										LastChildFill="True">
										<ContentPresenter
											Name="PART_NavPaneTitlePresenter"
											VerticalAlignment="Center"
											SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
											ContentTemplate="{TemplateBinding dc:SelectedContentHeaderTemplate}"
											Content="{TemplateBinding dc:SelectedContentHeader}"
											TextElement.Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}" />
									</DockPanel>
								</Border>
							</Border>
							<Border
								DockPanel.Dock="Bottom"
								BorderThickness="0,1,0,0"
								BorderBrush="{TemplateBinding BorderBrush}">
								<dc:NavigationPanePanel
									Name="PART_ItemPanel"
									IsItemsHost="True"
									LargeItemsCount="{TemplateBinding LargeItemsCount}"
									ClipToBounds="True"
									SmallItemsBackground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}" />
							</Border>
							<dc:NavigationPaneSplitter
								Name="npsplitter"
								DockPanel.Dock="Bottom"
								PanePanel="{Binding ElementName=PART_ItemPanel}" />
							<ContentPresenter
								Name="PART_NavPaneContentPresenter"
								ContentSource="SelectedContent"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								ContentTemplate="{TemplateBinding dc:SelectedContentTemplate}"
								Content="{TemplateBinding dc:SelectedContent}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<DataTrigger
							Value="true"
							Binding="{Binding Path=(dc:NavigationPane.SelectedContentHeader), RelativeSource={RelativeSource self}, Converter={StaticResource IsStringTypeConverter}}">
							<Setter
								TargetName="PART_NavPaneTitlePresenter"
								Property="ContentTemplate">
								<Setter.Value>
									<DataTemplate>
										<TextBlock
											TextTrimming="CharacterEllipsis"
											FontWeight="Bold"
											FontSize="14"
											Text="{Binding}" />
									</DataTemplate>
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPaneExpandButton}">
		<Setter
			Property="Padding"
			Value="6" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="ItemBorder"
						Background="#00FFFFFF"
						Cursor="Hand"
						Padding="{TemplateBinding Padding}">
						<ContentPresenter
							ContentSource="Content"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Content="{TemplateBinding Content}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="ItemBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type ToggleButton}"
		x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPanePopupButton}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="1,1,0,0" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="ItemBorder"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						Padding="{TemplateBinding Padding}">
						<ContentPresenter
							ContentSource="Content"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Content="{TemplateBinding Content}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseOverBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseOverBorder}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseDownBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseDownBorder}}}" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedPopupOpenBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedPopupOpenBorder}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
