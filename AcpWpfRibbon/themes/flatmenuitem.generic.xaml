<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
	<StreamGeometry
		x:Key="MenuItemCheckBoxGlyph">M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z</StreamGeometry>
	<Style
		TargetType="{x:Type MenuItem}"
		x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, FlatMenuItem}">
		<Style.Triggers>
			<Trigger
				Property="MenuItem.Role"
				Value="SubmenuHeader">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=FlatSubmenuHeaderTemplateKey, TypeInTargetAssembly=dc:Ribbon}}" />
			</Trigger>
		</Style.Triggers>
		<Setter
			Property="HorizontalContentAlignment"
			Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
		<Setter
			Property="VerticalContentAlignment"
			Value="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuPopupForeground}}}" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId=FlatSubmenuItemTemplateKey, TypeInTargetAssembly=dc:Ribbon}}" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, FlatSubmenuItemTemplateKey}">
		<Grid
			SnapsToDevicePixels="true">
			<Rectangle
				Name="Bg"
				Fill="{TemplateBinding Background}"
				Stroke="{TemplateBinding BorderBrush}"
				StrokeThickness="1" />
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						MinWidth="24"
						Width="Auto"
						SharedSizeGroup="MenuItemIconColumnGroup" />
					<ColumnDefinition
						Width="4" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="37" />
					<ColumnDefinition
						Width="Auto"
						SharedSizeGroup="MenuItemIGTColumnGroup" />
					<ColumnDefinition
						Width="17" />
				</Grid.ColumnDefinitions>
				<Border
					Name="IconBorder"
					Margin="1"
					VerticalAlignment="Center"
					Padding="0,2,0,2">
					<ContentPresenter
						Name="Icon"
						ContentSource="Icon"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				</Border>
				<Border
					Name="GlyphPanel"
					BorderThickness="1"
					Margin="1"
					Visibility="Hidden"
					Width="20"
					Height="20"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBorder}}}">
					<Path
						Name="Glyph"
						Width="9"
						Height="11"
						Fill="#0C12A1"
						FlowDirection="LeftToRight"
						Data="{StaticResource MenuItemCheckBoxGlyph}" />
				</Border>
				<ContentPresenter
					Grid.Column="2"
					ContentSource="Header"
					Margin="{TemplateBinding Padding}"
					RecognizesAccessKey="true"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				<TextBlock
					Grid.Column="4"
					Text="{TemplateBinding InputGestureText}"
					Margin="{TemplateBinding Padding}" />
			</Grid>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="MenuItem.Icon"
				Value="{x:Null}">
				<Setter
					TargetName="IconBorder"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="IconBorder"
					Property="Border.Padding"
					Value="0" />
			</Trigger>
			<Trigger
				Property="MenuItem.IsChecked"
				Value="true">
				<Setter
					TargetName="GlyphPanel"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="IconBorder"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBackground}}}" />
				<Setter
					TargetName="IconBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBorder}}}" />
				<Setter
					TargetName="IconBorder"
					Property="BorderThickness"
					Value="1" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="MenuItem.IsChecked"
						Value="true" />
					<Condition
						Property="MenuItem.Icon"
						Value="{x:Null}" />
				</MultiTrigger.Conditions>
				<Setter
					TargetName="GlyphPanel"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="IconBorder"
					Property="Visibility"
					Value="Collapsed" />
			</MultiTrigger>
			<Trigger
				Property="MenuItem.IsHighlighted"
				Value="true">
				<Setter
					TargetName="Bg"
					Property="Fill"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemMouseOverBackground}}}" />
				<Setter
					TargetName="Bg"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemMouseOverBorder}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="false">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
				<Setter
					TargetName="GlyphPanel"
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					TargetName="GlyphPanel"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
				<Setter
					TargetName="Glyph"
					Property="Fill"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, FlatSubmenuHeaderTemplateKey}">
		<Grid
			SnapsToDevicePixels="true">
			<Rectangle
				Name="Bg"
				Fill="{TemplateBinding Background}"
				Stroke="{TemplateBinding BorderBrush}"
				StrokeThickness="1" />
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						MinWidth="24"
						Width="Auto"
						SharedSizeGroup="MenuItemIconColumnGroup" />
					<ColumnDefinition
						Width="4" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="37" />
					<ColumnDefinition
						Width="Auto"
						SharedSizeGroup="MenuItemIGTColumnGroup" />
					<ColumnDefinition
						Width="17" />
				</Grid.ColumnDefinitions>
				<Border
					Name="IconBorder"
					Margin="1"
					VerticalAlignment="Center">
					<ContentPresenter
						Name="Icon"
						ContentSource="Icon"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				</Border>
				<Border
					Name="GlyphPanel"
					BorderThickness="1"
					Margin="1"
					Visibility="Hidden"
					Width="20"
					Height="20"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBackground}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBorder}}}">
					<Path
						Name="Glyph"
						Width="9"
						Height="11"
						Fill="#0C12A1"
						FlowDirection="LeftToRight"
						Data="{StaticResource MenuItemCheckBoxGlyph}" />
				</Border>
				<ContentPresenter
					Grid.Column="2"
					ContentSource="Header"
					Margin="{TemplateBinding Padding}"
					RecognizesAccessKey="true"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				<TextBlock
					Grid.Column="4"
					Text="{TemplateBinding InputGestureText}"
					Margin="{TemplateBinding Padding}" />
				<Path
					Grid.Column="5"
					VerticalAlignment="Center"
					Margin="4,0,0,0"
					Fill="{TemplateBinding Foreground}"
					Data="M0,0 L4,3.5 L0,7" />
			</Grid>
			<Popup
				Name="PART_Popup"
				AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
				Placement="Right"
				VerticalOffset="-3"
				HorizontalOffset="-2"
				Focusable="false"
				PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimation}"
				IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
				<mwt:SystemDropShadowChrome
					Name="Shdw"
					Color="Transparent">
					<ContentControl
						Name="SubMenuBorder"
						IsTabStop="false"
						Template="{DynamicResource {ComponentResourceKey ResourceId=FlatSubmenuContent, TypeInTargetAssembly=dc:Ribbon}}">
						<ScrollViewer
							CanContentScroll="true"
							Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}">
							<ItemsPresenter
								Margin="2"
								KeyboardNavigation.TabNavigation="Cycle"
								KeyboardNavigation.DirectionalNavigation="Cycle"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								Grid.IsSharedSizeScope="true" />
						</ScrollViewer>
					</ContentControl>
				</mwt:SystemDropShadowChrome>
			</Popup>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="MenuItem.Icon"
				Value="{x:Null}">
				<Setter
					TargetName="IconBorder"
					Property="Visibility"
					Value="Collapsed" />
			</Trigger>
			<Trigger
				Property="MenuItem.IsChecked"
				Value="true">
				<Setter
					TargetName="GlyphPanel"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="IconBorder"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBackground}}}" />
				<Setter
					TargetName="IconBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemCheckedBorder}}}" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="MenuItem.IsChecked"
						Value="true" />
					<Condition
						Property="MenuItem.Icon"
						Value="{x:Null}" />
				</MultiTrigger.Conditions>
				<Setter
					TargetName="GlyphPanel"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="IconBorder"
					Property="Visibility"
					Value="Collapsed" />
			</MultiTrigger>
			<Trigger
				Property="MenuItem.IsHighlighted"
				Value="true">
				<Setter
					TargetName="Bg"
					Property="Fill"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemMouseOverBackground}}}" />
				<Setter
					TargetName="Bg"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemMouseOverBorder}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="false">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
				<Setter
					TargetName="GlyphPanel"
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					TargetName="GlyphPanel"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
				<Setter
					TargetName="Glyph"
					Property="Fill"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuItemDisabledForeground}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type ContentControl}"
		x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, FlatSubmenuContent}">
		<Border
			BorderThickness="1"
			Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuPopupBackground}}}"
			BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuPopupBorder}}}">
			<Grid>
				<Rectangle
					HorizontalAlignment="Left"
					Width="28"
					Margin="2"
					Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.MenuPopupIconBackground}}}" />
				<ContentPresenter
					Grid.ColumnSpan="2"
					Margin="1,0" />
			</Grid>
		</Border>
	</ControlTemplate>
	<Style
		TargetType="{x:Type Separator}"
		x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, FlatSeparator}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:MenuItemColors.SeparatorBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="MinHeight"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Padding"
			Value="30,0,1,0" />
		<Setter
			Property="Margin"
			Value="0,1,0,1" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Separator}">
					<Border
						Margin="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
