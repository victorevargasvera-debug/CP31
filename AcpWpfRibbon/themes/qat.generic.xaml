<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
	<dcc:BoolToVisibilityConverter
		x:Key="BoolToVisibilityConverter" />
	<Style
		TargetType="{x:Type DevCo:Qat}"
		x:Key="{x:Type DevCo:Qat}">
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Foreground"
			Value="#FFFF0000" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<DockPanel
						KeyboardNavigation.TabNavigation="None"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<DevCo:QatBorder
							Name="MainPanelBorder"
							Margin="0,0,6,0"
							BorderThickness="1"
							IsBorderVisible="{TemplateBinding IsAboveRibbon}"
							Padding="{TemplateBinding Padding}"
							MinHeight="24"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveBorder}}}"
							LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveLightBorder}}}"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveBackground}}}">
							<DevCo:QatPanel
								Name="PART_ToolBarPanel"
								Margin="7,1,2,2"
								IsItemsHost="True"
								KeyboardNavigation.DirectionalNavigation="Continue" />
						</DevCo:QatBorder>
						<ToggleButton
							Name="PART_OverflowButton"
							ClickMode="Press"
							MinWidth="12"
							MinHeight="22"
							IsChecked="{Binding Path=IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}"
							FocusVisualStyle="{x:Null}"
							Visibility="{TemplateBinding DevCo:Qat.HasOverflowItems, Converter={StaticResource BoolToVisibilityConverter}}">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type ToggleButton}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type ToggleButton}">
												<DevCo:ButtonBorder
													Name="ToggleButtonBorder"
													BorderThickness="1,1,1,1"
													SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
													CornerRadius="2">
													<Canvas
														Width="6"
														Height="4">
														<Path
															Data="M0,3 L2,1.5 L0,0"
															Fill="{TemplateBinding Foreground}" />
														<Path
															Canvas.Left="4"
															Data="M0,3 L2,1.5 L0,0"
															Fill="{TemplateBinding Foreground}" />
													</Canvas>
												</DevCo:ButtonBorder>
												<ControlTemplate.Triggers>
													<Trigger
														Property="UIElement.IsMouseOver"
														Value="True">
														<Setter
															TargetName="ToggleButtonBorder"
															Property="DevCo:ButtonBorder.ButtonState"
															Value="Hover" />
													</Trigger>
													<Trigger
														Property="ToggleButton.IsChecked"
														Value="True">
														<Setter
															TargetName="ToggleButtonBorder"
															Property="DevCo:ButtonBorder.ButtonState"
															Value="Expanded" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</FrameworkElement.Style>
						</ToggleButton>
						<Popup
							Name="OverflowPopup"
							Placement="Bottom"
							StaysOpen="False"
							Focusable="False"
							AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}"
							IsOpen="{TemplateBinding DevCo:IsOverflowOpen}"
							PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}">
							<WinTheme:SystemDropShadowChrome
								Name="Shdw"
								Color="#71000000"
								Margin="0,0,5,5">
								<Border
									BorderBrush="#FF8A867A"
									BorderThickness="1,1,1,1"
									Background="#FFFCFCF9"
									CornerRadius="3">
									<DevCo:QatOverflowPanel
										Name="PART_OverflowPanel"
										Margin="2,2,2,2"
										Focusable="True"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Orientation="Horizontal"
										KeyboardNavigation.TabNavigation="Cycle"
										KeyboardNavigation.DirectionalNavigation="Cycle"
										FocusVisualStyle="{x:Null}" />
								</Border>
							</WinTheme:SystemDropShadowChrome>
						</Popup>
					</DockPanel>
					<ControlTemplate.Triggers>
						<Trigger
							Property="DevCo:Qat.IsActive"
							Value="False">
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatInactiveBorder}}}" />
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.LightBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatInactiveLightBorder}}}" />
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatInactiveBackground}}}" />
						</Trigger>
						<Trigger
							Property="DevCo:Qat.IsAboveRibbon"
							Value="False">
							<Setter
								TargetName="MainPanelBorder"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="PART_ToolBarPanel"
								Property="Margin"
								Value="0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="DevCo:Qat.IsGlassEnabled"
									Value="true" />
								<Condition
									Property="DevCo:Qat.IsAboveRibbon"
									Value="true" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveGlassBorder}}}" />
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.LightBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveGlassLightBorder}}}" />
							<Setter
								TargetName="MainPanelBorder"
								Property="DevCo:QatBorder.Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.QatActiveGlassBackground}}}" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ContextMenu
		Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonContextMenu, TypeInTargetAssembly=DevCo:Ribbon}}"
		x:Key="{ComponentResourceKey {x:Type DevCo:Ribbon}, QatCustomizeContextMenu}">
		<MenuItem
			Header="{x:Static DevCo:Ribbon.SystemAddToQatMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonMenuItem, TypeInTargetAssembly=DevCo:Ribbon}}" />
		<MenuItem
			Header="{x:Static DevCo:Ribbon.SystemRemoveFromQatMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonMenuItem, TypeInTargetAssembly=DevCo:Ribbon}}" />
		<Separator
			Style="{DynamicResource Separator}" />
		<MenuItem
			Header="{x:Static DevCo:Ribbon.SystemCustomizeQatMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonMenuItem, TypeInTargetAssembly=DevCo:Ribbon}}" />
		<MenuItem
			Header="{x:Static DevCo:Ribbon.SystemQatChangePlacementMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonMenuItem, TypeInTargetAssembly=DevCo:Ribbon}}" />
		<Separator
			Style="{DynamicResource Separator}" />
		<MenuItem
			Header="{x:Static DevCo:Ribbon.SystemQatMinMaxRibbonMenuItem}"
			Style="{DynamicResource {ComponentResourceKey ResourceId=RibbonMenuItem, TypeInTargetAssembly=DevCo:Ribbon}}" />
	</ContextMenu>
</ResourceDictionary>
