<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
	<Style
		TargetType="{x:Type DevCo:RibbonTab}"
		x:Key="{x:Type DevCo:RibbonTab}">
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="DevCo:Ribbon.IsCustomizable"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<DevCo:RibbonTabBorder
						Name="PART_RibbonTabBorder"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<ContentPresenter
							ClipToBounds="True"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							ContentTemplate="{TemplateBinding HeaderTemplate}"
							RecognizesAccessKey="True"
							Content="{TemplateBinding Header}" />
					</DevCo:RibbonTabBorder>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="PART_RibbonTabBorder"
							Property="DevCo:RibbonTabBorder.TabState"
							Value="Selected">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonTabSelectedForeground}}}" />
						</Trigger>
						<Trigger
							SourceName="PART_RibbonTabBorder"
							Property="DevCo:RibbonTabBorder.TabState"
							Value="Hover">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonTabHoverForeground}}}" />
						</Trigger>
						<Trigger
							SourceName="PART_RibbonTabBorder"
							Property="DevCo:RibbonTabBorder.TabState"
							Value="HoverSelected">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonTabHoverSelectedForeground}}}" />
						</Trigger>
						<Trigger
							SourceName="PART_RibbonTabBorder"
							Property="DevCo:RibbonTabBorder.TabState"
							Value="Focused">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonTabFocusedForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
