<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
	<dcc:ImagePositionToDockConverter
		x:Key="ImagePositionToDockConverter" />
	<dcc:ExpandPositionToDockConverter
		x:Key="ExpandPositionToDockConverter" />
	<dcc:BoolToVisibilityConverter
		x:Key="BoolToVisibilityConverter" />
	<Style
		TargetType="{x:Type DevCo:Gallery}"
		x:Key="{x:Type DevCo:Gallery}">
		<Style.Triggers>
			<Trigger
				Property="DevCo:Gallery.IsCollapsed"
				Value="True">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=GalleryButton, TypeInTargetAssembly=DevCo:Gallery}}" />
				<Setter
					Property="DevCo:ButtonDropDown.ExpandPosition"
					Value="Bottom" />
				<Setter
					Property="Margin"
					Value="0" />
			</Trigger>
		</Style.Triggers>
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryNormalBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Margin"
			Value="3" />
		<Setter
			Property="DevCo:ButtonDropDown.Role"
			Value="DropDown" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="DevCo:ButtonDropDown.ImagePosition"
			Value="Top" />
		<Setter
			Property="DevCo:ButtonDropDown.CommandParameter">
			<Setter.Value>
				<DevCo:ButtonCommandParameter />
			</Setter.Value>
		</Setter>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type DevCo:Gallery}">
					<Border
						Name="PART_GalleryBorder"
						Background="{TemplateBinding Background}"
						CornerRadius="3"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="{TemplateBinding Padding}">
						<Grid
							SnapsToDevicePixels="True">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<Popup
								Name="PART_Popup"
								Placement="Bottom"
								Focusable="False"
								AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}"
								PopupAnimation="None"
								MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
								IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
								<WinTheme:SystemDropShadowChrome
									Name="Shdw"
									Color="#00FFFFFF">
									<Border
										BorderThickness="1,1,1,1"
										CornerRadius="3"
										BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBorder}}}"
										Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBackground}}}">
										<StackPanel
											Orientation="Vertical">
											<ScrollViewer
												Name="PopupScrollViewer"
												CanContentScroll="False"
												Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryMenuScrollViewer, TypeInTargetAssembly=DevCo:Gallery}}">
												<StackPanel
													Name="PopupContainerPanel"
													Orientation="Vertical" />
											</ScrollViewer>
											<Separator
												Padding="0"
												Margin="0"
												Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
											<Grid
												Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}">
												<Rectangle
													Margin="1,0,1,1"
													Width="28"
													RadiusY="2"
													HorizontalAlignment="Left"
													RadiusX="2"
													Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideBackground}}}" />
												<Rectangle
													Margin="29,0,0,2"
													Width="1"
													HorizontalAlignment="Left"
													Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineDark}}}" />
												<Rectangle
													Margin="30,0,0,2"
													Width="1"
													HorizontalAlignment="Left"
													Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineLight}}}" />
												<StackPanel
													Name="PART_MenuItemsPanel"
													Orientation="Vertical"
													Grid.ColumnSpan="2" />
											</Grid>
											<Border
												BorderThickness="0,1,0,0"
												MinHeight="11"
												Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBackground}}}"
												BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBorder}}}"
												Visibility="{TemplateBinding DevCo:Gallery.IsResizeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
												<Thumb
													Name="GalleryPopupResizeThumb"
													Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryThumb, TypeInTargetAssembly=DevCo:Gallery}}" />
											</Border>
										</StackPanel>
									</Border>
								</WinTheme:SystemDropShadowChrome>
							</Popup>
							<Border
								Grid.Column="0"
								Grid.Row="0">
								<DevCo:GalleryScrollViewer
									Name="GalleryView"
									ClipToBounds="True">
									<WrapPanel
										Name="PART_ItemsPanel"
										Orientation="Horizontal"
										IsItemsHost="True"
										Canvas.Left="0"
										Canvas.Top="0"
										KeyboardNavigation.DirectionalNavigation="Continue" />
								</DevCo:GalleryScrollViewer>
							</Border>
							<Border
								Grid.Column="1"
								Grid.Row="0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition
											Height="*" />
										<RowDefinition
											Height="*" />
										<RowDefinition
											Height="*" />
									</Grid.RowDefinitions>
									<RepeatButton
										Visibility="Visible"
										Focusable="False"
										Command="DevCo:GalleryScrollViewer.LineUpCommand"
										Margin="0,-1,-1,0"
										Grid.Column="0"
										Grid.Row="0"
										CommandTarget="{Binding ElementName=GalleryView}">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type RepeatButton}">
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate
															TargetType="{x:Type RepeatButton}">
															<Border
																Name="RepeatBorder"
																BorderThickness="1"
																CornerRadius="0,2,0,0"
																BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
																Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
																<Border
																	Name="RepeatBorderInner"
																	BorderThickness="1"
																	CornerRadius="0,1,0,0"
																	Padding="2,4,2,4"
																	BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
																	<Path
																		Name="RepeatSign"
																		VerticalAlignment="Center"
																		Data="M3.5,0 L0,4 L7,4"
																		Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}" />
																</Border>
															</Border>
															<ControlTemplate.Triggers>
																<Trigger
																	Property="UIElement.IsMouseOver"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}" />
																	<Setter
