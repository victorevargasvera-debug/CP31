																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsPressed"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsEnabled"
																	Value="False">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</FrameworkElement.Style>
									</RepeatButton>
									<RepeatButton
										Name="PART_ScrollDownButton"
										Visibility="Visible"
										Focusable="False"
										Command="{x:Static DevCo:GalleryScrollViewer.LineDownCommand}"
										Margin="0,0,-1,0"
										Grid.Column="0"
										Grid.Row="1"
										CommandTarget="{Binding ElementName=GalleryView}">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type RepeatButton}">
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate
															TargetType="{x:Type RepeatButton}">
															<Border
																Name="RepeatBorder"
																BorderThickness="1"
																CornerRadius="0,2,0,0"
																BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
																Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
																<Border
																	Name="RepeatBorderInner"
																	BorderThickness="1"
																	CornerRadius="0,1,0,0"
																	Padding="2,4,2,4"
																	BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
																	<Path
																		Name="RepeatSign"
																		VerticalAlignment="Center"
																		Data="M0,0 L3.5,4 L7,0"
																		Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}" />
																</Border>
															</Border>
															<ControlTemplate.Triggers>
																<Trigger
																	Property="UIElement.IsMouseOver"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsPressed"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsEnabled"
																	Value="False">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</FrameworkElement.Style>
									</RepeatButton>
									<RepeatButton
										Visibility="Visible"
										Focusable="False"
										Margin="0,0,-1,-1"
										Command="{x:Static DevCo:Gallery.DropDownGalleryCommand}"
										Grid.Column="0"
										Grid.Row="2"
										CommandTarget="{Binding Source={RelativeSource TemplatedParent}}">
										<FrameworkElement.Style>
											<Style
												TargetType="{x:Type RepeatButton}">
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate
															TargetType="{x:Type RepeatButton}">
															<Border
																Name="RepeatBorder"
																BorderThickness="1"
																CornerRadius="0,0,0,2"
																BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
																Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
																<Border
																	Name="RepeatBorderInner"
																	BorderThickness="1"
																	CornerRadius="0,1,0,0"
																	Padding="2,4,2,4"
																	BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
																	<StackPanel
																		VerticalAlignment="Center">
																		<Path
																			Name="RepeatSignLine"
																			Data="M0,0.5 L7,0.5"
																			Margin="0,0,0,2"
																			Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}" />
																		<Path
																			Name="RepeatSign"
																			Data="M0,0 L3.5,4 L7,0"
																			Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}" />
																	</StackPanel>
																</Border>
															</Border>
															<ControlTemplate.Triggers>
																<Trigger
																	Property="UIElement.IsMouseOver"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsPressed"
																	Value="True">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}" />
																</Trigger>
																<Trigger
																	Property="IsEnabled"
																	Value="False">
																	<Setter
																		TargetName="RepeatBorder"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}" />
																	<Setter
																		TargetName="RepeatBorder"
																		Property="Background"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}" />
																	<Setter
																		TargetName="RepeatBorderInner"
																		Property="BorderBrush"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}" />
																	<Setter
																		TargetName="RepeatSign"
																		Property="Fill"
																		Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</FrameworkElement.Style>
									</RepeatButton>
								</Grid>
							</Border>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="PART_Popup"
							Property="Popup.HasDropShadow"
							Value="True">
							<Setter
								TargetName="Shdw"
								Property="Margin"
								Value="0,0,5,5" />
							<Setter
								TargetName="Shdw"
								Property="WinTheme:SystemDropShadowChrome.Color"
								Value="#71000000" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ControlTemplate
		TargetType="{x:Type DevCo:Gallery}"
		x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryButton}">
		<DevCo:ButtonBorder
			Name="PART_ButtonDropDownBorder"
			BorderThickness="1,1,1,1"
			SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
			CornerRadius="2"
			Padding="{TemplateBinding Padding}"
			ColorClass="{TemplateBinding ColorClass}">
			<DockPanel
				LastChildFill="True">
				<Popup
					Name="PART_Popup"
					Placement="Bottom"
					Focusable="False"
					AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}"
					PopupAnimation="None"
					MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
					IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
					<WinTheme:SystemDropShadowChrome
						Name="Shdw"
						Color="#00FFFFFF">
						<Border
							BorderThickness="1,1,1,1"
							CornerRadius="3"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBorder}}}"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBackground}}}">
							<StackPanel
								Orientation="Vertical">
								<ScrollViewer
									Name="PopupScrollViewer"
									CanContentScroll="False"
									Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryMenuScrollViewer, TypeInTargetAssembly=DevCo:Gallery}}">
									<StackPanel
										Name="PopupContainerPanel"
										Orientation="Vertical" />
								</ScrollViewer>
								<Separator
									Padding="0"
									Margin="0"
									Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
								<Grid
									Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}">
									<Rectangle
										Margin="1,0,1,1"
										Width="28"
										RadiusY="2"
										HorizontalAlignment="Left"
										RadiusX="2"
										Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideBackground}}}" />
									<Rectangle
										Margin="29,0,0,2"
										Width="1"
										HorizontalAlignment="Left"
										Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineDark}}}" />
									<Rectangle
										Margin="30,0,0,2"
										Width="1"
										HorizontalAlignment="Left"
										Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineLight}}}" />
									<StackPanel
										Name="PART_MenuItemsPanel"
										Orientation="Vertical"
										Grid.ColumnSpan="2" />
								</Grid>
								<Border
									BorderThickness="0,1,0,0"
									MinHeight="11"
									Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBackground}}}"
									BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBorder}}}"
									Visibility="{TemplateBinding DevCo:Gallery.IsResizeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
									<Thumb
										Name="GalleryPopupResizeThumb"
										Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryThumb, TypeInTargetAssembly=DevCo:Gallery}}" />
								</Border>
							</StackPanel>
						</Border>
					</WinTheme:SystemDropShadowChrome>
				</Popup>
				<ContentPresenter
					Name="PART_ButtonImage"
					ContentSource="RenderImage"
					Margin="1,1,1,1"
					VerticalAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding DevCo:RenderImage}"
					DockPanel.Dock="{TemplateBinding DevCo:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}" />
				<Path
					Name="PART_ButtonExpand"
					Margin="2,2,2,2"
					Data="M0,0 L3,2.5 L0,5"
					Fill="{TemplateBinding Foreground}"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Visibility="{TemplateBinding DevCo:IsExpandVisible}"
					DockPanel.Dock="{TemplateBinding DevCo:ButtonDropDown.ExpandPosition, Converter={StaticResource ExpandPositionToDockConverter}}" />
				<TextBlock
					Name="PART_ButtonContent"
					TextWrapping="Wrap"
					Margin="0"
					HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
					VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
					TextAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
					<AccessText
						TextWrapping="Wrap"
						Text="{TemplateBinding Header}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" /> <Path
						Name="PART_ButtonExpandInline"
						Margin="0,0,0,4"
						Data="M0,0 L2.5,3 L5,0"
						Fill="{TemplateBinding Foreground}"
						VerticalAlignment="Center"
						Visibility="Collapsed" /></TextBlock>
			</DockPanel>
		</DevCo:ButtonBorder>
		<ControlTemplate.Triggers>
			<Trigger
				Property="DevCo:ButtonDropDown.ImagePosition"
				Value="Right">
				<Setter
					Property="HorizontalContentAlignment"
					Value="Right" />
				<Setter
					Property="VerticalContentAlignment"
					Value="Center" />
			</Trigger>
			<Trigger
				Property="DevCo:ButtonDropDown.ImagePosition"
				Value="Top">
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="VerticalContentAlignment"
					Value="Top" />
			</Trigger>
			<Trigger
				Property="DevCo:ButtonDropDown.ImagePosition"
				Value="Bottom">
				<Setter
					Property="HorizontalContentAlignment"
					Value="Center" />
				<Setter
					Property="VerticalContentAlignment"
					Value="Bottom" />
			</Trigger>
			<Trigger
				Property="DevCo:ButtonDropDown.PartVisibility"
				Value="ImageOnly">
				<Setter
					TargetName="PART_ButtonImage"
					Value="{x:Static Visibility.Visible}"
					Property="Visibility" />
				<Setter
					TargetName="PART_ButtonContent"
					Value="{x:Static Visibility.Collapsed}"
					Property="Visibility" />
			</Trigger>
			<Trigger
				Property="DevCo:ButtonDropDown.PartVisibility"
				Value="HeaderOnly">
				<Setter
					TargetName="PART_ButtonImage"
					Value="{x:Static Visibility.Collapsed}"
					Property="Visibility" />
				<Setter
					TargetName="PART_ButtonContent"
					Value="{x:Static Visibility.Visible}"
					Property="Visibility" />
			</Trigger>
			<Trigger
				Property="DevCo:ButtonDropDown.Image"
				Value="{x:Null}">
				<Setter
					TargetName="PART_ButtonImage"
					Value="{x:Static Visibility.Collapsed}"
					Property="Visibility" />
			</Trigger>
			<Trigger
				SourceName="PART_Popup"
				Property="Popup.HasDropShadow"
				Value="True">
				<Setter
					TargetName="Shdw"
					Property="Margin"
					Value="0,0,5,5" />
				<Setter
					TargetName="Shdw"
					Property="WinTheme:SystemDropShadowChrome.Color"
					Value="#71000000" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ButtonDisabledForeground}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type ScrollViewer}"
		x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryMenuScrollViewer}">
		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="True" />
		<Setter
			Property="VerticalScrollBarVisibility"
			Value="Visible" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ScrollViewer}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<ScrollContentPresenter
							Grid.Row="0"
							Grid.Column="0"
							CanContentScroll="{TemplateBinding CanContentScroll}"
							Content="{TemplateBinding Content}" />
						<ScrollBar
							Name="PART_VerticalScrollBar"
							Orientation="Vertical"
							Grid.Row="0"
							Grid.Column="1"
							Minimum="0"
							Maximum="{TemplateBinding ScrollableHeight}"
							Value="{TemplateBinding VerticalOffset}"
							ViewportSize="{TemplateBinding ViewportHeight}"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
							Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryScrollBar, TypeInTargetAssembly=DevCo:Gallery}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Thumb}"
		x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryThumb}">
		<Setter
			Property="MinWidth"
			Value="7" />
		<Setter
			Property="MinHeight"
			Value="7" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Thumb}">
					<Grid
						SnapsToDevicePixels="true"
						Background="{TemplateBinding Background}">
						<Path
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="0,0,2,2"
							Data="M7,0 L7,7 L0,7 L0,4 L4,4 L4,0">
							<Shape.Fill>
								<DrawingBrush
									Viewbox="0,0,4,4"
									Viewport="0,0,4,4"
									TileMode="Tile"
									ViewportUnits="Absolute"
									ViewboxUnits="Absolute">
									<DrawingBrush.Drawing>
										<DrawingGroup>
											<DrawingGroup.Children>
												<GeometryDrawing
													Brush="#00FFFFFF">
													<GeometryDrawing.Geometry>
														<RectangleGeometry
															Rect="0,0,1,1" />
													</GeometryDrawing.Geometry>
												</GeometryDrawing>
												<GeometryDrawing
													Geometry="M1,1 L3,1 L3,3 L1,3"
													Brush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeThumbLight}}}" />
												<GeometryDrawing
													Geometry="M0,0 L2,0 L2,2 L0,2"
													Brush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeThumbDark}}}" />
											</DrawingGroup.Children>
										</DrawingGroup>
									</DrawingBrush.Drawing>
								</DrawingBrush>
							</Shape.Fill>
						</Path>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
