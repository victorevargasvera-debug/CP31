<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters">
	<dcc:PopupPlacementConverter
		x:Key="PopupPlacementConverter" />
	<Style
		TargetType="{x:Type DevCo:CollapsedRibbonBarControl}"
		x:Key="{x:Type DevCo:CollapsedRibbonBarControl}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ButtonNormalForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<ContentPresenter
						HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
						VerticalAlignment="Stretch"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						RecognizesAccessKey="False"
						Content="{TemplateBinding Header}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type DevCo:CollapsedRibbonBarButton}"
		x:Key="{x:Type DevCo:CollapsedRibbonBarButton}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<DevCo:RibbonBorder
						Name="PART_CollapsedRibbonBarBorder"
						BorderThickness="1"
						LightBorderThickness="1"
						AutoAnimation="False"
						InnerBorder="True"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						CornerRadius="3"
						Padding="1,4,1,1"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalBorder}}}"
						LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalBorderLight}}}"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalBackground}}}"
						TopHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalTopHighlight}}}">
						<StackPanel>
							<Border
								Name="PART_CollapsedRibbonBarImage"
								CornerRadius="3"
								BorderThickness="1"
								HorizontalAlignment="Center"
								Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalImageBackground}}}"
								BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalImageBorder}}}">
								<Grid
									MinWidth="31"
									MinHeight="31">
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition
											Height="*" />
										<RowDefinition
											Height="7" />
									</Grid.RowDefinitions>
									<ContentPresenter
										ContentSource="Image"
										VerticalAlignment="Center"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Content="{TemplateBinding DevCo:Image}"
										Grid.Row="0"
										Grid.Column="0"
										Width="16"
										Height="16" />
									<Border
										Name="PART_CollapsedRibbonBarImageBottom"
										Grid.Row="1"
										Grid.Column="0"
										Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedNormalImageBottomBackground}}}" />
								</Grid>
							</Border>
							<ContentPresenter
								Name="PART_ButtonContent"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								ContentTemplate="{TemplateBinding HeaderTemplate}"
								RecognizesAccessKey="True"
								Content="{TemplateBinding Header}"
								Margin="3,1,3,1" />
							<Path
								Margin="3,3,3,3"
								Data="M0,0 L7,0 L3.5,4"
								Fill="{TemplateBinding Foreground}"
								VerticalAlignment="Top"
								HorizontalAlignment="Center" />
							<Popup
								Name="PART_Popup"
								VerticalOffset="-1"
								Focusable="False"
								AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}"
								PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
								Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PopupPlacementConverter}}"
								IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
								<DevCo:CollapsedRibbonBarPanel
									Name="PART_CollapsedRibbonBarPanel"
									Focusable="True"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									KeyboardNavigation.TabNavigation="Cycle"
									KeyboardNavigation.DirectionalNavigation="Cycle"
									FocusVisualStyle="{x:Null}" />
							</Popup>
						</StackPanel>
					</DevCo:RibbonBorder>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverBorder}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.LightBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverBorderLight}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverBackground}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.TopHighlight"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverTopHighlight}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImage"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverImageBackground}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImage"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverImageBorder}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImageBottom"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedHoverImageBottomBackground}}}" />
						</Trigger>
						<Trigger
							Property="DevCo:ButtonDropDown.IsPopupOpen"
							Value="True">
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedBorder}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.LightBorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedBorderLight}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedBackground}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarBorder"
								Property="DevCo:RibbonBorder.TopHighlight"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedTopHighlight}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImage"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedImageBackground}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImage"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedImageBorder}}}" />
							<Setter
								TargetName="PART_CollapsedRibbonBarImageBottom"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.RibbonBarCollapsedExpandedImageBottomBackground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
