			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabForeground}}}" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="FontSize"
			Value="8.25pt" />
		<Setter
			Property="dc:Ribbon.IsCustomizable"
			Value="True" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId=Office2007, TypeInTargetAssembly=dc:Ribbon}}" />
		<Style.Triggers>
			<Trigger
				Property="dc:Ribbon.EffectiveStyle"
				Value="Office2010">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=Office2010, TypeInTargetAssembly=dc:Ribbon}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
