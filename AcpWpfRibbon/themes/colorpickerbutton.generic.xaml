<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfRibbon" xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
	<dcc:ImagePositionToDockConverter
		x:Key="ImagePositionToDockConverter" />
	<dcc:ExpandPositionToDockConverter
		x:Key="ExpandPositionToDockConverter" />
	<dcc:PopupPlacementConverter
		x:Key="PopupPlacementConverter" />
	<Style
		TargetType="{x:Type dc:ColorPickerButton}"
		x:Key="{x:Type dc:ColorPickerButton}">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="dc:ButtonDropDown.Role"
			Value="DropDown" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:ColorPickerButton}">
					<dc:ButtonBorder
						Name="PART_ButtonDropDownBorder"
						BorderThickness="1,1,1,1"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						CornerRadius="2"
						Padding="{TemplateBinding Padding}"
						ColorClass="{TemplateBinding ColorClass}">
						<DockPanel
							LastChildFill="True">
							<Popup
								Name="PART_Popup"
								VerticalOffset="-1"
								Focusable="False"
								AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
								PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
								Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PopupPlacementConverter}}"
								PlacementTarget="{Binding Path=PopupPlacementTarget, RelativeSource={RelativeSource TemplatedParent}}"
								IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
								<WinTheme:SystemDropShadowChrome
									Name="Shdw"
									Color="#00FFFFFF">
									<ContentControl
										Name="PART_PopupContent"
										IsTabStop="False"
										Template="{DynamicResource {ComponentResourceKey ResourceId=PopupTypeMenuContent, TypeInTargetAssembly=dc:ButtonDropDown}}">
										<ScrollViewer
											CanContentScroll="True"
											Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}">
											<ItemsPresenter
												Margin="1"
												KeyboardNavigation.TabNavigation="Cycle"
												KeyboardNavigation.DirectionalNavigation="Cycle"
												SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
												Grid.IsSharedSizeScope="True" />
										</ScrollViewer>
									</ContentControl>
								</WinTheme:SystemDropShadowChrome>
							</Popup>
							<DockPanel
								Margin="1,1,1,1"
								LastChildFill="True"
								Dock="{TemplateBinding dc:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}">
								<Border
									Name="PART_ColorSwatch"
									BorderThickness="1"
									Width="{TemplateBinding dc:ColorSwatchWidth}"
									Height="{TemplateBinding dc:ColorSwatchHeight}"
									Background="{TemplateBinding dc:SelectedColorBrush}"
									VerticalAlignment="Center"
									BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ColorPickerButtonColorBorder}}}"
									DockPanel.Dock="{TemplateBinding dc:ColorPickerButton.ColorSwatchPosition, Converter={StaticResource ImagePositionToDockConverter}}">
									<Path
										Name="NoColorSelected"
										Data="M0,0 L1,1 M0,1 L1,0"
										Stretch="Fill"
										StrokeThickness="0.5"
										Visibility="Hidden"
										Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ColorPickerButtonColorBorder}}}" />
								</Border>
								<ContentPresenter
									Name="PART_ButtonImage"
									ContentSource="RenderImage"
									VerticalAlignment="Center"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Content="{TemplateBinding dc:RenderImage}"
									DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}" />
							</DockPanel>
							<dc:ExpandDecorator
								Name="PART_ButtonExpand"
								Margin="2,2,2,2"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Visibility="{TemplateBinding IsExpandVisible}"
								DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ExpandPosition, Converter={StaticResource ExpandPositionToDockConverter}}" />
							<TextBlock
								Name="PART_ButtonContent"
								TextWrapping="Wrap"
								Padding="0"
								Margin="0"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								TextAlignment="Center"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
								<AccessText
									Name="HeaderAccessText"
									TextWrapping="Wrap"
									Text="{TemplateBinding Header}"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" /> <Path
									Name="PART_ButtonExpandInline"
									Margin="3,0,0,2.5"
									Data="M0,0 L2.5,3 L5,0"
									Fill="{TemplateBinding Foreground}"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Visibility="Collapsed" /></TextBlock>
						</DockPanel>
					</dc:ButtonBorder>
					<ControlTemplate.Triggers>
						<Trigger
							Property="dc:Ribbon.ElementRole"
							Value="AppMenuDocumentCommand">
							<Setter
								TargetName="PART_ButtonExpand"
								Property="Margin"
								Value="9,2,4,2" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.ImagePosition"
							Value="Right">
							<Setter
								Property="HorizontalContentAlignment"
								Value="Right" />
							<Setter
								Property="VerticalContentAlignment"
								Value="Center" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.ImagePosition"
							Value="Top">
							<Setter
								Property="HorizontalContentAlignment"
								Value="Center" />
							<Setter
								Property="VerticalContentAlignment"
								Value="Top" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.ImagePosition"
							Value="Bottom">
							<Setter
								Property="HorizontalContentAlignment"
								Value="Center" />
							<Setter
								Property="VerticalContentAlignment"
								Value="Bottom" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.PartVisibility"
							Value="ImageOnly">
							<Setter
								TargetName="PART_ButtonImage"
								Value="{x:Static Visibility.Visible}"
								Property="Visibility" />
							<Setter
								TargetName="PART_ButtonContent"
								Value="{x:Static Visibility.Collapsed}"
								Property="Visibility" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.PartVisibility"
							Value="HeaderOnly">
							<Setter
								TargetName="PART_ButtonImage"
								Value="{x:Static Visibility.Collapsed}"
								Property="Visibility" />
							<Setter
								TargetName="PART_ButtonContent"
								Value="{x:Static Visibility.Visible}"
								Property="Visibility" />
						</Trigger>
						<Trigger
							Property="dc:ButtonDropDown.RenderImage"
							Value="{x:Null}">
							<Setter
								TargetName="PART_ButtonImage"
								Value="{x:Static Visibility.Collapsed}"
								Property="Visibility" />
						</Trigger>
						<Trigger
							SourceName="PART_Popup"
							Property="Popup.HasDropShadow"
							Value="True">
							<Setter
								TargetName="Shdw"
								Property="Margin"
								Value="0,0,5,5" />
							<Setter
								TargetName="Shdw"
								Property="WinTheme:SystemDropShadowChrome.Color"
								Value="#71000000" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}" />
						</Trigger>
						<Trigger
							Property="dc:ColorPickerButton.SelectedColorBrush"
							Value="{x:Null}">
							<Setter
								TargetName="NoColorSelected"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="dc:ColorPickerButton.ColorSwatchBorder"
							Value="False">
							<Setter
								TargetName="PART_ColorSwatch"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="NoColorSelected"
								Property="Visibility"
								Value="Hidden" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
