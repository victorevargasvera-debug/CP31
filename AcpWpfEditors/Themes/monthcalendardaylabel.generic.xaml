<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dcp:MonthCalendarDayLabel}"
		x:Key="{x:Type dcp:MonthCalendarDayLabel}">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Right" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarForeground}}}" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="4,2,4,2" />
		<Setter
			Property="Margin"
			Value="0" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dcp:MonthCalendarDayLabel}">
					<Border
						Background="{TemplateBinding Background}"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						SnapsToDevicePixels="true">
						<Border
							Name="innerBorder"
							BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								RecognizesAccessKey="true"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="dcp:MonthCalendarDayLabel.IsToday"
							Value="true">
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarTodayDateBorder}}}" />
						</Trigger>
						<Trigger
							Property="dcp:MonthCalendarDayLabel.IsTrailing"
							Value="true">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarTrailingDayForeground}}}" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="true">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonCheckedBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonCheckedBorder}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonCheckedForeground}}}" />
							<Setter
								TargetName="innerBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonCheckedBorderInner}}}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dcp:MonthCalendarDayLabel.Selectable"
									Value="True" />
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorder}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverForeground}}}" />
							<Setter
								TargetName="innerBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorderInner}}}" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dcp:MonthCalendarDayLabel.Selectable"
									Value="True" />
								<Condition
									Property="IsPressed"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorder}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedForeground}}}" />
							<Setter
								TargetName="innerBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorderInner}}}" />
						</MultiTrigger>
						<Trigger
							Property="IsEnabled"
							Value="false">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarDayDisabledForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
