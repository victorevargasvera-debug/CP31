<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:SuperTabItem}"
		x:Key="{x:Type dc:SuperTabItem}">
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId=OneNote2007, TypeInTargetAssembly=dc:SuperTabItem}}" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="ClipToBounds"
			Value="True" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="HorizontalAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Stretch" />
		<Style.Triggers>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="VisualStudio2008Dock">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=VisualStudio2008Dock, TypeInTargetAssembly=dc:SuperTabItem}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="VisualStudio2008Document">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=VisualStudio2008Document, TypeInTargetAssembly=dc:SuperTabItem}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="Office2007">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=Office2007, TypeInTargetAssembly=dc:SuperTabItem}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="Office2010BackstageBlue">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=Office2010BackstageBlue, TypeInTargetAssembly=dc:SuperTabItem}}" />
				<Setter
					Property="Margin"
					Value="0,0,0,-1" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="OneNote2007">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=OneNote2007, TypeInTargetAssembly=dc:SuperTabItem}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabItem.TabStripStyle"
				Value="WinMediaPlayer12">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey ResourceId=WinMediaPlayer12, TypeInTargetAssembly=dc:SuperTabItem}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<ControlTemplate
		TargetType="{x:Type dc:SuperTabItem}"
		x:Key="{ComponentResourceKey {x:Type dc:SuperTabItem}, WinMediaPlayer12}">
		<Border
			Name="TabBorder"
			CornerRadius="3.5,3.5,0,0"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			BorderThickness="1"
			ToolTip="{TemplateBinding dc:TabToolTip}">
			<Border
				Name="TabBorderInner"
				CornerRadius="2.5,2.5,0,0"
				BorderBrush="{TemplateBinding dc:InnerBorderBrush}"
				BorderThickness="{TemplateBinding dc:InnerBorderThickness}"
				Padding="{TemplateBinding Padding}">
				<DockPanel
					LastChildFill="True">
					<ContentPresenter
						Name="TabImage"
						ContentSource="RenderImage"
						Margin="2"
						DockPanel.Dock="{TemplateBinding dc:ImagePosition}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:RenderImage}" />
					<dc:TabCloseButton
						Margin="1"
						DockPanel.Dock="{TemplateBinding CloseButtonPosition}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Command="dc:SuperTabItem.CloseTab"
						Visibility="{TemplateBinding EffectiveCloseButtonVisibility}"
						IsActive="{TemplateBinding IsSelected}" />
					<ContentPresenter
						Name="PART_HeaderContentHost"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						VerticalAlignment="Center"
						Content="{TemplateBinding Header}" />
				</DockPanel>
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				Property="TabItem.IsSelected"
				Value="True">
				<Setter
					TargetName="PART_HeaderContentHost"
					Property="FontWeight"
					Value="Bold" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Top">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,1,1,0" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,1,1,0" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Bottom">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,0,1,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,0,1,1" />
				<Setter
					TargetName="TabBorder"
					Property="Border.CornerRadius"
					Value="0,0,3,3" />
				<Setter
					TargetName="TabBorderInner"
					Property="Border.CornerRadius"
					Value="0,0,2,2" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Left">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,1,0,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,1,0,1" />
				<Setter
					TargetName="TabBorder"
					Property="Border.CornerRadius"
					Value="3,0,0,3" />
				<Setter
					TargetName="TabBorderInner"
					Property="Border.CornerRadius"
					Value="2,0,0,2" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Right">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="0,1,1,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="0,1,1,1" />
				<Setter
					TargetName="TabBorder"
					Property="Border.CornerRadius"
					Value="0,3,3,0" />
				<Setter
					TargetName="TabBorderInner"
					Property="Border.CornerRadius"
					Value="0,3,3,0" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type dc:SuperTabItem}"
		x:Key="{ComponentResourceKey {x:Type dc:SuperTabItem}, Office2010BackstageBlue}">
		<Border
			Name="TabBorder"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			BorderThickness="1"
			ToolTip="{TemplateBinding dc:TabToolTip}">
			<Border
				Name="TabBorderInner"
				BorderBrush="{TemplateBinding dc:InnerBorderBrush}"
				BorderThickness="{TemplateBinding dc:InnerBorderThickness}"
				Padding="{TemplateBinding Padding}">
				<DockPanel
					LastChildFill="True">
					<Path
						Name="SelectMark"
						DockPanel.Dock="Bottom"
						Fill="#FFFFFFFF"
						Data="M0,1 L1,1 L0.5,0"
						Margin="0,2,0,-2"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Stretch="Fill"
						Width="11"
						Height="6"
						Visibility="Hidden" />
					<ContentPresenter
						Name="TabImage"
						ContentSource="RenderImage"
						Margin="2"
						DockPanel.Dock="{TemplateBinding dc:ImagePosition}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:RenderImage}" />
					<dc:TabCloseButton
						Name="TabCloseButton"
						Margin="1"
						DockPanel.Dock="{TemplateBinding CloseButtonPosition}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Command="dc:SuperTabItem.CloseTab"
						Visibility="{TemplateBinding EffectiveCloseButtonVisibility}"
						IsActive="{TemplateBinding IsSelected}"
						Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
					<ContentPresenter
						Name="PART_HeaderContentHost"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						VerticalAlignment="Center"
						Content="{TemplateBinding Header}" />
				</DockPanel>
			</Border>
		</Border>
