			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			BorderThickness="1"
			ToolTip="{TemplateBinding dc:TabToolTip}">
			<Border
				Name="TabBorderInner"
				BorderBrush="{TemplateBinding dc:InnerBorderBrush}"
				BorderThickness="{TemplateBinding dc:InnerBorderThickness}"
				Padding="{TemplateBinding Padding}">
