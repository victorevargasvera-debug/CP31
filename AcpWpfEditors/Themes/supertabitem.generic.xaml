					<ContentPresenter
						Name="TabImage"
						ContentSource="RenderImage"
						Margin="2"
						DockPanel.Dock="{TemplateBinding dc:ImagePosition}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:RenderImage}" />
					<dc:TabCloseButton
						Margin="1"
