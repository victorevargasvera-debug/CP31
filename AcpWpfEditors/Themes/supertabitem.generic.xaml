			<Trigger
				Property="TabItem.IsSelected"
				Value="True">
				<Setter
					TargetName="PART_HeaderContentHost"
					Property="FontWeight"
					Value="Bold" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Top">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,1,1,0" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,1,1,0" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Bottom">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,0,1,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,0,1,1" />
				<Setter
					TargetName="SelectMark"
					Property="Dock"
					Value="Top" />
				<Setter
					TargetName="SelectMark"
					Property="Data"
					Value="M0,0 L1,0 L0.5,1" />
				<Setter
					TargetName="SelectMark"
					Property="Margin"
					Value="0,-2,0,2" />
				<Setter
					Property="Margin"
					Value="0,-1,0,0" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Left">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="1,1,0,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="1,1,0,1" />
				<Setter
					TargetName="SelectMark"
					Property="Dock"
					Value="Right" />
				<Setter
					TargetName="SelectMark"
					Property="Data"
					Value="M0,0.5 L1,1 L1,0" />
				<Setter
					TargetName="SelectMark"
					Property="Margin"
					Value="2,0,-2,0" />
				<Setter
					TargetName="SelectMark"
					Property="Width"
					Value="6" />
				<Setter
					TargetName="SelectMark"
					Property="Height"
					Value="11" />
				<Setter
					Property="Margin"
					Value="0,0,0,0" />
			</Trigger>
			<Trigger
				Property="TabItem.TabStripPlacement"
				Value="Right">
				<Setter
					TargetName="TabBorder"
					Property="BorderThickness"
					Value="0,1,1,1" />
				<Setter
					TargetName="TabBorderInner"
					Property="BorderThickness"
					Value="0,1,1,1" />
				<Setter
					TargetName="SelectMark"
					Property="Dock"
					Value="Left" />
				<Setter
					TargetName="SelectMark"
					Property="Data"
					Value="M0,0 L1,0.5 L0,1" />
				<Setter
					TargetName="SelectMark"
					Property="Margin"
					Value="-2,0,2,0" />
				<Setter
					TargetName="SelectMark"
					Property="Width"
					Value="6" />
				<Setter
					TargetName="SelectMark"
					Property="Height"
					Value="11" />
				<Setter
					Property="Margin"
					Value="-1,0,0,0" />
			</Trigger>
			<Trigger
				Property="TabItem.IsSelected"
				Value="True">
				<Setter
					TargetName="SelectMark"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="TabItem.IsSelected"
						Value="False" />
					<Condition
						Property="TabItem.TabStripPlacement"
						Value="Top" />
				</MultiTrigger.Conditions>
				<MultiTrigger.Setters>
					<Setter
						Property="Margin"
						Value="0,2,0,0" />
				</MultiTrigger.Setters>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="TabItem.IsSelected"
						Value="False" />
					<Condition
						Property="TabItem.TabStripPlacement"
						Value="Bottom" />
				</MultiTrigger.Conditions>
				<MultiTrigger.Setters>
					<Setter
						Property="Margin"
						Value="0,0,0,2" />
				</MultiTrigger.Setters>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="TabItem.IsSelected"
						Value="False" />
					<Condition
						Property="TabItem.TabStripPlacement"
						Value="Left" />
				</MultiTrigger.Conditions>
				<MultiTrigger.Setters>
					<Setter
						Property="Margin"
						Value="2,0,0,0" />
				</MultiTrigger.Setters>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="TabItem.IsSelected"
						Value="False" />
					<Condition
						Property="TabItem.TabStripPlacement"
						Value="Right" />
				</MultiTrigger.Conditions>
				<MultiTrigger.Setters>
					<Setter
						Property="Margin"
						Value="0,0,2,0" />
				</MultiTrigger.Setters>
			</MultiTrigger>
			<Trigger
				Property="dc:SuperTabItem.TabLayoutType"
				Value="Multiline">
				<Setter
					Property="Margin"
					Value="0" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
