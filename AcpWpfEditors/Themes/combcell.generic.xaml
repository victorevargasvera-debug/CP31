<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:CombCell}"
		x:Key="{x:Type dc:CombCell}">
		<Setter
			Property="Background"
			Value="#FF000000" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Panel.ZIndex"
			Value="0" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:CombCell}">
					<Grid>
						<Polygon
							Name="Outter"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Points="0,-1 0.866,-0.5 0.866,0.5 0,1 -0.866,0.5 -0.866,-0.5"
							Stroke="{TemplateBinding BorderBrush}"
							Fill="{TemplateBinding Background}"
							Stretch="Fill" />
						<Polygon
							Name="Inner"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Margin="1"
							Points="0,-1 0.866,-0.5 0.866,0.5 0,1 -0.866,0.5 -0.866,-0.5"
							Stroke="#FF95B2EF"
							StrokeThickness="2"
							Visibility="Hidden"
							Stretch="Fill" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Inner"
								Property="Visibility"
								Value="Visible" />
							<Setter
								Property="BorderBrush"
								Value="#FF5F84B0" />
							<Setter
								Property="Panel.ZIndex"
								Value="99" />
						</Trigger>
						<Trigger
							Property="dc:SelectableControl.IsSelected"
							Value="True">
							<Setter
								TargetName="Inner"
								Property="Visibility"
								Value="Visible" />
							<Setter
								Property="BorderBrush"
								Value="#FF5F84B0" />
							<Setter
								Property="Panel.ZIndex"
								Value="99" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
