<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dcp:ColorInputDropDownButton}"
		x:Key="{x:Type dcp:ColorInputDropDownButton}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBorder}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="VerticalAlignment"
			Value="Stretch" />
		<Setter
			Property="MinWidth"
			Value="15" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=EditorColorDropDownButton}}" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type ButtonBase}"
		x:Key="{ComponentResourceKey {x:Type dcp:EditorElement}, EditorColorDropDownButton}">
		<Border
			Background="{TemplateBinding Background}"
			BorderBrush="{TemplateBinding BorderBrush}"
			BorderThickness="{TemplateBinding BorderThickness}">
			<Border
				Name="innerBorder"
				BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBorderInner}}}">
				<Grid
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
					<ContentPresenter
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding Content}"
						TextElement.Foreground="{TemplateBinding Foreground}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center" />
					<Path
						Name="DropDownSign"
						Margin="2,4,2,4"
						Data="M0,0 L8,0 L4,3.5"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Stretch="None"
						Fill="{TemplateBinding Foreground}"
						Visibility="Collapsed" />
					<Popup
						Name="PART_Popup"
						Placement="Bottom"
						VerticalOffset="0"
						Focusable="False"
						AllowsTransparency="True"
						PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
						IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
						<WinTheme:SystemDropShadowChrome
							Name="Shdw"
							Color="#00FFFFFF">
							<Border
								BorderThickness="1,1,1,1"
								CornerRadius="3"
								BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ColorItemMenuBorder}}}"
								Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ColorItemMenuBackground}}}">
								<dc:ColorItemSelector
									Name="PART_ColorSelector"
									Margin="0,0,0,4"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:ColorInput, ResourceId=ColorItemSelector}}"
									MoreColorsButtonVisibility="{Binding Path=MoreColorsButtonVisibility, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dc:ColorInput}}}" />
							</Border>
						</WinTheme:SystemDropShadowChrome>
					</Popup>
				</Grid>
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				SourceName="PART_ColorSelector"
				Property="dc:ColorItemSelector.MoreColorsButtonVisibility"
				Value="Visible">
				<Setter
					TargetName="PART_ColorSelector"
					Property="Margin"
					Value="0" />
			</Trigger>
			<Trigger
				Property="Content"
				Value="{x:Null}">
				<Setter
					TargetName="DropDownSign"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="true">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorderInner}}}" />
			</Trigger>
			<Trigger
				Property="IsPressed"
				Value="true">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorderInner}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="false">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBorderInner}}}" />
			</Trigger>
			<Trigger
				SourceName="PART_Popup"
				Property="Popup.HasDropShadow"
				Value="True">
				<Setter
					TargetName="Shdw"
					Property="Margin"
					Value="0,0,5,5" />
				<Setter
					TargetName="Shdw"
					Property="WinTheme:SystemDropShadowChrome.Color"
					Value="#71000000" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
</ResourceDictionary>
