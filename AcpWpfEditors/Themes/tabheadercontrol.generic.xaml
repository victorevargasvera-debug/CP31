<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:TabHeaderControl}"
		x:Key="{x:Type dc:TabHeaderControl}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderControlForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderControlBorder}}}" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderControlBackground}}}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Center" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabHeaderControl, ResourceId=TabStripTop}}" />
		<Style.Triggers>
			<Trigger
				Property="TabControl.TabStripPlacement"
				Value="Bottom">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabHeaderControl, ResourceId=TabStripBottom}}" />
			</Trigger>
			<Trigger
				Property="TabControl.TabStripPlacement"
				Value="Left">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabHeaderControl, ResourceId=TabStripLeft}}" />
			</Trigger>
			<Trigger
				Property="TabControl.TabStripPlacement"
				Value="Right">
				<Setter
					Property="Template"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabHeaderControl, ResourceId=TabStripRight}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<ControlTemplate
		TargetType="{x:Type dc:TabHeaderControl}"
		x:Key="{ComponentResourceKey {x:Type dc:TabHeaderControl}, TabStripTop}">
		<Border
			Background="{TemplateBinding Background}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}">
			<Grid
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				KeyboardNavigation.TabNavigation="Local">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Border
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="0,0,0,1"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderPanelBackground}}}" />
				<TabPanel
					Name="HeaderPanel"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,0,0,1"
					IsItemsHost="True"
					KeyboardNavigation.TabIndex="1"
					Grid.Column="0"
					Grid.Row="0" />
				<ContentPresenter
					Name="PART_TabInfoContentHost"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,0,0,1"
					ContentSource="TabInfo"
					VerticalAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:TabInfo}"
					Grid.Column="1"
					Grid.Row="0" />
				<ContentPresenter
					Name="PART_TabHeaderContentHost"
					ContentSource="Header"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:Header}"
					Grid.Column="0"
					Grid.Row="1"
					Grid.ColumnSpan="2" />
				<Border
					Name="ContentPanel"
					KeyboardNavigation.TabIndex="2"
					KeyboardNavigation.TabNavigation="Local"
					KeyboardNavigation.DirectionalNavigation="Contained"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					Grid.Row="2">
					<ContentPresenter
						Name="PART_SelectedContentHost"
						ContentSource="SelectedContent"
						Margin="{TemplateBinding Padding}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						ContentTemplate="{TemplateBinding SelectedContentTemplate}"
						Content="{TemplateBinding SelectedContent}" />
				</Border>
				<ContentPresenter
					Name="PART_TabFooterContentHost"
					ContentSource="Footer"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:Footer}"
					Grid.Column="0"
					Grid.Row="3"
					Grid.ColumnSpan="2" />
			</Grid>
		</Border>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type dc:TabHeaderControl}"
		x:Key="{ComponentResourceKey {x:Type dc:TabHeaderControl}, TabStripBottom}">
		<Border
			Background="{TemplateBinding Background}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}">
			<Grid
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				KeyboardNavigation.TabNavigation="Local">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Border
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Grid.Row="3"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="0,1,0,0"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderPanelBackground}}}" />
				<TabPanel
					Name="HeaderPanel"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,1,0,0"
					IsItemsHost="True"
					KeyboardNavigation.TabIndex="1"
					Grid.Column="0"
					Grid.Row="3" />
				<ContentPresenter
					Name="PART_TabInfoContentHost"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,1,0,0"
					ContentSource="TabInfo"
					VerticalAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:TabInfo}"
					Grid.Column="1"
					Grid.Row="3" />
				<ContentPresenter
					Name="PART_TabHeaderContentHost"
					ContentSource="Header"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:Header}"
					Grid.Column="0"
					Grid.Row="0"
					Grid.ColumnSpan="2" />
				<Border
					Name="ContentPanel"
					KeyboardNavigation.TabIndex="2"
					KeyboardNavigation.TabNavigation="Local"
					KeyboardNavigation.DirectionalNavigation="Contained"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					Grid.Row="1">
					<ContentPresenter
						Name="PART_SelectedContentHost"
						ContentSource="SelectedContent"
						Margin="{TemplateBinding Padding}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						ContentTemplate="{TemplateBinding SelectedContentTemplate}"
						Content="{TemplateBinding SelectedContent}" />
				</Border>
				<ContentPresenter
					Name="PART_TabFooterContentHost"
					ContentSource="Footer"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:Footer}"
					Grid.Column="0"
					Grid.Row="2"
					Grid.ColumnSpan="2" />
			</Grid>
		</Border>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type dc:TabHeaderControl}"
		x:Key="{ComponentResourceKey {x:Type dc:TabHeaderControl}, TabStripLeft}">
		<Border
			Background="{TemplateBinding Background}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}">
			<Grid
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				KeyboardNavigation.TabNavigation="Local">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Border
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Grid.Row="0"
					Grid.Column="0"
					Grid.RowSpan="2"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="0,0,1,0"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderPanelBackground}}}" />
				<TabPanel
					Name="HeaderPanel"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,0,1,0"
					IsItemsHost="True"
					KeyboardNavigation.TabIndex="1"
					Grid.Column="0"
					Grid.Row="0" />
				<ContentPresenter
					Name="PART_TabInfoContentHost"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="0,0,1,0"
					ContentSource="TabInfo"
					VerticalAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:TabInfo}"
					Grid.Column="0"
					Grid.Row="1" />
				<Grid
					Column="1"
					Row="0"
					RowSpan="2">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<ContentPresenter
						Name="PART_TabHeaderContentHost"
						ContentSource="Header"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:Header}"
						Grid.Column="0"
						Grid.Row="0" />
					<Border
						Name="ContentPanel"
						KeyboardNavigation.TabIndex="2"
						KeyboardNavigation.TabNavigation="Local"
						KeyboardNavigation.DirectionalNavigation="Contained"
						Grid.Column="0"
						Grid.Row="1">
						<ContentPresenter
							Name="PART_SelectedContentHost"
							ContentSource="SelectedContent"
							Margin="{TemplateBinding Padding}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							ContentTemplate="{TemplateBinding SelectedContentTemplate}"
							Content="{TemplateBinding SelectedContent}" />
					</Border>
					<ContentPresenter
						Name="PART_TabFooterContentHost"
						ContentSource="Footer"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:Footer}"
						Grid.Column="0"
						Grid.Row="2" />
				</Grid>
			</Grid>
		</Border>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type dc:TabHeaderControl}"
		x:Key="{ComponentResourceKey {x:Type dc:TabHeaderControl}, TabStripRight}">
		<Border
			Background="{TemplateBinding Background}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}">
			<Grid
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				KeyboardNavigation.TabNavigation="Local">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Grid
					Column="0"
					Row="0"
					RowSpan="2">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<ContentPresenter
						Name="PART_TabHeaderContentHost"
						ContentSource="Header"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:Header}"
						Grid.Column="0"
						Grid.Row="0" />
					<Border
						Name="ContentPanel"
						KeyboardNavigation.TabIndex="2"
						KeyboardNavigation.TabNavigation="Local"
						KeyboardNavigation.DirectionalNavigation="Contained"
						Grid.Column="0"
						Grid.Row="1">
						<ContentPresenter
							Name="PART_SelectedContentHost"
							ContentSource="SelectedContent"
							Margin="{TemplateBinding Padding}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							ContentTemplate="{TemplateBinding SelectedContentTemplate}"
							Content="{TemplateBinding SelectedContent}" />
					</Border>
					<ContentPresenter
						Name="PART_TabFooterContentHost"
						ContentSource="Footer"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Content="{TemplateBinding dc:Footer}"
						Grid.Column="0"
						Grid.Row="2" />
				</Grid>
				<Border
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Grid.Row="0"
					Grid.Column="1"
					Grid.RowSpan="2"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="1,0,0,0"
					Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabHeaderPanelBackground}}}" />
				<TabPanel
					Name="HeaderPanel"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="1,0,0,0"
					IsItemsHost="True"
					KeyboardNavigation.TabIndex="1"
					Grid.Column="1"
					Grid.Row="0" />
				<ContentPresenter
					Name="PART_TabInfoContentHost"
					Visibility="{TemplateBinding dc:TabStripVisibility}"
					Margin="1,0,0,0"
					ContentSource="TabInfo"
					VerticalAlignment="Center"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Content="{TemplateBinding dc:TabInfo}"
					Grid.Column="1"
					Grid.Row="1" />
			</Grid>
		</Border>
	</ControlTemplate>
	<Style
		TargetType="{x:Type TabItem}"
		x:Key="{ComponentResourceKey {x:Type dc:TabHeaderControl}, TabItem}">
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemBorder}}}" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemBackground}}}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,1,0" />
		<Setter
			Property="Padding"
			Value="10,6,10,6" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type TabItem}">
					<Border
						Name="PART_Border"
						Cursor="Hand"
						Background="{TemplateBinding Background}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="{TemplateBinding Padding}"
						BorderBrush="{TemplateBinding BorderBrush}">
						<ContentPresenter
							Name="PART_HeaderContentHost"
							ContentSource="Header"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							ContentTemplate="{TemplateBinding HeaderTemplate}"
							ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
							Content="{TemplateBinding Header}"
							TextElement.Foreground="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemForeground}}}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="TabItem.IsSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemSelectedBackground}}}" />
						</Trigger>
						<Trigger
							SourceName="PART_Border"
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemMouseOverBackground}}}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="TabItem.IsSelected"
									Value="True" />
								<Condition
									SourceName="PART_Border"
									Property="UIElement.IsMouseOver"
									Value="True" />
							</MultiTrigger.Conditions>
							<MultiTrigger.Setters>
								<Setter
									Property="Background"
									Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabHeaderItemSelectedMouseOverBackground}}}" />
							</MultiTrigger.Setters>
						</MultiTrigger>
						<Trigger
							Property="TabItem.TabStripPlacement"
							Value="Left">
							<Setter
								Property="BorderThickness"
								Value="0,0,0,1" />
						</Trigger>
						<Trigger
							Property="TabItem.TabStripPlacement"
							Value="Right">
							<Setter
								Property="BorderThickness"
								Value="0,0,0,1" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
