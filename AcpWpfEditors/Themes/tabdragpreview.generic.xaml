<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:TabDragPreview}"
		x:Key="{x:Type dc:TabDragPreview}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:TabDragPreview}">
					<Border
						Opacity=".6">
						<Border.Background>
							<VisualBrush
								Stretch="None"
								Visual="{Binding Path=DragTab, RelativeSource={RelativeSource TemplatedParent}}" />
						</Border.Background>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
