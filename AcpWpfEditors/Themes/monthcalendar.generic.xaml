<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:MonthCalendar}"
		x:Key="{x:Type dc:MonthCalendar}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarForeground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="True" />
		<Setter
			Property="FocusManager.IsFocusScope"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:MonthCalendar}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						CornerRadius="{TemplateBinding dc:CornerRadius}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="1"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<Grid
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<dc:StateAnimationControl
								Name="StateAnimation"
								Grid.Row="0"
								Grid.Column="0">
								<Grid
									Name="CalendarGrid" />
							</dc:StateAnimationControl>
							<Grid
								Row="1"
								Column="0">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<dcp:EditorButton
									Name="TodayButton"
									Visibility="{TemplateBinding dc:TodayButtonVisibility}"
									Content="{TemplateBinding dc:TodayButtonContent}"
									Padding="4,0,4,0"
									Margin="0,0,4,0"
									Grid.Row="0"
									Grid.Column="0"
									HorizontalAlignment="Right"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=TodayButton}}" />
								<dcp:EditorButton
									Name="ClearButton"
									Visibility="{TemplateBinding dc:ClearButtonVisibility}"
									Content="{TemplateBinding dc:ClearButtonContent}"
									Padding="4,0,4,0"
									Margin="4,0,0,0"
									Grid.Row="0"
									Grid.Column="1"
									HorizontalAlignment="Left"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=ClearButton}}" />
							</Grid>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type dcp:EditorButton}"
		x:Key="{ComponentResourceKey {x:Type dcp:EditorElement}, TodayButton}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="VerticalAlignment"
			Value="Stretch" />
		<Setter
			Property="MinWidth"
			Value="15" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=EditorButton}}" />
	</Style>
	<Style
		TargetType="{x:Type dcp:EditorButton}"
		x:Key="{ComponentResourceKey {x:Type dcp:EditorElement}, ClearButton}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="VerticalAlignment"
			Value="Stretch" />
		<Setter
			Property="MinWidth"
			Value="15" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=EditorButton}}" />
	</Style>
</ResourceDictionary>
