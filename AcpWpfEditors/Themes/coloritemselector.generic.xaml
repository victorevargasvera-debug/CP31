		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuHeaderLabelBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,1" />
		<Setter
			Property="Padding"
			Value="6,1,1,1" />
	</Style>
	<Style
		TargetType="{x:Type Separator}"
		x:Key="{ComponentResourceKey {x:Type dc:EditColors}, MenuSeparator}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuSeparatorBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuSeparatorBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="0,1,0,0" />
		<Setter
			Property="MinHeight"
			Value="2" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Padding"
			Value="0,0,1,0" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Separator}">
					<Border
						Margin="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		x:Key="{ComponentResourceKey {x:Type dc:EditColors}, ButtonMenuItem}">
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Padding"
			Value="0" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuItemForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="BorderOutter"
						Background="#00FFFFFF"
						BorderBrush="#00FFFFFF"
						BorderThickness="1"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						CornerRadius="2"
						Padding="{TemplateBinding Padding}">
						<Border
							Name="BorderInner"
							BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										SharedSizeGroup="MenuIconColumnGroup"
										Width="Auto"
										MinWidth="24" />
									<ColumnDefinition
										Width="4" />
									<ColumnDefinition
										Width="*" />
									<ColumnDefinition
										Width="37" />
									<ColumnDefinition
										SharedSizeGroup="MenuShortcutColumnGroup"
										Width="Auto" />
									<ColumnDefinition
										Width="17" />
								</Grid.ColumnDefinitions>
								<ContentPresenter
									Name="PART_ButtonContent"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									RecognizesAccessKey="True"
									ContentTemplate="{TemplateBinding HeaderTemplate}"
									Content="{TemplateBinding Content}"
									Margin="3,1,3,1"
									Grid.Column="2" />
							</Grid>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="BorderOutter"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuItemHoverBackground}}}" />
							<Setter
								TargetName="BorderOutter"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuItemHoverBorder}}}" />
							<Setter
								TargetName="BorderInner"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuItemHoverBorderInner}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
