	<Style
		TargetType="{x:Type dc:ColorItem}"
		x:Key="{ComponentResourceKey {x:Type dc:ColorItem}, ColorItemStandAloneRow}">
		<Setter
			Property="Margin"
			Value="0,0,3,0" />
		<Style.Triggers>
			<Trigger
				Property="Column"
				Value="9">
				<Setter
					Property="Margin"
					Value="0,0,0,0" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type dc:ColorItem}"
		x:Key="{ComponentResourceKey {x:Type dc:ColorItem}, ColorItemFirstRow}">
		<Setter
			Property="Margin"
			Value="0,5,3,0" />
		<Setter
			Property="BorderThickness"
			Value="1,1,1,0" />
		<Style.Triggers>
			<Trigger
				Property="Column"
				Value="9">
				<Setter
					Property="Margin"
					Value="0,5,0,0" />
			</Trigger>
		</Style.Triggers>
	</Style>
