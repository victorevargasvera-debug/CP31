	<Style
		TargetType="{x:Type Label}"
		x:Key="{ComponentResourceKey {x:Type dc:EditColors}, HeaderLabel}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MenuHeaderLabelBackground}}}" />
