<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">
	<Style
		TargetType="{x:Type dc:FreeTextEntryBox}"
		x:Key="{x:Type dc:FreeTextEntryBox}">
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:FreeTextEntryBox}">
					<theme:ListBoxChrome
						Name="Bd"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						RenderMouseOver="{TemplateBinding IsMouseOver}"
						RenderFocused="{TemplateBinding IsKeyboardFocusWithin}"
						SnapsToDevicePixels="true">
						<Grid>
							<ScrollViewer
								Name="PART_ContentHost"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
							<TextBlock
								Name="PART_Watermark"
								Focusable="False"
								HorizontalAlignment="{TemplateBinding dc:WatermarkAlignment}"
								Foreground="{TemplateBinding dc:WatermarkBrush}"
								Text="{TemplateBinding dc:WatermarkText}"
								Visibility="{TemplateBinding dc:WatermarkVisibility}" />
						</Grid>
					</theme:ListBoxChrome>
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsEnabled"
							Value="false">
							<Setter
								TargetName="Bd"
								Value="{DynamicResource SystemColors.ControlBrush}"
								Property="theme:ListBoxChrome.Background" />
							<Setter
								Value="{DynamicResource SystemColors.GrayTextBrush}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
