<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:SuperTabControl}"
		x:Key="{x:Type dc:SuperTabControl}">
		<Setter
			Property="dc:SuperTabControl.ContentBorderThickness"
			Value="1,0,1,1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:SuperTabControl}">
					<Grid
						KeyboardNavigation.TabNavigation="Local"
						SnapsToDevicePixels="true"
						ClipToBounds="true">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Name="ColumnDefinition0" />
							<ColumnDefinition
								Name="ColumnDefinition1"
								Width="0" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Name="RowDefinition0"
								Height="Auto" />
							<RowDefinition
								Name="RowDefinition1"
								Height="*" />
						</Grid.RowDefinitions>
						<dc:TabPanelBorder
							Name="TabStripBorder"
							Margin="0,0,0,-2"
							Panel.ZIndex="1"
							TabPlacement="{TemplateBinding TabStripPlacement}"
							BorderBrush="{TemplateBinding ContentBorderBrush}"
							InnerBorderBrush="{TemplateBinding ContentInnerBorderBrush}"
							SelectedTabIndex="{TemplateBinding SelectedIndex}"
							SnapsToDevicePixels="True"
							Grid.Column="0"
							Grid.Row="0">
							<DockPanel
								Name="HeaderPanel"
								LastChildFill="True"
								ZIndex="1"
								Margin="0,2,0,0"
								Background="{TemplateBinding Background}">
								<ContentPresenter
									Name="PART_TabHeaderLeft"
									DockPanel.Dock="Left"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Margin="{TemplateBinding Padding}"
									ContentSource="TabHeaderLeft" />
								<ContentPresenter
									Name="PART_TabHeaderRight"
									DockPanel.Dock="Right"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Margin="{TemplateBinding Padding}"
									ContentSource="TabHeaderRight" />
								<Grid
									Name="ControlBoxGrid"
									DockPanel.Dock="Right"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="Auto" />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition
											Height="Auto" />
										<RowDefinition
											Height="Auto" />
									</Grid.RowDefinitions>
									<Button
										Name="ButtonTabMenu"
										Style="{TemplateBinding dc:ControlButtonStyle}"
										Grid.Column="0"
										Visibility="{TemplateBinding dc:ControlBoxTabMenuVisibility}">
										<FrameworkElement.ContextMenu>
											<ContextMenu
												Name="TabListMenu" />
										</FrameworkElement.ContextMenu>
										<ContentControl.Content>
											<Grid>
												<Path
													Name="PathTabMenu"
													Margin="1,3,1,3"
													Width="8.5"
													Height="5"
													Data="M0,0 L1,0 L0.5,1"
													Stretch="Fill"
													Fill="{TemplateBinding Foreground}" />
												<Path
													Name="PathMoreTabsMenu1"
													Margin="1,2,6,2"
													Width="4"
													Height="8.5"
													Data="M0,0 L1,0.5 L0,1"
													Stretch="Fill"
													Visibility="Hidden"
													Fill="{TemplateBinding Foreground}" />
												<Path
													Name="PathMoreTabsMenu2"
													Margin="7,2,0,2"
													Width="4"
													Height="8.5"
													Data="M0,0 L1,0.5 L0,1"
													Stretch="Fill"
													Visibility="Hidden"
													Fill="{TemplateBinding Foreground}" />
											</Grid>
										</ContentControl.Content>
									</Button>
									<Button
										Name="ButtonCloseTab"
										Margin="0,0,.5,0"
										Style="{TemplateBinding dc:ControlButtonStyle}"
										Grid.Column="1"
										Command="dc:SuperTabItem.CloseTab"
										Visibility="{TemplateBinding dc:ControlBoxCloseTabVisibility}">
										<ContentControl.Content>
											<Path
												Margin="1"
												Width="9"
												Height="9"
												Data="M0,0 L1,1 M0,1 L1,0"
												Stretch="UniformToFill"
												StrokeThickness="1.5"
												Stroke="{TemplateBinding Foreground}" />
										</ContentControl.Content>
									</Button>
								</Grid>
								<dc:SuperTabPanel
									Name="TabStripPanel"
									ZIndex="1"
									KeyboardNavigation.TabIndex="1"
									IsItemsHost="true"
									LayoutType="{TemplateBinding TabLayoutType}" />
							</DockPanel>
						</dc:TabPanelBorder>
						<Border
							Name="ContentPanel"
							Background="{TemplateBinding dc:ContentBackground}"
							BorderThickness="{TemplateBinding dc:ContentBorderThickness}"
							BorderBrush="{TemplateBinding dc:ContentBorderBrush}"
							KeyboardNavigation.TabNavigation="Local"
							KeyboardNavigation.DirectionalNavigation="Contained"
							KeyboardNavigation.TabIndex="2"
							Grid.Column="0"
							Grid.Row="1">
							<Border
								Name="ContentPanelInner"
								BorderThickness="{TemplateBinding dc:ContentBorderThickness}"
								BorderBrush="{TemplateBinding dc:ContentInnerBorderBrush}">
								<ContentPresenter
									Name="PART_SelectedContentHost"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Margin="{TemplateBinding Padding}"
									ContentSource="SelectedContent" />
							</Border>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="TabStripPanel"
							Property="dc:SuperTabPanel.IsOversized"
							Value="true">
							<Setter
								TargetName="PathTabMenu"
								Property="Visibility"
								Value="Hidden" />
							<Setter
								TargetName="PathMoreTabsMenu1"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="PathMoreTabsMenu2"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="dc:SuperTabControl.TabStyle"
							Value="WinMediaPlayer12">
							<Setter
								TargetName="TabStripPanel"
								Property="dc:SuperTabPanel.TabTuck"
								Value="-3" />
						</Trigger>
						<Trigger
							Property="dc:SuperTabControl.TabStyle"
							Value="OneNote2007">
							<Setter
								TargetName="TabStripPanel"
								Property="dc:SuperTabPanel.TabTuck"
								Value="8" />
						</Trigger>
						<Trigger
							Property="dc:SuperTabControl.TabStyle"
							Value="Office2007">
							<Setter
								TargetName="TabStripPanel"
								Property="dc:SuperTabPanel.TabTuck"
								Value="0" />
						</Trigger>
						<Trigger
							Property="dc:SuperTabControl.TabStyle"
							Value="Office2010BackstageBlue">
							<Setter
								TargetName="TabStripPanel"
								Property="dc:SuperTabPanel.TabTuck"
								Value="0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dc:SuperTabControl.TabStyle"
									Value="OneNote2007" />
								<Condition
									Property="TabControl.TabStripPlacement"
									Value="Left" />
							</MultiTrigger.Conditions>
							<MultiTrigger.Setters>
								<Setter
									TargetName="TabStripPanel"
									Property="dc:SuperTabPanel.TabTuck"
									Value="14" />
							</MultiTrigger.Setters>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dc:SuperTabControl.TabStyle"
									Value="OneNote2007" />
								<Condition
									Property="TabControl.TabStripPlacement"
									Value="Right" />
							</MultiTrigger.Conditions>
							<MultiTrigger.Setters>
								<Setter
									TargetName="TabStripPanel"
									Property="dc:SuperTabPanel.TabTuck"
									Value="14" />
							</MultiTrigger.Setters>
						</MultiTrigger>
						<Trigger
							Property="dc:SuperTabControl.TabStyle"
							Value="VisualStudio2008Document">
							<Setter
								TargetName="TabStripPanel"
								Property="dc:SuperTabPanel.TabTuck"
								Value="14" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="dc:SuperTabControl.TabStyle"
									Value="VisualStudio2008Document" />
								<Condition
									Property="TabControl.TabStripPlacement"
									Value="Right" />
							</MultiTrigger.Conditions>
							<MultiTrigger.Setters>
								<Setter
									TargetName="TabStripPanel"
									Property="dc:SuperTabPanel.TabTuck"
									Value="10" />
							</MultiTrigger.Setters>
						</MultiTrigger>
						<Trigger
							Property="TabControl.TabStripPlacement"
							Value="Bottom">
							<Setter
								TargetName="TabStripBorder"
								Property="Row"
								Value="1" />
							<Setter
								TargetName="ContentPanel"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="RowDefinition0"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="RowDefinition1"
								Property="Height"
								Value="Auto" />
							<Setter
								TargetName="HeaderPanel"
								Property="Margin"
								Value="0,0,0,2" />
							<Setter
								TargetName="TabStripBorder"
								Property="Margin"
								Value="0,-2,0,0" />
							<Setter
								Property="dc:SuperTabControl.ContentBorderThickness"
								Value="1,1,1,0" />
						</Trigger>
						<Trigger
							Property="TabControl.TabStripPlacement"
							Value="Left">
							<Setter
								TargetName="TabStripBorder"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="ContentPanel"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="TabStripBorder"
								Property="Column"
								Value="0" />
							<Setter
								TargetName="ContentPanel"
								Property="Column"
								Value="1" />
							<Setter
								TargetName="ColumnDefinition0"
								Property="Width"
								Value="Auto" />
							<Setter
								TargetName="ColumnDefinition1"
								Property="Width"
								Value="*" />
							<Setter
								TargetName="RowDefinition0"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="RowDefinition1"
								Property="Height"
								Value="0" />
							<Setter
								TargetName="HeaderPanel"
								Property="Margin"
								Value="2,0,0,0" />
							<Setter
								TargetName="PART_TabHeaderLeft"
								Property="Dock"
								Value="Top" />
							<Setter
								TargetName="PART_TabHeaderRight"
								Property="Dock"
								Value="Bottom" />
							<Setter
								TargetName="TabStripBorder"
								Property="Margin"
								Value="0,0,-2.5,0" />
							<Setter
								Property="dc:SuperTabControl.ContentBorderThickness"
								Value="0,1,1,1" />
							<Setter
								TargetName="ControlBoxGrid"
								Property="Dock"
								Value="Bottom" />
							<Setter
								TargetName="ButtonCloseTab"
								Property="Column"
								Value="0" />
							<Setter
								TargetName="ButtonCloseTab"
								Property="Row"
								Value="1" />
						</Trigger>
						<Trigger
							Property="TabControl.TabStripPlacement"
							Value="Right">
							<Setter
								TargetName="TabStripBorder"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="ContentPanel"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="TabStripBorder"
								Property="Column"
								Value="1" />
							<Setter
								TargetName="ContentPanel"
								Property="Column"
								Value="0" />
							<Setter
								TargetName="ColumnDefinition0"
								Property="Width"
								Value="*" />
							<Setter
								TargetName="ColumnDefinition1"
								Property="Width"
								Value="Auto" />
							<Setter
								TargetName="RowDefinition0"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="RowDefinition1"
								Property="Height"
								Value="0" />
							<Setter
								TargetName="HeaderPanel"
								Property="Margin"
								Value="0,0,2,0" />
							<Setter
								TargetName="PART_TabHeaderLeft"
								Property="Dock"
								Value="Top" />
							<Setter
								TargetName="PART_TabHeaderRight"
								Property="Dock"
								Value="Bottom" />
							<Setter
								TargetName="TabStripBorder"
								Property="Margin"
								Value="-2,0,0,0" />
							<Setter
								Property="dc:SuperTabControl.ContentBorderThickness"
								Value="1,1,0,1" />
							<Setter
								TargetName="ControlBoxGrid"
								Property="Dock"
								Value="Bottom" />
							<Setter
								TargetName="ButtonCloseTab"
								Property="Column"
								Value="0" />
							<Setter
								TargetName="ButtonCloseTab"
								Property="Row"
								Value="1" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="false">
							<Setter
								Value="{DynamicResource SystemColors.GrayTextBrush}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="dc:SuperTabControl.TabStyle"
				Value="Office2007">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=Office2007Background}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabControl.TabStyle"
				Value="Office2010BackstageBlue">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=Office2010BackstageBlueBackground}}" />
			</Trigger>
			<Trigger
				Property="dc:SuperTabControl.TabStyle"
				Value="WinMediaPlayer12">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=WinMediaPlayer12Background}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<ControlTemplate
		TargetType="{x:Type ButtonBase}"
		x:Key="TabMenuButton">
		<Border
			BorderThickness="{TemplateBinding BorderThickness}"
			Padding="1"
			Background="{TemplateBinding Background}"
			BorderBrush="{TemplateBinding BorderBrush}">
			<ContentPresenter
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				Content="{TemplateBinding Content}"
				TextElement.Foreground="{TemplateBinding Foreground}"
				VerticalAlignment="Center"
				HorizontalAlignment="Center" />
		</Border>
	</ControlTemplate>
	<Style
		TargetType="{x:Type ButtonBase}"
		x:Key="{ComponentResourceKey {x:Type dc:SuperTabControl}, VS2008Button}">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=VS2008ButtonForeground}}" />
		<Setter
			Property="Template"
			Value="{StaticResource TabMenuButton}" />
		<Style.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=VS2008ButtonMouseOverBorder}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=VS2008ButtonMouseOverBackground}}" />
			</Trigger>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=VS2008ButtonMouseDownBorder}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=VS2008ButtonMouseDownBackground}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type ButtonBase}"
		x:Key="{ComponentResourceKey {x:Type dc:SuperTabControl}, OneNote2007Button}">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=OneNote2007ButtonForeground}}" />
		<Setter
			Property="Template"
			Value="{StaticResource TabMenuButton}" />
		<Style.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=OneNote2007ButtonMouseOverBorder}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=OneNote2007ButtonMouseOverBackground}}" />
			</Trigger>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=OneNote2007ButtonMouseDownBorder}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:SuperTabControl, ResourceId=OneNote2007ButtonMouseDownBackground}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
