									<dcp:MonthCalendarDayLabel
										Name="Day10"
										Grid.Column="3"
										Grid.Row="2" />
									<dcp:MonthCalendarDayLabel
										Name="Day11"
										Grid.Column="4"
										Grid.Row="2" />
									<dcp:MonthCalendarDayLabel
										Name="Day12"
										Grid.Column="5"
