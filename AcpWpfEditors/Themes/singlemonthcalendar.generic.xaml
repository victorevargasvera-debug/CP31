									<dcp:MonthCalendarDayNameLabel
										Name="DayName6"
										Grid.Column="6"
										Grid.Row="0" />
									<dcp:MonthCalendarDayNameLabel
										Name="DayName7"
										Grid.Column="7"
										Grid.Row="0" />
									<dcp:MonthCalendarDayLabel
										Name="Day1"
										Grid.Column="1"
										Grid.Row="1" />
									<dcp:MonthCalendarDayLabel
										Name="Day2"
										Grid.Column="2"
										Grid.Row="1" />
									<dcp:MonthCalendarDayLabel
										Name="Day3"
										Grid.Column="3"
