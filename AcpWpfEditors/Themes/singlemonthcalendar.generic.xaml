										Grid.Row="5" />
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber6"
										Grid.Column="0"
										Grid.Row="6" />
									<dcp:MonthCalendarDayNameLabel
										Name="DayName1"
										Grid.Column="1"
										Grid.Row="0" />
									<dcp:MonthCalendarDayNameLabel
										Name="DayName2"
										Grid.Column="2"
										Grid.Row="0" />
									<dcp:MonthCalendarDayNameLabel
										Name="DayName3"
