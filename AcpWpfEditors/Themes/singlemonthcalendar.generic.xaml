<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:SingleMonthCalendar}"
		x:Key="{x:Type dc:SingleMonthCalendar}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarForeground}}}" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:SingleMonthCalendar}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="1"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<Grid
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition />
							</Grid.RowDefinitions>
							<DockPanel
								Grid.Column="0"
								Grid.Row="0"
								LastChildFill="True"
								Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarNavigationBackground}}}">
								<dcp:EditorButton
									Name="ButtonPreviousMonth"
									Margin="1"
									DockPanel.Dock="Left"
									Visibility="{TemplateBinding dc:PreviousMonthButtonVisibility}"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=MonthChangeButton}}">
									<Path
										Margin="4,2,4,2"
										Data="M0,4 L4,0 L4,8"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarNavigationForeground}}}" />
								</dcp:EditorButton>
								<dcp:EditorButton
									Name="ButtonNextMonth"
									Margin="1"
									Visibility="{TemplateBinding dc:NextMonthButtonVisibility}"
									DockPanel.Dock="Right"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=MonthChangeButton}}">
									<Path
										Margin="4,2,4,2"
										Data="M0,0 L4,4 L0,8"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.MonthCalendarNavigationForeground}}}" />
								</dcp:EditorButton>
								<Label
									Name="MonthNameLabel"
									Padding="0,1,0,1"
									Content="{TemplateBinding dc:DisplayMonthName}"
									Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=MonthLabel}}" />
							</DockPanel>
							<dc:StateAnimationControl
								Name="StateAnimation"
								Grid.Column="0"
								Grid.Row="1">
								<Grid
									Name="PART_CalGrid"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									Column="0"
									Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Name="WeekColumn"
											Width="Auto" />
										<ColumnDefinition />
										<ColumnDefinition />
										<ColumnDefinition />
										<ColumnDefinition />
										<ColumnDefinition />
										<ColumnDefinition />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition
											Name="DayNameRow" />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber1"
										Grid.Column="0"
										Grid.Row="1" />
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber2"
										Grid.Column="0"
										Grid.Row="2" />
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber3"
										Grid.Column="0"
										Grid.Row="3" />
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber4"
										Grid.Column="0"
										Grid.Row="4" />
									<dcp:MonthCalendarWeekLabel
										Name="WeekNumber5"
