<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:dcp="clr-namespace:DevComponents.WpfEditors.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dcp:LockUpdateCheckBox}"
		x:Key="{x:Type dcp:LockUpdateCheckBox}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalForeground}}}" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalBorder}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Margin"
			Value="1,0,3,0" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dcp:EditorElement, ResourceId=EditorCheckBox}}" />
		<Setter
			Property="VerticalAlignment"
			Value="Center" />
		<Setter
			Property="HorizontalAlignment"
			Value="Left" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type CheckBox}"
		x:Key="{ComponentResourceKey {x:Type dcp:EditorElement}, EditorCheckBox}">
		<StackPanel
			Orientation="Horizontal">
			<Border
				Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}">
				<Grid
					Margin="1">
					<Border
						Name="innerBorder"
						BorderThickness="1"
						MinWidth="9"
						MinHeight="9"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalBackgroundInner}}}"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalBorderInner}}}" />
					<Path
						Name="checkmark"
						StrokeThickness="2"
						Data="M0,4 L2,6 L6,0"
						Margin="1,0,0,0"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Visibility="Hidden"
						Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalCheckMark}}}" />
					<Border
						Name="checkneutral"
						Margin="2"
						Visibility="Hidden"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxNormalCheckMark}}}" />
				</Grid>
			</Border>
			<ContentPresenter
				Margin="{TemplateBinding Padding}"
				VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
				HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
				RecognizesAccessKey="true"
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				TextElement.Foreground="{TemplateBinding Foreground}" />
		</StackPanel>
		<ControlTemplate.Triggers>
			<Trigger
				Property="ToggleButton.IsChecked"
				Value="true">
				<Setter
					TargetName="checkmark"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="checkneutral"
					Property="Visibility"
					Value="Hidden" />
			</Trigger>
			<Trigger
				Property="ToggleButton.IsChecked"
				Value="{x:Null}">
				<Setter
					TargetName="checkmark"
					Property="Visibility"
					Value="Hidden" />
				<Setter
					TargetName="checkneutral"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="true">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverForeground}}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverBorder}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverBorderInner}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverBackgroundInner}}}" />
				<Setter
					TargetName="checkmark"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverCheckMark}}}" />
				<Setter
					TargetName="checkneutral"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxHoverCheckMark}}}" />
			</Trigger>
			<Trigger
				Property="IsPressed"
				Value="true">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedForeground}}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedBorder}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedBorderInner}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedBackgroundInner}}}" />
				<Setter
					TargetName="checkmark"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedCheckMark}}}" />
				<Setter
					TargetName="checkneutral"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxPressedCheckMark}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="false">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledForeground}}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledBorder}}}" />
				<Setter
					TargetName="innerBorder"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledBorderInner}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledBackgroundInner}}}" />
				<Setter
					TargetName="checkmark"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledCheckMark}}}" />
				<Setter
					TargetName="checkneutral"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.CheckBoxDisabledCheckMark}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
</ResourceDictionary>
