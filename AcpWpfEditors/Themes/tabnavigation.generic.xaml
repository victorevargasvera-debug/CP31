<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfEditors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:TabNavigation}"
		x:Key="{x:Type dc:TabNavigation}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabNavigationForeground}}}" />
		<Setter
			Property="Padding"
			Value="12,8,12,8" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabNavigationBorder}}}" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabNavigationBackground}}}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Center" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:TabNavigation}">
					<Grid>
						<Border
							Margin="8,0,8,0"
							Background="{TemplateBinding Background}"
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							CornerRadius="4,4,9,9">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>
								<Border
									Grid.ColumnSpan="3"
									Grid.RowSpan="2"
									Grid.Column="0"
									Grid.Row="0"
									BorderThickness="1,0,1,1"
									BorderBrush="#A0CDCDCD"
									CornerRadius="4,4,9,9"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch">
									<Border
										BorderThickness="1,0,1,1"
										BorderBrush="#90DEDEDE"
										CornerRadius="4,4,9,9">
										<Border
											BorderThickness="1,0,1,1"
											BorderBrush="#70EEEEEE"
											CornerRadius="4,4,9,9" />
									</Border>
								</Border>
								<Border
									CornerRadius="3,3,0,0"
									Grid.ColumnSpan="3"
									Grid.Row="0"
									Grid.Column="0"
									Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabNavigationTitleBackground}}}" />
								<ContentPresenter
									TextElement.FontWeight="Bold"
									Opacity=".4"
									Margin="8,0,0,0"
									Grid.Row="0"
									Grid.Column="0"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									ContentSource="SelectedHeader"
									VerticalAlignment="Center"
									TextElement.Foreground="#FFFFFFFF">
									<UIElement.RenderTransform>
										<TranslateTransform
											X="1"
											Y="1" />
									</UIElement.RenderTransform>
								</ContentPresenter>
								<ContentPresenter
									Name="PART_SelectedHeaderContentHost"
									TextElement.FontWeight="Bold"
									Margin="8,0,0,0"
									Grid.Row="0"
									Grid.Column="0"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									ContentSource="SelectedHeader"
									VerticalAlignment="Center"
									TextElement.Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.TabNavigationTitleForeground}}}" />
								<StackPanel
									Name="HeaderPanel"
									Orientation="Horizontal"
									HorizontalAlignment="Center"
									Grid.Row="0"
									Grid.Column="1"
									Margin="4"
									IsItemsHost="true" />
								<dc:StateAnimationControl
									Name="PART_StateAnimation"
									Grid.ColumnSpan="3"
									Grid.Row="1"
									Grid.Column="0">
									<ContentPresenter
										Name="PART_SelectedContentHost"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Margin="{TemplateBinding Padding}"
										ContentSource="SelectedContent" />
								</dc:StateAnimationControl>
							</Grid>
						</Border>
						<Button
							Name="PreviousTabButton"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabNavigation, ResourceId=NavigationButton}}">
							<Path
								Margin="3"
								Data="M0,4 L4,0 L4,3 L8,3 L8,6 L4,6 L4,9 L0,5"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Opacity=".7"
								Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
						</Button>
						<Button
							Name="NextTabButton"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabNavigation, ResourceId=NavigationButton}}">
							<Path
								Margin="3"
								Data="M0,3 L4,3 L4,0 L8,4 L8,5 L4,9 L4,6 L0,6"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Opacity=".7"
								Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
						</Button>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type TabItem}"
		x:Key="{ComponentResourceKey {x:Type dc:TabNavigation}, TabItem}">
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabNavigationTitleForeground}}}" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Margin"
			Value="2" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type TabItem}">
					<Ellipse
						Cursor="Hand"
						Width="8"
						Height="8"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						Fill="{TemplateBinding Background}"
						Stroke="{TemplateBinding BorderBrush}"
						StrokeThickness="{TemplateBinding BorderThickness}" />
					<ControlTemplate.Triggers>
						<Trigger
							Property="TabItem.IsSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey {x:Type dc:EditColors}, {x:Static dc:EditColors.TabNavigationTitleForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		x:Key="{ComponentResourceKey {x:Type dc:TabNavigation}, NavigationButton}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBorder}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="true" />
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:TabNavigation, ResourceId=NavigationButtonTemplate}}" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type Button}"
		x:Key="{ComponentResourceKey {x:Type dc:TabNavigation}, NavigationButtonTemplate}">
		<Grid>
			<Ellipse
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				Fill="{TemplateBinding Background}"
				Stroke="{TemplateBinding BorderBrush}"
				StrokeThickness="{TemplateBinding BorderThickness}" />
			<Ellipse
				Name="innerBorder"
				Margin="1"
				StrokeThickness="{TemplateBinding BorderThickness}"
				Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonNormalBorderInner}}}" />
			<ContentPresenter
				Margin="{TemplateBinding Padding}"
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				Content="{TemplateBinding Content}"
				TextElement.Foreground="{TemplateBinding Foreground}"
				VerticalAlignment="Center"
				HorizontalAlignment="Center" />
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="true">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonHoverBorderInner}}}" />
			</Trigger>
			<Trigger
				Property="IsPressed"
				Value="true">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonPressedBorderInner}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="false">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBackground}}}" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBorder}}}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledForeground}}}" />
				<Setter
					TargetName="innerBorder"
					Property="Stroke"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:EditColors, ResourceId={x:Static dc:EditColors.ButtonDisabledBorderInner}}}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
</ResourceDictionary>
