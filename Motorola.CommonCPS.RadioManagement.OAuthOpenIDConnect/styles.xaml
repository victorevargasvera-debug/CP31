	<Style
		TargetType="{x:Type igDP:CellValuePresenter}"
		BasedOn="{StaticResource CellValuePresenterStyle}"
		x:Key="ShowCompareSourceValueStyle">
		<Style.Setters>
			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}">
							<TextBlock
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="Center"
								HorizontalAlignment="Center">
								<controls:RMHyperlink
									Name="lbtDetails"
									IsEnabled="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}, Converter={StaticResource CompareResultSourceEnable}}"
									Command="{Binding Path=DataContext.NavigateToSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
									CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
									<FrameworkContentElement.Style>
										<Style
											TargetType="{x:Type controls:RMHyperlink}">
											<Style.Triggers>
												<DataTrigger
													Value="False"
													Binding="{Binding ElementName=lbtDetails, Path=IsEnabled}">
													<Setter
														Property="Inline.TextDecorations"
														Value="" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</FrameworkContentElement.Style>
									<TextBlock
										Text="{Binding Path=DataRecord.DataItem.SourceValue, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
								</controls:RMHyperlink>
							</TextBlock>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style.Setters>
		<Style.Triggers>
			<DataTrigger
				Value="True"
				Binding="{Binding Path=Record.DataItem.IsOutOfSync, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Hidden" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
