<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.OAuthOpenIDConnect.SelectAgencyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:oauthopenidconnect="clr-namespace:Motorola.CommonCPS.RadioManagement.OAuthOpenIDConnect">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converters:AgencySelectionComboBoxSizeConverter
				x:Key="AgencySelectionComboBoxSizeConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24"
		HorizontalAlignment="Center">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="30" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			HorizontalAlignment="Right">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Agency}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 2-->
			<controls:RMComboBox
				Name="AgencyCmboBox"
				Grid.Column="2"
				DisplayMemberPath="provAgencyName"
				HorizontalAlignment="Center"
				Width="{Binding Path=ActualWidth, Converter={StaticResource AgencySelectionComboBoxSizeConverter}, ConverterParameter=0.75, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
				ItemsSource="{Binding SelectAgencyContext.AvailableAgencies}"
				SelectedItem="{Binding SelectAgencyContext.SelectedAgency}" />
		</Grid>
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 3-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectAgencyCommand}" />
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="3"
			Error="{Binding SelectAgencyContext.ExceptionMessage}" />
	</Grid>
</UserControl>
