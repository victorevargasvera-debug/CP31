	<Style
		TargetType="{x:Type ScrollViewer}"
		x:Key="ScrollViewerStyle">
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Top" />
		<Setter
			Property="VerticalScrollBarVisibility"
			Value="Visible" />
		<Setter
			Property="Padding"
			Value="0" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="BorderBrush">
			<Setter.Value>
				<LinearGradientBrush
					EndPoint="0.5,1"
					StartPoint="0.5,0">
					<GradientStop
						Color="#FFA3AEB9"
						Offset="0" />
					<GradientStop
						Color="#FF8399A9"
						Offset="0.375" />
					<GradientStop
						Color="#FF718597"
						Offset="0.375" />
					<GradientStop
						Color="#FF617584"
						Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ScrollViewer}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="2">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="ScrollVisibility">
								<VisualState
									x:Name="VerticalVisible">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetName="UpScrollButtonPalce"
											Storyboard.TargetProperty="Height">
											<DiscreteObjectKeyFrame
												KeyTime="0"
												Value="16" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetName="BottomScrollButtonPalce"
											Storyboard.TargetProperty="Height">
											<DiscreteObjectKeyFrame
												KeyTime="0"
												Value="16" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="HorizontalVisible">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetName="LeftScrollButtonPalce"
											Storyboard.TargetProperty="Width">
											<DiscreteObjectKeyFrame
												KeyTime="0"
												Value="16" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Duration="0"
											Storyboard.TargetName="RightScrollButtonPalce"
											Storyboard.TargetProperty="Width">
											<DiscreteObjectKeyFrame
												KeyTime="0"
												Value="16" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Hidden" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid
							Background="{TemplateBinding Background}">
							<Grid.RowDefinitions>
								<RowDefinition
									Name="UpScrollButtonPalce"
									Height="0" />
								<RowDefinition
									Height="*" />
								<RowDefinition
									Name="BottomScrollButtonPalce"
									Height="0" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Name="LeftScrollButtonPalce"
									Width="0" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Name="RightScrollButtonPalce"
									Width="0" />
							</Grid.ColumnDefinitions>
							<ScrollContentPresenter
								Name="ScrollContentPresenter"
								Grid.Row="1"
								Grid.Column="1"
								Cursor="{TemplateBinding Cursor}"
								Margin="{TemplateBinding Padding}"
								ContentTemplate="{TemplateBinding ContentTemplate}" />
							<ScrollBar
								Name="VerticalScrollBar"
								Width="{TemplateBinding Width}"
								Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
								IsTabStop="False"
								Grid.Column="0"
								Grid.ColumnSpan="3"
								Grid.Row="0"
								Grid.RowSpan="3"
								Maximum="{TemplateBinding ScrollableHeight}"
								Minimum="0"
								Value="{TemplateBinding VerticalOffset}"
								Orientation="Vertical"
								ViewportSize="{TemplateBinding ViewportHeight}"
								Style="{StaticResource ScrollBarStyle}" />
							<ScrollBar
								Name="HorizontalScrollBar"
								Height="{TemplateBinding Height}"
								Margin="-1,0,-1,-1"
								Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
								IsTabStop="False"
								Grid.Column="0"
								Grid.ColumnSpan="3"
								Grid.Row="0"
								Grid.RowSpan="3"
								Maximum="{TemplateBinding ScrollableWidth}"
								Minimum="0"
								Value="{TemplateBinding HorizontalOffset}"
								Orientation="Horizontal"
								ViewportSize="{TemplateBinding ViewportWidth}"
								Style="{StaticResource ScrollBarStyle}" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
