												KeyTime="00:00:00">
												<ObjectKeyFrame.Value>
													<Thickness>1,1,1,1</Thickness>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup
								x:Name="LogicalOperators">
								<VisualState
									x:Name="NoLogicalOp" />
								<VisualState
									x:Name="And">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Duration="00:00:00"
											Storyboard.TargetName="LogicalOpBorder"
											Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame
												KeyTime="00:00:00"
												Value="{StaticResource LogicalANDBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Or">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames
											BeginTime="00:00:00"
											Duration="00:00:00"
											Storyboard.TargetName="LogicalOpBorder"
											Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame
												KeyTime="00:00:00"
												Value="{StaticResource LogicalORBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Border
							Name="Root"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Background="{TemplateBinding Background}" />
						<Rectangle
							Name="AltMouseOver"
