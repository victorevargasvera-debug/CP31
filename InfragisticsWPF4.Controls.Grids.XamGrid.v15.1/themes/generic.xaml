	<Style
		TargetType="{x:Type igPrim:GroupByMovingIndicator}"
		x:Key="{x:Type igPrim:GroupByMovingIndicator}">
		<Setter
			Property="Background"
			Value="#FFFFFFFF" />
		<Setter
			Property="Foreground"
			Value="{StaticResource FocusBrush}" />
		<Setter
			Property="Width"
			Value="13" />
		<Setter
			Property="igPrim:MovingIndicator.HorizontalOffset"
			Value="-12" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igPrim:GroupByMovingIndicator}">
					<Canvas>
						<Path
							Name="TopIndicator"
							Height="5"
							Width="8"
							Data="M0,0 L4,4 L8,0"
							Fill="{TemplateBinding Background}"
							RenderTransformOrigin="0.5,0">
							<UIElement.RenderTransform>
								<TransformGroup>
									<ScaleTransform />
									<SkewTransform />
									<RotateTransform />
									<TranslateTransform />
								</TransformGroup>
							</UIElement.RenderTransform>
						</Path>
						<Path
							Name="BottomIndicator"
							Height="5"
							Width="8"
							Data="M0,4 L8,4 L4,0"
							Fill="{TemplateBinding Background}"
							RenderTransformOrigin="0.5,0">
							<UIElement.RenderTransform>
								<TransformGroup>
									<ScaleTransform />
									<SkewTransform />
									<RotateTransform />
									<TranslateTransform />
								</TransformGroup>
							</UIElement.RenderTransform>
						</Path>
						<Path
							Name="CenterIndicator"
							Width="13"
							Height="26"
							Canvas.Top="2"
							Data="M3,26 C3,26 13,15 13,15 C14,14 14,12 13,11 C13,11 3,0 3,0 C3,0 0,0 0,0 C0,0 10,11 10,11 C11,12 11,14 10,15 C10,15 0,26 0,26 C0,26 3,26 3,26"
							Fill="{TemplateBinding Foreground}"
							Stretch="Fill" />
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="CommonStates">
								<VisualState
									x:Name="Normal">
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="TopIndicator"
											Storyboard.TargetProperty="Opacity"
											From="0.2"
											To="1"
											Duration="00:00:00.50"
											AutoReverse="True"
											RepeatBehavior="Forever" />
										<DoubleAnimation
											Storyboard.TargetName="TopIndicator"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)"
											From="0"
											To="-3"
											Duration="00:00:00.40"
											AutoReverse="True"
											RepeatBehavior="Forever" />
										<DoubleAnimation
											Storyboard.TargetName="BottomIndicator"
											Storyboard.TargetProperty="Opacity"
											From="0.2"
											To="1"
											Duration="00:00:00.50"
											AutoReverse="True"
											RepeatBehavior="Forever" />
										<DoubleAnimation
											Storyboard.TargetName="BottomIndicator"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)"
											From="0"
											To="3"
											Duration="00:00:00.40"
											AutoReverse="True"
											RepeatBehavior="Forever" />
										<DoubleAnimation
											Storyboard.TargetName="CenterIndicator"
											Storyboard.TargetProperty="Opacity"
											From="0.2"
											To="1"
											Duration="00:00:00.50"
											BeginTime="00:00:00.20"
											AutoReverse="True"
											RepeatBehavior="Forever" />
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Canvas>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
