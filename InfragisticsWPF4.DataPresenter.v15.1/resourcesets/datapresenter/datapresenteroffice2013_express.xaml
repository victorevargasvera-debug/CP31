						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="BeforeParentHeadersAttached"
									Binding="{Binding Path=FieldLayout.ChildRecordsDisplayOrderResolved}" />
								<Condition
									Value="Horizontal"
									Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_NestedContentSite"
								Property="Column"
								Value="0" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:RecordPresenter.TemplateCardView">
