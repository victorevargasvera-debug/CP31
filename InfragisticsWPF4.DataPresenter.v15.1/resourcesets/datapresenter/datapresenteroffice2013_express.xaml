	<Style
		TargetType="{x:Type Button}"
		x:Key="{x:Static igDP:DataPresenterBase.FieldChooserButtonStyleKey}">
		<Setter
			Property="Background"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.ButtonNormalCenterBrush}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.ButtonNormalOuterBorderBrush}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid
						Background="#00FFFFFF"
						Width="24"
						Height="24"
						SnapsToDevicePixels="True">
						<Border
							Name="Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="True" />
						<Grid
							Name="FieldChooserIcon"
							Width="10"
							Height="10"
							VerticalAlignment="Center"
							HorizontalAlignment="Center"
							SnapsToDevicePixels="True">
							<Path
								Data="M0,8 L4,8 L4,10 L0,10 M0,5 L4,5 L4,7 L0,7 M3,3 L10,3 L10,4 L10,5 L9,5 L9,4 L8,4 L8,5 L9,5 L9,6 L10,6 L10,7 L8,7 L8,9 L8,10 L7,10 L5,10 L5,9 L7,9 L7,7 L5,7 L5,6 L6,6 L6,5 L7,5 L7,4 L6,4 L6,5 L5,5 L5,4 L3,4 M3,0 L10,0 L10,2 L3,2"
								Stretch="Fill"
								Width="10"
								Height="10"
								VerticalAlignment="Top"
								SnapsToDevicePixels="True"
								Fill="{StaticResource IndicatorsFill}" />
						</Grid>
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							Margin="{TemplateBinding Padding}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ButtonHoverCenterBrush}"
								Property="Background" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type RepeatButton}"
		x:Key="btnGroupByNavBase">
		<Setter
			Property="Stylus.IsPressAndHoldEnabled"
			Value="False" />
		<Setter
			Property="Width"
			Value="24" />
		<Setter
			Property="Height"
			Value="24" />
