								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<DockPanel
								Visibility="{TemplateBinding igDP:FieldGroupSelectorVisibilityResolved}">
								<editors:XamCheckEditor
									Name="toggleAllCheckBox"
									DockPanel.Dock="Left"
									IsThreeState="False"
									Margin="4,0,0,0"
									Value="{Binding Path=AllCurrentFieldsVisible, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}"
									Visibility="{Binding Path=DisplayHiddenFieldsOnly, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=OneWay, Converter={StaticResource NotBoolToVisConverter}}" />
								<editors:XamComboEditor
									Name="fieldGroupSelector"
									DockPanel.Dock="Right"
									ItemsSource="{TemplateBinding igDP:FieldGroups}"
									DisplayValueSource="Value"
									HorizontalAlignment="Stretch"
									Margin="2 2 2 4"
									ValueType="{x:Type igDP:FieldChooserGroup}"
									Value="{Binding Path=CurrentFieldGroup, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}" />
							</DockPanel>
							<igWindows:CardPanel
								Grid.Row="1"
								Margin=" 0 4 0 0">
								<ListBox
									Name="fieldsListBox"
									ItemsSource="{TemplateBinding igDP:CurrentFields}"
									SelectionMode="Single"
									HorizontalContentAlignment="Stretch"
									Style="{DynamicResource ListBoxStyle}"
									BorderThickness="0 1 0 0"
									SelectedItem="{Binding Path=SelectedField, RelativeSource={x:Static RelativeSource.TemplatedParent}, Mode=TwoWay}">
									<ItemsControl.ItemContainerStyle>
										<Style
											TargetType="{x:Type ListBoxItem}">
											<Setter
												Property="FrameworkElement.FocusVisualStyle"
												Value="{x:Null}" />
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type ListBoxItem}">
														<Border
															Background="{TemplateBinding Background}"
															BorderBrush="{TemplateBinding BorderBrush}"
															BorderThickness="{TemplateBinding BorderThickness}"
															Padding="{TemplateBinding Padding}"
															SnapsToDevicePixels="True">
															<ContentPresenter
																HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
														</Border>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</ItemsControl.ItemContainerStyle>
									<UIElement.InputBindings>
										<KeyBinding
											Key="Space"
											Command="{x:Static igDP:FieldChooserCommands.ToggleVisibility}" />
									</UIElement.InputBindings>
								</ListBox>
								<Border
									Name="highlightBorder"
									BorderThickness="1"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									BorderBrush="{StaticResource TransparentBrush}" />
							</igWindows:CardPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:FieldChooser.IsDraggingItem"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="igDP:FieldChooser.IsDraggingItemFromDataPresenter"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="igDP:FieldChooser.IsDragItemOver"
							Value="True">
							<Setter
								TargetName="highlightBorder"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.FieldChooserDragBorderBrushKey}"
								Property="BorderBrush" />
						</Trigger>
						<DataTrigger
							Value="0"
							Binding="{Binding Path=CurrentFields.Count, RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="toggleAllCheckBox"
								Property="IsEnabled"
								Value="False" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
