										Margin="1,1,10,1"
										Foreground="{DynamicResource AccentForegroundBrush}"
										FontFamily="Segoe UI Semibold" />
									<ContentControl
										Name="prompt2"
										Content="{TemplateBinding igDP:Prompt2}"
										ContentTemplate="{TemplateBinding igDP:Prompt2Template}" />
