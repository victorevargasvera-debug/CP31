							<Setter
								TargetName="PART_NestedContentSite"
								Property="Row"
								Value="0" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="BeforeParent"
									Binding="{Binding Path=FieldLayout.ChildRecordsDisplayOrderResolved}" />
								<Condition
									Value="Horizontal"
									Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_NestedContentSite"
								Property="Column"
								Value="0" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="BeforeParentHeadersAttached"
									Binding="{Binding Path=FieldLayout.ChildRecordsDisplayOrderResolved}" />
								<Condition
									Value="Vertical"
									Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_NestedContentSite"
