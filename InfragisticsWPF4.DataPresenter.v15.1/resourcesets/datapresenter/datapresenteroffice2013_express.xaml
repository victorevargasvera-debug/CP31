							Name="filterPanel"
							Orientation="Horizontal"
							Visibility="Collapsed">
							<Rectangle
								Width="20" />
							<TextBlock
								Text="{Binding Path=FieldFilter.Description}" />
						</StackPanel>
					</StackPanel>
					<DataTemplate.Triggers>
