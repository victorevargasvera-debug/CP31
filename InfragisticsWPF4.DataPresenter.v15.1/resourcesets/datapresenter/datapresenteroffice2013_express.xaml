							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:RecordPresenter.Orientation"
									Value="Vertical" />
								<Condition
									Property="igDP:RecordPresenter.ShouldDisplayGroupByRecordContent"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="ExpansionIndicatorBorder"
								Property="Row"
								Value="2" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:RecordPresenter.Orientation"
									Value="Horizontal" />
								<Condition
									Property="igDP:RecordPresenter.ShouldDisplayGroupByRecordContent"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_RecordContentSite"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<Trigger
