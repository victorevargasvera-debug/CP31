					DataType="{x:Type igDP:FieldChooserEntry}">
					<DockPanel>
						<editors:XamCheckEditor
							Name="checkBox"
							DockPanel.Dock="Left"
							IsThreeState="False"
							Value="{Binding Path=IsVisible, Mode=TwoWay}" />
