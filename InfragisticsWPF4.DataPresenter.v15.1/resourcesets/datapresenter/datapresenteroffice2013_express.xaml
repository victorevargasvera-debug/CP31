	<Style
		BasedOn="{x:Static themes:DataPresenterGeneric.DataRecordCellArea}"
		TargetType="{x:Type igDP:DataRecordCellArea}"
		x:Key="{x:Type igDP:DataRecordCellArea}">
		<Setter
			Property="Background"
			Value="{StaticResource DataRecordCellAreaBackground}" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource DataRecordCellAreaBorderBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundHover"
			Value="{StaticResource DataRecordCellAreaBgHover}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderHoverBrush"
			Value="{StaticResource DataRecordCellAreaBorderHoverBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundActive"
			Value="{StaticResource DataRecordCellAreaBackgroundActive}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderActiveBrush"
			Value="{StaticResource DataRecordCellAreaBorderActiveBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundAlternate"
			Value="{StaticResource DataRecordCellAreaBackgroundAlternate}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderAlternateBrush"
			Value="{StaticResource DataRecordCellAreaBorderAlternateBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundSelected"
			Value="{StaticResource DataRecordCellAreaBgSelected}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderSelectedBrush"
			Value="{StaticResource DataRecordCellAreaBorderSelectedBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.CornerRadius"
			Value="0" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="Foreground"
			Value="{StaticResource ForegroundBrush}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundStyle"
			Value="{DynamicResource {ComponentResourceKey {x:Type igDP:XamDataGrid}, GrayForegroundStyle}}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundActiveStyle"
			Value="{DynamicResource {ComponentResourceKey {x:Type igDP:XamDataGrid}, GrayForegroundStyle}}" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundAlternateStyle"
			Value="{DynamicResource {ComponentResourceKey {x:Type igDP:XamDataGrid}, GrayForegroundStyle}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:DataRecordCellArea}">
					<FrameworkTemplate.Resources>
						<ResourceDictionary>
							<Storyboard
								x:Key="timelineIsActive">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Active"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsActive_off">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Active"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsSelected">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Selected"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsSelected_off">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Selected"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineHover">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Hover"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineHover_off">
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="Hover"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="0"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</ResourceDictionary>
					</FrameworkTemplate.Resources>
					<igWindows:CardPanel>
						<Border
							Name="Background"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}" />
						<Border
							Name="Alternate"
							Background="{TemplateBinding igDP:BackgroundAlternate}"
							BorderBrush="{TemplateBinding igDP:BorderAlternateBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Opacity="1"
							Visibility="Collapsed" />
						<Border
							Name="Selected"
							Background="{TemplateBinding igDP:BackgroundSelected}"
							BorderBrush="{TemplateBinding igDP:BorderSelectedBrush}"
							BorderThickness="1"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Opacity="0"
							Visibility="Visible" />
						<Border
							Name="Hover"
							Background="{TemplateBinding igDP:BackgroundHover}"
							BorderBrush="{TemplateBinding igDP:BorderHoverBrush}"
							BorderThickness="1"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Opacity="0"
							Visibility="Visible" />
						<Border
							Name="Active"
							Background="{TemplateBinding igDP:BackgroundActive}"
							BorderBrush="{TemplateBinding igDP:BorderActiveBrush}"
							BorderThickness="0"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Visibility="Collapsed" />
						<ContentPresenter
							Name="CellContent"
							Style="{TemplateBinding igDP:ForegroundStyle}" />
					</igWindows:CardPanel>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:DataRecordCellArea.IsAlternate"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsFilterRecord"
									Value="False" />
								<Condition
									Property="igDP:DataRecordCellArea.IsAddRecord"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Alternate"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundAlternateStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsFilterRecord"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundActiveStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="Active"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<EventTrigger
							RoutedEvent="igDP:DataRecordCellArea.HoverBegin">
							<EventTrigger.Actions>
								<BeginStoryboard
									Storyboard="{StaticResource timelineHover}" />
							</EventTrigger.Actions>
						</EventTrigger>
						<EventTrigger
							RoutedEvent="igDP:DataRecordCellArea.HoverEnd">
							<EventTrigger.Actions>
								<BeginStoryboard
									Storyboard="{StaticResource timelineHover_off}" />
							</EventTrigger.Actions>
						</EventTrigger>
						<EventTrigger
							RoutedEvent="igDP:DataRecordCellArea.Selected">
							<EventTrigger.Actions>
								<BeginStoryboard
									Storyboard="{StaticResource timelineIsSelected}" />
							</EventTrigger.Actions>
						</EventTrigger>
						<EventTrigger
							RoutedEvent="igDP:DataRecordCellArea.Deselected">
							<EventTrigger.Actions>
								<BeginStoryboard
									Storyboard="{StaticResource timelineIsSelected_off}" />
							</EventTrigger.Actions>
						</EventTrigger>
						<Trigger
							Property="igDP:DataRecordCellArea.IsAddRecord"
							Value="True">
							<Setter
								TargetName="Hover"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<Trigger
							Property="igDP:DataRecordCellArea.IsFilterRecord"
							Value="True">
							<Setter
								TargetName="Hover"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Selected"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsSelected"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundStyle, RelativeSource={RelativeSource TemplatedParent}}" />
