	<Style
		BasedOn="{x:Static themes:DataPresenterGeneric.DataRecordCellArea}"
		TargetType="{x:Type igDP:DataRecordCellArea}"
		x:Key="{x:Type igDP:DataRecordCellArea}">
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundHover"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABackgroundHoverKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderHoverBrush"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABorderHoverKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundActive"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABackgroundActiveKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.BorderActiveBrush"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABorderActiveKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundAlternate"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABackgroundAlternateKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.BackgroundSelected"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABackgroundSelectedKey}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,1" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.DRCABorderKey}" />
		<Setter
			Property="igDP:DataRecordCellArea.CornerRadius"
			Value="0,0,0,0" />
		<Setter
			Property="igDP:DataRecordCellArea.ForegroundActiveStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=DRCAActiveForeground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:DataRecordCellArea}">
					<FrameworkTemplate.Resources>
						<ResourceDictionary>
							<Storyboard
								x:Key="timelineIsActive">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Active"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.1000000"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsActive_off">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Active"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.4000000"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsSelected">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Selected"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.1000000"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineIsSelected_off">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Selected"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.3000000"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineHover">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Hover"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.2000000"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="timelineHover_off">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="Hover"
									Storyboard.TargetProperty="(UIElement.Opacity)">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.3000000"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</ResourceDictionary>
					</FrameworkTemplate.Resources>
					<igWindows:CardPanel>
						<Border
							Name="Background"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" />
						<Border
							Name="Alternate"
							Visibility="Collapsed"
							Background="{TemplateBinding igDP:BackgroundAlternate}"
							BorderBrush="{TemplateBinding igDP:BorderAlternateBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Opacity="1" />
						<Border
							Name="Selected"
							Visibility="Visible"
							Background="{TemplateBinding igDP:BackgroundSelected}"
							BorderBrush="{TemplateBinding igDP:BorderSelectedBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							Opacity="0" />
						<Border
							Name="Hover"
							Visibility="Visible"
							Background="{TemplateBinding igDP:BackgroundHover}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							BorderBrush="{TemplateBinding igDP:BorderHoverBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Opacity="0" />
						<Border
							Name="Active"
							Visibility="Collapsed"
							Background="{TemplateBinding igDP:BackgroundActive}"
							BorderBrush="{TemplateBinding igDP:BorderActiveBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding igDP:CornerRadius}" />
						<ContentPresenter
							Name="CellContent"
							Style="{TemplateBinding igDP:ForegroundStyle}" />
					</igWindows:CardPanel>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:DataRecordCellArea.IsActive"
							Value="True">
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundActiveStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="Active"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:DataRecordCellArea.IsSelected"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="False" />
							</MultiTrigger.Conditions>
							<TriggerBase.EnterActions>
								<BeginStoryboard
									Name="timelineIsSelected_BeginStoryboard"
									Storyboard="{StaticResource timelineIsSelected}" />
							</TriggerBase.EnterActions>
							<TriggerBase.ExitActions>
								<BeginStoryboard
									Name="timelineIsSelected_off_BeginStoryboard"
									Storyboard="{StaticResource timelineIsSelected_off}" />
							</TriggerBase.ExitActions>
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundSelectedStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="False" />
							</MultiTrigger.Conditions>
							<TriggerBase.EnterActions>
								<BeginStoryboard
									Name="timelineHover_BeginStoryboard"
									Storyboard="{StaticResource timelineHover}" />
							</TriggerBase.EnterActions>
							<TriggerBase.ExitActions>
								<BeginStoryboard
									Name="timelineHover_off_BeginStoryboard"
									Storyboard="{StaticResource timelineHover_off}" />
							</TriggerBase.ExitActions>
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundHoverStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<Trigger
							Property="igDP:DataRecordCellArea.IsAlternate"
							Value="True">
							<Setter
								TargetName="Alternate"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="CellContent"
								Property="Style"
								Value="{Binding Path=ForegroundAlternateStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:DataRecordCellArea.IsFilterRecord"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								Property="igDP:DataRecordCellArea.BackgroundActive"
								Value="#FFFFFFFF" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDP:DataRecordCellArea.IsAddRecord"
									Value="True" />
								<Condition
									Property="igDP:DataRecordCellArea.IsActive"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								Property="igDP:DataRecordCellArea.BackgroundActive"
								Value="#FFFFFFFF" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igDP:GroupByRecordPresenter}"
		x:Key="{x:Type igDP:GroupByRecordPresenter}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey ResourceId=LabelForeground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Margin"
			Value="0,0,0,2" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:GroupByRecordPresenter}">
					<FrameworkTemplate.Resources>
						<ResourceDictionary>
							<Storyboard
								x:Key="sbDisplayNested">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="ncpVisual"
									Storyboard.TargetProperty="Opacity"
									FillBehavior="HoldEnd">
									<DiscreteDoubleKeyFrame
										Value="0"
										KeyTime="00:00:00" />
									<DiscreteDoubleKeyFrame
										Value="0"
										KeyTime="00:00:00.25" />
									<SplineDoubleKeyFrame
										KeySpline="0.5,0.5,0.5,0.5"
										Value="1"
										KeyTime="00:00:0.75" />
								</DoubleAnimationUsingKeyFrames>
								<ObjectAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="ncpVisual"
									Storyboard.TargetProperty="(UIElement.Visibility)">
									<DiscreteObjectKeyFrame
										Value="{x:Static Visibility.Visible}"
										KeyTime="00:00:00" />
									<DiscreteObjectKeyFrame
										Value="{x:Static Visibility.Collapsed}"
										KeyTime="00:00:0.75" />
								</ObjectAnimationUsingKeyFrames>
								<ObjectAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="ncpMask"
									Storyboard.TargetProperty="(UIElement.Visibility)">
									<DiscreteObjectKeyFrame
										Value="{x:Static Visibility.Visible}"
										KeyTime="00:00:00" />
									<DiscreteObjectKeyFrame
										Value="{x:Static Visibility.Collapsed}"
										KeyTime="00:00:0.75" />
								</ObjectAnimationUsingKeyFrames>
							</Storyboard>
							<Storyboard
								x:Key="sbHideNested">
								<DoubleAnimationUsingKeyFrames
									BeginTime="00:00:00"
									Storyboard.TargetName="NestedContentPresenter"
									Storyboard.TargetProperty="Opacity"
									FillBehavior="HoldEnd">
									<SplineDoubleKeyFrame
										KeySpline="0.5,0.5,0.5,0.5"
										Value="1"
										KeyTime="00:00:00.15" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</ResourceDictionary>
					</FrameworkTemplate.Resources>
					<Grid
						Background="{TemplateBinding Background}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<igWindows:ExpansionIndicator
							Name="ExpansionIndicator"
							RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
							Panel.ZIndex="1"
							Grid.Row="1"
							Visibility="{TemplateBinding igDP:ExpansionIndicatorVisibility}"
							Command="{x:Static igDP:DataPresenterCommands.ToggleRecordIsExpanded}"
							CommandParameter="{TemplateBinding igDP:Record}"
							ToggleMode="Manual"
							IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
						<ContentPresenter
							Name="PART_HeaderContentSite"
							Grid.Row="0"
							Grid.Column="1"
							Content="{TemplateBinding igDP:HeaderContent}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Visibility="{Binding Path=HasHeaderContent, Converter={StaticResource BoolToVisConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
						<Grid
							Name="PART_RecordContentSite"
							RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
							Margin="0"
							Row="1"
							Column="1"
							Visibility="Collapsed">
							<Border
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								Width="Auto"
								Height="Auto"
								RenderTransformOrigin="0.5,0.5"
								CornerRadius="2,2,2,2"
								SnapsToDevicePixels="True"
								Background="{DynamicResource igDP:DataPresenterBrushKeys.LabelBackgroundKey}"
								BorderBrush="{DynamicResource igDP:DataPresenterBrushKeys.LabelOuterBorderKey}"
								BorderThickness="1,1,1,1" />
							<StackPanel
								Orientation="Vertical"
								Margin="3,3,3,3">
								<ContentControl
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									Style="{StaticResource LabelContentStyle}"
									Content="{Binding Path=Description, RelativeSource={RelativeSource TemplatedParent}}" />
								<igDP:GroupBySummariesPresenter
									Name="GroupBySummariesPresenter"
									RenderTransform="{TemplateBinding ScrollableElementTransform}"
									HorizontalAlignment="Left"
									Visibility="Collapsed"
									GroupByRecord="{TemplateBinding Record}" />
							</StackPanel>
						</Grid>
						<Grid
							Name="PART_NestedContentSite"
							Row="2"
							Column="1"
							Visibility="Collapsed">
							<Border
								RenderTransform="{TemplateBinding igDP:FixedNearElementTransform}"
								CornerRadius="0,0,3,3"
								BorderBrush="#44102975"
								BorderThickness="1">
								<Border.Background>
									<LinearGradientBrush
										StartPoint="0,0"
										EndPoint="0,1">
										<GradientStop
											Color="#FFFFFFFF"
											Offset="0.25" />
										<GradientStop
											Color="#FFEEEEEE"
											Offset="1.2" />
									</LinearGradientBrush>
								</Border.Background>
								<ContentControl
									Name="NestedContentPresenter"
									RenderTransform="{TemplateBinding igDP:ScrollableElementTransform}"
									Margin="0,0,0,5"
									Content="{Binding Path=NestedContent, RelativeSource={RelativeSource TemplatedParent}}" />
							</Border>
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="True"
									Binding="{Binding Path=FieldLayout.AutoFitToWidth, RelativeSource={RelativeSource Self}}" />
								<Condition
									Value="Vertical"
									Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_HeaderContentSite"
								Property="ColumnSpan"
								Value="2" />
							<Setter
								TargetName="PART_RecordContentSite"
								Property="ColumnSpan"
								Value="2" />
							<Setter
								TargetName="GroupBySummariesPresenter"
								Property="HorizontalAlignment"
								Value="Stretch" />
							<Setter
								TargetName="PART_HeaderContentSite"
								Property="HorizontalAlignment"
								Value="Stretch" />
						</MultiDataTrigger>
						<Trigger
							Property="igDP:RecordPresenter.ShouldDisplayGroupByRecordContent"
							Value="True">
							<Setter
								TargetName="PART_RecordContentSite"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:RecordPresenter.ShouldDisplayGroupByRecordContent"
							Value="False">
							<Setter
								TargetName="ExpansionIndicator"
								Property="Visibility"
								Value="Hidden" />
						</Trigger>
						<Trigger
							Property="igDP:GroupByRecordPresenter.ShouldDisplaySummaryCells"
							Value="True">
							<Setter
								TargetName="GroupBySummariesPresenter"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
