<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006" xmlns:igWindows="http://infragistics.com/Windows" xmlns:editors="http://infragistics.com/Editors" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter" xmlns:igThemes="http://infragistics.com/Themes">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="DataPresenterGeneric.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		TargetType="{x:Type igDP:FixedFieldButton}"
		x:Key="{x:Type igDP:FixedFieldButton}">
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type ToggleButton}"
					x:Key="{x:Type ToggleButton}">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type ToggleButton}">
								<igWindows:CardPanel
									Background="{TemplateBinding Background}">
									<ContentPresenter />
								</igWindows:CardPanel>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<Style
					TargetType="{x:Type Menu}"
					x:Key="{x:Type Menu}">
					<Setter
						Property="Background"
						Value="#00FFFFFF" />
					<Setter
						Property="BorderThickness"
						Value="0" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Menu}">
								<Grid
									IsSharedSizeScope="True">
									<StackPanel
										IsItemsHost="True"
										ClipToBounds="True" />
								</Grid>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
				<Style
					TargetType="{x:Type MenuItem}"
					x:Key="{x:Type MenuItem}">
					<Setter
						Property="Background"
						Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuHighlightBackgroundBrushFillKey}" />
					<Setter
						Property="BorderBrush"
						Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuHighlightOuterBorderBrushFillKey}" />
					<Setter
						Property="BorderThickness"
						Value="1" />
					<Setter
						Property="Padding"
						Value="3,2,3,2" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type MenuItem}">
								<FrameworkTemplate.Resources>
									<ResourceDictionary>
										<Storyboard
											x:Key="Hover">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="Hover"
												Storyboard.TargetProperty="(UIElement.Opacity)">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.2000000"
													Value="1" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
										<Storyboard
											x:Key="HoverOff">
											<DoubleAnimationUsingKeyFrames
												BeginTime="00:00:00"
												Storyboard.TargetName="Hover"
												Storyboard.TargetProperty="(UIElement.Opacity)">
												<SplineDoubleKeyFrame
													KeyTime="00:00:00.3000000"
													Value="0" />
											</DoubleAnimationUsingKeyFrames>
										</Storyboard>
									</ResourceDictionary>
								</FrameworkTemplate.Resources>
								<Grid
									Background="#00FFFFFF">
									<Border
										Name="Hover"
										Opacity="0"
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="3" />
									<Grid
										Margin="{TemplateBinding Padding}">
										<ContentPresenter
											Name="Content"
											Margin="{TemplateBinding Padding}"
											Content="{TemplateBinding Header}"
											ContentSource="Header"
											RecognizesAccessKey="True" />
										<Popup
											Name="PART_Popup"
											AllowsTransparency="True"
											HorizontalOffset="-2"
											Placement="Bottom"
											PopupAnimation="{DynamicResource SystemParameters.ComboBoxPopupAnimationKey}"
											Focusable="False"
											IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
											<Border
												Name="SubMenuBorder"
												BorderThickness="1"
												Background="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonPopupBackground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}"
												BorderBrush="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonPopupBorder, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}">
												<ScrollViewer
													CanContentScroll="True"
													Margin="1"
													Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
													<ItemsPresenter
														Grid.IsSharedSizeScope="True"
														KeyboardNavigation.DirectionalNavigation="Cycle"
														KeyboardNavigation.TabNavigation="Cycle" />
												</ScrollViewer>
											</Border>
										</Popup>
									</Grid>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger
										Property="MenuItem.IsSuspendingPopupAnimation"
										Value="True">
										<Setter
											TargetName="PART_Popup"
											Property="PopupAnimation"
											Value="None" />
									</Trigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition
												Property="MenuItem.Role"
												Value="SubmenuItem" />
											<Condition
												Property="MenuItem.IsHighlighted"
												Value="True" />
										</MultiTrigger.Conditions>
										<TriggerBase.EnterActions>
											<BeginStoryboard
												Name="Hover_BeginStoryboard"
												Storyboard="{StaticResource Hover}" />
										</TriggerBase.EnterActions>
										<TriggerBase.ExitActions>
											<BeginStoryboard
												Name="HoverOff_BeginStoryboard"
												Storyboard="{StaticResource HoverOff}" />
										</TriggerBase.ExitActions>
										<Setter
											TargetName="Content"
											Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuHighlightTextBrushFillKey}"
											Property="Foreground" />
									</MultiTrigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											Value="{DynamicResource SystemColors.GrayTextBrushKey}"
											Property="Foreground" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ResourceDictionary>
		</Style.Resources>
		<Setter
			Property="igDP:FixedFieldButton.FixToFarEdgePrompt"
			Value="{Binding Path=Value, Source={x:Static igDP:ResourcesDataPresenter.FieldFixToFarEdgePrompt}}" />
		<Setter
			Property="igDP:FixedFieldButton.FixToNearEdgePrompt"
			Value="{Binding Path=Value, Source={x:Static igDP:ResourcesDataPresenter.FieldFixToNearEdgePrompt}}" />
		<Setter
			Property="igDP:FixedFieldButton.UnfixPrompt"
			Value="{Binding Path=Value, Source={x:Static igDP:ResourcesDataPresenter.FieldUnfixPrompt}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonForeground, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:FixedFieldButton}">
					<Border
						Background="#00FFFFFF">
						<igWindows:CardPanel>
							<ToggleButton
								Name="toggleButton"
								Focusable="False"
								Command="{TemplateBinding igDP:CurrentCommand}"
								CommandParameter="{TemplateBinding igDP:Field}"
								Background="#00FFFFFF">
								<Grid
									Width="12"
									Height="12">
									<Path
										Name="btnFixedGlyph"
										Visibility="Collapsed"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Height="10"
										Width="7"
										Stretch="Fill"
										Opacity="1"
										Data="M6,4 C6,4 8,4 8,4 C8,4 8,9 8,9 C8,9 6,9 6,9 C6,9 6,4 6,4 M5,3 C5,3 5,9 5,9 C5,9 4,9 4,9 C4,9 4,10 4,10 C4,10 7,10 7,10 C7,10 7,13 7,13 C7,13 8,13 8,13 C8,13 8,10 8,10 C8,10 11,10 11,10 C11,10 11,9 11,9 C11,9 10,9 10,9 C10,9 10,3 10,3 C10,3 5,3 5,3"
										Fill="{TemplateBinding Foreground}" />
									<Path
										Name="btnUnfixedGlyph"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Height="7"
										Width="10"
										Stretch="Fill"
										Opacity="1"
										Data="M12,7 C12,7 12,9 12,9 C12,9 7,9 7,9 C7,9 7,7 7,7 C7,7 12,7 12,7 M13,6 C13,6 7,6 7,6 C7,6 7,5 7,5 C7,5 6,5 6,5 C6,5 6,8 6,8 C6,8 3,8 3,8 C3,8 3,9 3,9 C3,9 6,9 6,9 C6,9 6,12 6,12 C6,12 7,12 7,12 C7,12 7,11 7,11 C7,11 13,11 13,11 C13,11 13,6 13,6"
										Fill="{TemplateBinding Foreground}" />
								</Grid>
							</ToggleButton>
							<Menu
								Name="menu"
								Visibility="Collapsed"
								IsMainMenu="False">
								<MenuItem
									Padding="0">
									<HeaderedItemsControl.Header>
										<igWindows:CardPanel>
											<Grid
												Width="12"
												Height="12">
												<Path
													Name="menuFixedGlyph"
													Visibility="Collapsed"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Height="10"
													Width="7"
													Stretch="Fill"
													Opacity="1"
													Data="M6,4 C6,4 8,4 8,4 C8,4 8,9 8,9 C8,9 6,9 6,9 C6,9 6,4 6,4 M5,3 C5,3 5,9 5,9 C5,9 4,9 4,9 C4,9 4,10 4,10 C4,10 7,10 7,10 C7,10 7,13 7,13 C7,13 8,13 8,13 C8,13 8,10 8,10 C8,10 11,10 11,10 C11,10 11,9 11,9 C11,9 10,9 10,9 C10,9 10,3 10,3 C10,3 5,3 5,3"
													Fill="{TemplateBinding Foreground}" />
												<Path
													Name="MenuUnfixedGlyph"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Height="7"
													Width="10"
													Stretch="Fill"
													Opacity="1"
													Data="M12,7 C12,7 12,9 12,9 C12,9 7,9 7,9 C7,9 7,7 7,7 C7,7 12,7 12,7 M13,6 C13,6 7,6 7,6 C7,6 7,5 7,5 C7,5 6,5 6,5 C6,5 6,8 6,8 C6,8 3,8 3,8 C3,8 3,9 3,9 C3,9 6,9 6,9 C6,9 6,12 6,12 C6,12 7,12 7,12 C7,12 7,11 7,11 C7,11 13,11 13,11 C13,11 13,6 13,6"
													Fill="{TemplateBinding Foreground}" />
											</Grid>
										</igWindows:CardPanel>
									</HeaderedItemsControl.Header>
									<MenuItem
										Name="unfix"
										Header="{TemplateBinding igDP:UnfixPrompt}"
										Command="{TemplateBinding igDP:UnfixCommand}"
										CommandParameter="{TemplateBinding igDP:Field}" />
									<MenuItem
										Name="fixNear"
										Header="{TemplateBinding igDP:FixToNearEdgePrompt}"
										Command="{TemplateBinding igDP:FixToNearEdgeCommand}"
										CommandParameter="{TemplateBinding igDP:Field}" />
									<MenuItem
										Name="fixFar"
										Header="{TemplateBinding igDP:FixToFarEdgePrompt}"
										Command="{TemplateBinding igDP:FixToFarEdgeCommand}"
										CommandParameter="{TemplateBinding igDP:Field}" />
								</MenuItem>
							</Menu>
						</igWindows:CardPanel>
					</Border>
					<ControlTemplate.Triggers>
						<DataTrigger
							Value="FixedToNearEdge"
							Binding="{Binding Path=Field.FixedLocation, RelativeSource={RelativeSource TemplatedParent}}">
							<Setter
								TargetName="menuFixedGlyph"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="MenuUnfixedGlyph"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="btnFixedGlyph"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="btnUnfixedGlyph"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
						<DataTrigger
							Value="FixedToFarEdge"
							Binding="{Binding Path=Field.FixedLocation, RelativeSource={RelativeSource TemplatedParent}}">
							<Setter
								TargetName="menuFixedGlyph"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="MenuUnfixedGlyph"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="btnFixedGlyph"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="btnUnfixedGlyph"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
						<DataTrigger
							Value="NearOrFar"
							Binding="{Binding Path=Field.AllowFixingResolved, RelativeSource={RelativeSource TemplatedParent}}">
							<Setter
								TargetName="menu"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="toggleButton"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="NearOrFar"
									Binding="{Binding Path=Field.AllowFixingResolved, RelativeSource={RelativeSource TemplatedParent}}" />
								<Condition
									Value="Scrollable"
									Binding="{Binding Path=Field.FixedLocation, RelativeSource={RelativeSource TemplatedParent}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="unfix"
								Property="Visibility"
								Value="Collapsed" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="NearOrFar"
									Binding="{Binding Path=Field.AllowFixingResolved, RelativeSource={RelativeSource TemplatedParent}}" />
								<Condition
									Value="FixedToNearEdge"
									Binding="{Binding Path=Field.FixedLocation, RelativeSource={RelativeSource TemplatedParent}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="fixNear"
								Property="Visibility"
								Value="Collapsed" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="NearOrFar"
									Binding="{Binding Path=Field.AllowFixingResolved, RelativeSource={RelativeSource TemplatedParent}}" />
								<Condition
									Value="FixedToFarEdge"
									Binding="{Binding Path=Field.FixedLocation, RelativeSource={RelativeSource TemplatedParent}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="fixFar"
								Property="Visibility"
								Value="Collapsed" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		BasedOn="{x:Static igThemes:DataPresenterGeneric.CardHeaderPresenter}"
		TargetType="{x:Type igDP:CardHeaderPresenter}"
		x:Key="{x:Type igDP:CardHeaderPresenter}">
		<Setter
			Property="BorderThickness"
			Value="0" />
	</Style>
	<Style
		TargetType="{x:Type igDP:CardViewCard}"
		x:Key="{x:Type igDP:CardViewCard}">
		<Setter
			Property="Visibility"
			Value="{Binding Path=VisibilityResolved}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:CardViewCard}">
					<Border
						Name="Bd"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						Padding="{TemplateBinding Padding}"
						CornerRadius="3,3,1,1">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<Border
								Name="HeaderBgWhenVisHidden"
								Visibility="Collapsed"
								CornerRadius="2,2,0,0"
								Background="{Binding ElementName=CardHeaderPresenter, Path=Background}" />
							<igDP:CardHeaderPresenter
								Name="CardHeaderPresenter"
								Content="{Binding Path=Header, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								ContentTemplate="{Binding Path=HeaderTemplate, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								ContentTemplateSelector="{Binding Path=HeaderTemplateSelector, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								Visibility="{Binding Path=HeaderVisibility, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								Card="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
							<Rectangle
								Name="outerBd"
								Fill="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardChromeBorderBrushKey}"
								Grid.Row="1" />
							<Border
								Name="activeBd"
								BorderBrush="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderBorderNormalBrushKey}"
								BorderThickness="1"
								Grid.RowSpan="2"
								Visibility="Collapsed"
								CornerRadius="2,2,0,0" />
							<Border
								Name="highlightStroke"
								BorderBrush="#7FFFFFFF"
								BorderThickness="1"
								CornerRadius="2,2,0,0"
								Grid.RowSpan="2"
								Visibility="Collapsed" />
							<Border
								Name="innerBd"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1"
								Grid.Row="1"
								Margin="5,0,5,5">
								<ScrollViewer
									Name="CardContentScrollViewer"
									Focusable="False"
									CanContentScroll="False"
									HorizontalScrollBarVisibility="Auto"
									VerticalScrollBarVisibility="Auto">
									<ContentControl
										Name="CardContent"
										Content="{TemplateBinding Content}"
										ContentTemplate="{TemplateBinding ContentTemplate}" />
								</ScrollViewer>
							</Border>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:CardViewCard.IsCollapsed"
							Value="True">
							<Setter
								TargetName="innerBd"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Bd"
								Property="VerticalAlignment"
								Value="Top" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.HeaderVisibility"
							Value="Collapsed">
							<Setter
								TargetName="innerBd"
								Property="Margin"
								Value="5" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.HeaderVisibility"
							Value="Hidden">
							<Setter
								TargetName="HeaderBgWhenVisHidden"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsSelected"
							Value="True" />
						<Trigger
							Property="igDP:CardViewCard.IsActive"
							Value="True">
							<Setter
								TargetName="activeBd"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsAddRecord"
							Value="True">
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderAddRowHeaderBrushKey}"
								Property="Background" />
							<Setter
								TargetName="outerBd"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderAddRowCardChromeBrushKey}"
								Property="Fill" />
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderAddRowHeaderTextBrushKey}"
								Property="Foreground" />
							<Setter
								TargetName="highlightStroke"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsFilterRecord"
							Value="True">
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderFilterRecordHeaderBrushKey}"
								Property="Background" />
							<Setter
								TargetName="outerBd"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderFilterRecordCardChromeBrushKey}"
								Property="Fill" />
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderAddRowHeaderTextBrushKey}"
								Property="Foreground" />
							<Setter
								TargetName="highlightStroke"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsOpacityReduced"
							Value="True">
							<Setter
								TargetName="Bd"
								Property="UIElement.Opacity"
								Value="0.35" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
