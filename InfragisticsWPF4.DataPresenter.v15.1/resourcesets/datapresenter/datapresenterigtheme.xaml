			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:CardViewCard}">
					<Border
						Name="Bd"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						Padding="{TemplateBinding Padding}"
						CornerRadius="2">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<Border
								Name="HeaderBgWhenVisHidden"
								Visibility="Collapsed"
								CornerRadius="2,2,0,0"
								Background="{Binding ElementName=CardHeaderPresenter, Path=Background}" />
							<igDP:CardHeaderPresenter
								Name="CardHeaderPresenter"
								Content="{Binding Path=Header, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								ContentTemplate="{Binding Path=HeaderTemplate, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								ContentTemplateSelector="{Binding Path=HeaderTemplateSelector, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								Visibility="{Binding Path=HeaderVisibility, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
								Card="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
							<Rectangle
								Name="captionStroke"
								Fill="{TemplateBinding BorderBrush}"
								Height="1"
								Grid.Row="1" />
							<Rectangle
								Name="outerBd"
								Fill="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardChromeBorderBrushKey}"
								Grid.Row="2" />
							<Border
								Name="innerBd"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1,0,1,1"
								Grid.Row="2"
								Margin="1,0,1,1">
								<ScrollViewer
									Name="CardContentScrollViewer"
									Focusable="False"
									CanContentScroll="False"
									HorizontalScrollBarVisibility="Auto"
									VerticalScrollBarVisibility="Auto">
									<ContentControl
										Name="CardContent"
										Content="{TemplateBinding Content}"
										ContentTemplate="{TemplateBinding ContentTemplate}" />
								</ScrollViewer>
							</Border>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igDP:CardViewCard.IsCollapsed"
							Value="True">
							<Setter
								TargetName="innerBd"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Bd"
								Property="VerticalAlignment"
								Value="Top" />
							<Setter
								TargetName="captionStroke"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.HeaderVisibility"
							Value="Collapsed">
							<Setter
								TargetName="captionStroke"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="innerBd"
								Property="Margin"
								Value="1" />
							<Setter
								TargetName="innerBd"
								Property="BorderThickness"
								Value="1" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.HeaderVisibility"
							Value="Hidden">
							<Setter
								TargetName="HeaderBgWhenVisHidden"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsSelected"
							Value="True" />
						<Trigger
							Property="igDP:CardViewCard.IsActive"
							Value="True" />
						<Trigger
							Property="igDP:CardViewCard.IsFilterRecord"
							Value="True">
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderFilterRecordHeaderBrushKey}"
								Property="Background" />
							<Setter
								TargetName="outerBd"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderFilterRecordCardChromeBrushKey}"
								Property="Fill" />
							<Setter
								TargetName="CardHeaderPresenter"
								Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardHeaderAddRowHeaderTextBrushKey}"
								Property="Foreground" />
						</Trigger>
						<Trigger
							Property="igDP:CardViewCard.IsOpacityReduced"
							Value="True">
							<Setter
								TargetName="Bd"
								Property="UIElement.Opacity"
								Value="0.35" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
