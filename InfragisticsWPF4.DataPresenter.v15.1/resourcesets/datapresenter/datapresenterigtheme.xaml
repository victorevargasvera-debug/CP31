	<Style
		TargetType="{x:Type igDP:CardViewCard}"
		x:Key="{x:Type igDP:CardViewCard}">
		<Setter
			Property="Background"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.ViewCardBackgroundBrushKey}" />
