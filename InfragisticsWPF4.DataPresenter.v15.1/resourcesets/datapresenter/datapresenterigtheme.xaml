								</igWindows:CardPanel>
							</igWindows:CardPanel>
							<igWindows:AutoDisabledImage
								Name="Icon"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								Source="{Binding ImageSource}" />
						</igWindows:CardPanel>
					</Border>
				</Border>
				<ContentPresenter
					Name="Header"
					ContentSource="Header"
					HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
					VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
					RecognizesAccessKey="True"
					Margin="7,0,0,0"
					Grid.Column="2" />
				<Rectangle
					Name="Separator"
					SnapsToDevicePixels="True"
					Visibility="Collapsed"
					Fill="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemSeparatorBrushKey}"
					Height="1"
					Grid.Column="2"
					Grid.ColumnSpan="2" />
				<Grid
					Name="Menu_Arrow"
					Margin="7,0,5,0"
					Column="3"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Visibility="Collapsed">
					<Path
						Name="Glyph_Arrow"
						Fill="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemDropDownArrowBrushKey}"
						SnapsToDevicePixels="True"
						Stretch="None"
						Data="M0,0 L0,7 L4,3.5"
						HorizontalAlignment="Center"
						Margin="0,0,0,0"
						VerticalAlignment="Center" />
				</Grid>
			</Grid>
			<Popup
				Name="PART_Popup"
				AllowsTransparency="True"
				Placement="Right"
				Focusable="False"
				IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
				<AdornerDecorator>
					<Border
						CornerRadius="1"
						BorderThickness="1"
						BorderBrush="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemPopupOuterBorderBrushKey}"
						Background="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemPopupFillBrushKey}">
						<igWindows:PopupResizerDecorator
							Name="resizeDecorator"
							Grid.IsSharedSizeScope="True">
							<igWindows:XamPager
								CanContentScroll="True"
								VerticalScrollBarVisibility="Auto"
								HorizontalScrollBarVisibility="Disabled">
								<ItemsPresenter
									Grid.ColumnSpan="2"
									KeyboardNavigation.TabNavigation="Cycle"
									KeyboardNavigation.DirectionalNavigation="Cycle"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
							</igWindows:XamPager>
						</igWindows:PopupResizerDecorator>
					</Border>
				</AdornerDecorator>
			</Popup>
		</igWindows:CardPanel>
		<ControlTemplate.Triggers>
			<Trigger
				Property="MenuItem.IsChecked"
				Value="True">
				<Setter
					TargetName="OrangeCheckBox"
					Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemIsCheckedFillBrushKey}"
					Property="Background" />
				<Setter
					TargetName="OrangeCheckBox"
					Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemIsCheckedBorderBrushKey}"
					Property="BorderBrush" />
			</Trigger>
			<DataTrigger
				Value="True"
				Binding="{Binding HasResizableItems}">
				<Setter
					TargetName="resizeDecorator"
					Property="igWindows:PopupResizerDecorator.ResizeMode"
					Value="Both" />
			</DataTrigger>
			<DataTrigger
				Value="True"
				Binding="{Binding IsResizable}">
				<Setter
					TargetName="IconArea"
					Property="VerticalAlignment"
					Value="Top" />
			</DataTrigger>
			<Trigger
				Property="MenuItem.IsSubmenuOpen"
				Value="False">
				<Setter
					TargetName="PART_Popup"
					Value="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
					Property="PopupAnimation" />
			</Trigger>
			<Trigger
				Property="MenuItem.Role"
				Value="SubmenuHeader">
				<Setter
					TargetName="Menu_Arrow"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
			<DataTrigger
				Value="True"
				Binding="{Binding Path=IsSeparator}">
				<Setter
					TargetName="IconArea"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="Header"
					Property="Column"
					Value="2" />
				<Setter
					TargetName="Menu_Arrow"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="Separator"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="Separator"
					Property="Margin"
					Value="3,0,0,0" />
			</DataTrigger>
			<Trigger
				Property="HasHeader"
				Value="False">
				<Setter
					TargetName="Separator"
					Property="Margin"
					Value="7,0,0,0" />
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="False"
						Binding="{Binding IsControlHost}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="IconAreaBackground"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="Highlight"
					Property="Visibility"
					Value="Visible" />
				<Setter
					Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemIconAreaBrushKey}"
					Property="Foreground" />
				<Setter
					TargetName="Glyph_Arrow"
					Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemHotTrackDropDownArrowBrushKey}"
					Property="Fill" />
			</MultiDataTrigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Value="{DynamicResource SystemColors.GrayTextBrushKey}"
					Property="Foreground" />
				<Setter
					TargetName="Glyph_Arrow"
					Value="{DynamicResource SystemColors.GrayTextBrushKey}"
					Property="Fill" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						SourceName="Icon"
						Property="Source"
						Value="{x:Null}" />
					<Condition
						Property="MenuItem.IsChecked"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					TargetName="GlyphPanel"
					Property="Visibility"
					Value="Visible" />
			</MultiTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type igDP:FieldMenuItem}"
		x:Key="{x:Type igDP:FieldMenuItem}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource igDP:DataPresenterBrushKeys.MenuItemForegroundBrushKey}" />
		<Setter
			Property="MenuItem.CommandParameter"
			Value="{Binding CommandParameter}" />
		<Setter
			Property="MenuItem.Command"
			Value="{Binding Command}" />
		<Setter
			Property="MenuItem.IsChecked"
			Value="{Binding IsChecked}" />
		<Setter
			Property="MenuItem.IsCheckable"
			Value="{Binding IsCheckable}" />
		<Setter
			Property="Header"
			Value="{Binding Header}" />
		<Setter
			Property="MenuItem.Icon"
			Value="{Binding ImageSource}" />
		<Setter
			Property="ItemsSource"
			Value="{Binding Items}" />
		<Setter
			Property="MenuItem.StaysOpenOnClick"
			Value="{Binding StaysOpenOnClick}" />
		<Setter
			Property="igWindows:PopupResizerStackPanel.IsResizable"
			Value="{Binding IsResizable}" />
		<Setter
			Property="BorderThickness"
			Value="0" />
		<Setter
			Property="Padding"
			Value="0" />
		<Setter
			Property="Margin"
			Value="0" />
		<Setter
			Property="Template"
			Value="{StaticResource subMenuItemTemplate}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<igWindows:PopupResizerStackPanel />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="MenuItem.Role"
				Value="TopLevelHeader">
				<Setter
					Property="Template"
					Value="{StaticResource topLevelMenuItemTemplate}" />
			</Trigger>
			<Trigger
				Property="MenuItem.Role"
				Value="TopLevelItem">
				<Setter
					Property="Template"
					Value="{StaticResource topLevelMenuItemTemplate}" />
			</Trigger>
			<DataTrigger
				Value="True"
				Binding="{Binding IsSeparator}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="True"
				Binding="{Binding IsResizable}">
				<Setter
					Property="VerticalContentAlignment"
					Value="Stretch" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<ControlTemplate
		TargetType="{x:Type igDP:FilterButton}"
		x:Key="excelFilterButtonTemplate">
		<FrameworkTemplate.Resources>
			<ResourceDictionary />
		</FrameworkTemplate.Resources>
		<Border
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			SnapsToDevicePixels="True"
			Padding="{TemplateBinding Padding}">
			<Menu
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
				VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
				Style="{StaticResource RootMenuStyle}">
				<igDP:FieldMenuItem
					Name="PART_FilterMenu"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					IsSubmenuOpen="{Binding Path=IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
					<FrameworkElement.DataContext>
						<igDP:FieldMenuDataItem />
					</FrameworkElement.DataContext>
					<HeaderedItemsControl.Header>
						<igWindows:AutoDisabledImage
							Name="BtnImage"
							Stretch="None"
							Utilities.SnapElementToDevicePixels="True"
							VerticalAlignment="Center"
							HorizontalAlignment="Center">
							<Image.Source>
								<BitmapImage
									UriSource="..\..\Images\Filter.png" />
							</Image.Source>
						</igWindows:AutoDisabledImage>
					</HeaderedItemsControl.Header>
				</igDP:FieldMenuItem>
			</Menu>
		</Border>
	</ControlTemplate>
	<Style
		TargetType="{x:Type igDP:FilterButton}"
		x:Key="FilterButtonStyleBase">
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="Background"
			Value="{StaticResource Brush_1020}" />
		<Setter
			Property="Padding"
			Value="0" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Center" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:FilterButton}">
					<Border
						Name="Border"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						IsHitTestVisible="True">
						<igWindows:CardPanel
							IsHitTestVisible="False"
							Margin="{TemplateBinding Padding}">
							<igWindows:AutoDisabledImage
								Name="BtnImage"
								Stretch="None"
								Utilities.SnapElementToDevicePixels="True"
								VerticalAlignment="{TemplateBinding HorizontalContentAlignment}"
								HorizontalAlignment="{TemplateBinding VerticalContentAlignment}">
								<Image.Source>
									<BitmapImage
										UriSource="..\..\Images\Filter.png" />
								</Image.Source>
							</igWindows:AutoDisabledImage>
							<editors:XamComboEditor
								MinDropDownWidth="150"
								DropDownResizeMode="None"
								Opacity="0"
								MaxWidth="1"
								ItemsSource="{Binding Path=Operands, RelativeSource={RelativeSource TemplatedParent}}"
								SelectedItem="{Binding Path=SelectedOperand, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
								IsDropDownOpen="{Binding Path=IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
								Height="{Binding Path=ActualHeight, ElementName=BtnImage}" />
						</igWindows:CardPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igDP:FilterButton.DropDownType"
				Value="MultiSelectExcelStyle">
				<Setter
					Property="Template"
					Value="{StaticResource excelFilterButtonTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igDP:FilterButton}"
		BasedOn="{StaticResource FilterButtonStyleBase}"
		x:Key="{x:Type igDP:FilterButton}">
		<Setter
			Property="Padding"
			Value="3,0" />
		<Style.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId=SummaryButtonBackgroundHover, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
