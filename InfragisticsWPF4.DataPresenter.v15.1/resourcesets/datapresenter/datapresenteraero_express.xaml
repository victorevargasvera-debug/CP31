	<Style
		TargetType="{x:Type CheckBox}"
		x:Key="AeroCheckBox">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxNormalInnerBoxBorderFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxNormalOuterBoxBorderFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type CheckBox}">
					<BulletDecorator
						Background="#00FFFFFF">
						<BulletDecorator.Bullet>
							<StackPanel
								Width="Auto"
								Height="Auto"
								Orientation="Horizontal">
								<Grid
									Width="13"
									Height="13">
									<Border
										Name="OuterBox"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										Background="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxNormalOuterBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
									<Border
										Name="InnerBox"
										Margin="2,2,2,2"
										BorderThickness="1,1,1,1"
										BorderBrush="{TemplateBinding Background}"
										Background="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxNormalInnerBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
									<Grid
										Name="CheckMark"
										Visibility="Collapsed"
										Margin="0,0,0,0">
										<Path
											Name="Background"
											Height="9.661"
											Width="10.137"
											Stretch="Fill"
											Opacity="0.8"
											Data="M2.6673452,7.8617508 C2.6673452,7.8617508 5.817048,10.192734 5.817048,10.192734 C5.817048,10.192734 9.5967099,4.4942121 9.5967099,4.4942121"
											Stroke="#FFFFFFFF"
											StrokeThickness="3"
											SnapsToDevicePixels="True"
											HorizontalAlignment="Left"
											Margin="1.138,0.965,0,0"
											VerticalAlignment="Top" />
										<Path
											Name="Foreground"
											Height="8.915"
											Width="8.66"
											Stretch="Fill"
											Opacity="1"
											Data="M1.6839831,7.7438574 C1.6839831,7.7438574 5.8697866,10.85053 5.8697866,10.85053 C5.8697866,10.85053 10.540217,1.6301305 10.540217,1.6301305"
											Stroke="#FF4C6198"
											StrokeThickness="2"
											SnapsToDevicePixels="True"
											HorizontalAlignment="Left"
											Margin="1.855,1.465,0,0"
											VerticalAlignment="Top" />
									</Grid>
								</Grid>
								<ContentPresenter
									RecognizesAccessKey="True"
									Margin="4,0,0,0"
									Width="Auto"
									Height="Auto" />
							</StackPanel>
						</BulletDecorator.Bullet>
					</BulletDecorator>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="ToggleButton.IsThreeState"
									Value="True" />
								<Condition
									Property="ToggleButton.IsChecked"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="CheckMark"
								Property="Visibility"
								Value="Collapsed" />
						</MultiTrigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<Setter
								TargetName="CheckMark"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxHoverInnerBoxBorderFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<Setter
								TargetName="InnerBox"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxHoverInnerBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<Setter
								TargetName="OuterBox"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxHoverOuterBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="InnerBox"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxPressedInnerBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<Setter
								TargetName="InnerBox"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxPressedInnerBoxBorderFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<Setter
								TargetName="OuterBox"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=CheckBoxHoverOuterBoxCenterFill, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								TargetName="OuterBox"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId=DisabledBackgroundBrush, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
							<Setter
								TargetName="OuterBox"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId=DisabledBorderBrush, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="BorderThickness"
			Value="1,1,1,1" />
	</Style>
	<Style
		TargetType="{x:Type ContentControl}"
