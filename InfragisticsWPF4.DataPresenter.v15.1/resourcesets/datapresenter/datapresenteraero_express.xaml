	<Style
		TargetType="{x:Type igWindows:SortIndicator}"
		x:Key="{x:Type igWindows:SortIndicator}">
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="MinHeight"
			Value="3.5" />
		<Setter
			Property="MinWidth"
			Value="7" />
		<Setter
			Property="Visibility"
			Value="Visible" />
		<Setter
			Property="Background"
			Value="#FF0000" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igWindows:SortIndicator}">
					<Polygon
						Name="Arrow"
						Points="0,0 8,0 4,4"
						StrokeEndLineCap="Round"
						StrokeStartLineCap="Round"
						StrokeLineJoin="Round"
						VerticalAlignment="Center"
						HorizontalAlignment="Stretch"
						Width="Auto"
						Height="Auto">
						<Shape.Fill>
							<LinearGradientBrush
								StartPoint="0.2222222222222222,0.25"
								EndPoint="0.4444444444444444,0.75">
								<GradientBrush.GradientStops>
									<GradientStopCollection>
										<GradientStop
											Color="#FF3c596c"
											Offset="0" />
										<GradientStop
											Color="#FFc3e4f5"
											Offset="0.9944444298744202" />
									</GradientStopCollection>
								</GradientBrush.GradientStops>
							</LinearGradientBrush>
						</Shape.Fill>
					</Polygon>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igWindows:SortIndicator.SortStatus"
							Value="Descending">
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="igWindows:SortIndicator.SortStatus"
							Value="Ascending">
							<Setter
								TargetName="Arrow"
								Property="Polygon.Points"
								Value="0,4 8,4 4,0" />
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="HorizontalAlignment"
			Value="Center" />
		<Setter
			Property="VerticalAlignment"
			Value="Center" />
		<Setter
			Property="Margin"
			Value="0,1,0,0" />
	</Style>
	<Style
		BasedOn="{x:Static themes:DataPresenterGeneric.CellValuePresenter}"
		TargetType="{x:Type igDP:CellValuePresenter}"
		x:Key="{x:Type igDP:CellValuePresenter}">
		<Setter
			Property="BorderBrush"
			Value="#FFEDEDED" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundHover"
			Value="#00EDEDED" />
		<Setter
			Property="igDP:CellValuePresenter.BorderHoverBrush"
			Value="#FFEDEDED" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundActive">
			<Setter.Value>
				<LinearGradientBrush
					EndPoint="0,1"
					StartPoint="0,0">
					<GradientStop
						Color="#FF8BD2F5"
						Offset="0" />
					<GradientStop
						Color="#4CFFFFFF"
						Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderActiveBrush"
			Value="#FFEDEDED" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundSelected">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFF6FBFD" />
					<GradientStop
						Offset="0.99"
						Color="#FFD5EFFC" />
					<GradientStop
						Offset="0.99"
						Color="#FFD5EFFC" />
					<GradientStop
						Color="#FFffffff"
						Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderSelectedBrush"
			Value="#FF99DEFD" />
		<Setter
			Property="igDP:CellValuePresenter.BackgroundFieldSelected">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFF6FBFD" />
					<GradientStop
						Offset="0.99"
						Color="#FFD5EFFC" />
					<GradientStop
						Offset="0.99"
						Color="#FFD5EFFC" />
					<GradientStop
						Color="#FFffffff"
						Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.BorderFieldSelectedBrush"
			Value="#FF99DEFD" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundAlternateStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=BlackForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="igDP:CellValuePresenter.ForegroundPrimaryStyle">
			<Setter.Value>
				<Style>
					<Setter
						Property="Foreground"
						Value="#FF333333" />
					<Setter
						Property="FontWeight"
						Value="Bold" />
				</Style>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igDP:CellValuePresenter.ForegroundHoverStyle"
			Value="{DynamicResource {ComponentResourceKey ResourceId=BlackForegroundStyle, TypeInTargetAssembly={x:Type igDP:XamDataGrid}}}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,1,0" />
		<Setter
			Property="Margin"
			Value="0,0,0,0" />
		<Setter
			Property="Padding"
			Value="2,0,2,0" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igDP:CellValuePresenter}">
					<igWindows:CardPanel>
						<Border
							Name="MainBorder"
							CornerRadius="{TemplateBinding igDP:CornerRadius}"
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}" />
						<Rectangle
							Name="Active"
							Fill="{TemplateBinding igDP:BackgroundActive}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Width="Auto"
							Height="Auto"
							SnapsToDevicePixels="True"
							Opacity="1"
							Visibility="Collapsed"
							StrokeThickness="1"
							Stroke="{TemplateBinding igDP:BorderActiveBrush}" />
						<ContentPresenter
							Name="PART_EditorSite"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Margin="{TemplateBinding Padding}"
							Style="{TemplateBinding igDP:ForegroundStyle}" />
					</igWindows:CardPanel>
					<ControlTemplate.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="True"
									Binding="{Binding Path=IsAlternate, RelativeSource={RelativeSource Self}}" />
								<Condition
									Value="DataRecord"
									Binding="{Binding Path=Record.RecordType, RelativeSource={RelativeSource Self}}" />
								<Condition
									Value="False"
									Binding="{Binding Path=Record.IsAddRecord, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundAlternateStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiDataTrigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsMouseOverRecord"
							Value="True" />
						<Trigger
							Property="igDP:CellValuePresenter.IsRecordSelected"
							Value="True">
							<Setter
								Property="BorderThickness"
								Value="0,0,1,0" />
							<Setter
								Property="Margin"
								Value="0,0,0,0" />
							<Setter
								Property="Padding"
								Value="2,0,2,0" />
						</Trigger>
						<Trigger
							Property="igDP:DataItemPresenter.HighlightAsPrimary"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundPrimary, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderPrimaryBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundPrimaryStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsFieldSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundFieldSelected, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderFieldSelectedBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundFieldSelectedStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								Property="igDP:CellValuePresenter.CornerRadius"
								Value="4" />
							<Setter
								Property="BorderThickness"
								Value="1,1,1,1" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundSelected, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderSelectedBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundSelectedStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								Property="igDP:CellValuePresenter.CornerRadius"
								Value="4" />
							<Setter
								Property="BorderThickness"
								Value="1,1,1,1" />
						</Trigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsActive"
							Value="True">
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundActiveStyle, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter
								TargetName="Active"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="True" />
								<Condition
									Property="igDP:CellValuePresenter.IsSelected"
									Value="False" />
								<Condition
									Property="igDP:CellValuePresenter.IsFieldSelected"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								Property="Background"
								Value="{Binding Path=BackgroundHover, RelativeSource={RelativeSource Self}}" />
							<Setter
								Property="BorderBrush"
								Value="{Binding Path=BorderHoverBrush, RelativeSource={RelativeSource Self}}" />
							<Setter
								TargetName="PART_EditorSite"
								Property="Style"
								Value="{Binding Path=ForegroundHoverStyle, RelativeSource={RelativeSource TemplatedParent}}" />
						</MultiTrigger>
						<DataTrigger
							Value="True"
							Binding="{Binding Path=Field.IsFixedStateChanging, RelativeSource={RelativeSource Self}}">
							<Setter
								Property="Background"
								Value="#AA8DBAEB" />
							<Setter
								Property="BorderBrush"
								Value="#AA8DBAEB" />
						</DataTrigger>
						<Trigger
							Property="igDP:CellValuePresenter.IsDataErrorTemplateActive"
							Value="True">
							<Setter
								TargetName="PART_EditorSite"
								Value="{DynamicResource igDP:DataPresenterBase.DataErrorContentTemplateKey}"
								Property="ContentTemplate" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
