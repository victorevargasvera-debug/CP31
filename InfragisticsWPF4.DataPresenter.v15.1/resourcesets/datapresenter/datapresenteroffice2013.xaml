			</Setter.Value>
		</Setter>
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type ScrollViewer}"
					BasedOn="{StaticResource ScrollViewerStyle}"
					x:Key="{x:Type ScrollViewer}" />
