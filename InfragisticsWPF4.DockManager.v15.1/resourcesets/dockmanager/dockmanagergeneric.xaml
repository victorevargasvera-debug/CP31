	<ToolTip
		Style="{DynamicResource igDock:XamDockManager.ToolTipStyleKey}"
		Content="{x:Static igWindows:ResourcesWindows.RestoreUpButtonToolTip}"
		x:Key="restoreUpToolTip" />
	<ToolTip
		Style="{DynamicResource igDock:XamDockManager.ToolTipStyleKey}"
		Content="{x:Static igWindows:ResourcesWindows.RestoreDownButtonToolTip}"
		x:Key="restoreDownToolTip" />
	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{x:Null}"
		x:Key="ScrollLeftButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="XamPagerButton"
						Margin="1,1,1,1"
						Width="Auto"
						Height="Auto"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch">
						<Border
							Name="Background"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveOuterBorderFillKey}"
							BorderThickness="1,1,1,1"
							CornerRadius="2,0,0,2"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveBottomCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Border
							Name="Highlight"
							CornerRadius="2,0,0,2"
							BorderThickness="1"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveInnerBorderFillKey}"
							Margin="1"
							SnapsToDevicePixels="True" />
						<ContentPresenter
							Margin="2"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True"
							RenderTransformOrigin="0.5,0.5" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackBottomCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True" />
						<Trigger
							Property="IsEnabled"
							Value="False" />
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{x:Null}"
		x:Key="ScrollRightButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="XamPagerButton"
						Margin="1,1,1,1"
						Width="Auto"
						Height="Auto"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch">
						<Border
							Name="Background"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveOuterBorderFillKey}"
							BorderThickness="1,1,1,1"
							CornerRadius="0,2,2,0"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveBottomCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Border
							Name="Highlight"
							CornerRadius="0,2,2,0"
							BorderThickness="1"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveInnerBorderFillKey}"
							Margin="1"
							SnapsToDevicePixels="True" />
						<ContentPresenter
							Margin="2"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True"
							RenderTransformOrigin="0.5,0.5" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackBottomCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True" />
						<Trigger
							Property="IsEnabled"
							Value="False" />
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{x:Null}"
		x:Key="ScrollUpButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="XamPagerButton"
						Margin="1,1,1,1"
						Width="Auto"
						Height="Auto"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch">
						<Border
							Name="Background"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveOuterBorderFillKey}"
							BorderThickness="1,1,1,1"
							CornerRadius="2,2,0,0"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveBottomCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Border
							Name="Highlight"
							CornerRadius="2,2,0,0"
							BorderThickness="1"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveInnerBorderFillKey}"
							Margin="1"
							SnapsToDevicePixels="True" />
						<ContentPresenter
							Margin="0,4,0,4"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackBottomCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True" />
						<Trigger
							Property="IsEnabled"
							Value="False" />
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{x:Null}"
		x:Key="ScrollDownButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="XamPagerButton"
						Margin="1,1,1,1"
						Width="Auto"
						Height="Auto"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch">
						<Border
							Name="Background"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveOuterBorderFillKey}"
							BorderThickness="1,1,1,1"
							CornerRadius="0,0,2,2"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveBottomCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Border
							Name="Highlight"
							CornerRadius="0,0,2,2"
							BorderThickness="1"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListNotActiveInnerBorderFillKey}"
							Margin="1"
							SnapsToDevicePixels="True" />
						<ContentPresenter
							Margin="0,5,0,4"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True"
							RenderTransformOrigin="0.5,0.5" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackBottomCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="Background"
								Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True" />
						<Trigger
							Property="IsEnabled"
							Value="False" />
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igWindows:XamPager}"
		x:Key="TabGroupXamPagerStyle">
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igWindows:XamPager}">
					<DockPanel
						Background="{TemplateBinding Background}">
						<RepeatButton
							Name="PART_ScrollRight"
							DockPanel.Dock="Right"
							Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineRightCommand}"
							Style="{StaticResource ScrollRightButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="3"
								Height="5"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M0,0 L0,5 L3,2.5"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollLeft"
							DockPanel.Dock="Right"
							Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineLeftCommand}"
							Style="{StaticResource ScrollLeftButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="3"
								Height="5"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M3,0 L3,5 L0,2.5"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollDown"
							DockPanel.Dock="Bottom"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineDownCommand}"
							Style="{StaticResource ScrollDownButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="5"
								Height="3"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M0,0 L5,0 L2.5,3"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollUp"
							DockPanel.Dock="Bottom"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineUpCommand}"
							Style="{StaticResource ScrollUpButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="5"
								Height="3"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M0,2.5 L5,2.5 L2.5,0"
								Fill="#000000" />
						</RepeatButton>
						<igWindows:PagerContentPresenter
							Name="PART_PagerContentPresenter"
							CanContentScroll="{TemplateBinding CanContentScroll}"
							Margin="{TemplateBinding Padding}" />
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ControlTemplate
		TargetType="{x:Type ContentControl}"
		x:Key="SimpleContentControlTemplate">
		<Border
			Background="{TemplateBinding Background}"
			CornerRadius="{TemplateBinding CornerRadius}"
			BorderBrush="{TemplateBinding BorderBrush}"
			BorderThickness="{TemplateBinding BorderThickness}"
			SnapsToDevicePixels="True">
			<Path
				Fill="{TemplateBinding Foreground}"
				Stretch="Uniform"
				Margin="{TemplateBinding Padding}"
				HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
				VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
				SnapsToDevicePixels="True"
				Data="{Binding Path=Content, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Value="{DynamicResource igDock:DockManagerBrushKeys.GrayTextBrushKey}"
					Property="Foreground" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="SimpleMenuItemTemplate">
		<igWindows:CardPanel>
			<Border
				Background="{TemplateBinding Background}"
				CornerRadius="{TemplateBinding CornerRadius}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
				SnapsToDevicePixels="True">
				<Path
					Fill="{TemplateBinding Foreground}"
					Stretch="Uniform"
					Margin="{TemplateBinding Padding}"
					HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
					VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
					SnapsToDevicePixels="True"
					Data="{Binding Path=Header, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
			</Border>
			<Popup
				Name="PART_Popup"
				AllowsTransparency="True"
				Placement="Bottom"
				PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
				IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
				<luna:SystemDropShadowChrome
					Name="Shdw"
					Color="Transparent">
					<Grid
						Name="MenuItem"
						Height="Auto"
						Width="Auto">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="27" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Grid.ColumnSpan="2"
							Opacity="1"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Margin="0,0,0,0"
							Stroke="{DynamicResource igDock:DockManagerBrushKeys.MenuItemOuterBorderFillKey}"
							StrokeThickness="1"
							Fill="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCenterFillKey}"
							SnapsToDevicePixels="True" />
						<ScrollViewer
							Grid.ColumnSpan="2"
							CanContentScroll="True"
							Margin="3"
							Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
							<ItemsPresenter
								KeyboardNavigation.TabNavigation="Cycle"
								KeyboardNavigation.DirectionalNavigation="Cycle"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</ScrollViewer>
					</Grid>
				</luna:SystemDropShadowChrome>
			</Popup>
		</igWindows:CardPanel>
		<ControlTemplate.Triggers>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Value="{DynamicResource igDock:DockManagerBrushKeys.GrayTextBrushKey}"
					Property="Foreground" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type Button}"
		x:Key="ButtonStyleBase">
		<Setter
			Property="ToolTipService.ShowOnDisabled"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Template"
			Value="{StaticResource SimpleContentControlTemplate}" />
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ButtonStyleBase}"
		x:Key="CaptionButtonStyleBase">
		<Style.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding Path=Pane.IsActivePane, RelativeSource={RelativeSource AncestorType={x:Type igDock:PaneHeaderPresenter}}}" />
					<Condition
						Value="True"
						Binding="{Binding Path=IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonHottrackOuterBorderFillKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonHottrackCenterFillKey}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="False"
						Binding="{Binding Path=Pane.IsActivePane, RelativeSource={RelativeSource AncestorType={x:Type igDock:PaneHeaderPresenter}}}" />
					<Condition
						Value="True"
						Binding="{Binding Path=IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonNotActiveHottrackOuterBorderFillKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonNotActiveHottrackCenterFillKey}" />
			</MultiDataTrigger>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonPressedOuterBorderFillKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource igDock:DockManagerBrushKeys.PaneCaptionButtonPressedCenterFillKey}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="Foreground"
					Value="{DynamicResource SystemColors.ControlDarkBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type Menu}"
		x:Key="RootMenuStyle">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="VerticalAlignment"
			Value="Top" />
		<Setter
			Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<igWindows:CardPanel />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type MenuItem}"
		x:Key="TopLevelHeaderMenuItemStyleBase">
		<Setter
			Property="ToolTipService.ShowOnDisabled"
			Value="True" />
		<Setter
			Property="IsTabStop"
			Value="False" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="#FFFF0000" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Template"
			Value="{StaticResource SimpleMenuItemTemplate}" />
	</Style>
	<Style
		TargetType="{x:Type Border}"
		x:Key="MenuItem_IconAreaBackground">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Background"
			Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemIconGroupCenterFillKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemIconGroupBorderFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,1,0" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="{x:Static igDock:XamDockManager.SubMenuItemTemplateKey}">
		<Grid
			Background="#00FFFFFF">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Name="iconColumn"
						MinWidth="27"
						Width="Auto"
						SharedSizeGroup="MenuItemIconColumnGroup" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Border
					Name="IconAreaBackground"
					Style="{StaticResource MenuItem_IconAreaBackground}" />
				<Grid
					Name="Highlight"
					Visibility="Collapsed"
					ColumnSpan="2"
					Margin="1,0,1,0">
					<Border
						Name="CenterAndBorderFill"
						Background="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionCenterFillKey}"
						BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionOuterBorderFillKey}"
						BorderThickness="1"
						SnapsToDevicePixels="True"
						CornerRadius="3" />
					<Rectangle
						Name="InnerBorderFill"
						StrokeThickness="1"
						Stroke="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionInnerBorderFillKey}"
						RadiusX="2"
						RadiusY="2"
						Margin="1"
						SnapsToDevicePixels="True" />
				</Grid>
				<ContentPresenter
					Name="Icon"
					Width="16"
					Height="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					ContentSource="Icon" />
				<Grid
					Name="CheckMark"
					Visibility="Collapsed">
					<Border
						Name="CheckMarkBox"
						Width="20"
						Height="20"
						SnapsToDevicePixels="True"
						Background="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxNormalCenterFillKey}"
						BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxNormalOuterBorderFillKey}"
						BorderThickness="1,1,1,1">
						<Path
							Name="CheckMarkGlyph"
							SnapsToDevicePixels="True"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="{DynamicResource igDock:DockManagerBrushKeys.DarkBrushKey}"
