	<Style
		TargetType="{x:Type igWindows:XamPager}"
		x:Key="TabGroupXamPagerStyle">
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igWindows:XamPager}">
					<DockPanel
						Background="{TemplateBinding Background}">
						<RepeatButton
							Name="PART_ScrollRight"
							DockPanel.Dock="Right"
							Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineRightCommand}"
							Style="{StaticResource ScrollRightButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="3"
								Height="5"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M0,0 L0,5 L3,2.5"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollLeft"
							DockPanel.Dock="Right"
							Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineLeftCommand}"
							Style="{StaticResource ScrollLeftButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="3"
								Height="5"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M3,0 L3,5 L0,2.5"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollDown"
							DockPanel.Dock="Bottom"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
							Command="{x:Static ScrollBar.LineDownCommand}"
							Style="{StaticResource ScrollDownButtonStyle}"
							CommandTarget="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Path
								HorizontalAlignment="Center"
								Width="5"
								Height="3"
								VerticalAlignment="Center"
								Stretch="Fill"
								Opacity="1"
								Data="M0,0 L5,0 L2.5,3"
								Fill="#000000" />
						</RepeatButton>
						<RepeatButton
							Name="PART_ScrollUp"
							DockPanel.Dock="Bottom"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
