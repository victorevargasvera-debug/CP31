													Visual="{Binding Path=SelectedPane, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
											</Shape.Fill>
										</Rectangle>
									</Viewbox>
								</Grid>
							</Border>
							<Grid
								Row="2"
								MinHeight="27">
								<Border
									Name="footerBackground"
									SnapsToDevicePixels="True"
									Background="{DynamicResource igDock:DockManagerBrushKeys.PaneNavigatorFooterFillKey}"
									CornerRadius="0,0,4,4">
									<ContentControl
										Name="selectedPaneDescription"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
										Focusable="False"
										VerticalAlignment="Center"
										Margin="13,0,13,0"
										Content="{Binding Path=SelectedPane.NavigatorDescription, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
										ContentTemplate="{Binding Path=SelectedPane.NavigatorDescriptionTemplate, RelativeSource={x:Static RelativeSource.TemplatedParent}}"
										ContentTemplateSelector="{Binding Path=SelectedPane.NavigatorDescriptionTemplateSelector, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
								</Border>
							</Grid>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDock:PaneNavigator.SelectedPaneAspectRatioIsWide"
									Value="False" />
								<Condition
									Property="igDock:PaneNavigator.SelectedPaneIsDocument"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="viewbox"
								Property="Viewbox.Stretch"
								Value="Uniform" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igDock:PaneNavigator.SelectedPaneAspectRatioIsWide"
									Value="True" />
								<Condition
									Property="igDock:PaneNavigator.SelectedPaneIsDocument"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="viewbox"
								Property="Viewbox.Stretch"
								Value="Uniform" />
							<Setter
								TargetName="viewbox"
								Property="Viewbox.StretchDirection"
								Value="DownOnly" />
						</MultiTrigger>
						<DataTrigger
							Value="True"
							Binding="{Binding Source={x:Static interop:BrowserInteropHelper.IsBrowserHosted}}">
							<Setter
								TargetName="border"
								Property="Border.CornerRadius"
								Value="0" />
							<Setter
								TargetName="footerBackground"
								Property="Border.CornerRadius"
								Value="0" />
							<Setter
								TargetName="headerBackground"
								Property="Border.CornerRadius"
								Value="0" />
						</DataTrigger>
						<DataTrigger
							Value="False"
							Binding="{Binding Path=(igDock:XamDockManager.DockManager).HasDocumentContentHost, RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="documentsLabel"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="lstDocuments"
								Property="Visibility"
								Value="Collapsed" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type ListBox}"
					x:Key="{x:Type ListBox}">
					<Setter
						Property="HorizontalScrollBarVisibility"
						Value="Hidden" />
					<Setter
						Property="VerticalScrollBarVisibility"
						Value="Hidden" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type ListBox}">
								<ScrollViewer
									CanContentScroll="True">
									<ItemsPresenter />
								</ScrollViewer>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ResourceDictionary>
		</Style.Resources>
	</Style>
	<Style
		BasedOn="{x:Static igWinThemes:PrimitivesLunaNormal.ToolWindow}"
		TargetType="{x:Type igDock:PaneToolWindow}"
		x:Key="{x:Type igDock:PaneToolWindow}" />
</ResourceDictionary>
