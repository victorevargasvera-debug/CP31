	<Style
		TargetType="{x:Type RepeatButton}"
		BasedOn="{x:Null}"
		x:Key="ScrollLeftButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Grid
						Name="XamPagerButton"
						Margin="1,1,1,1"
						Width="Auto"
						Height="Auto"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch">
						<Border
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedDocumentNotActiveOuterBorderFillKey}"
							BorderThickness="1,1,1,1"
							CornerRadius="2,0,0,2"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedDocumentNotActiveCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Border
							Name="Highlight"
							Visibility="Hidden"
							CornerRadius="2,0,0,2"
							BorderThickness="1,0,0,0"
							Background="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHighlightFillKey}"
							BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.TabbedListHighlightBorderFillKey}"
							Width="3"
							HorizontalAlignment="Left"
							VerticalAlignment="Stretch"
							SnapsToDevicePixels="True" />
						<ContentPresenter
							Margin="2,2,2,2"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True"
							RenderTransformOrigin="0.5,0.5">
							<UIElement.RenderTransform>
								<TransformGroup>
									<ScaleTransform
										ScaleX="1"
										ScaleY="1" />
									<SkewTransform
										AngleX="0"
										AngleY="0" />
									<RotateTransform
										Angle="-90" />
									<TranslateTransform
										X="0"
										Y="0" />
								</TransformGroup>
							</UIElement.RenderTransform>
						</ContentPresenter>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Highlight"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True" />
						<Trigger
							Property="IsEnabled"
							Value="False" />
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
