								Data="M1.9999808,0 L7.9999809,0 L7.9999809,8.0000019 L10,8.0000019 L10,10.000002 L6.0000005,10.000002 L6.0000005,14.000002 L4.0000005,14.000002 L4.0000005,10.000002 L0,10.000002 L0,8.0000019 L1.9999808,8.0000019"
								Fill="{TemplateBinding Foreground}" />
							<Path
								Name="UnpinnedGlyph"
								Visibility="Collapsed"
								Height="10"
								Width="14"
								Stretch="Fill"
								Opacity="1"
								Data="M4,0 L6,0 L6,1.9999999 L14,1.9999999 L14,8 L6,8 L6,10 L4,10 L4,8 L4,6 L0,6 L0,4 L4,4 L4,1.9999999"
								Fill="{TemplateBinding Foreground}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Value="{DynamicResource igDock:DockManagerBrushKeys.GrayTextBrushKey}"
								Property="Foreground" />
						</Trigger>
						<Trigger
							Property="igDock:XamDockManager.PaneLocation"
							Value="Unpinned">
							<Setter
								TargetName="UnpinnedGlyph"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="PinnedGlyph"
								Property="Visibility"
								Value="Collapsed" />
