	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ButtonStyleBase}"
		x:Key="CaptionButtonStyleBase">
		<Style.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</MultiDataTrigger>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="UIElement.Opacity"
					Value="0.3" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="True" />
		</Style.Triggers>
	</Style>
