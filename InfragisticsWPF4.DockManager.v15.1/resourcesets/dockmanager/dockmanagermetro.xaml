	<Style
		TargetType="{x:Type Border}"
		x:Key="MenuItem_IconAreaBackground">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Background"
			Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemIconGroupCenterFillKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemIconGroupBorderFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="0,0,1,0" />
	</Style>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="{x:Static igDock:XamDockManager.SubMenuItemTemplateKey}">
		<Grid
			MinHeight="32"
			Background="#00FFFFFF">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Name="iconColumn"
						MinWidth="33"
						Width="Auto"
						SharedSizeGroup="MenuItemIconColumnGroup" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Border
					Name="IconAreaBackground"
					Style="{StaticResource MenuItem_IconAreaBackground}" />
				<Grid
					Name="Highlight"
					Visibility="Collapsed"
					ColumnSpan="2"
					Margin="2">
					<Border
						Name="CenterAndBorderFill"
						Background="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionCenterFillKey}"
						BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionOuterBorderFillKey}"
						BorderThickness="1"
						SnapsToDevicePixels="True" />
					<Rectangle
						Name="InnerBorderFill"
						StrokeThickness="1"
						Stroke="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionInnerBorderFillKey}"
						Margin="1"
						SnapsToDevicePixels="True" />
				</Grid>
				<ContentPresenter
					Name="Icon"
					Width="16"
					Height="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					ContentSource="Icon" />
				<Grid
					Name="CheckMark"
					Visibility="Collapsed">
					<Border
						Name="CheckMarkBox"
						Width="18"
						Height="18"
						SnapsToDevicePixels="True"
						Background="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxNormalCenterFillKey}"
						BorderBrush="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxNormalOuterBorderFillKey}"
						BorderThickness="1,1,1,1">
						<Path
							Name="CheckMarkGlyph"
							SnapsToDevicePixels="True"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="{DynamicResource igDock:DockManagerBrushKeys.DarkBrushKey}"
							Data="M0,2 L0,4.8 L2.5,7.4 L7.1,2.8 L7.1,0 L2.5,4.6"
							FlowDirection="LeftToRight" />
					</Border>
				</Grid>
				<Grid
					Column="1"
					VerticalAlignment="Center">
					<ContentPresenter
						Name="Content"
						TextBlock.FontFamily="Segoe UI"
						TextBlock.FontSize="14.667"
						ContentSource="Header"
						Margin="8,4,8,4"
						TextBlock.Foreground="{StaticResource ForegroundBrush}" />
				</Grid>
			</Grid>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger
				Property="MenuItem.IsHighlighted"
				Value="True">
				<Setter
					TargetName="Highlight"
					Property="Visibility"
					Value="Visible" />
				<Setter
					Value="{DynamicResource igDock:DockManagerBrushKeys.MenuSelectionHottrackTextFillKey}"
					Property="Foreground" />
			</Trigger>
			<Trigger
				Property="MenuItem.IsChecked"
				Value="True">
				<Setter
					TargetName="CheckMark"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="Icon"
					Property="Visibility"
					Value="Collapsed" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="MenuItem.IsChecked"
						Value="True" />
					<Condition
						Property="MenuItem.IsHighlighted"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					TargetName="CheckMarkBox"
					Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxHottrackCenterFillKey}"
					Property="Background" />
				<Setter
					TargetName="CheckMarkBox"
					Value="{DynamicResource igDock:DockManagerBrushKeys.MenuItemCheckmarkBoxHottrackOuterBorderFillKey}"
					Property="BorderBrush" />
			</MultiTrigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					TargetName="Content"
					Value="{DynamicResource igDock:DockManagerBrushKeys.GrayTextBrushKey}"
					Property="Foreground" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type MenuItem}"
		BasedOn="{StaticResource TopLevelHeaderMenuItemStyleBase}"
		x:Key="{x:Static igDock:TabGroupPane.DocumentFilesMenuItemStyleKey}">
		<Setter
			Property="FrameworkElement.ToolTip"
			Value="{StaticResource positionToolTip}" />
		<Setter
			Property="Width"
			Value="30" />
		<Setter
			Property="Height"
			Value="30" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource igDock:DockManagerBrushKeys.TabbedDocumentGlyphFillKey}" />
		<Setter
			Property="Margin"
			Value="0" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type MenuItem}">
					<igWindows:CardPanel>
						<Border
							Background="{TemplateBinding Background}"
							CornerRadius="{TemplateBinding CornerRadius}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							SnapsToDevicePixels="True">
							<Grid
								VerticalAlignment="Stretch"
								Width="30"
								Height="30">
								<Path
									Name="AllItemsInViewGlyph"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Height="6"
									Width="10"
									Stretch="Fill"
									Data="M3,8 C3,8 7.5,12.5 7.5,12.5 C7.5,12.5 12,8 12,8 C12,8 3,8 3,8"
									Fill="{TemplateBinding Foreground}" />
								<Path
									Name="HasItemsOutOfViewGlyph"
									Visibility="Collapsed"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Height="10"
									Width="10"
									Stretch="Fill"
									Data="M0,3 C0,3 9,3 9,3 C9,3 4.5,7.5 4.5,7.5 C4.5,7.5 0,3 0,3 M0,0 L9,0 L9,2 L0,2 L0,0"
									Fill="{TemplateBinding Foreground}" />
							</Grid>
						</Border>
						<Popup
							Name="PART_Popup"
							AllowsTransparency="True"
							Placement="Bottom"
							PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
							IsOpen="{Binding IsSubmenuOpen, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
							<Grid
								Name="MenuItem"
								Height="Auto"
								Width="Auto">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="27" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Rectangle
									Grid.ColumnSpan="2"
									Opacity="1"
