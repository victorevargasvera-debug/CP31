	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource paneCaptionButtonStyleBase}"
		x:Key="{x:Static igDock:PaneHeaderPresenter.MaximizeButtonStyleKey}">
		<Setter
			Property="FrameworkElement.ToolTip"
			Value="{StaticResource maximizeToolTip}" />
