					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="Foreground"
					Value="{StaticResource HighlightedForegroundBrush}" />
