<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.ApplicationLicense.ApplicationLicenseMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prism="http://www.codeplex.com/prism" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ig="http://schemas.infragistics.com/xaml" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.ApplicationLicense" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:uiModels="clr-namespace:Motorola.CommonCPS.RadioManagement.UIModels;assembly=Motorola.CommonCPS.RadioManagement.UIModels" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
	</UIElement.InputBindings>
	<i:Interaction.Triggers>
		<prism:InteractionRequestTrigger
			i:SourceObject="{Binding ShowRegisterApplicationLicenseDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True">
				<infrastructure:PopupWindowAction.Content>
					<local:RegisterLicenseView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</prism:InteractionRequestTrigger>
	</i:Interaction.Triggers>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:BoolToInverseConverter
				x:Key="BoolToInverseConverter" />
			<converters:RegionToStringConverter
				x:Key="RegionToStringConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Style="{StaticResource WindowBorderStyle}">
		<Grid
			Margin="10">
			<!--Unknown connection ID: 1-->
			<controls:RMDataGrid
				Name="dgrApplicationLicense"
				igDP:GroupByAreaLocation="None"
				CRUDToolBarVisibility="Visible"
				igDP:DataSource="{Binding Items}"
				SearchCommand="{Binding SearchCommand}"
				infrastructure:DataGridEditModeEnding.Command="{Binding SaveItemCommand}"
				infrastructure:DataGridSelectedItemsChanged.Command="{Binding UpdateSelectedItemsCommand}"
				AddCommand="{Binding PrepareRegisterApplicationLicenseDialogCommand}">
				<igDP:DataPresenterBase.FieldLayouts>
					<igDP:FieldLayout>
						<igDP:FieldLayout.Fields>
							<igDP:Field
								Name="FeatureName"
								Label="{x:Static resourceRepository:Resources.RMC_Model_FeatureInfo_FeatureName}">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.EditorStyle>
											<Style
												TargetType="{x:Type igEditors:XamTextEditor}">
												<Setter
													Property="igEditors:ValueEditor.IsReadOnly"
													Value="True" />
											</Style>
										</igDP:FieldSettings.EditorStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								Name="Region"
								Label="{x:Static resourceRepository:Resources.RMC_Region_Title}"
								Converter="{StaticResource RegionToStringConverter}">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.EditorStyle>
											<Style
												TargetType="{x:Type igEditors:XamTextEditor}">
												<Setter
													Property="igEditors:ValueEditor.IsReadOnly"
													Value="True" />
											</Style>
										</igDP:FieldSettings.EditorStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								Name="UIStatus"
								Label="{x:Static resourceRepository:Resources.RMC_AppLicenseView_StatusColumn}">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.EditorStyle>
											<Style
												TargetType="{x:Type igEditors:XamTextEditor}">
												<Setter
													Property="igEditors:ValueEditor.IsReadOnly"
													Value="True" />
											</Style>
										</igDP:FieldSettings.EditorStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								Name="AppComments"
								Label="{x:Static resourceRepository:Resources.RMC_Model_FeatureInfo_Comments}">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.EditorStyle>
											<Style
												TargetType="{x:Type igEditors:XamTextEditor}">
												<Setter
													Property="igEditors:ValueEditor.ValueConstraint">
													<Setter.Value>
														<igEditors:ValueConstraint
															MaxLength="1024" />
													</Setter.Value>
												</Setter>
												<Setter
													Property="igEditors:ValueEditor.IsReadOnly"
													Value="{Binding Path=DataItem.IsCommentEditable, Converter={StaticResource BoolToInverseConverter}}" />
												<Setter
													Property="Background"
													Value="#00FFFFFF" />
												<Setter
													Property="BorderBrush"
													Value="#00FFFFFF" />
												<Setter
													Property="BorderThickness"
													Value="0" />
												<Setter
													Property="Foreground"
													Value="#FF000000" />
											</Style>
										</igDP:FieldSettings.EditorStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
						</igDP:FieldLayout.Fields>
					</igDP:FieldLayout>
				</igDP:DataPresenterBase.FieldLayouts>
			</controls:RMDataGrid>
		</Grid>
	</Border>
</UserControl>
