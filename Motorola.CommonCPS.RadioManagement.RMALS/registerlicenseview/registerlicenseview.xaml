<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.ApplicationLicense.RegisterLicenseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository"
	Height="580"
	Width="800" xmlns:applicationlicense="clr-namespace:Motorola.CommonCPS.RadioManagement.ApplicationLicense">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<converters:BoolToInverseConverter
				x:Key="BoolToInverseConverter" />
			<converters:RegionToStringConverter
				x:Key="RegionToStringConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<!--Unknown connection ID: 1-->
		<Grid
			Name="grdASTRO"
			HorizontalAlignment="Stretch"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:ASTRO]}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*"
					MinWidth="200" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="2*"
					MinWidth="400" />
			</Grid.ColumnDefinitions>
			<ListBox
				Style="{StaticResource ListBox_SelectionNode}"
				SelectedIndex="{Binding RegisterApplicationLicenseContext.CurrentMode}">
				<!--Unknown connection ID: 2-->
				<ListBoxItem
					Name="lbiEID"
					Content="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicenseView_EID}"
					Padding="10,5"
					IsSelected="True" />
				<!--Unknown connection ID: 3-->
				<ListBoxItem
					Name="lbiFile"
					Content="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicenseView_File}"
					Padding="10,5" />
			</ListBox>
			<GridSplitter
				Grid.Column="1"
				ResizeBehavior="PreviousAndNext"
				Width="10"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch" />
			<!--Unknown connection ID: 4-->
			<Border
				Name="bdEID"
				Grid.Column="2"
				Style="{StaticResource WindowBorderStyle}"
				Visibility="{Binding Converter={StaticResource BooleanToVisibilityConverter}, ElementName=lbiEID, Path=IsSelected}">
				<Grid
					Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<controls:RMAnchorNoExpander
						Grid.Row="0"
						Caption="{x:Static resourceRepository:Resources.RMC_License_EnterEID}" />
					<Grid
						Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="20" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="20" />
							<ColumnDefinition
								Width="100" />
							<ColumnDefinition
								Width="20" />
						</Grid.ColumnDefinitions>
						<controls:RMTextBlock
							Grid.Column="0"
							VerticalAlignment="Center"
							Text="{x:Static resourceRepository:Resources.RMC_Views_RegisterApplicationLicense_EnterEID}" />
						<!--Unknown connection ID: 5-->
						<controls:RMTextBox
							Name="msiEID"
							Grid.Column="2"
							Text="{Binding RegisterApplicationLicenseContext.EIDString}" />
						<!--Unknown connection ID: 6-->
						<controls:RMButton
							Name="btnQuery"
							Grid.Column="4"
							Content="{x:Static resourceRepository:Resources.RMC_Action_Query}"
							Command="{Binding QueryEidCommand}" />
					</Grid>
					<controls:RMAnchorNoExpander
						Grid.Row="4"
						Caption="Results" />
					<!--Unknown connection ID: 7-->
					<controls:RMDataGrid
						Name="dgrFeatures"
						Grid.Row="6"
						igDP:GroupByAreaLocation="None"
						igDP:DataSource="{Binding RegisterApplicationLicenseContext.EIDInfos, Converter={StaticResource GridViewSourceConverter}}"
						SearchCommand="{Binding SearchCommand}">
						<igDP:DataPresenterBase.FieldSettings>
							<igDP:FieldSettings
								AllowEdit="False"
								CellClickAction="SelectRecord"
								Width="Auto" />
						</igDP:DataPresenterBase.FieldSettings>
						<igDP:DataPresenterBase.FieldLayouts>
							<igDP:FieldLayout>
								<igDP:FieldLayout.Fields>
									<igDP:Field
										Name="Entitlement"
										Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_EntitlementID}"
										Width="*">
										<igDP:Field.Settings>
											<igDP:FieldSettings>
												<igDP:FieldSettings.EditorStyle>
													<Style
														TargetType="{x:Type igEditors:XamTextEditor}">
														<Setter
															Property="igEditors:ValueEditor.IsReadOnly"
															Value="True" />
													</Style>
												</igDP:FieldSettings.EditorStyle>
											</igDP:FieldSettings>
										</igDP:Field.Settings>
									</igDP:Field>
									<igDP:Field
										Name="FeatureName"
										Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_FeatureName}">
										<igDP:Field.Settings>
											<igDP:FieldSettings>
												<igDP:FieldSettings.EditorStyle>
													<Style
														TargetType="{x:Type igEditors:XamTextEditor}">
														<Setter
															Property="igEditors:ValueEditor.IsReadOnly"
															Value="True" />
													</Style>
												</igDP:FieldSettings.EditorStyle>
											</igDP:FieldSettings>
										</igDP:Field.Settings>
									</igDP:Field>
									<igDP:Field
										Name="QtyPurchased"
										Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_QtyPurchased}">
										<igDP:Field.Settings>
											<igDP:FieldSettings>
												<igDP:FieldSettings.EditorStyle>
													<Style
														TargetType="{x:Type igEditors:XamTextEditor}">
														<Setter
															Property="igEditors:ValueEditor.IsReadOnly"
															Value="True" />
													</Style>
												</igDP:FieldSettings.EditorStyle>
											</igDP:FieldSettings>
										</igDP:Field.Settings>
									</igDP:Field>
									<igDP:Field
										Name="Available"
										Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_Available}">
										<igDP:Field.Settings>
											<igDP:FieldSettings>
												<igDP:FieldSettings.EditorStyle>
													<Style
														TargetType="{x:Type igEditors:XamTextEditor}">
														<Setter
															Property="igEditors:ValueEditor.IsReadOnly"
															Value="True" />
													</Style>
												</igDP:FieldSettings.EditorStyle>
											</igDP:FieldSettings>
										</igDP:Field.Settings>
									</igDP:Field>
									<igDP:Field
										Name="RadioCountUpdates"
										Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_RadioCountUpdates}">
										<igDP:Field.Settings>
											<igDP:FieldSettings
												AllowEdit="True">
												<igDP:FieldSettings.EditorStyle>
													<Style
														TargetType="{x:Type igEditors:XamMaskedEditor}">
														<Setter
															Property="igEditors:XamMaskedEditor.Mask"
															Value="nnnnn" />
														<Setter
															Property="igEditors:ValueEditor.IsReadOnly"
															Value="{Binding Path=DataItem.IsRadioCountUpdatesEditable, Converter={StaticResource BoolToInverseConverter}}" />
														<Setter
															Property="igEditors:XamMaskedEditor.PromptChar"
															Value="" />
														<Setter
															Property="Background"
															Value="#00FFFFFF" />
														<Setter
															Property="BorderThickness"
															Value="0" />
														<Setter
															Property="Foreground"
															Value="#FF000000" />
													</Style>
												</igDP:FieldSettings.EditorStyle>
											</igDP:FieldSettings>
										</igDP:Field.Settings>
									</igDP:Field>
								</igDP:FieldLayout.Fields>
							</igDP:FieldLayout>
						</igDP:DataPresenterBase.FieldLayouts>
					</controls:RMDataGrid>
				</Grid>
			</Border>
			<!--Unknown connection ID: 8-->
			<Border
				Name="bdFile"
				Grid.Column="2"
				Style="{StaticResource WindowBorderStyle}"
				Visibility="{Binding Converter={StaticResource BooleanToVisibilityConverter}, ElementName=lbiFile, Path=IsSelected}">
				<!--Unknown connection ID: 9-->
				<Grid
					Name="gridFile"
					Column="2"
					Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<controls:RMAnchorNoExpander
						Grid.Row="0"
						Caption="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicense_HostID}" />
					<Grid
						Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="120" />
							<ColumnDefinition
								Width="20" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<controls:RMTextBlock
							Text="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicense_HostID}"
							VerticalAlignment="Center"
							HorizontalAlignment="Right" />
						<!--Unknown connection ID: 10-->
						<controls:RMButton
							Name="btnGetHostID"
							Grid.Column="2"
							VerticalAlignment="Center"
							Width="100"
							HorizontalAlignment="Left"
							Content="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicense_SaveHostID}"
							Command="{Binding GetHostIdCommand}" />
					</Grid>
					<controls:RMAnchorNoExpander
						Grid.Row="4"
						Caption="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicense_LicenseFile}" />
					<Grid
						Row="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="120" />
							<ColumnDefinition
								Width="20" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="20" />
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="20" />
						</Grid.ColumnDefinitions>
						<Label
							Content="{x:Static resourceRepository:Resources.RMC_RegisterApplicationLicense_LicenseFile}"
							VerticalAlignment="Center"
							HorizontalAlignment="Right" />
						<!--Unknown connection ID: 11-->
						<controls:RMTextBox
							Name="msiLicenseFile"
							Grid.Column="2"
							VerticalAlignment="Center"
							Text="{Binding RegisterApplicationLicenseContext.LicenseFile, UpdateSourceTrigger=PropertyChanged}" />
						<controls:RMButton
							Grid.Column="4"
							Content="{x:Static resourceRepository:Resources.RMC_Action_Browse}"
							Margin="10,0,0,0"
							Command="{Binding ChooseLicenseFileCommand}" />
					</Grid>
				</Grid>
			</Border>
		</Grid>
		<!--Unknown connection ID: 12-->
		<Grid
			Name="grdPCR"
			HorizontalAlignment="Stretch"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[PAC:PCR]}">
			<!--Unknown connection ID: 13-->
			<Grid
				Name="gridEID">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="20" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="20" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="20" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<controls:RMAnchorNoExpander
					Grid.Row="0"
					Caption="{x:Static resourceRepository:Resources.RMC_License_EnterEID}" />
				<Grid
					Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="60" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="100" />
					</Grid.ColumnDefinitions>
					<controls:RMTextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Text="{x:Static resourceRepository:Resources.RMC_Views_RegisterApplicationLicense_EnterEID}" />
					<!--Unknown connection ID: 14-->
					<controls:RMTextBox
						Name="msiPCREID"
						Grid.Column="1"
						Text="{Binding RegisterApplicationLicenseContext.EIDString, UpdateSourceTrigger=PropertyChanged}" />
					<!--Unknown connection ID: 15-->
					<controls:RMButton
						Name="btnPCRQuery"
						Grid.Column="2"
						Margin="10,0,0,0"
						Content="{x:Static resourceRepository:Resources.RMC_Action_Query}"
						Command="{Binding QueryEidCommand}" />
				</Grid>
				<controls:RMAnchorNoExpander
					Grid.Row="4"
					Caption="{x:Static resourceRepository:Resources.RMC_License_Results}" />
				<!--Unknown connection ID: 16-->
				<controls:RMDataGrid
					Name="dgrPCRFeatures"
					Grid.Row="6"
					igDP:GroupByAreaLocation="None"
					igDP:DataSource="{Binding RegisterApplicationLicenseContext.EIDInfos, Converter={StaticResource GridViewSourceConverter}}"
					SearchCommand="{Binding SearchCommand}"
					igDP:ActiveDataItem="{Binding RegisterApplicationLicenseContext.EidInfoItem}">
					<igDP:DataPresenterBase.FieldSettings>
						<igDP:FieldSettings
							AllowEdit="False"
							CellClickAction="SelectRecord"
							Width="Auto" />
					</igDP:DataPresenterBase.FieldSettings>
					<igDP:DataPresenterBase.FieldLayouts>
						<igDP:FieldLayout>
							<igDP:FieldLayout.Fields>
								<igDP:Field
									Name="Entitlement"
									Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_EntitlementID}"
									Width="*">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="FeatureName"
									Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_FeatureName}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="Region"
									Label="{x:Static resourceRepository:Resources.RMC_Region_Title}"
									Converter="{StaticResource RegionToStringConverter}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="QtyPurchased"
									Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_QtyPurchased}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="Available"
									Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_Available}">
									<igDP:Field.Settings>
										<igDP:FieldSettings>
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamTextEditor}">
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="True" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
								<igDP:Field
									Name="RadioCountUpdates"
									Label="{x:Static resourceRepository:Resources.RMC_Model_EIDInfo_RadioCountUpdates}">
									<igDP:Field.Settings>
										<igDP:FieldSettings
											AllowEdit="True">
											<igDP:FieldSettings.EditorStyle>
												<Style
													TargetType="{x:Type igEditors:XamMaskedEditor}">
													<Setter
														Property="igEditors:XamMaskedEditor.Mask"
														Value="nnnnn" />
													<Setter
														Property="igEditors:ValueEditor.IsReadOnly"
														Value="{Binding Path=DataItem.IsRadioCountUpdatesEditable, Converter={StaticResource BoolToInverseConverter}}" />
													<Setter
														Property="igEditors:XamMaskedEditor.PromptChar"
														Value="" />
													<Setter
														Property="Background"
														Value="#00FFFFFF" />
													<Setter
														Property="BorderThickness"
														Value="0" />
													<Setter
														Property="Foreground"
														Value="#FF000000" />
												</Style>
											</igDP:FieldSettings.EditorStyle>
										</igDP:FieldSettings>
									</igDP:Field.Settings>
								</igDP:Field>
							</igDP:FieldLayout.Fields>
						</igDP:FieldLayout>
					</igDP:DataPresenterBase.FieldLayouts>
				</controls:RMDataGrid>
			</Grid>
		</Grid>
		<Grid
			Row="2"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 17-->
			<controls:RMButton
				Name="btnRegister"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Register}"
				MinWidth="95"
				Command="{Binding RegisterApplicationLicenseCommand}" />
			<!--Unknown connection ID: 18-->
			<controls:RMButton
				Name="btnClose"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Close}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="3"
			Error="{Binding RegisterApplicationLicenseContext.ExceptionMessage}" />
	</Grid>
</UserControl>
