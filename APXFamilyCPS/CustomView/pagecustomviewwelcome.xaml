										TargetName="ExpandSite"
										Property="Dock"
										Value="Left" />
									<Setter
										TargetName="HeaderSite"
										Property="Dock"
										Value="Right" />
									<Setter
										TargetName="HeaderSite"
										Property="Style"
										Value="{StaticResource ExpanderLeftHeaderStyle}" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="false">
									<Setter
										Value="{DynamicResource SystemColors.GrayTextBrushKey}"
										Property="Foreground" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
