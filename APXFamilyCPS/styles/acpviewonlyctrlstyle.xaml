<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type AcpUINS:AcpViewOnlyCtrl}"
		x:Key="AcpViewOnlyCtrlStyleBase">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Label}">
					<Border
						BorderThickness="1"
						BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlBorderBrush}}}">
						<ContentPresenter
							RecognizesAccessKey="False" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlDisabledForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type AcpUINS:AcpViewOnlyCtrl}"
		BasedOn="{StaticResource AcpViewOnlyCtrlStyleBase}"
		x:Key="{x:Type AcpUINS:AcpViewOnlyCtrl}">
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type AcpUINS:AcpTableViewOnlyCtrl}"
		BasedOn="{StaticResource AcpViewOnlyCtrlStyleBase}"
		x:Key="{x:Type AcpUINS:AcpTableViewOnlyCtrl}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type AcpUINS:AcpTableViewOnlyCtrl}">
					<ContentPresenter
						RecognizesAccessKey="False" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
