						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="UIElement.IsMouseOver"
									Value="true" />
								<Condition
									Property="AcpUINS:AcpTableTextBoxSpinner.IsAcpEditable"
									Value="true" />
								<Condition
