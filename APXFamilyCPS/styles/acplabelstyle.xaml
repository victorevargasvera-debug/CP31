<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type AcpUINS:AcpLabel}"
		x:Key="{x:Type AcpUINS:AcpLabel}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type AcpUINS:AcpLabel}">
					<TextBlock
						Margin="0,4,4,4"
						TextWrapping="Wrap"
						Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelDisabledForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelDisabledForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type Label}"
		x:Key="{x:Type Label}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}" />
	</Style>
</ResourceDictionary>
