<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type AcpUINS:AcpExpander}"
		x:Key="{x:Type AcpUINS:AcpExpander}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type AcpUINS:AcpExpander}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="25" />
							<RowDefinition
								Name="ContentRow"
								Height="0" />
						</Grid.RowDefinitions>
						<Border
							Name="Border"
							Grid.Row="0"
							BorderThickness="1"
							CornerRadius="2,2,0,0"
							Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBackground}}}"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBrush1}}}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="20" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<ToggleButton
									Name="ExpanderButton"
									DockPanel.Dock="Top"
									Grid.Column="0"
									Template="{DynamicResource GroupExpanderToggleButtonTemplate}"
									Content="{TemplateBinding Header}"
									Background="{TemplateBinding Tag}"
									OverridesDefaultStyle="True"
									Padding="1.5,0"
									IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
								<TextBlock
									Grid.Column="1" />
								<ContentPresenter
									Grid.Column="2"
									VerticalAlignment="Center"
									ContentSource="ExpToolbar" />
							</Grid>
						</Border>
						<Border
							Name="Content"
							Grid.Row="1"
							BorderThickness="1,0,1,1"
							CornerRadius="0,0,2,2"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBrush2}}}">
							<ContentPresenter
								Margin="4" />
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="Expander.IsExpanded"
							Value="True">
							<Setter
								TargetName="ContentRow"
								Property="Height"
								Value="{Binding ElementName=Content, Path=DesiredHeight}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<DataTrigger
				Value="true"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Visible" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<DrawingBrush
		Stretch="Uniform"
		x:Key="TriangleDown">
		<DrawingBrush.Drawing>
			<DrawingGroup>
				<DrawingGroup.Children>
					<GeometryDrawing
						Brush="#003E3E3E"
						Geometry="F1 M0,0.00134277 L511.999,0.00134277 L511.999,512 L0,512 L0,0.00134277" />
					<GeometryDrawing
						Brush="#FF3E3E3E"
						Geometry="F1 M256,416 L416,96 L96,96 L256,416" />
				</DrawingGroup.Children>
			</DrawingGroup>
		</DrawingBrush.Drawing>
	</DrawingBrush>
	<DrawingBrush
		Stretch="Uniform"
		x:Key="TriangleRight">
		<DrawingBrush.Drawing>
			<DrawingGroup>
				<DrawingGroup.Children>
					<GeometryDrawing
						Brush="#003E3E3E"
						Geometry="F1 M0,0.00134277 L511.999,0.00134277 L511.999,512 L0,512 L0,0.00134277" />
					<GeometryDrawing
						Brush="#FF3E3E3E"
						Geometry="F1 M416,256 L96,96 L96,416 L416,256" />
				</DrawingGroup.Children>
			</DrawingGroup>
		</DrawingBrush.Drawing>
	</DrawingBrush>
	<ControlTemplate
		TargetType="{x:Type ToggleButton}"
		x:Key="GroupExpanderToggleButtonTemplate">
		<Border
			Name="ExpanderButtonBorder"
			Background="{TemplateBinding Background}"
			BorderBrush="{TemplateBinding BorderBrush}"
			BorderThickness="{TemplateBinding BorderThickness}"
			Padding="{TemplateBinding Padding}"
			FocusVisualStyle="{x:Null}">
			<Grid
				FocusVisualStyle="{x:Null}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<Rectangle
					Fill="#00FFFFFF"
					Grid.ColumnSpan="2" />
				<Rectangle
					Name="Sign"
					Grid.Column="0"
					Width="17"
					Height="17"
					Fill="{DynamicResource TriangleRight}"
					FocusVisualStyle="{x:Null}" />
				<ContentPresenter
					Name="HeaderContent"
					Grid.Column="1"
					Margin="0,0,0,0"
					ContentSource="Content"
					VerticalAlignment="Center"
					FocusVisualStyle="{x:Null}" />
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				Property="ToggleButton.IsChecked"
				Value="True">
				<Setter
					TargetName="Sign"
					Value="{DynamicResource TriangleDown}"
					Property="Fill" />
				<Setter
					Property="FrameworkElement.FocusVisualStyle">
					<Setter.Value>
						<Style />
					</Setter.Value>
				</Setter>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style
		TargetType="{x:Type Expander}"
		x:Key="{x:Type Expander}">
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}" />
	</Style>
</ResourceDictionary>
