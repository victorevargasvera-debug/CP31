	<Style
		TargetType="{x:Type Thumb}"
		x:Key="HorizontalSliderThumbStyle">
		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="true" />
		<Setter
			Property="Foreground"
			Value="{x:Null}" />
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.ControlBrushKey}" />
		<Setter
			Property="Height"
			Value="21" />
		<Setter
			Property="Width"
			Value="11" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Thumb}">
					<Microsoft_Windows_Themes:ClassicBorderDecorator
						Background="{TemplateBinding Background}"
						BorderBrush="{x:Static ClassicBorderDecorator.ClassicBorderBrush}"
						BorderStyle="Raised"
						BorderThickness="3">
						<Rectangle
							Name="ForegroundRect"
							Opacity="0.5"
							Margin="-1"
							Fill="{TemplateBinding Foreground}" />
					</Microsoft_Windows_Themes:ClassicBorderDecorator>
					<ControlTemplate.Triggers>
						<Trigger
							Property="Thumb.IsDragging"
							Value="true">
							<Setter
								Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
								Property="Foreground" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="false">
							<Setter
								Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
