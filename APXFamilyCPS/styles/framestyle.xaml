						Property="Frame.NavigationUIVisibility"
						Value="Automatic" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Template"
					Value="{StaticResource FrameNavChromeTemplateKey}" />
			</MultiTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
