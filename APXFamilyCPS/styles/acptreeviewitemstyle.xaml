<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type AcpUINS:AcpTreeViewItem}"
		x:Key="{x:Type AcpUINS:AcpTreeViewItem}">
		<Setter
			Property="HeaderTemplate">
			<Setter.Value>
				<DataTemplate>
					<StackPanel
						Name="HeaderPanel_PART"
						Orientation="Horizontal">
						<Image
							Name="HeaderDiffIcon"
							Visibility="Collapsed"
							Width="10"
							Height="10"
							HorizontalAlignment="Right"
							Margin="5,0,0,0"
							Source="../../icons/warning.ico" />
						<TextBlock
							Name="HeaderLbl"
							HorizontalAlignment="Left"
							Margin="5,0"
							Text="{Binding}"
							Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemForeground}}}" />
					</StackPanel>
					<DataTemplate.Triggers>
						<DataTrigger
							Value="True"
							Binding="{Binding Path=ShowDiffIcon, RelativeSource={RelativeSource TemplatedParent}}">
							<Setter
								TargetName="HeaderDiffIcon"
								Property="Visibility"
								Value="Visible" />
						</DataTrigger>
						<DataTrigger
							Value="True"
							Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource TemplatedParent}}">
							<Setter
								TargetName="HeaderPanel_PART"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemSelectedBackground}}}" />
							<Setter
								TargetName="HeaderLbl"
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemSelectedForeground}}}" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
