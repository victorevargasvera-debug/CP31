	<Style
		TargetType="{x:Type AcpUINS:AcpRtdButton}"
		x:Key="{x:Type AcpUINS:AcpRtdButton}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type AcpUINS:AcpRtdButton}">
					<Grid>
						<Border
							Name="Border"
							Width="16"
							Height="16"
							CornerRadius="0"
							BorderThickness="0"
							Background="#00FFFFFF">
							<Image
								Width="16"
								Height="16"
								Source="{StaticResource RtdDrawingImage}" />
						</Border>
						<ContentPresenter />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="true">
							<Setter
								TargetName="Border"
								Property="UIElement.Effect">
								<Setter.Value>
									<DropShadowEffect
										Color="#FFF7931E"
										ShadowDepth="2" />
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="true">
							<Setter
								TargetName="Border"
								Property="UIElement.Effect">
								<Setter.Value>
									<DropShadowEffect
										Color="#FFFFFFFF"
										ShadowDepth="2" />
								</Setter.Value>
							</Setter>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
