	<Style
		TargetType="{x:Type TextBox}"
		x:Key="{x:Type TextBox}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxForeground}}}" />
	</Style>
	<ContextMenu
		Visibility="Collapsed"
		IsEnabled="False"
		x:Key="EmptyContextMenu" />
	<Style
		TargetType="{x:Type AcpUINS:AcpTextBox}"
		BasedOn="{StaticResource {x:Type TextBox}}"
		x:Key="{x:Type AcpUINS:AcpTextBox}">
		<Style.Triggers>
			<Trigger
				Property="AcpUINS:AcpTextBox.IsMasked"
				Value="true">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type AcpUINS:AcpTextBox}">
							<igEditors:XamMaskedEditor
								Name="xamlTextEd"
								InvalidValueBehavior="RevertValue"
								BorderBrush="{x:Static SystemColors.HighlightBrush}"
								ContextMenu="{StaticResource EmptyContextMenu}"
								Mask="{Binding Path=MaskType, RelativeSource={RelativeSource TemplatedParent}}"
								Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
								Background="{Binding Path=Background, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								Foreground="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
							<ControlTemplate.Triggers>
								<Trigger
									Property="UIElement.IsFocused"
									Value="true">
									<Setter
										TargetName="xamlTextEd"
										Property="igEditors:ValueEditor.IsInEditMode"
										Value="true" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
