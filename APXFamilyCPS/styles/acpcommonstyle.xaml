	<AcpUINS:AcpViewModel
		x:Key="viewModel" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="WebBrowserBackground">
		<GradientBrush.GradientStops>
			<GradientStop
				Color="#FFFFFF"
				Offset="0" />
			<GradientStop
				Color="#E3E8F4"
				Offset="0.5" />
			<GradientStop
				Color="#CFD7EB"
				Offset="0.5" />
			<GradientStop
				Color="#E9ECFA"
				Offset="1.0" />
		</GradientBrush.GradientStops>
	</LinearGradientBrush>
	<Style
		x:Key="AcpFocusVisual">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle
						Margin="-1"
						StrokeThickness="2"
						Stroke="#FF000037" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="MyFocusVisual">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle
						Margin="0"
						StrokeThickness="1"
						Stroke="#FF000000"
						StrokeDashArray="1 2" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type TextBlock}"
		x:Key="WelcomeScreenTextBlockStyle">
		<Style.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="true">
				<Setter
					Property="Foreground"
					Value="#FFFF0000" />
				<Setter
					Property="TextDecorations"
					Value="Underline" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type ScrollBar}"
		x:Key="{x:Type ScrollBar}">
		<Setter
			Property="Background"
			Value="#FF000000" />
	</Style>
	<Style
		TargetType="{x:Type Image}"
		x:Key="Image32x32Style">
		<Setter
			Property="Height"
			Value="32" />
		<Setter
			Property="Width"
			Value="32" />
	</Style>
	<Style
		TargetType="{x:Type Image}"
		x:Key="Image24x24Style">
		<Setter
			Property="Height"
			Value="24" />
		<Setter
			Property="Width"
			Value="24" />
	</Style>
	<Style
		TargetType="{x:Type Image}"
		x:Key="Image16x16Style">
		<Setter
			Property="Height"
			Value="16" />
		<Setter
			Property="Width"
			Value="16" />
	</Style>
	<AcpUICommonNS:ComboBoxItemsWidthConverter
		x:Key="comboBoxItemsWidthConverter" />
	<DataTemplate
		x:Key="AcpComboBoxItemsTemplate">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpComboBox}}, Converter={StaticResource comboBoxItemsWidthConverter}}" />
				<ColumnDefinition
					MinWidth="16" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				Text="{Binding Path=ItemName}" />
			<Image
				Grid.Column="1"
				Style="{StaticResource Image16x16Style}"
				Source="{Binding Path=ItemImage}" />
		</Grid>
	</DataTemplate>
	<DataTemplate
		x:Key="AcpCheckBoxContentStyle">
		<TextBlock
			Margin="5,0,0,0"
			Text="{Binding}" />
	</DataTemplate>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{x:Null}"
		x:Key="UndoButton">
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Button, ResourceId={x:Static AcpUINS:AcpColorKeys.UndoButtonTempalte}}}" />
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{x:Null}"
		x:Key="RedoButton">
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Button, ResourceId={x:Static AcpUINS:AcpColorKeys.RedoButtonTempalte}}}" />
	</Style>
