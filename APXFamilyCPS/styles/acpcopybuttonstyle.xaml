<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib" xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer">
	<Style
		TargetType="{x:Type AcpUINS:AcpCopyButton}"
		x:Key="{x:Type AcpUINS:AcpCopyButton}">
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpCopyButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpCopyButtonInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=AreValuesEqual, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Content"
					Value="&lt;&lt;" />
				<Setter
					Property="IsEnabled"
					Value="True" />
			</DataTrigger>
			<DataTrigger
				Value="true"
				Binding="{Binding Path=AreValuesEqual, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type AcpUINS:AcpCopyButton}">
							<Border
								Name="Border"
								CornerRadius="0"
								BorderThickness="1"
								Background="{StaticResource NormalBrush}"
								BorderBrush="{StaticResource NormalBorderBrush}">
								<Image
									Name="CopyCheckMark"
									Source="../../icons/GreenCheckIcon.png" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="{x:Static AcpCommonLibNS:ApplicationMode.CodeplugConfigurationMode}"
						Binding="{Binding Source={x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}, Path=AppMode}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="{x:Static AcpCommonLibNS:ApplicationMode.CustomViewConfigurationMode}"
						Binding="{Binding Source={x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}, Path=AppMode}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=MyCompCtrl.IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="{x:Static AcpCommonLibNS:ApplicationMode.CodeplugComparisonMode}"
						Binding="{Binding Source={x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}, Path=AppMode}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="true"
						Binding="{Binding Path=MyCompCtrl.IsAcpVisible, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="{x:Static AcpCommonLibNS:ApplicationMode.CodeplugComparisonMode}"
						Binding="{Binding Source={x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}, Path=AppMode}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Visibility"
					Value="Hidden" />
			</MultiDataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
