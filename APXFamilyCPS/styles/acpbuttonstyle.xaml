<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type Button}"
		x:Key="{x:Type Button}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Border
						Name="rectangle"
						OpacityMask="#FF000000"
						BorderThickness="1"
						CornerRadius="2.252"
						Width="{TemplateBinding Width}"
						Height="{TemplateBinding Height}"
						Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonNormalBackground}}}">
						<UIElement.BitmapEffect>
							<DropShadowBitmapEffect
								Opacity="0.515" />
						</UIElement.BitmapEffect>
						<Border
							OpacityMask="#FF000000"
							RenderTransformOrigin="0.5,0.5"
							BorderThickness="1"
							Margin="2"
							CornerRadius="2.252"
							Background="{x:Null}"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonBorderBrush}}}">
							<TextBlock
								Name="Text_PART"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Text="{TemplateBinding Content}"
								Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonNormalForeground}}}" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True" />
						<Trigger
							Property="Button.IsDefaulted"
							Value="True" />
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="rectangle"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonHoverBackground}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="rectangle"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonPressedBackground}}}" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								TargetName="Text_PART"
								Property="Foreground"
								Value="{DynamicResource ResourceKey={x:Static SystemColors.GrayTextBrushKey}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type AcpUINS:AcpButton}"
		BasedOn="{StaticResource {x:Type Button}}"
		x:Key="{x:Type AcpUINS:AcpButton}">
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
