<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igEditors="http://infragistics.com/Editors" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
	<Style
		TargetType="{x:Type AcpUINS:AcpPasswordEyeBox}"
		x:Key="{x:Type AcpUINS:AcpPasswordEyeBox}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxForeground}}}" />
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{x:Static SystemColors.ControlBrush}" />
			</MultiDataTrigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type AcpUINS:AcpTablePasswordEyeBox}"
		x:Key="{x:Type AcpUINS:AcpTablePasswordEyeBox}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxBackground}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxForeground}}}" />
		<Setter
			Property="AcpUINS:AcpPasswordEyeBox.IsEyeVisible"
			Value="0" />
		<Style.Triggers>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="IsEnabled"
					Value="False" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}" />
				<Setter
					Property="Foreground"
					Value="{x:Static SystemColors.GrayTextBrush}" />
			</DataTrigger>
			<DataTrigger
				Value="false"
				Binding="{Binding Path=IsAcpVisible, RelativeSource={RelativeSource Self}}">
				<Setter
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpApplicable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpValid, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="false"
						Binding="{Binding Path=IsAcpEditable, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}" />
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}" />
			</MultiDataTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="UIElement.IsMouseOver"
						Value="true" />
					<Condition
						Property="AcpUINS:AcpPasswordEyeBox.IsAcpEditable"
						Value="true" />
					<Condition
						Property="AcpUINS:AcpPasswordEyeBox.IsAcpApplicable"
						Value="true" />
				</MultiTrigger.Conditions>
				<Setter
					Property="AcpUINS:AcpPasswordEyeBox.IsEyeVisible"
					Value="1" />
			</MultiTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
