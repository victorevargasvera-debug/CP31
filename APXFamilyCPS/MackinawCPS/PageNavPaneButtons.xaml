<Page
	x:Class="MackinawCPS.PageNavPaneButtons" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfRibbon;assembly=AcpWpfRibbon" xmlns:MackinawCPSNS="clr-namespace:MackinawCPS" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
	Title="{x:Static CommonResxNS:AppResources.PageNavPaneButtons_Id}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<MackinawCPSNS:NavigationButtonEnabledConverter
				x:Key="NavigationButtonEnabledConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel
		LastChildFill="True">
		<!--Unknown connection ID: 1-->
		<dc:NavigationPane
			Name="AppNavPane"
			DockPanel.Dock="Left"
			Background="{DynamicResource SilverGradBrush}"
			LargeItemsCount="0">
			<!--Unknown connection ID: 2-->
			<dc:PaneItem
				Name="ButtonHome"
				Header="{x:Static CommonResxNS:AcgResources.ID_HOME}"
				ImageSmall="{Binding Path=Image, RelativeSource={RelativeSource Self}}">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource NavigationButtonEnabledConverter}"
						ConverterParameter="ButtonHome">
						<Binding
							Path="CurrentAppMode" />
						<Binding
							Path="CpgOpenFlag" />
						<Binding
							Path="CustomViewOpenFlag" />
						<Binding
							Path="ReadWriteInProgress" />
					</MultiBinding>
				</UIElement.IsEnabled>
				<dc:PaneItem.Image>
					<Image
						Source="{StaticResource HomebaseImage}"
						Height="24"
						Width="24" />
				</dc:PaneItem.Image>
				<!--Unknown connection ID: 3-->
				<Frame
					Name="FrameHome"
					NavigationUIVisibility="Hidden" />
			</dc:PaneItem>
			<!--Unknown connection ID: 4-->
			<dc:PaneItem
				Name="ButtonCpgNav"
				Header="{x:Static CommonResxNS:AppResources.Codeplug_Configuration}"
				ImageSmall="{Binding Path=Image, RelativeSource={RelativeSource Self}}">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource NavigationButtonEnabledConverter}"
						ConverterParameter="ButtonCpgNav">
						<Binding
							Path="CurrentAppMode" />
						<Binding
							Path="CpgOpenFlag" />
						<Binding
							Path="CustomViewOpenFlag" />
						<Binding
							Path="ReadWriteInProgress" />
					</MultiBinding>
				</UIElement.IsEnabled>
				<dc:PaneItem.Image>
					<Image
						Source="{StaticResource CodeplugConfigImage}"
						Height="24"
						Width="24" />
				</dc:PaneItem.Image>
				<!--Unknown connection ID: 5-->
				<Frame
					Name="FrameCodeplug"
					NavigationUIVisibility="Hidden"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch" />
			</dc:PaneItem>
			<!--Unknown connection ID: 6-->
			<dc:PaneItem
				Name="ButtonCustomViewMode"
				Header="{x:Static CommonResxNS:AppResources.Custom_View_Configuration}"
				ImageSmall="{Binding Path=Image, RelativeSource={RelativeSource Self}}">
				<UIElement.IsEnabled>
					<MultiBinding
						Converter="{StaticResource NavigationButtonEnabledConverter}"
						ConverterParameter="ButtonCustomViewMode">
						<Binding
							Path="CurrentAppMode" />
						<Binding
							Path="CpgOpenFlag" />
						<Binding
							Path="CustomViewOpenFlag" />
						<Binding
							Path="ReadWriteInProgress" />
					</MultiBinding>
				</UIElement.IsEnabled>
				<dc:PaneItem.Image>
					<Image
						Source="{StaticResource CustomViewImage}"
						Height="24"
						Width="24" />
				</dc:PaneItem.Image>
				<!--Unknown connection ID: 7-->
				<Frame
					Name="FrameCustView"
					NavigationUIVisibility="Hidden" />
			</dc:PaneItem>
		</dc:NavigationPane>
	</DockPanel>
</Page>
