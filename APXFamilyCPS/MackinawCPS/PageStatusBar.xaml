<Page
	x:Class="MackinawCPS.PageStatusBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="Auto"
	Height="Auto" xmlns:mackinawcps="clr-namespace:MackinawCPS">
	<DockPanel>
		<StatusBar
			DockPanel.Dock="Bottom"
			MinHeight="25">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<DockPanel
						LastChildFill="True" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<StatusBarItem
				DockPanel.Dock="Left"
				Margin="5,0,0,0">
				<!--Unknown connection ID: 1-->
				<TextBlock
					Name="StatusText"
					Text="{Binding Path=Status}" />
			</StatusBarItem>
			<StatusBarItem
				DockPanel.Dock="Right"
				Margin="0,0,15,0">
				<!--Unknown connection ID: 2-->
				<TextBlock
					Name="CPSVersionText"
					Text="{Binding Path=CPSVersion}" />
			</StatusBarItem>
			<Separator
				DockPanel.Dock="Right" />
			<StatusBarItem
				DockPanel.Dock="Right">
				<!--Unknown connection ID: 3-->
				<TextBlock
					Name="SerialNumText"
					Text="{Binding Path=SerialNum}" />
			</StatusBarItem>
			<Separator
				DockPanel.Dock="Right" />
			<StatusBarItem
				DockPanel.Dock="Right">
				<!--Unknown connection ID: 4-->
				<TextBlock
					Name="ModelText"
					Text="{Binding Path=RadioModel}" />
			</StatusBarItem>
			<Separator
				DockPanel.Dock="Right" />
			<StatusBarItem
				DockPanel.Dock="Right">
				<!--Unknown connection ID: 5-->
				<ProgressBar
					Name="ProgBar"
					Width="100"
					Height="15"
					Visibility="Collapsed" />
			</StatusBarItem>
			<StatusBarItem />
		</StatusBar>
	</DockPanel>
</Page>
