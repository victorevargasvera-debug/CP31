			Color="#FFE3F5FD"
			Offset="0.07" />
		<GradientStop
			Color="#FFC1D9F3"
			Offset="0.096" />
		<GradientStop
			Color="#FF85AAC4"
			Offset="0.448" />
		<GradientStop
			Color="#FF648DAE"
			Offset="0.468" />
		<GradientStop
			Color="#FF07090B"
			Offset="0.984" />
		<GradientStop
			Color="#FFB2D4F0"
			Offset="0.004" />
		<GradientStop
			Color="#FF4288BA"
			Offset="0.828" />
	</LinearGradientBrush>
	<LinearGradientBrush
		EndPoint="0.640625,1.08108"
		StartPoint="0.640625,-0.0270241"
		x:Key="{ComponentResourceKey ResourceId=XamDataPresenterColHeaderHighlightBackground, TypeInTargetAssembly={x:Type Grid}}">
		<GradientStop
			Color="#FF4288BA"
			Offset="0.07" />
		<GradientStop
			Color="#FF648DAE"
			Offset="0.096" />
		<GradientStop
			Color="#FF85AAC4"
			Offset="0.448" />
		<GradientStop
			Color="#FFC1D9F3"
			Offset="0.468" />
		<GradientStop
			Color="#FFB2D4F0"
			Offset="0.984" />
		<GradientStop
			Color="#FF07090B"
			Offset="0.004" />
		<GradientStop
			Color="#FF4288BA"
			Offset="0.828" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#fefefe"
		x:Key="{ComponentResourceKey ResourceId=SCBHoverbrush, TypeInTargetAssembly={x:Type Thumb}}" />
	<SolidColorBrush
		Color="Gray"
		x:Key="{ComponentResourceKey ResourceId=SCBPressedbrush, TypeInTargetAssembly={x:Type Thumb}}" />
	<SolidColorBrush
		Color="LightGray"
		x:Key="{ComponentResourceKey ResourceId=SCBStandardBorderbrush, TypeInTargetAssembly={x:Type Thumb}}" />
	<SolidColorBrush
		Color="LightGray"
		x:Key="{ComponentResourceKey ResourceId=SCBStandardbrush, TypeInTargetAssembly={x:Type Thumb}}" />
