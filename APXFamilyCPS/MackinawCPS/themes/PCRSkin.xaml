<ResourceDictionary
	x:Class="MackinawCPS.themes.PCRSkin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:themes="clr-namespace:MackinawCPS.themes">
	<SolidColorBrush
		Color="#C8C8C8"
		x:Key="NormalBrush" />
	<SolidColorBrush
		Color="#828282"
		x:Key="{ComponentResourceKey ResourceId=FrameNormalFrameContentAreaBackgroundBackground, TypeInTargetAssembly={x:Type Frame}}" />
	<SolidColorBrush
		Color="#C8C8C8"
		x:Key="{ComponentResourceKey ResourceId=RMCFrameBackground, TypeInTargetAssembly={x:Type Frame}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId=ListViewItemNormalBackground, TypeInTargetAssembly={x:Type ListViewItem}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId=ListViewBoxNormalBackground, TypeInTargetAssembly={x:Type ListBox}}" />
	<SolidColorBrush
		Opacity="0.8"
		Color="White"
		x:Key="{ComponentResourceKey ResourceId=ListViewItemNormalForeground, TypeInTargetAssembly={x:Type ListViewItem}}" />
