		Opacity="0.8"
		Color="White"
		x:Key="{ComponentResourceKey ResourceId=ListViewItemIsSelectedForeground, TypeInTargetAssembly={x:Type ListViewItem}}" />
	<SolidColorBrush
		Opacity="0.8"
		Color="White"
		x:Key="{ComponentResourceKey ResourceId=RMCLabelForeground, TypeInTargetAssembly={x:Type Label}}" />
	<SolidColorBrush
		Opacity="0.8"
		Color="LightGray"
		x:Key="{ComponentResourceKey ResourceId=RMCLabelDisabledForeground, TypeInTargetAssembly={x:Type Label}}" />
