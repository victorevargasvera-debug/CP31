    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" />
    <section name="DiscoverySection" type="Motorola.Security.SamlTokenComponent.DiscoveryConfigSectionHandler, SamlTokenComponent" />
  </configSections>
  <certificates>
    <group type="client">
      <certificate StoreLocation="LocalMachine" StoreName="My" X509FindType="FindBySubjectName" Value="CommonCps256Client" />
      <certificate StoreLocation="LocalMachine" StoreName="My" X509FindType="FindBySubjectName" Value="CommonCpsClient" />
    </group>
    <group type="serverIdentity">
      <certificate StoreLocation="LocalMachine" StoreName="TrustedPeople" X509FindType="FindBySubjectName" Value="CommonCpsService" />
      <certificate StoreLocation="LocalMachine" StoreName="TrustedPeople" X509FindType="FindBySubjectName" Value="CommonCps256Service" />
    </group>
  </certificates>
  <TokenIssuerSection>
    <TokenIssuer authenticationMethod="Windows" address="https://localhost:443/RMIdP/windows" binding="ws2007HttpBinding" bindingConfiguration="stsBindingWin" />
    <TokenIssuer authenticationMethod="Certificate" address="https://localhost:443/RMIdP/certificate" binding="ws2007HttpBinding" bindingConfiguration="stsBindingCert" />
    <TokenIssuer authenticationMethod="UserName" address="https://localhost:443/RMIdP/username" binding="ws2007HttpBinding" bindingConfiguration="stsBindingUserName" />
  </TokenIssuerSection>
  <DiscoverySection>
    <DiscoveryEndpoint address="https://localhost:443/Discovery/Probe" binding="customBinding" bindingConfiguration="HttpBindingConfig" />
    <DiscoveryEndpoint address="net.pipe://localhost/Discovery/Probe" binding="netNamedPipeBinding" bindingConfiguration="namedPipeBindingConfig" />
  </DiscoverySection>
  <appSettings>
    <add key="HelpCacheFolder" value="ApxFamilyCPS" />
    <add key="HelpRootDir" value="Help\en\" />
    <add key="TutorialRootDir" value="zzTutorials\" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="JobDelayTime" value="0" />
    <add key="FederatedEndpointName" value="FederatedEndpoint" />
    <add key="FederatedStreamedEndpointName" value="FederatedStreamedEndpoint" />
    <add key="LocalEndpointName" value="LocalEndpoint" />
    <add key="DataRetrievalPageSize" value="100" />
    <add key="FederatedWebsocketEndpointName" value="FederatedWebsocketEndpoint" />
  </appSettings>
