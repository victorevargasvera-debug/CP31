											<DiscreteObjectKeyFrame
												KeyTime="0"
												Value="{StaticResource MouseOverGroupTitleBackgroundBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Pressed" />
								<VisualState
									x:Name="Disabled" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Path
							Name="path"
							Width="6"
							Height="10"
							Data="M0,10 C0,10 0,0 0,0 C0,0 2,0 2,0 C2,0 2,1 2,1 C2,1 3,1 3,1 C3,1 3,2 3,2 C3,2 4,2 4,2 C4,2 4,3 4,3 C4,3 5,3 5,3 C5,3 5,4 5,4 C5,4 6,4 6,4 C6,4 6,6 6,6 C6,6 5,6 5,6 C5,6 5,7 5,7 C5,7 4,7 4,7 C4,7 4,8 4,8 C4,8 3,8 3,8 C3,8 3,9 3,9 C3,9 2,9 2,9 C2,9 2,10 2,10 C2,10 0,10 0,10"
							Stretch="Fill"
							StrokeThickness="1"
							Fill="{StaticResource NavGlyphFill}"
							Stroke="{StaticResource Brush_003}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
