<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igwindows="http://infragistics.com/Windows" xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors" xmlns:luna="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:igThemes="http://infragistics.com/Themes" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="EditorsLunaNormal_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<SolidColorBrush
		x:Freeze="true"
		Color="#FFFFFF"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorBackgroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#CCCCCC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorBorderBrushKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#666666"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorForegroundKey}" />
	<CornerRadius
		x:Freeze="true"
		TopLeft="0"
		TopRight="0"
		BottomRight="0"
		BottomLeft="0"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorCornerRadiusKey}" />
	<Thickness
		x:Freeze="true"
		Left="1"
		Top="1"
		Right="1"
		Bottom="1"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorBorderThicknessKey}" />
	<Thickness
		x:Freeze="true"
		Left="1"
		Top="1"
		Right="1"
		Bottom="1"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorMarginKey}" />
	<Thickness
		x:Freeze="true"
		Left="5"
		Top="3"
		Right="5"
		Bottom="3"
		x:Key="{x:Static igEditors:EditorsBrushKeys.TextEditorPaddingKey}" />
	<LinearGradientBrush
		x:Freeze="true"
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemHoverFillKey}">
		<GradientStop
			Color="#FFF6FCFF"
			Offset="0" />
		<GradientStop
			Color="#FFEAF7FF"
			Offset="1" />
	</LinearGradientBrush>
	<LinearGradientBrush
		x:Freeze="true"
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemSelectedFillKey}">
		<GradientStop
			Color="#FFF7FCFE"
			Offset="0" />
		<GradientStop
			Color="#FFD6F0FD"
			Offset="1" />
	</LinearGradientBrush>
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF0066CC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemHoverForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FFDAF2FC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemHoverOuterBorderFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF9ADFFE"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemSelectedOuterBorderFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF0066CC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarDayTodayOuterBorderFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF0066CC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarDayTodayForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF0066CC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemSelectedForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#00000000"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarDayTodayFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#72FFFFFF"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemInnerBorderFillKey}" />
	<LinearGradientBrush
		x:Freeze="true"
		EndPoint="0.5,1"
		StartPoint="0.5,0"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarNavGlyphFillKey}">
		<GradientStop
			Color="#FF3B3B3B"
			Offset="0" />
		<GradientStop
			Color="#FF0B0B0B"
			Offset="1" />
	</LinearGradientBrush>
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF0066CC"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarNavGlyphHoverFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FFF5F5F5"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarSeparatorStrokeKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF000000"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarDayOfWeekForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#006FA1D9"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemGroupTitleBackgroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FF000000"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemGroupTitleForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#00000000"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="#FFB3B3B3"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarOtherDayForegroundKey}" />
	<SolidColorBrush
		x:Freeze="true"
		Color="Transparent"
		x:Key="{x:Static igEditors:EditorsBrushKeys.CalendarItemGroupTitleBackgroundHoverKey}" />
</ResourceDictionary>
