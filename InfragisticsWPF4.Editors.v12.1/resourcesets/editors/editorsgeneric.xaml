<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igWindows="http://infragistics.com/Windows" xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors" xmlns:luna="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:igThemes="clr-namespace:Infragistics.Windows.Themes" xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="../EditorsBrushes/EditorsGeneric_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<igWindows:BoolToHiddenConverter
		x:Key="BoolToHidden" />
	<igEditors:DayOfWeekToStringConverter
		x:Key="DayOfWeekToStr" />
	<igWindows:StringFormatConverter
		x:Key="StrFormatConv" />
	<igWindows:FormattableToStringConverter
		x:Key="FormattableToStr" />
	<igEditors:HorizontalToTextAlignmentConverter
		x:Key="horizToTextAlignmentConverter" />
	<igWindows:NullToFalseConverter
		x:Key="nullToFalseConverter" />
	<igWindows:TypeCheckConverter
		x:Key="typeCheckConverter" />
	<igWindows:NullToParameterConverter
		x:Key="nullToParameterConverter" />
	<igWindows:BoolToValueConverter
		x:Key="complementConverter">
		<igWindows:BoolToValueConverter.TrueConvertValue>
			<sys:Boolean>False</sys:Boolean>
		</igWindows:BoolToValueConverter.TrueConvertValue>
		<igWindows:BoolToValueConverter.FalseConvertValue>
			<sys:Boolean>True</sys:Boolean>
		</igWindows:BoolToValueConverter.FalseConvertValue>
	</igWindows:BoolToValueConverter>
	<Style
		TargetType="{x:Type Button}"
		x:Key="BorderlessButtonStyle">
		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Border
						Background="#00FFFFFF">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type RepeatButton}"
		x:Key="spinButtonStyle">
		<Setter
			Property="Background"
			Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalCenterFillKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalOuterBorderFillKey}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="3,1" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RepeatButton}">
					<Border
						Name="Bd"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource igEditors:EditorsBrushKeys.SpinButtonCornerRadiusKey}">
						<Grid>
							<Border
								Name="innerBd"
								BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalInnerBorderFillKey}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource igEditors:EditorsBrushKeys.SpinButtonCornerRadiusKey}" />
							<ContentPresenter
								Name="ContentPresenter"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								Margin="{TemplateBinding Padding}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="innerBd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="Bd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="Bd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="Bd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnPressedOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="Bd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnPressedCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="innerBd"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnPressedInnerBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								TargetName="ContentPresenter"
								Property="UIElement.Opacity"
								Value="0.25" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<DataTemplate
		x:Key="{x:Static igEditors:EditorsBrushKeys.IncreaseGlyphKey}">
		<Path
			Width="7"
			Height="4"
			Data="M0,3 C0,3 0,4 0,4 C0,4 3,4 3,4 C3,4 3,3 3,3 C3,3 4,3 4,3 C4,3 4,4 4,4 C4,4 7,4 7,4 C7,4 7,3 7,3 C7,3 6,3 6,3 C6,3 6,2 6,2 C6,2 5,2 5,2 C5,2 5,1 5,1 C5,1 4,1 4,1 C4,1 4,0 4,0 C4,0 3,0 3,0 C3,0 3,1 3,1 C3,1 2,1 2,1 C2,1 2,2 2,2 C2,2 1,2 1,2 C1,2 1,3 1,3 C1,3 0,3 0,3"
			Fill="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}" />
	</DataTemplate>
	<DataTemplate
		x:Key="{x:Static igEditors:EditorsBrushKeys.DecreaseGlyphKey}">
		<Path
			Width="7"
			Height="4"
			Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1"
			Fill="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}" />
	</DataTemplate>
	<Style
		TargetType="{x:Type igEditors:XamMaskedEditor}"
		x:Key="XamMaskedEditorBaseStyle">
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="2" />
		<Setter
			Property="Margin"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="igEditors:XamMaskedEditor.SpinButtonStyle"
			Value="{StaticResource spinButtonStyle}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMaskedEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel>
							<Grid
								Name="PART_SpinButtons"
								DockPanel.Dock="Right"
								Visibility="{TemplateBinding igEditors:SpinButtonVisibilityResolved}"
								Margin="0,1">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="*" />
									<RowDefinition
										Height="1" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>
								<RepeatButton
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									IsHitTestVisible="False"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.IncreaseGlyphKey}" />
								<RepeatButton
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									IsHitTestVisible="False"
									Grid.Row="2"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.DecreaseGlyphKey}" />
							</Grid>
							<igWindows:SimpleTextBlock
								Name="TextBlock"
								Margin="{TemplateBinding Padding}"
								Text="{TemplateBinding igEditors:DisplayText}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:ValueEditor.IsEmbedded"
							Value="False">
							<Setter
								Property="Padding"
								Value="4,2,4,2" />
							<Setter
								Property="igWindows:SimpleTextBlock.OptimizeWidthMeasurement"
								Value="False" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="igEditors:ValueEditor.EditTemplate">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:XamMaskedEditor}">
					<Border
						Name="MainBorder"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel>
							<Grid
								Name="PART_SpinButtons"
								DockPanel.Dock="Right"
								Visibility="{TemplateBinding igEditors:SpinButtonVisibilityResolved}"
								Margin="0,1">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="*" />
									<RowDefinition
										Height="1" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>
								<RepeatButton
									Name="spinUp"
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.IncreaseGlyphKey}" />
								<RepeatButton
									Name="spinDown"
									Style="{TemplateBinding igEditors:SpinButtonStyle}"
									Focusable="False"
									Grid.Row="2"
									ContentTemplate="{DynamicResource igEditors:EditorsBrushKeys.DecreaseGlyphKey}" />
							</Grid>
							<igWindows:CardPanel
								Name="PART_FocusSite">
								<igEditors:SectionsList
									Name="SectionsList"
									Margin="{TemplateBinding Padding}"
									Foreground="{TemplateBinding Foreground}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									FlowDirection="LeftToRight"
									InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
									InputMethod.IsInputMethodEnabled="{TemplateBinding IsInputMethodEnabled}"
									ItemsSource="{Binding Path=Sections, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
								<TextBox
									Name="PART_InputTextBox"
									Visibility="Collapsed"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Background="#00FFFFFF"
									BorderBrush="#00FFFFFF"
									BorderThickness="0,0,0,0"
									Foreground="{TemplateBinding Foreground}"
									InputMethod.PreferredImeState="{TemplateBinding PreferredImeState}"
									TextAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource horizToTextAlignmentConverter}}" />
							</igWindows:CardPanel>
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:XamMaskedEditor.SpinButtonVisibilityResolved"
							Value="Visible">
							<Setter
								TargetName="spinUp"
								Value="{x:Static igEditors:MaskedEditorCommands.SpinUp}"
								Property="Command" />
							<Setter
								TargetName="spinDown"
								Value="{x:Static igEditors:MaskedEditorCommands.SpinDown}"
								Property="Command" />
						</Trigger>
						<Trigger
							Property="igEditors:ValueEditor.IsEmbedded"
							Value="False" />
						<Trigger
							Property="igEditors:ValueEditor.IsInEditMode"
							Value="True">
							<Setter
								Property="IsTabStop"
								Value="False" />
						</Trigger>
						<Trigger
							Property="igEditors:XamMaskedEditor.IsTextBoxEntryEnabled"
							Value="True">
							<Setter
								TargetName="SectionsList"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="PART_InputTextBox"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="True">
				<Setter
					Property="BorderThickness"
					Value="0" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{x:Null}" />
				<Setter
					Property="BorderBrush"
					Value="{x:Null}" />
			</MultiTrigger>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="False">
				<Setter
					Property="Foreground"
					Value="{DynamicResource SystemColors.WindowTextBrushKey}" />
			</Trigger>
			<Trigger
				Property="igEditors:ValueEditor.IsInEditMode"
				Value="True">
				<Setter
					Property="FrameworkElement.FocusVisualStyle">
					<Setter.Value>
						<Style />
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorBorderBrushKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CheckBoxNormalOuterBoxCenterFillKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorForegroundKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamMaskedEditor}"
		BasedOn="{StaticResource XamMaskedEditorBaseStyle}"
		x:Key="{x:Type igEditors:XamMaskedEditor}" />
	<Style
		TargetType="{x:Type igEditors:DisplayCharacterPresenter}"
		x:Key="{x:Type igEditors:DisplayCharacterPresenter}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:DisplayCharacterPresenter}">
					<Grid>
						<TextBlock
							Name="TextBlock"
							Margin="0,0,0,0"
							Text="{Binding Path=DisplayCharacter.DrawString, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
							Visibility="{Binding Path=DisplayCharacter.Visibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
						<Rectangle
							Name="SelectionRect"
							Margin="0,0,0,0"
							Fill="{DynamicResource SystemColors.HighlightBrushKey}"
							Opacity="0.5"
							IsHitTestVisible="False"
							Visibility="{Binding Path=DrawAsSelected, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToHidden}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:SectionPresenter}"
		x:Key="{x:Type igEditors:SectionPresenter}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:SectionPresenter}">
					<igEditors:DisplayCharactersList
						ItemsSource="{Binding Path=Section.DisplayChars, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:DisplayCharactersList}"
		x:Key="{x:Type igEditors:DisplayCharactersList}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:DisplayCharactersList}">
					<StackPanel
						IsItemsHost="True"
						Orientation="Horizontal" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:SectionsList}"
		x:Key="{x:Type igEditors:SectionsList}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:SectionsList}">
					<ScrollViewer
						Focusable="False"
						HorizontalScrollBarVisibility="Hidden"
						VerticalScrollBarVisibility="Hidden">
						<StackPanel
							IsItemsHost="True"
							Orientation="Horizontal" />
					</ScrollViewer>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CaretElement}"
		x:Key="{x:Type igEditors:CaretElement}">
		<Setter
			Property="Background"
			Value="#FF000000" />
		<Setter
			Property="Width"
			Value="{DynamicResource SystemParameters.CaretWidthKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CaretElement}">
					<Rectangle
						Fill="{TemplateBinding Background}" />
					<ControlTemplate.Triggers>
						<EventTrigger
							RoutedEvent="FrameworkElement.Loaded">
							<EventTrigger.Actions>
								<BeginStoryboard
									Name="BlinkStoryboard">
									<Storyboard>
										<BooleanAnimationUsingKeyFrames
											Storyboard.TargetProperty="BlinkVisibility"
											Duration="{x:Static igEditors:CaretElement.CaretBlinkDuration}"
											RepeatBehavior="Forever">
											<DiscreteBooleanKeyFrame
												Value="True"
												KeyTime="0%" />
											<DiscreteBooleanKeyFrame
												Value="False"
												KeyTime="50%" />
											<DiscreteBooleanKeyFrame
												Value="True"
												KeyTime="100%" />
										</BooleanAnimationUsingKeyFrames>
									</Storyboard>
								</BeginStoryboard>
							</EventTrigger.Actions>
						</EventTrigger>
						<EventTrigger
							RoutedEvent="igEditors:CaretElement.ResetBlinking">
							<EventTrigger.Actions>
								<SeekStoryboard
									BeginStoryboardName="BlinkStoryboard"
									Origin="BeginTime" />
							</EventTrigger.Actions>
						</EventTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:XamNumericEditor}"
		BasedOn="{StaticResource {x:Type igEditors:XamMaskedEditor}}"
		x:Key="{x:Type igEditors:XamNumericEditor}" />
	<Style
		TargetType="{x:Type igEditors:XamCurrencyEditor}"
		BasedOn="{StaticResource {x:Type igEditors:XamMaskedEditor}}"
		x:Key="{x:Type igEditors:XamCurrencyEditor}" />
	<Style
		TargetType="{x:Type ToggleButton}"
		x:Key="ComboEditor_DropDownButtonStyle">
		<Setter
			Property="MinWidth"
			Value="0" />
		<Setter
			Property="MinHeight"
			Value="0" />
		<Setter
			Property="Width"
			Value="Auto" />
		<Setter
			Property="Height"
			Value="Auto" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="ButtonBase.ClickMode"
			Value="Press" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ToggleButton}">
					<Grid
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto"
								SharedSizeGroup="ComboBoxButton" />
						</Grid.ColumnDefinitions>
						<Grid
							Name="ComboEditorDropdown"
							HorizontalAlignment="Right"
							Background="#00FFFFFF"
							Column="1"
							Width="15"
							Margin="0,1,1,1">
							<Border
								Name="OuterBorder_Center"
								SnapsToDevicePixels="True"
								BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalOuterBorderFillKey}"
								BorderThickness="1"
								Background="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalCenterFillKey}"
								CornerRadius="2" />
							<Border
								Name="InnerBorder"
								SnapsToDevicePixels="True"
								Margin="1,1,1,1"
								BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnNormalInnerBorderFillKey}"
								BorderThickness="1"
								CornerRadius="2" />
						</Grid>
						<Grid
							Name="glyphArrow"
							Column="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Width="9"
							Height="6"
							Margin="0,0,1,0">
							<Path
								Name="glyph"
								HorizontalAlignment="Stretch"
								Width="6"
								RenderTransformOrigin="0,0"
								SnapsToDevicePixels="True"
								Fill="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}"
								Stretch="Fill"
								Data="M4,0 L6,0 L6,6 L6,6 L6,6 L0,6 L0,4 L4,4 L4,0"
								Height="6"
								Margin="0,-5,-6,0">
								<UIElement.RenderTransform>
									<TransformGroup>
										<ScaleTransform
											ScaleX="1"
											ScaleY="1" />
										<SkewTransform
											AngleX="0"
											AngleY="0" />
										<RotateTransform
											Angle="45" />
										<TranslateTransform
											X="0"
											Y="0" />
									</TransformGroup>
								</UIElement.RenderTransform>
							</Path>
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="FrameworkElement.Tag"
							Value="MouseOverControlTrue">
							<Setter
								TargetName="InnerBorder"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="OuterBorder_Center"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="OuterBorder_Center"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="True">
							<Setter
								TargetName="OuterBorder_Center"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnPressedOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="OuterBorder_Center"
								Value="{DynamicResource igEditors:EditorsBrushKeys.DropdownBtnPressedCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="InnerBorder"
