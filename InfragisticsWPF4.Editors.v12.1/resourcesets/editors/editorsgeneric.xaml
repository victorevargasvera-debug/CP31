	<Style
		TargetType="{x:Type igEditors:CalendarItemGroupTitle}"
		x:Key="CalendarItemGroupTitleBase">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
						VerticalAlignment="{TemplateBinding VerticalAlignment}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}">
						<DockPanel
							Grid.Row="0"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							LastChildFill="True">
							<RepeatButton
								Name="previousMonth"
								DockPanel.Dock="Left"
								Focusable="False"
								Command="{x:Static igEditors:MonthCalendarCommands.ScrollPreviousGroup}"
								Style="{DynamicResource igEditors:XamMonthCalendar.ScrollPreviousRepeatButtonStyleKey}"
								Visibility="{Binding Path=ScrollPreviousButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}">&lt;</RepeatButton>
							<RepeatButton
								Name="nextMonth"
								DockPanel.Dock="Right"
								Focusable="False"
								Command="{x:Static igEditors:MonthCalendarCommands.ScrollNextGroup}"
								Style="{DynamicResource igEditors:XamMonthCalendar.ScrollNextRepeatButtonStyleKey}"
								Visibility="{Binding Path=ScrollNextButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}">&gt;</RepeatButton>
							<Button
								Name="headerContent"
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								Focusable="False"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								Command="{x:Static igEditors:MonthCalendarCommands.ZoomOutCalendarMode}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Content="{TemplateBinding Content}"
								Style="{StaticResource BorderlessButtonStyle}"
								CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type igEditors:CalendarItemGroup}}}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							SourceName="headerContent"
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarNavGlyphHoverFillKey}"
								Property="Foreground" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Background"
			Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemGroupTitleBackgroundKey}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource igEditors:EditorsBrushKeys.CalendarItemGroupTitleForegroundKey}" />
		<Setter
			Property="Padding"
			Value="0,0,0,0" />
	</Style>
