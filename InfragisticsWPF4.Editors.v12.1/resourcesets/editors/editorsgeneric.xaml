	<Style
		TargetType="{x:Type igEditors:CalendarItemGroup}"
		x:Key="{x:Type igEditors:CalendarItemGroup}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="igEditors:CalendarItemGroup.ScrollNextButtonVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemGroup.ScrollPreviousButtonVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).ScrollButtonVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemGroup}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True"
						Padding="{TemplateBinding Padding}">
						<DockPanel
							LastChildFill="True"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<igEditors:CalendarItemGroupTitle
								Name="groupTitle"
								DockPanel.Dock="Top" />
							<igEditors:CalendarItemAreaPanel />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Days">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding Path=FirstDateOfGroup, RelativeSource={x:Static RelativeSource.TemplatedParent}, ConverterParameter=y, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Months">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{Binding Path=FirstDateOfGroup, RelativeSource={x:Static RelativeSource.TemplatedParent}, ConverterParameter=yyyy, Converter={StaticResource FormattableToStr}}" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Years">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Decades">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.CurrentCalendarMode"
							Value="Centuries">
							<Setter
								TargetName="groupTitle"
								Property="Content">
								<Setter.Value>
									<MultiBinding
										ConverterParameter="{}{0:yyyy}-{1:yyyy}"
										Converter="{StaticResource StrFormatConv}">
										<Binding
											Path="FirstDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
										<Binding
											Path="LastDateOfGroup"
											RelativeSource="{x:Static RelativeSource.TemplatedParent}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemGroup.FirstDateOfGroup"
							Value="{x:Null}">
							<Setter
								TargetName="groupTitle"
								Property="Content"
								Value="{x:Null}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igEditors:CalendarItemArea}"
		x:Key="CalendarItemAreaBase">
		<Setter
			Property="igEditors:CalendarItemArea.DayOfWeekHeaderVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DayOfWeekHeaderVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="igEditors:CalendarItemArea.WeekNumberVisibility"
			Value="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).WeekNumberVisibility, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igEditors:CalendarItemArea}">
					<AdornerDecorator>
						<Border
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True"
							Padding="{TemplateBinding Padding}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<ItemsControl
									Name="daysOfWeek"
									Grid.Column="1"
									Visibility="{TemplateBinding igEditors:DayOfWeekHeaderVisibility}"
									Focusable="False"
									Background="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}"
									ItemsSource="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												Rows="1"
												p19:Columns="{Binding Path=(igEditors:XamMonthCalendar.MonthCalendar).DaysOfWeek.Count, RelativeSource={x:Static RelativeSource.TemplatedParent}}" xmlns:p19="http://schemas.infragistics.com/xaml/primitives" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<igEditors:CalendarDayOfWeek
												DataContext="{Binding}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<igWindows:CardPanel
									Name="weekNumbers"
									Grid.Column="0"
									Grid.Row="1"
									Visibility="{TemplateBinding igEditors:WeekNumberVisibility}">
									<igEditors:CalendarWeekNumber
										DataContext="52"
										Visibility="Hidden"
										IsHitTestVisible="False" />
									<ItemsControl
										Name="weekNumberItems"
										Focusable="False"
										Background="{DynamicResource igEditors:EditorsBrushKeys.CalendarDayOfWeekFillKey}"
										ItemsSource="{Binding Path=WeekNumbers, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<igWindows:UniformGridEx
													p20:Rows="6"
													p20:Columns="1"
													p20:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}" xmlns:p20="http://schemas.infragistics.com/xaml/primitives" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<igEditors:CalendarWeekNumber
													DataContext="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</igWindows:CardPanel>
								<ItemsControl
									Name="itemsList"
									Grid.Column="1"
									Grid.Row="1"
									KeyboardNavigation.DirectionalNavigation="None"
									Focusable="False"
									BorderBrush="{DynamicResource igEditors:EditorsBrushKeys.CalendarSeparatorStrokeKey}"
									BorderThickness="0"
									ItemsSource="{Binding Path=Items, RelativeSource={x:Static RelativeSource.TemplatedParent}}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<igWindows:UniformGridEx
												p19:FirstColumn="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemColumnOffset, RelativeSource={x:Static RelativeSource.Self}}"
												p19:FirstRow="{Binding Path=(igEditors:CalendarItemArea.ItemArea).FirstItemRowOffset, RelativeSource={x:Static RelativeSource.Self}}"
												p19:Rows="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemRows, RelativeSource={x:Static RelativeSource.Self}}"
												p19:Columns="{Binding Path=(igEditors:CalendarItemArea.ItemArea).ItemColumns, RelativeSource={x:Static RelativeSource.Self}}" xmlns:p19="http://schemas.infragistics.com/xaml/primitives" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
							</Grid>
						</Border>
					</AdornerDecorator>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igEditors:CalendarItemArea.DayOfWeekHeaderVisibility"
							Value="Visible">
							<Setter
								TargetName="itemsList"
								Property="BorderThickness"
								Value="0,1,0,0" />
						</Trigger>
						<Trigger
							Property="igEditors:CalendarItemArea.WeekNumberVisibility"
							Value="Visible">
							<Setter
								TargetName="itemsList"
								Property="BorderThickness"
								Value="1,0,0,0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igEditors:CalendarItemArea.DayOfWeekHeaderVisibility"
									Value="Visible" />
								<Condition
									Property="igEditors:CalendarItemArea.WeekNumberVisibility"
									Value="Visible" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="itemsList"
								Property="BorderThickness"
								Value="1,1,0,0" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
