<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igWindows="http://infragistics.com/Windows" xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors" xmlns:luna="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:igThemes="clr-namespace:Infragistics.Windows.Themes" xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="EditorsGeneric.xaml" />
		<ResourceDictionary
			Source="../EditorsBrushes/EditorsIGTheme_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		TargetType="{x:Type Button}"
		x:Key="BorderlessButtonStyle">
		<Setter
			Property="FrameworkElement.OverridesDefaultStyle"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Border
						Background="{StaticResource Brush_1000}">
						<ContentPresenter
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Margin="{TemplateBinding Padding}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		BasedOn="{x:Static igThemes:EditorsGeneric.XamMaskedEditor}"
		TargetType="{x:Type igEditors:XamMaskedEditor}"
		x:Key="{x:Type igEditors:XamMaskedEditor}">
		<Style.Triggers>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="True">
				<Setter
					Property="Background"
					Value="{StaticResource Brush_1001}" />
				<Setter
					Property="BorderBrush"
					Value="{StaticResource Brush_1002}" />
				<Setter
					Property="Padding"
					Value="2" />
				<Setter
					Property="BorderThickness"
					Value="0" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{StaticResource Brush_1003}" />
				<Setter
					Property="BorderBrush"
					Value="{StaticResource Brush_1004}" />
				<Setter
					Property="Padding"
					Value="2" />
				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
		</Style.Triggers>
	</Style>
