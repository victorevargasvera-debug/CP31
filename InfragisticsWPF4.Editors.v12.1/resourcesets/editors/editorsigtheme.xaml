						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{StaticResource Brush_1015}" />
				<Setter
					Property="BorderBrush"
					Value="{StaticResource Brush_1016}" />
				<Setter
					Property="Padding"
					Value="2" />
				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
		</Style.Triggers>
