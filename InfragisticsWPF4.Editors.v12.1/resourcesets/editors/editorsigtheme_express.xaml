<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igwindows="http://infragistics.com/Windows" xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors" xmlns:luna="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:igThemes="clr-namespace:Infragistics.Windows.Themes" xmlns:themesEd="clr-namespace:Infragistics.Windows.Themes">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="EditorsGeneric_Express.xaml" />
		<ResourceDictionary
			Source="../EditorsBrushes/EditorsIGTheme_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		BasedOn="{x:Static igThemes:EditorsGeneric.XamTextEditor}"
		TargetType="{x:Type igEditors:XamTextEditor}"
		x:Key="{x:Type igEditors:XamTextEditor}">
		<Style.Triggers>
			<Trigger
				Property="igEditors:ValueEditor.IsEmbedded"
				Value="True">
				<Setter
					Property="Background"
					Value="{StaticResource Brush_2000}" />
				<Setter
					Property="BorderBrush"
					Value="{StaticResource Brush_2001}" />
				<Setter
					Property="Padding"
					Value="2" />
				<Setter
					Property="BorderThickness"
					Value="0" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="igEditors:ValueEditor.IsEmbedded"
						Value="True" />
					<Condition
						Property="igEditors:ValueEditor.IsInEditMode"
						Value="True" />
				</MultiTrigger.Conditions>
				<Setter
					Property="Background"
					Value="{StaticResource Brush_2002}" />
				<Setter
					Property="BorderBrush"
					Value="{StaticResource Brush_2003}" />
				<Setter
					Property="Padding"
					Value="2" />
				<Setter
					Property="BorderThickness"
					Value="0" />
			</MultiTrigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorBorderBrushKey}" />
				<Setter
					Property="Background"
					Value="{DynamicResource igEditors:EditorsBrushKeys.CheckBoxNormalOuterBoxCenterFillKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource igEditors:EditorsBrushKeys.TextEditorForegroundKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
