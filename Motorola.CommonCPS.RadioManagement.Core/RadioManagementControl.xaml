<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Core.RadioManagementControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:prism="http://www.codeplex.com/prism" xmlns:igDock="http://infragistics.com/DockManager" xmlns:igWindows="http://infragistics.com/Windows" xmlns:astroSystem="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTROSystem;assembly=Motorola.CommonCPS.RadioManagement.ASTROSystem" xmlns:astroDataProfile="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTRODataProfile;assembly=Motorola.CommonCPS.RadioManagement.ASTRODataProfile" xmlns:astroOtarProfile="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTROOtarProfile;assembly=Motorola.CommonCPS.RadioManagement.ASTROOtarProfile" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common;assembly=Motorola.CommonCPS.RadioManagement.Common" xmlns:oauthOidc="clr-namespace:Motorola.CommonCPS.RadioManagement.OAuthOpenIDConnect;assembly=Motorola.CommonCPS.RadioManagement.OAuthOpenIDConnect" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:radio="clr-namespace:Motorola.CommonCPS.RadioManagement.Radio;assembly=Motorola.CommonCPS.RadioManagement.Radio" xmlns:template="clr-namespace:Motorola.CommonCPS.RadioManagement.Template;assembly=Motorola.CommonCPS.RadioManagement.Template" xmlns:rr="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Core" xmlns:clr="clr-namespace:System;assembly=mscorlib"
	Name="uscCore"
	SnapsToDevicePixels="True"
	UseLayoutRounding="True">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:QueryToPaneHeaderConverter
				x:Key="QueryToPaneHeaderConverter" />
			<BooleanToVisibilityConverter
				x:Key="BoolToVisConverter" />
			<converters:AstroPcrSystemNameConverter
				x:Key="AstroPcrSystemNameConverter" />
			<clr:String
				x:Key="AstroPcrSystemModuleName">System</clr:String>
			<ControlTemplate
				TargetType="{x:Type igDock:PaneHeaderPresenter}"
				x:Key="Template4PaneHeaderPresenterRemoveActiveBackground">
				<Grid>
					<Border
						Background="{TemplateBinding Background}"
						SnapsToDevicePixels="True"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel
							Margin="{TemplateBinding Padding}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<Button
								Name="closeBtn"
								DockPanel.Dock="Right"
								Command="{x:Static igDock:ContentPaneCommands.Close}"
								CommandParameter="{TemplateBinding igDock:Pane}"
								Style="{StaticResource {x:Static igDock:PaneHeaderPresenter.CloseButtonStyleKey}}"
								Visibility="{Binding Path=Pane.CloseButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
							<Button
								Name="unpinBtn"
								DockPanel.Dock="Right"
								Command="{x:Static igDock:ContentPaneCommands.TogglePinnedState}"
								CommandParameter="{TemplateBinding igDock:Pane}"
								Style="{StaticResource {x:Static igDock:PaneHeaderPresenter.PinButtonStyleKey}}"
								Visibility="{Binding Path=Pane.PinButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
							<Menu
								Name="positionMenu"
								DockPanel.Dock="Right"
								Style="{StaticResource RootMenuStyle}"
								Visibility="{Binding Path=Pane.WindowPositionMenuVisibility, RelativeSource={RelativeSource TemplatedParent}}">
								<MenuItem
									Name="PART_PositionMenuItem"
									Style="{StaticResource {x:Static igDock:PaneHeaderPresenter.PositionMenuItemStyleKey}}" />
							</Menu>
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</DockPanel>
					</Border>
					<Border
						Name="innerBorderHighlight"
						BorderThickness="1,1,1,0"
						BorderBrush="{StaticResource {x:Static igDock:DockManagerBrushKeys.PaneNotActiveCaptionInnerBorderFillKey}}" />
				</Grid>
				<ControlTemplate.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding Path=Pane.IsActivePane, RelativeSource={x:Static RelativeSource.Self}}">
						<Setter
							TargetName="innerBorderHighlight"
							Property="BorderBrush"
							Value="{StaticResource {x:Static igDock:DockManagerBrushKeys.PaneActiveCaptionInnerBorderFillKey}}" />
					</DataTrigger>
					<Trigger
						Property="igDock:XamDockManager.PaneLocation"
						Value="FloatingOnly">
						<Setter
							TargetName="unpinBtn"
							Property="Visibility"
							Value="Collapsed" />
					</Trigger>
					<Trigger
						Property="igDock:XamDockManager.PaneLocation"
						Value="Floating">
						<Setter
							TargetName="unpinBtn"
							Property="Visibility"
							Value="Collapsed" />
					</Trigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition
								Value="True"
								Binding="{Binding Path=Pane.IsProvidingFloatingWindowCaption, RelativeSource={x:Static RelativeSource.Self}}" />
							<Condition
								Value="Minimized"
								Binding="{Binding Path=(igWindows:ToolWindow.ToolWindow).WindowState, RelativeSource={x:Static RelativeSource.Self}}" />
						</MultiDataTrigger.Conditions>
						<Setter
							TargetName="closeBtn"
							Property="VerticalAlignment"
							Value="Center" />
						<Setter
							TargetName="unpinBtn"
							Property="VerticalAlignment"
							Value="Center" />
						<Setter
							TargetName="positionMenu"
							Property="VerticalAlignment"
							Value="Center" />
						<Setter
							TargetName="positionMenu"
							Property="Visibility"
							Value="Collapsed" />
					</MultiDataTrigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
