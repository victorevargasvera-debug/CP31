	<Grid
		Background="{StaticResource MainWindowBackgroundColor}">
		<Grid
			IsEnabled="{Binding MainViewEnable}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="15" />
				<RowDefinition />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<!--Unknown connection ID: 2-->
			<ContentControl
				Name="ctcNavigation"
				BorderBrush="#00FFFFFF"
				prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.NavigationRegion}"
				Margin="15,15,15,0" />
			<!--Unknown connection ID: 3-->
			<igDock:XamDockManager
				Name="dmgDockManager"
				Grid.Row="2"
				FlyoutAnimation="None"
				Background="#00FFFFFF"
				Margin="10,0,10,0"
				Theme="IGTheme"
				UnpinnedTabHoverAction="None">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type igDock:PaneTabItem}"
							x:Key="{x:Type igDock:PaneTabItem}">
							<Setter
								Property="controls:OutputPaneTwinklingExtension.IsRegisterTwinklingForContentPane"
								Value="True" />
							<Style.Triggers>
								<DataTrigger
									Value="ItemChanged"
									Binding="{Binding Path=Pane.Tag, RelativeSource={RelativeSource Self}}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type igDock:PaneTabItem}">
												<Border
													SnapsToDevicePixels="True">
													<igWindows:CardPanel>
														<igWindows:CardPanel
															Name="Background">
															<Grid
																HorizontalAlignment="Stretch"
																VerticalAlignment="Stretch"
																Width="Auto"
																Height="Auto">
																<Border
																	Name="OuterBorder"
																	BorderBrush="{TemplateBinding BorderBrush}"
																	Background="{TemplateBinding Background}"
																	SnapsToDevicePixels="True"
																	BorderThickness="0,1,1,1" />
																<Border
																	Name="InnerBorder"
																	Margin="0,1,1,1"
																	BorderThickness="0,1,1,1"
																	SnapsToDevicePixels="True"
																	BorderBrush="{StaticResource {x:Static igDock:DockManagerBrushKeys.UnpinnedTabItemHighlightFillKey}}" />
															</Grid>
														</igWindows:CardPanel>
														<Border
															Name="Content"
															BorderThickness="{TemplateBinding BorderThickness}"
															Padding="{TemplateBinding Padding}"
															Background="{StaticResource {x:Static igDock:DockManagerBrushKeys.UnpinnedTabItemBottomHottrackCenterFillKey}}">
															<DockPanel>
																<igWindows:AutoDisabledImage
																	DockPanel.Dock="Left"
																	Margin="0,0,5,0"
																	Stretch="None"
																	Visibility="{Binding Path=Pane.HasImage, RelativeSource={x:Static RelativeSource.TemplatedParent}, Converter={StaticResource BoolToVisConverter}}"
																	Source="{Binding Path=Pane.Image, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
																<ContentPresenter
																	Name="contentHeader"
																	ContentSource="Header"
																	SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
																	RecognizesAccessKey="True"
																	igWindows:ClippedTextToolTipService.ToolTipStyleKey="{x:Static igDock:XamDockManager.ToolTipStyleKey}"
																	ToolTip="{x:Static rr:Resources.DockPanelTabItemToolTip}"
																	TextElement.Foreground="{StaticResource {x:Static igDock:DockManagerBrushKeys.TabbedListHottrackTextFillKey}}"
																	HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
																	VerticalAlignment="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
															</DockPanel>
														</Border>
													</igWindows:CardPanel>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger
														Property="igWindows:TabItemEx.IsMouseOverTab"
														Value="True">
														<Setter
															TargetName="InnerBorder"
															Property="BorderBrush"
															Value="{StaticResource {x:Static igDock:DockManagerBrushKeys.UnpinnedTabItemHottrackHighlightFillKey}}" />
														<Setter
															TargetName="contentHeader"
															Property="Foreground"
															Value="{StaticResource {x:Static igDock:DockManagerBrushKeys.TabbedListNotActiveTextFillKey}}" />
													</Trigger>
													<Trigger
														Property="TabItem.TabStripPlacement"
														Value="Top">
														<Setter
															Property="Padding"
															Value="3,4,4,3" />
														<Setter
															Property="Margin"
															Value="-1,0,0,0" />
														<Setter
															TargetName="OuterBorder"
															Property="BorderThickness"
															Value="1,1,1,0" />
														<Setter
															TargetName="InnerBorder"
															Property="BorderThickness"
															Value="1,1,1,0" />
														<Setter
															TargetName="InnerBorder"
															Property="Margin"
															Value="1,1,1,0" />
													</Trigger>
													<Trigger
														Property="TabItem.TabStripPlacement"
														Value="Bottom">
														<Setter
															Property="Padding"
															Value="3,4,4,4" />
														<Setter
															Property="Margin"
															Value="-1,0,0,0" />
														<Setter
															TargetName="OuterBorder"
															Property="BorderThickness"
															Value="1,0,1,1" />
														<Setter
