<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.ASTROSystem.GroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:astrosystem="clr-namespace:Motorola.CommonCPS.RadioManagement.ASTROSystem">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.ASTROSystem;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<!--Unknown connection ID: 1-->
	<controls:RMGroupList
		Name="gplGroups"
		AutomationProperties.AutomationId="gplGroupsSystem"
		AllowEdit="False"
		Groups="{Binding NavigationItems}"
		IsEnabled="{Binding Path=IsSelectedNavigationItemLocked, Converter={StaticResource BoolToInverseConverter}}"
		SelectedGroup="{Binding Path=SelectedNavigationItem, Mode=TwoWay}" />
</UserControl>
