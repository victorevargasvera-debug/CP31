<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Job.JobMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:prism="http://www.codeplex.com/prism" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Job">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Job;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:a
				x:Key="FilterOptionToBoolConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Border
		Style="{StaticResource WindowBorderStyle}">
		<Grid
			Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="24" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="15" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid
				VerticalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Text="{x:Static resourceRepository:Resources.RMC_ViewBy}"
					Visibility="{Binding Path=IsOptionFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
				<!--Unknown connection ID: 1-->
				<controls:RMRadioButton
					Name="rbtAll"
					Grid.Column="2"
					Content="{x:Static resourceRepository:Resources.RMC_Views_Jobs_AllJobs}"
					IsChecked="{Binding Path=FilterOption, Converter={StaticResource FilterOptionToBoolConverter}, ConverterParameter=All}"
					Visibility="{Binding Path=IsOptionFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
				<!--Unknown connection ID: 2-->
				<controls:RMRadioButton
					Name="rbtProgramming"
					Grid.Column="4"
					Content="{x:Static resourceRepository:Resources.RMC_Views_Jobs_ProgrammingJobs}"
					IsChecked="{Binding Path=FilterOption, Converter={StaticResource FilterOptionToBoolConverter}, ConverterParameter=Programming}"
					Visibility="{Binding Path=IsOptionFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
				<!--Unknown connection ID: 3-->
				<controls:RMRadioButton
					Name="rbtOperational"
					Grid.Column="6"
					Content="{x:Static resourceRepository:Resources.RMC_Views_Jobs_OperationalJobs}"
					IsChecked="{Binding Path=FilterOption, Converter={StaticResource FilterOptionToBoolConverter}, ConverterParameter=Operational}"
					Visibility="{Binding Path=IsOptionFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
			</Grid>
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<ContentControl
				Grid.Row="3"
				prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.JobMainRegion}" />
		</Grid>
	</Border>
</UserControl>
