<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Job.ProgrammingDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:Motorola.CommonCPS.RadioManagement.Job" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:interactionRequest="http://www.codeplex.com/prism">
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{Binding RefreshCommand}" />
	</UIElement.InputBindings>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:RuntimeIdentifiersToVisibilityConverter
				x:Key="RuntimeIdentifiersToVisibilityConverter" />
			<converters:JobStatusToStringConverter
				x:Key="JobStatusToStringConverter" />
			<converters:JobTypeToUINameConverter
				x:Key="JobTypeToUINameConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<i:Interaction.Triggers>
		<interactionRequest:InteractionRequestTrigger
			i:SourceObject="{Binding ShowRadioDetailsDialogRequest}">
			<infrastructure:PopupWindowAction
				IsModal="True"
				IsMaximizationEnabled="True"
				DisableMinimalizingButtonInWindow="True">
				<infrastructure:PopupWindowAction.Content>
					<local:JobRadioDetailsView />
				</infrastructure:PopupWindowAction.Content>
			</infrastructure:PopupWindowAction>
		</interactionRequest:InteractionRequestTrigger>
	</i:Interaction.Triggers>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="1" />
			<RowDefinition
				Height="15" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<Label
				Grid.Row="0"
				Grid.Column="0"
				FontWeight="Bold"
				VerticalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.RMC_Views_JobDetails_JobName}" />
			<!--Unknown connection ID: 2-->
			<Label
				Name="JobName"
				Grid.Row="0"
				Grid.Column="1"
				VerticalAlignment="Center"
				Content="{Binding JobContainer.ContainerName}" />
			<Label
				Grid.Row="0"
				Grid.Column="2"
				FontWeight="Bold"
				VerticalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.RMC_Views_JobDetails_CreatedDate}" />
			<!--Unknown connection ID: 3-->
			<Label
				Name="CreatedTime"
				Grid.Row="0"
				Grid.Column="3"
				VerticalAlignment="Center"
				Content="{Binding JobContainer.CreatedTime}" />
			<Label
				Grid.Row="1"
				Grid.Column="0"
				FontWeight="Bold"
				VerticalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.RMC_Views_JobDetails_StartDate}" />
			<!--Unknown connection ID: 4-->
			<Label
				Name="StartTime"
				Grid.Row="1"
				Grid.Column="1"
				VerticalAlignment="Center"
				Content="{Binding JobContainer.StartTime}" />
			<Label
				Grid.Row="1"
				Grid.Column="2"
				FontWeight="Bold"
				VerticalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.RMC_Views_JobDetails_EndDate}" />
			<!--Unknown connection ID: 5-->
			<Label
				Name="EndTime"
				Grid.Row="1"
				Grid.Column="3"
				VerticalAlignment="Center"
				Content="{Binding JobContainer.EndTime}" />
			<Label
				Grid.Row="2"
				Grid.Column="0"
				FontWeight="Bold"
				VerticalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.RMC_Views_JobDetails_JobType}" />
			<!--Unknown connection ID: 6-->
			<Label
				Name="JobType"
				Grid.Row="2"
				Grid.Column="1"
				VerticalAlignment="Center">
				<ContentControl.Content>
					<MultiBinding
						Converter="{StaticResource JobTypeToUINameConverter}"
						Mode="OneWay">
						<Binding
							Path="JobContainer.IsMigrationJob" />
						<Binding
							Path="JobContainer.Type" />
					</MultiBinding>
				</ContentControl.Content>
			</Label>
		</Grid>
		<Grid
			Row="1"
			Background="{StaticResource BrushAccent}" />
		<!--Unknown connection ID: 7-->
		<controls:RMDataGrid
			Name="dgrTemplateProgrammingJobs"
			Grid.Row="3"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[MODE:Template]}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					AllowEdit="False"
					CellClickAction="SelectCell"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_SerialNumber}"
							Column="0">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.CellValuePresenterStyle>
										<Style
											TargetType="{x:Type igDP:CellValuePresenter}">
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type igDP:CellValuePresenter}">
														<controls:RMTextBlock
															Margin="{TemplateBinding Padding}"
															VerticalAlignment="Center">
															<controls:RMHyperlink
																Command="{Binding Path=DataContext.ShowRadioDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
																CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																<controls:RMTextBlock
																	Text="{Binding Path=Value, RelativeSource={RelativeSource TemplatedParent}}" />
															</controls:RMHyperlink>
														</controls:RMTextBlock>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</igDP:FieldSettings.CellValuePresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ModelNumber}"
							Column="1" />
						<igDP:Field
							Name="TemplateName"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_Template}"
							Column="2" />
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_RadioAlias}"
							Column="3" />
						<igDP:Field
							Name="UIJobStatus"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_JobStatus}"
							Column="4"
							Converter="{StaticResource JobStatusToStringConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									EditAsType="{x:Type sys:String}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ExecutedDate"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ExecutedDate}"
							Column="5">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Reason"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_Reason}"
							Column="6" />
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<!--Unknown connection ID: 8-->
		<controls:RMDataGrid
			Name="dgrConfigurationProgrammingJobs"
			Grid.Row="3"
			igDP:GroupByAreaLocation="None"
			igDP:DataSource="{Binding Items}"
			SearchCommand="{Binding SearchCommand}"
			Visibility="{Binding Converter={StaticResource RuntimeIdentifiersToVisibilityConverter}, ConverterParameter=[MODE:Configuration]}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					AllowEdit="False"
					CellClickAction="SelectCell"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_SerialNumber}"
							Column="0">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.CellValuePresenterStyle>
										<Style
											TargetType="{x:Type igDP:CellValuePresenter}">
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type igDP:CellValuePresenter}">
														<controls:RMTextBlock
															Margin="{TemplateBinding Padding}"
															VerticalAlignment="Center">
															<controls:RMHyperlink
																Command="{Binding Path=DataContext.ShowRadioDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
																CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																<controls:RMTextBlock
																	Text="{Binding Path=Value, RelativeSource={RelativeSource TemplatedParent}}" />
															</controls:RMHyperlink>
														</controls:RMTextBlock>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</igDP:FieldSettings.CellValuePresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ProductIdentifier"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ProductIdentifier}"
							Column="1" />
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ModelNumber}"
							Column="1" />
						<igDP:Field
							Name="ConfigurationName"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ConfigurationName}"
							Column="2" />
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_RadioAlias}"
							Column="3" />
						<igDP:Field
							Name="UIJobStatus"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_JobStatus}"
							Column="4"
							Converter="{StaticResource JobStatusToStringConverter}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									EditAsType="{x:Type sys:String}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ExecutedDate"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_ExecutedDate}"
							Column="5">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="Reason"
							Label="{x:Static resourceRepository:Resources.RMC_Model_ReadWriteDeviceJob_Reason}"
							Column="6" />
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
	</Grid>
</UserControl>
