<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfDock">
	<Style
		TargetType="{x:Type dc:DockWindowInfo}"
		x:Key="{x:Type dc:DockWindowInfo}">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Padding"
			Value="1" />
		<Setter
			Property="FrameworkElement.Cursor"
			Value="Hand" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:DockWindowInfo}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						SnapsToDevicePixels="True">
						<DockPanel
							LastChildFill="True"
							Margin="{TemplateBinding Padding}">
							<ContentPresenter
								Name="TabImage"
								ContentSource="Image"
								Margin="1"
								DockPanel.Dock="Left"
								VerticalAlignment="Center"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								Content="{TemplateBinding dc:Image}" />
							<ContentPresenter
								Name="PART_HeaderContentHost"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
								VerticalAlignment="Center"
								Content="{TemplateBinding dc:Header}">
								<ContentPresenter.ContentTemplate>
									<DataTemplate>
										<TextBlock
											TextTrimming="CharacterEllipsis"
											Text="{Binding}" />
									</DataTemplate>
								</ContentPresenter.ContentTemplate>
							</ContentPresenter>
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="dc:DockWindowInfo.IsSelected"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockWindowInfoBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockWindowInfoBorder}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
