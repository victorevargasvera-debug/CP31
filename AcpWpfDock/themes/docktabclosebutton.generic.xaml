<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:dc="clr-namespace:DevComponents.WpfDock" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		TargetType="{x:Type dc:DockTabCloseButton}"
		x:Key="{x:Type dc:DockTabCloseButton}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBackground}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBorder}}}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveForeground}}}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type dc:DockTabCloseButton}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						CornerRadius="2"
						BorderThickness="{TemplateBinding BorderThickness}">
						<Border
							Name="BH"
							BorderThickness="1"
							CornerRadius="2"
							Padding="2"
							BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBorderInner}}}">
							<Canvas
								Width="6"
								Height="6"
								HorizontalAlignment="Center"
								VerticalAlignment="Center">
								<Line
									X1="0"
									Y1="0"
									X2="6"
									Y2="6"
									Stroke="{TemplateBinding Foreground}"
									StrokeThickness="1.2" />
								<Line
									X1="0"
									Y1="6"
									X2="6"
									Y2="0"
									Stroke="{TemplateBinding Foreground}"
									StrokeThickness="1.2" />
							</Canvas>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="dc:DockTabCloseButton.IsActive"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBorder}}}" />
							<Setter
								TargetName="BH"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveForeground}}}" />
						</Trigger>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBorder}}}" />
							<Setter
								TargetName="BH"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverForeground}}}" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBorder}}}" />
							<Setter
								TargetName="BH"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedForeground}}}" />
						</Trigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBackground}}}" />
							<Setter
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBorder}}}" />
							<Setter
								TargetName="BH"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBorderInner}}}" />
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledForeground}}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
