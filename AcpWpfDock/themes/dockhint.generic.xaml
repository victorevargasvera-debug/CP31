<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dc="clr-namespace:DevComponents.WpfDock" xmlns:dcp="clr-namespace:DevComponents.WpfDock.Primitives">
	<Style
		TargetType="{x:Type dc:DockHint}"
		x:Key="{x:Type dc:DockHint}">
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						Name="HintBorder"
						Background="#00FFFFFF"
						BorderThickness="0"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						BorderBrush="{DynamicResource {ComponentResourceKey ResourceId=DockHintBorder, TypeInTargetAssembly=dc:DockSite}}">
						<Image
							Name="HintImage"
							Source="SysImages/DockHintTop.png"
							Width="29"
							Height="31" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="dc:DockHint.DockHintSide"
							Value="Bottom">
							<Setter
								TargetName="HintImage"
								Property="Source"
								Value="SysImages/DockHintBottom.png" />
						</Trigger>
						<Trigger
							Property="dc:DockHint.DockHintSide"
							Value="Left">
							<Setter
								TargetName="HintImage"
								Property="Source"
								Value="SysImages/DockHintLeft.png" />
							<Setter
								TargetName="HintImage"
								Property="Width"
								Value="31" />
							<Setter
								TargetName="HintImage"
								Property="Height"
								Value="29" />
						</Trigger>
						<Trigger
							Property="dc:DockHint.DockHintSide"
							Value="Right">
							<Setter
								TargetName="HintImage"
								Property="Source"
								Value="SysImages/DockHintRight.png" />
							<Setter
								TargetName="HintImage"
								Property="Width"
								Value="31" />
							<Setter
								TargetName="HintImage"
								Property="Height"
								Value="29" />
						</Trigger>
						<Trigger
							Property="dc:DockHint.DockHintSide"
							Value="AllSides">
							<Setter
								TargetName="HintImage"
								Property="Source"
								Value="SysImages/DockHintAllSides.png" />
							<Setter
								TargetName="HintImage"
								Property="Width"
								Value="88" />
							<Setter
								TargetName="HintImage"
								Property="Height"
								Value="88" />
						</Trigger>
						<Trigger
							Property="dc:DockHint.DockHintSide"
							Value="AllSidesAndCenter">
							<Setter
								TargetName="HintImage"
								Property="Source"
								Value="SysImages/DockHintTab.png" />
							<Setter
								TargetName="HintImage"
								Property="Width"
								Value="88" />
							<Setter
								TargetName="HintImage"
								Property="Height"
								Value="88" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
