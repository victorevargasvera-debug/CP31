<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infragistics.Windows.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="PrimitivesGeneric.xaml" />
		<ResourceDictionary
			Source="PrimitivesOffice2013_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		TargetType="{x:Type Button}"
		x:Key="ToolWindowButtonStyle">
		<Setter
			Property="Width"
			Value="16" />
		<Setter
			Property="Height"
			Value="16" />
		<Setter
			Property="MinWidth"
			Value="10" />
		<Setter
			Property="MinHeight"
			Value="10" />
		<Setter
			Property="ToolTipService.ShowOnDisabled"
			Value="True" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="{Binding Foreground, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
		<Setter
			Property="VerticalAlignment"
			Value="Top" />
		<Setter
			Property="UIElement.Opacity"
			Value="0.7" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Border
						Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						SnapsToDevicePixels="True">
						<Path
							Fill="{TemplateBinding Foreground}"
							Stretch="Uniform"
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							SnapsToDevicePixels="True"
							Data="{Binding Content, RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey {x:Type controls:IGControlBase}, DisabledForegroundBrush}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding IsMouseOver, RelativeSource={x:Static RelativeSource.Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</MultiDataTrigger>
			<Trigger
				Property="IsPressed"
				Value="True">
				<Setter
					Property="UIElement.Opacity"
					Value="1" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Property="UIElement.Opacity"
					Value="0.3" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="True" />
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ToolWindowButtonStyle}"
		x:Key="ToolWindowMinimizeButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid
						Name="root">
						<Border
							Name="closeButtonOuterBorder"
							BorderThickness="0"
							BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalOuterBorderFillKey}"
							Background="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Rectangle
							Name="closeGlyph"
							Stroke="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphStrokeKey}"
							VerticalAlignment="Center"
							HorizontalAlignment="Center"
							StrokeThickness="0"
							Height="2"
							Width="9"
							Fill="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphFillKey}"
							SnapsToDevicePixels="True"
							Margin="0,5,0,0" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ToolWindowButtonStyle}"
		x:Key="ToolWindowMaximizeButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid
						Name="root">
						<Border
							Name="closeButtonOuterBorder"
							BorderThickness="1"
							BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalOuterBorderFillKey}"
							Background="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalCenterFillKey}"
							SnapsToDevicePixels="True" />
						<Grid
							VerticalAlignment="Center"
							HorizontalAlignment="Center">
							<Border
								Width="10"
								Height="10"
								BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphFillKey}"
								BorderThickness="1,3,1,1" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ToolWindowButtonStyle}"
		x:Key="ToolWindowRestoreButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid
						Name="root">
						<Border
							Name="closeButtonOuterBorder"
							BorderThickness="1"
							BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalOuterBorderFillKey}"
							Background="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalCenterFillKey}"
							SnapsToDevicePixels="True">
							<Rectangle
								Name="highlight"
								Stroke="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalInnerBorderFillKey}"
								SnapsToDevicePixels="True" />
						</Border>
						<Grid
							Width="16"
							Height="12"
							VerticalAlignment="Center"
							HorizontalAlignment="Center">
							<Path
								Width="16"
								Height="12"
								Stretch="Fill"
								Data="M2.9999905,8 L2.9999905,13.189775 L11,13.189775 L11,8 M10.936987,2.9552236 L10.936987,5.1449995 L14,5.1449995 L14,8.044776 L18.937006,8.044776 L18.937006,2.9552236 M7.936996,0 L21.936996,0 L21.936996,10.999999 L14,10.999999 L14,16.144999 L0,16.144999 L0,5.1449995 L7.936996,5.1449995"
								Fill="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphFillKey}"
								SnapsToDevicePixels="True" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource ToolWindowButtonStyle}"
		x:Key="ToolWindowCloseButtonStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid
						Name="root">
						<Border
							Name="closeButtonOuterBorder"
							BorderThickness="1"
							BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalOuterBorderFillKey}"
							Background="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalCenterFillKey}"
							SnapsToDevicePixels="True">
							<Rectangle
								Name="highlight"
								Stroke="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveMinMaxButtonNormalInnerBorderFillKey}"
								SnapsToDevicePixels="True" />
						</Border>
						<Grid
							Width="10"
							Height="10"
							VerticalAlignment="Center"
							HorizontalAlignment="Center">
							<Path
								Width="10"
								Height="10"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Stroke="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphFillKey}"
								StrokeThickness="2">
								<Path.Data>
									<GeometryGroup>
										<LineGeometry
											StartPoint="0,0"
											EndPoint="10,10" />
										<LineGeometry
											StartPoint="10,0"
											EndPoint="0,10" />
									</GeometryGroup>
								</Path.Data>
							</Path>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type controls:ToolWindow}"
		x:Key="{x:Type controls:ToolWindow}">
		<Setter
			Property="FontSize"
			Value="12" />
		<Setter
			Property="FontFamily"
			Value="Segoe UI" />
		<Setter
			Property="Background"
			Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowBackgroundFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="{Binding Path=PreferredBorderThickness, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type controls:ToolWindow}">
					<AdornerDecorator>
						<Grid
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True">
							<Border
								Name="windowOuterBorder"
								BorderBrush="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowInactiveOuterBorderFillKey}"
								BorderThickness="1,1,1,1" />
							<Border
								Name="windowCenterBorder"
								Background="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowInactiveCenterFillKey}">
								<Grid
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
									<Grid.RowDefinitions>
										<RowDefinition
											Name="captionRow"
											Height="Auto" />
										<RowDefinition
											Name="contentRow"
											Height="*" />
									</Grid.RowDefinitions>
									<controls:CardPanel
										Name="PART_Caption"
										Margin="5"
										Background="{DynamicResource PrimitivesBrushKeys.ToolWindowInactiveCaptionFillKey}"
										Visibility="{TemplateBinding CaptionVisibility}">
										<DockPanel
											Name="captionPanel"
											Margin="1">
											<Button
												Command="{x:Static controls:ToolWindow.CloseCommand}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Margin="5,3,5,3"
												Style="{StaticResource ToolWindowCloseButtonStyle}" />
											<Button
												Name="MaximizeButton"
												Command="{x:Static controls:ToolWindow.MaximizeCommand}"
												Visibility="{TemplateBinding controls:MaximizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Margin="5,3,5,3"
												Style="{StaticResource ToolWindowMaximizeButtonStyle}"
												ToolTip="{StaticResource maximizeToolTip}" />
											<Button
												Name="MinimizeButton"
												Command="{x:Static controls:ToolWindow.MinimizeCommand}"
												Visibility="{TemplateBinding controls:MinimizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Margin="5,3,5,3"
												Style="{StaticResource ToolWindowMinimizeButtonStyle}"
												ToolTip="{StaticResource minimizeToolTip}" />
											<TextBlock
												Name="txtCaption"
												Text="{TemplateBinding controls:Title}"
												IsHitTestVisible="False"
												TextTrimming="CharacterEllipsis"
												Foreground="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowInactiveCaptionTextFillKey}"
												FontFamily="{DynamicResource SystemFonts.SmallCaptionFontFamilyKey}"
												FontSize="{TemplateBinding FontSize}"
												FontStyle="{DynamicResource SystemFonts.SmallCaptionFontStyleKey}"
												FontWeight="{DynamicResource SystemFonts.SmallCaptionFontWeightKey}"
												TextDecorations="{DynamicResource SystemFonts.SmallCaptionFontTextDecorationsKey}"
												VerticalAlignment="Center"
												Margin="5,0,5,0" />
										</DockPanel>
									</controls:CardPanel>
									<Grid
										Name="Content"
										Background="{TemplateBinding Background}"
										Margin="1,0,1,1"
										Row="1">
										<ContentPresenter
											Name="PART_Content"
											Grid.Row="1"
											Margin="{TemplateBinding Padding}"
											HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											ContentSource="Content" />
										<Grid
											Name="PART_ResizeGrip"
											RowSpan="2"
											Background="#00FFFFFF"
											HorizontalAlignment="Right"
											VerticalAlignment="Bottom"
											Visibility="Collapsed">
											<ResizeGrip
												IsTabStop="False"
												IsHitTestVisible="False" />
										</Grid>
									</Grid>
								</Grid>
							</Border>
							<Grid
								Name="resizeAreas"
								Visibility="Collapsed"
								FlowDirection="LeftToRight">
								<controls:ToolWindowResizeElement
									Name="PART_BorderTop"
									BorderLocation="Top" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderLeft"
									BorderLocation="Left" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderBottom"
									BorderLocation="Bottom" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderRight"
									BorderLocation="Right" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderTopLeft"
									BorderLocation="TopLeft" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderTopRight"
									BorderLocation="TopRight" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderBottomLeft"
									BorderLocation="BottomLeft" />
								<controls:ToolWindowResizeElement
									Name="PART_BorderBottomRight"
									BorderLocation="BottomRight" />
							</Grid>
						</Grid>
					</AdornerDecorator>
					<ControlTemplate.Triggers>
						<Trigger
							Property="controls:ToolWindow.WindowState"
							Value="Minimized">
							<Setter
								TargetName="MinimizeButton"
								Value="{x:Static controls:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MinimizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreUpToolTip}" />
							<Setter
								TargetName="MinimizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<Trigger
							Property="controls:ToolWindow.WindowState"
							Value="Maximized">
							<Setter
								TargetName="MaximizeButton"
								Value="{x:Static controls:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MaximizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreDownToolTip}" />
							<Setter
								TargetName="MaximizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.CaptionVisibility"
									Value="Visible" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_Content"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="captionRow"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="contentRow"
								Property="Height"
								Value="0" />
							<Setter
								TargetName="captionPanel"
								Property="Margin"
								Value="6,0" />
							<Setter
								TargetName="PART_Caption"
								Property="Margin"
								Value="1" />
							<Setter
								TargetName="txtCaption"
								Property="VerticalAlignment"
								Value="Center" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Maximized" />
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="PART_Caption"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
						<Trigger
							Property="controls:ToolWindow.IsActive"
							Value="True">
							<Setter
								TargetName="txtCaption"
								Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCaptionTextFillKey}"
								Property="Foreground" />
							<Setter
								TargetName="windowOuterBorder"
								Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowCenterBorder"
								Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="PART_Caption"
								Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveCaptionFillKey}"
								Property="Background" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.ResizeMode"
									Value="CanResize" />
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_ResizeGrip"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<Trigger
							Property="controls:ToolWindow.IsUsingOSNonClientArea"
							Value="True">
							<Setter
								TargetName="PART_Caption"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0,0,0,0" />
							<Setter
								TargetName="PART_Caption"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="windowOuterBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Background"
								Value="#00FFFFFF" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Border.Padding"
								Value="0,0,0,0" />
							<Setter
								TargetName="windowCenterBorder"
								Property="Margin"
								Value="0,0,0,0" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Maximized" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowCenterBorder"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="windowOuterBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="PART_Caption"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="controls:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="controls:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="controls:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="Content"
								Property="Margin"
								Value="0" />
							<Setter
								TargetName="PART_Caption"
								Property="Margin"
								Value="0" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="controls:ToolWindow.IsActive"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource controls:PrimitivesBrushKeys.ToolWindowActiveOuterBorderFillKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{x:Null}"
		x:Key="ButtonArrowRightStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Canvas
						Name="arrowButton"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Margin="0,0,0,0">
						<Border
							Opacity="1"
							Width="12"
							Height="12"
							Background="{StaticResource TransparentBrush}">
							<Path
								Name="Path"
								Opacity="0.7"
								Width="7"
								Height="12"
								Stretch="Fill"
								Data="M0,0 L7,6 L0,12"
								Fill="{StaticResource ForegroundBrush}" />
						</Border>
					</Canvas>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Path"
								Property="UIElement.Opacity"
								Value="1" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="Path"
								Property="UIElement.Opacity"
								Value="0.7" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type Button}"
		BasedOn="{x:Null}"
		x:Key="ButtonArrowLeftStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Canvas
						Name="arrowButton"
