								TargetName="CloseButton"
								Property="Margin"
								Value="3,1,3,0" />
							<Setter
								TargetName="PreTabItemContent"
								Property="VerticalAlignment"
								Value="Bottom" />
							<Setter
								TargetName="PostTabItemContent"
								Property="VerticalAlignment"
								Value="Bottom" />
							<Setter
								TargetName="PostTabItemContent"
								Property="Margin"
								Value="3,0,3,4" />
							<Setter
								TargetName="PreTabItemContent"
								Property="Margin"
								Value="3,0,3,4" />
							<Setter
								TargetName="PART_TabHeaderPanel"
								Property="Margin"
								Value="7,1,7,0" />
