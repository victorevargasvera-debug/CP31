										Fill="{DynamicResource igWindows:PrimitivesBrushKeys.TabItemIsSelectedLeftHighlightFillKey}"
										SnapsToDevicePixels="True"
										HorizontalAlignment="Right"
										Margin="0,0,1,0"
										VerticalAlignment="Bottom" />
									<Border
										Name="InnerSideHighlightLeft1"
										SnapsToDevicePixels="True"
										HorizontalAlignment="Left"
										Margin="4,1,4,3"
										Width="3"
										BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.TabItemIsSelectedLeftHighlightFillKey}"
										BorderThickness="1,0,0,0"
										CornerRadius="2,0,0,0" />
									<Border
