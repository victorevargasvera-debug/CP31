								Property="Margin"
								Value="0,1,0,1" />
							<Setter
								TargetName="TabMouseOverNotSelected"
								Property="FrameworkElement.LayoutTransform">
								<Setter.Value>
									<RotateTransform
										Angle="90" />
								</Setter.Value>
							</Setter>
							<Setter
								TargetName="TabSelected"
								Property="FrameworkElement.LayoutTransform">
								<Setter.Value>
									<RotateTransform
										Angle="90" />
								</Setter.Value>
							</Setter>
							<Setter
								TargetName="TabHottrack"
								Property="FrameworkElement.LayoutTransform">
								<Setter.Value>
									<RotateTransform
										Angle="90" />
								</Setter.Value>
							</Setter>
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="TabItem.IsSelected"
									Value="True" />
								<Condition
									Property="TabItem.TabStripPlacement"
									Value="Top" />
							</MultiTrigger.Conditions>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="TabItem.IsSelected"
									Value="True" />
								<Condition
									Property="TabItem.TabStripPlacement"
									Value="Bottom" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="TabSelected"
								Property="Margin"
								Value="0,-1,0,0" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="TabItem.IsSelected"
									Value="True" />
								<Condition
									Property="TabItem.TabStripPlacement"
									Value="Left" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="TabSelected"
								Property="Margin"
								Value="0,-2,-1,-2" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="TabItem.IsSelected"
									Value="True" />
								<Condition
									Property="TabItem.TabStripPlacement"
									Value="Right" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="TabSelected"
								Property="Margin"
								Value="-1,-2,0,-2" />
						</MultiTrigger>
						<Trigger
							Property="IsEnabled"
							Value="False">
							<Setter
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.GrayTextBrushKey}"
								TargetName="Content"
								Property="Foreground" />
							<Setter
								TargetName="TabSelected"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="TabMouseOverNotSelected"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="TabHottrack"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type igWindows:ToolWindow}"
		x:Key="{x:Type igWindows:ToolWindow}">
		<Setter
			Property="Background"
			Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowBackgroundFillKey}" />
		<Setter
			Property="BorderThickness"
			Value="{Binding Path=PreferredBorderThickness, RelativeSource={x:Static RelativeSource.Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type igWindows:ToolWindow}">
					<AdornerDecorator>
						<Grid
							Background="{TemplateBinding Background}"
							SnapsToDevicePixels="True">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition
										Name="captionRow"
										Height="Auto" />
									<RowDefinition
										Name="contentRow"
										Height="*" />
								</Grid.RowDefinitions>
								<Border
									Name="captionOuterBorder"
									BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCaptionOuterBorderFillKey}"
									BorderThickness="1,1,1,1"
									Visibility="{TemplateBinding igWindows:CaptionVisibility}">
									<Border
										Name="captionInnerBorder"
										BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCaptionInnerBorderFillKey}"
										BorderThickness="0,1,0,0"
										HorizontalAlignment="Stretch">
										<DockPanel
											Name="PART_Caption"
											Background="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCaptionCenterFillKey}"
											SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
											HorizontalAlignment="Stretch">
											<Button
												Command="{x:Static igWindows:ToolWindow.CloseCommand}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Margin="0,1,5,0"
												Style="{StaticResource ToolWindowCloseButtonStyle}" />
											<Button
												Name="MaximizeButton"
												Command="{x:Static igWindows:ToolWindow.MaximizeCommand}"
												Visibility="{TemplateBinding igWindows:MaximizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Style="{StaticResource ToolWindowMaximizeButtonStyle}"
												ToolTip="{StaticResource maximizeToolTip}" />
											<Button
												Name="MinimizeButton"
												Command="{x:Static igWindows:ToolWindow.MinimizeCommand}"
												Visibility="{TemplateBinding igWindows:MinimizeButtonVisibility}"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												Style="{StaticResource ToolWindowMinimizeButtonStyle}"
												ToolTip="{StaticResource minimizeToolTip}" />
											<TextBlock
												Name="txtCaption"
												Text="{TemplateBinding igWindows:Title}"
												Foreground="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveCaptionTextFillKey}"
												FontFamily="{DynamicResource SystemFonts.SmallCaptionFontFamilyKey}"
												FontSize="{DynamicResource SystemFonts.SmallCaptionFontSizeKey}"
												FontStyle="{DynamicResource SystemFonts.SmallCaptionFontStyleKey}"
												FontWeight="{DynamicResource SystemFonts.SmallCaptionFontWeightKey}"
												TextDecorations="{DynamicResource SystemFonts.SmallCaptionFontTextDecorationsKey}"
												IsHitTestVisible="False"
												TextTrimming="CharacterEllipsis"
												Margin="2,4,0,2" />
										</DockPanel>
									</Border>
								</Border>
								<Grid
									Row="1">
									<Border
										Name="windowBorder"
										BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveOuterBorder1FillKey}"
										BorderThickness="1,0,1,1">
										<Border
											Name="windowBorder2"
											BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveOuterBorder2FillKey}"
											BorderThickness="1,0,1,1">
											<Border
												Name="windowBorder3"
												BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveOuterBorder3FillKey}"
												BorderThickness="1,0,1,1">
												<Border
													Name="windowBorder4"
													BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowInactiveOuterBorder4FillKey}"
													BorderThickness="1,0,1,1">
													<Grid
														SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
														<ContentPresenter
															Name="PART_Content"
															Grid.Row="1"
															Margin="{TemplateBinding Padding}"
															HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
															ContentSource="Content" />
														<Grid
															Name="PART_ResizeGrip"
															RowSpan="2"
															Background="#00FFFFFF"
															HorizontalAlignment="Right"
															VerticalAlignment="Bottom"
															Visibility="Collapsed">
															<ResizeGrip
																IsTabStop="False"
																IsHitTestVisible="False" />
														</Grid>
													</Grid>
												</Border>
											</Border>
										</Border>
									</Border>
								</Grid>
							</Grid>
							<Grid
								Name="resizeAreas"
								Visibility="Collapsed"
								FlowDirection="LeftToRight">
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTop"
									BorderLocation="Top" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderLeft"
									BorderLocation="Left" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottom"
									BorderLocation="Bottom" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderRight"
									BorderLocation="Right" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTopLeft"
									BorderLocation="TopLeft" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderTopRight"
									BorderLocation="TopRight" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottomLeft"
									BorderLocation="BottomLeft" />
								<igWindows:ToolWindowResizeElement
									Name="PART_BorderBottomRight"
									BorderLocation="BottomRight" />
							</Grid>
						</Grid>
					</AdornerDecorator>
					<ControlTemplate.Triggers>
						<Trigger
							Property="igWindows:ToolWindow.WindowState"
							Value="Minimized">
							<Setter
								TargetName="MinimizeButton"
								Value="{x:Static igWindows:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MinimizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreUpToolTip}" />
							<Setter
								TargetName="MinimizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<Trigger
							Property="igWindows:ToolWindow.WindowState"
							Value="Maximized">
							<Setter
								TargetName="MaximizeButton"
								Value="{x:Static igWindows:ToolWindow.RestoreCommand}"
								Property="Command" />
							<Setter
								TargetName="MaximizeButton"
								Property="FrameworkElement.ToolTip"
								Value="{StaticResource restoreDownToolTip}" />
							<Setter
								TargetName="MaximizeButton"
								Property="Style"
								Value="{StaticResource ToolWindowRestoreButtonStyle}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Visible" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowBorder"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="captionRow"
								Property="Height"
								Value="*" />
							<Setter
								TargetName="contentRow"
								Property="Height"
								Value="0" />
						</MultiTrigger>
						<Trigger
							Property="igWindows:ToolWindow.IsActive"
							Value="True">
							<Setter
								TargetName="txtCaption"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionTextFillKey}"
								Property="Foreground" />
							<Setter
								TargetName="PART_Caption"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="captionOuterBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="captionInnerBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCaptionInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveOuterBorder1FillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowBorder2"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveOuterBorder2FillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowBorder3"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveOuterBorder3FillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="windowBorder4"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveOuterBorder4FillKey}"
								Property="BorderBrush" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResize" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="resizeAreas"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.ResizeMode"
									Value="CanResizeWithGrip" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Normal" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_ResizeGrip"
								Property="Visibility"
								Value="Visible" />
						</MultiTrigger>
						<Trigger
							Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
							Value="True">
							<Setter
								TargetName="windowBorder"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder2"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder3"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder4"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="captionOuterBorder"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowBorder"
								Property="BorderThickness"
								Value="1" />
							<Setter
								TargetName="windowBorder2"
								Property="BorderThickness"
								Value="1" />
							<Setter
								TargetName="windowBorder3"
								Property="BorderThickness"
								Value="1" />
							<Setter
								TargetName="windowBorder4"
								Property="BorderThickness"
								Value="1" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Maximized" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowBorder"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder2"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder3"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder4"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="captionInnerBorder"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="captionOuterBorder"
								Property="BorderThickness"
								Value="0" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="igWindows:ToolWindow.WindowState"
									Value="Minimized" />
								<Condition
									Property="igWindows:ToolWindow.IsUsingOSNonClientArea"
									Value="False" />
								<Condition
									Property="igWindows:ToolWindow.CaptionVisibility"
									Value="Collapsed" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="windowBorder"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder2"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder3"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="windowBorder4"
								Property="BorderThickness"
								Value="0" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="igWindows:ToolWindow.IsActive"
				Value="True">
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource SystemColors.ActiveBorderBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
