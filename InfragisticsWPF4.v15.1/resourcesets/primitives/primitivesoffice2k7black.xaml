	<Style
		TargetType="{x:Type Button}"
		x:Key="{x:Static igWindows:XamTabControl.CloseButtonStyleKey}">
		<Setter
			Property="FrameworkElement.ToolTip"
			Value="{StaticResource closeToolTip}" />
		<Setter
			Property="Width"
			Value="13" />
		<Setter
			Property="Height"
			Value="13" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Grid>
						<Border
							Name="closeButtonOuterBorder"
							BorderThickness="1,1,1,1"
							BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalOuterBorderFillKey}"
							CornerRadius="2" />
						<Border
							Name="closeButtonInnerBorder"
							BorderThickness="1,1,1,1"
							Margin="1"
							BorderBrush="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalInnerBorderFillKey}"
							CornerRadius="1" />
						<Border
							Name="closeButtonCenter"
							Margin="2"
							Background="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalCenterFillKey}"
							CornerRadius="1">
							<Path
								Name="closeGlyph"
								Data="M0,0 L7,7 M0,7 L7,0"
								Margin="1"
								StrokeThickness="2"
								SnapsToDevicePixels="True"
								Stroke="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonNormalGlyphFillKey}" />
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="closeButtonOuterBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonHottrackOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="closeButtonInnerBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonHottrackInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="closeButtonCenter"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonHottrackCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="closeGlyph"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonHottrackGlyphFillKey}"
								Property="Stroke" />
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="closeButtonOuterBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonPressedOuterBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="closeButtonInnerBorder"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonPressedInnerBorderFillKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="closeButtonCenter"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonPressedCenterFillKey}"
								Property="Background" />
							<Setter
								TargetName="closeGlyph"
								Value="{DynamicResource igWindows:PrimitivesBrushKeys.ToolWindowActiveCloseButtonPressedGlyphFillKey}"
								Property="Stroke" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
