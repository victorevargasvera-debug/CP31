							<Setter
								TargetName="PART_ScrollRight"
								Property="Row"
								Value="0" />
							<Setter
								TargetName="PART_ScrollRight"
								Property="Column"
								Value="2" />
							<Setter
								TargetName="PART_ScrollRight"
								Property="Margin"
								Value="1,2,1,0" />
							<Setter
								TargetName="PART_PagerContentPresenter"
								Property="RowSpan"
