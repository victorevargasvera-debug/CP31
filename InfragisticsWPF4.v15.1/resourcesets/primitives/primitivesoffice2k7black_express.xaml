<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ig="clr-namespace:Infragistics.Windows" xmlns:controls="clr-namespace:Infragistics.Windows.Controls" xmlns:igWindows="clr-namespace:Infragistics.Windows.Controls" xmlns:looks="clr-namespace:Infragistics.Windows.Looks" xmlns:themes="clr-namespace:Infragistics.Windows.Themes" xmlns:d="http://schemas.microsoft.com/expression/interactivedesigner/2006" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="PrimitivesGeneric_Express.xaml" />
		<ResourceDictionary
			Source="PrimitivesOffice2k7Black_Brushes.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		TargetType="{x:Type controls:SortIndicator}"
		x:Key="{x:Type controls:SortIndicator}">
		<Setter
			Property="MinHeight"
			Value="3.5" />
		<Setter
			Property="MinWidth"
			Value="7" />
		<Setter
			Property="Visibility"
			Value="Hidden" />
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey {x:Type controls:SortIndicator}, SortIndicatorBackground}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type controls:SortIndicator}">
					<Polygon
						Name="Arrow"
						Fill="{TemplateBinding Background}"
						Points="0,0 7,0 3.5,3.5"
						StrokeEndLineCap="Round"
						StrokeStartLineCap="Round"
						StrokeLineJoin="Round" />
					<ControlTemplate.Triggers>
						<Trigger
							Property="controls:SortIndicator.SortStatus"
							Value="Descending">
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="controls:SortIndicator.SortStatus"
							Value="Ascending">
							<Setter
								TargetName="Arrow"
								Property="Polygon.Points"
								Value="0,3.5 7,3.5 3.5,0" />
							<Setter
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="Arrow"
								Property="Fill"
								Value="{DynamicResource {ComponentResourceKey {x:Type controls:SortIndicator}, SortIndicatorBackgroundHover}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		BasedOn="{x:Static themes:PrimitivesGeneric.ExpanderBar}"
		TargetType="{x:Type controls:ExpanderBar}"
		x:Key="{x:Type controls:ExpanderBar}">
		<Setter
			Property="controls:ExpanderBar.BackgroundHover">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFCCCCCC" />
					<GradientStop
						Offset=".06"
						Color="#FFCCCCCC" />
					<GradientStop
						Offset=".37"
						Color="#FFB8B8B8" />
					<GradientStop
						Offset="0.516"
						Color="#FF818181 " />
					<GradientStop
						Offset="0.602"
						Color="#FFAFAFAF" />
					<GradientStop
						Offset=".71"
						Color="#FFAFAFAF" />
					<GradientStop
						Offset=".74"
						Color="#FFB8B8B8" />
					<GradientStop
						Offset="1"
						Color="#FFB6B6B6" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="controls:ExpanderBar.BorderHoverBrush"
			Value="#FF767676" />
	</Style>
	<Style
		TargetType="{x:Type controls:DropIndicator}"
		x:Key="{x:Type controls:DropIndicator}">
		<Setter
			Property="Background"
			Value="{DynamicResource controls:PrimitivesBrushKeys.DropIndicatorFillKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type controls:DropIndicator}">
					<FrameworkTemplate.Resources>
						<ResourceDictionary />
					</FrameworkTemplate.Resources>
					<StackPanel
						Name="mainPanel"
						Orientation="Vertical">
						<Grid
							Name="ArrowTL"
							Width="9"
							Height="12">
							<Path
								Height="12"
								Width="9"
								Stretch="Fill"
								Opacity="1"
								Data="M420,371 C420,371 423,371 423,371 C423,371 423,378 423,378 C423,378 426,378 426,378 C426,378 421.5,383 421.5,383 C421.5,383 417,378 417,378 C417,378 420,378 420,378 C420,378 420,371 420,371"
								Fill="{TemplateBinding Background}"
								Stroke="#FFFFFFFF" />
						</Grid>
						<Rectangle
							Name="PART_Offset"
							Width="1"
							Height="1"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Visibility="Hidden" />
						<Grid
							Name="spaceRect"
							Width="{TemplateBinding controls:DropTargetWidth}"
							Height="{TemplateBinding controls:DropTargetHeight}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Visibility="Hidden">
							<Rectangle
								Stroke="{DynamicResource controls:PrimitivesBrushKeys.DropTargetStrokeKey}"
								StrokeThickness="1"
								Margin="2,2,2,4" />
						</Grid>
						<Grid
							Name="ArrowBR"
							Width="9"
							Height="12">
							<Path
								Height="12"
								Width="9"
								Stretch="Fill"
								Opacity="1"
								Data="M430,383 C430,383 433,383 433,383 C433,383 433,376 433,376 C433,376 436,376 436,376 C436,376 431.5,371 431.5,371 C431.5,371 427,376 427,376 C427,376 430,376 430,376 C430,376 430,383 430,383"
								Fill="{TemplateBinding Background}"
								Stroke="#FFFFFFFF" />
						</Grid>
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger
							Property="controls:DropIndicator.Orientation"
							Value="Horizontal">
							<Setter
								TargetName="spaceRect"
								Property="Height"
								Value="1" />
							<Setter
								TargetName="mainPanel"
								Property="StackPanel.Orientation"
								Value="Horizontal" />
							<Setter
								TargetName="ArrowTL"
								Property="FrameworkElement.LayoutTransform">
								<Setter.Value>
									<RotateTransform
										CenterX="15"
										CenterY="50"
										Angle="-90" />
								</Setter.Value>
							</Setter>
							<Setter
								TargetName="ArrowBR"
								Property="FrameworkElement.LayoutTransform">
								<Setter.Value>
									<RotateTransform
										CenterX="15"
										CenterY="0"
										Angle="-90" />
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="controls:DropIndicator.Orientation"
							Value="Vertical">
							<Setter
								TargetName="spaceRect"
								Property="Width"
								Value="1" />
						</Trigger>
						<Trigger
							Property="controls:DropIndicator.DropLocation"
							Value="OverTarget">
							<Setter
								TargetName="spaceRect"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="ArrowTL"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="ArrowBR"
								Property="Visibility"
								Value="Collapsed" />
							<Setter
								TargetName="PART_Offset"
								Property="HorizontalAlignment"
								Value="Left" />
							<Setter
								TargetName="PART_Offset"
								Property="VerticalAlignment"
								Value="Top" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
