<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.SelectModifiedRadioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:igEditors="http://infragistics.com/Editors" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:infrastructure="clr-namespace:Motorola.CommonCPS.RadioManagement.Infrastructure;assembly=Motorola.CommonCPS.RadioManagement.Infrastructure" xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Height="300"
	Width="400" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Radio;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type igDP:CellValuePresenter}"
				x:Key="{x:Type igDP:CellValuePresenter}">
				<Setter
					Property="BorderBrush"
					Value="#FFD3D3D3" />
				<Setter
					Property="BorderThickness"
					Value="0,0,1,0" />
				<Setter
					Property="igDP:CellValuePresenter.BorderHoverBrush"
					Value="#FFD3D3D3" />
				<Setter
					Property="FontFamily"
					Value="Arial" />
				<Setter
					Property="Height"
					Value="25" />
				<Style.Triggers>
					<DataTrigger
						Value="True"
						Binding="{Binding Record.IsSelected, RelativeSource={RelativeSource Self}}">
						<Setter
							Property="igDP:CellValuePresenter.ForegroundStyle">
							<Setter.Value>
								<Style>
									<Setter
										Property="FontWeight"
										Value="Bold" />
									<Setter
										Property="Foreground"
										Value="{DynamicResource SelectedRowForegroundBrush}" />
								</Style>
							</Setter.Value>
						</Setter>
						<Setter
							Property="Background"
							Value="{DynamicResource SelectedRowBackgroundBrush}" />
					</DataTrigger>
					<DataTrigger
						Value="{x:Static resourceRepository:Resources.General_Licenses}"
						Binding="{Binding Path=Field.Label, RelativeSource={RelativeSource Self}}">
						<Setter
							Property="BorderThickness"
							Value="0,0,1,0" />
						<Setter
							Property="BorderBrush"
							Value="#FFD3D3D3" />
						<Setter
							Property="FrameworkElement.ToolTip">
							<Setter.Value>
								<Grid>
									<DataGrid
										Background="#00FFFFFF"
										HeadersVisibility="Column"
										RowBackground="#00FFFFFF"
										CanUserAddRows="False"
										SelectionUnit="FullRow"
										AutoGenerateColumns="False"
										BorderThickness="0"
										GridLinesVisibility="None"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Panel.ZIndex="2"
										ItemsSource="{Binding DataItem.FeatureList}"
										Visibility="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibilityByRecordCountConverter}}">
										<DataGrid.ColumnHeaderStyle>
											<Style
												TargetType="{x:Type DataGridColumnHeader}">
												<Setter
													Property="Background"
													Value="#FFD3D3D3" />
												<Setter
													Property="Foreground"
													Value="#FF000000" />
												<Setter
													Property="FontWeight"
													Value="Bold" />
												<Setter
													Property="BorderThickness"
													Value="0,0,0,1" />
												<Setter
													Property="BorderBrush"
													Value="#FF000000" />
												<Setter
													Property="Padding"
													Value="5,2,5,2" />
											</Style>
										</DataGrid.ColumnHeaderStyle>
										<DataGrid.Columns>
											<DataGridTextColumn
												Width="Auto"
												Header="{x:Static resourceRepository:Resources.General_Feature}"
												Binding="{Binding LicenseName}" />
											<DataGridTextColumn
												Width="Auto"
												Header="{x:Static resourceRepository:Resources.General_Status}"
												Binding="{Binding LicenseStauts}" />
										</DataGrid.Columns>
									</DataGrid>
									<Label
										Content="{x:Static resourceRepository:Resources.Not_Applicable}"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Panel.ZIndex="0" />
								</Grid>
							</Setter.Value>
						</Setter>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24,10,24,24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<controls:RMTextBlock
			FontSize="14"
			VerticalAlignment="Center"
			TextWrapping="Wrap"
			Text="{x:Static resourceRepository:Resources.RMC_Select_Radio_To_Convert}" />
		<!--Unknown connection ID: 1-->
		<controls:RMDataGrid
			Name="dgrRadios"
			Grid.Row="1"
			Margin="0,20,0,0"
			BorderThickness="0"
			igDP:GroupByAreaLocation="None"
			CustomizedSelectedCount="{Binding SelectModifiedRadioContext.SelectedRadios.Count}"
			igDP:DataSource="{Binding SelectModifiedRadioContext.ModifiedRadios, Converter={StaticResource GridViewSourceConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							BindingType="Unbound"
							Name="Selected">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellClickAction="EnterEditModeIfAllowed"
									LabelClickAction="Nothing"
									AllowResize="False"
									EditAsType="{x:Type sys:Boolean}">
									<igDP:FieldSettings.EditorStyle>
										<!--Unknown connection ID: 2-->
										<Style
											TargetType="{x:Type igEditors:XamCheckEditor}">
											<Setter
												Property="infrastructure:FieldCheckChanged.Command"
												Value="{Binding ElementName=RadioView, Path=DataContext.FieldCheckChangedCommand}" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
									<igDP:FieldSettings.LabelPresenterStyle>
										<Style
											TargetType="{x:Type igDP:LabelPresenter}">
											<Setter
												Property="Template">
												<Setter.Value>
													<ControlTemplate
														TargetType="{x:Type igDP:LabelPresenter}">
														<!--Unknown connection ID: 3-->
														<CheckBox
															Name="HeaderCheckBox"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															IsThreeState="False"
															Command="{Binding ElementName=RadioView, Path=DataContext.SelectedAllCheckChangedCommand}"
															IsChecked="{Binding Path=IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
															<ButtonBase.CommandParameter>
																<MultiBinding
																	Converter="{StaticResource SelectAllParameterConverter}">
																	<MultiBinding.Bindings>
																		<Binding
																			Path="IsSelectAll"
																			RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
																		<Binding
																			ElementName="dgrRadios"
																			Path="Records" />
																	</MultiBinding.Bindings>
																</MultiBinding>
															</ButtonBase.CommandParameter>
														</CheckBox>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</igDP:FieldSettings.LabelPresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="SerialNumber"
							Label="{x:Static resourceRepository:Resources.General_Serial_Number}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="RadioAlias"
							Label="{x:Static resourceRepository:Resources.General_RadioAlias}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="ModelNumber"
							Label="{x:Static resourceRepository:Resources.General_Model_Number}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="TemplateName"
							Label="{x:Static resourceRepository:Resources.General_Template}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							Name="UIChangeIndicator"
							Label="{x:Static resourceRepository:Resources.RMC_Modified}">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource RadioChangeIndicatorStyle}">
									<igDP:FieldSettings.EditorStyle>
										<Style
											TargetType="{x:Type igEditors:XamTextEditor}">
											<Setter
												Property="igEditors:ValueEditor.IsReadOnly"
												Value="True" />
										</Style>
									</igDP:FieldSettings.EditorStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<Grid
			Row="3"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnOK"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding SelectModifiedRadioCommand}" />
		</Grid>
	</Grid>
</UserControl>
