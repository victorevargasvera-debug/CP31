<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.UpdateLogSettingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Width="480" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Common;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="40" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<controls:RMTextBlock
			Text="{x:Static resourceRepository:Resources.CPS2_UploadAppLogPrompt}"
			TextAlignment="Left"
			TextWrapping="Wrap" />
		<Grid
			Row="2"
			AutomationProperties.AutomationId="CPSHideDialogOption"
			HorizontalAlignment="Center"
			Margin="5,0"
			Visibility="{Binding ProgressContext.ShowHideOption, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<controls:RMCheckBox
				AutomationProperties.AutomationId="rcbHideDialog"
				IsEnabled="True"
				IsChecked="{Binding LogSetting.HideDialogChecked, Mode=TwoWay}" />
			<controls:RMTextBlock
				Grid.Column="1"
				Margin="5,0,0,0"
				Text="{x:Static resourceRepository:Resources.CPS2_Dont_show_again}"
				Style="{StaticResource FieldLabelStyle}" />
		</Grid>
		<Grid
			Row="4"
			HorizontalAlignment="Right"
			Width="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 1-->
			<controls:RMButton
				Name="btnYes"
				Content="{x:Static resourceRepository:Resources.General_Yes}"
				IsDefault="True"
				CommandParameter="true"
				Command="{Binding UpdateLogSettingCommand}" />
			<!--Unknown connection ID: 2-->
			<controls:RMButton
				Name="btnNo"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.General_No}"
				CommandParameter="false"
				Command="{Binding UpdateLogSettingCommand}" />
		</Grid>
	</Grid>
</UserControl>
