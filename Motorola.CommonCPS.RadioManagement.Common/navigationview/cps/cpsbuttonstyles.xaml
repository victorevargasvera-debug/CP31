								<Setter
									TargetName="rectangle"
									Property="Fill"
									Value="{StaticResource ButtonGreenPressed}" />
								<Setter
									TargetName="iconRow"
									Property="Height"
									Value="1.25*" />
								<Setter
									TargetName="iconColumn"
									Property="Width"
									Value="1.25*" />
							</Trigger>
							<Trigger
								Property="IsEnabled"
								Value="False">
								<Setter
									TargetName="rectangle"
									Property="Fill"
									Value="{StaticResource ButtonDisabledFill}" />
								<Setter
									TargetName="rectangle"
									Property="Stroke"
									Value="{StaticResource ButtonDisabledOutline}" />
								<Setter
									TargetName="ikon"
									Property="Fill"
									Value="{StaticResource ButtonIconGrey}" />
								<Setter
									TargetName="ikon"
									Property="Stroke"
									Value="{StaticResource ButtonDisabledOutline}" />
