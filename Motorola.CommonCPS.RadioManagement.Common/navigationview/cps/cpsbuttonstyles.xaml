				<Setter.Value>
					<ControlTemplate
						TargetType="{x:Type controls:RMButton}">
						<Grid>
							<Rectangle
								Name="rectangle"
								StrokeThickness="1"
								Style="{StaticResource RectSize}"
								Fill="{StaticResource ButtonGreenNormal}"
								Stroke="{StaticResource ButtonGreenOutline}" />
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="1*" />
									<RowDefinition
										Name="iconRow"
										Height="1.5*" />
									<RowDefinition
										Height="1*" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="1*" />
									<ColumnDefinition
										Name="iconColumn"
										Width="1.5*" />
									<ColumnDefinition
										Width="1*" />
								</Grid.ColumnDefinitions>
								<Path
									Name="ikon"
									Stretch="Uniform"
									Grid.Row="1"
									Grid.Column="1"
									StrokeThickness="1"
									Stroke="{StaticResource ButtonBlueOutline}"
									Fill="{StaticResource ButtonIconWhite}">
									<Path.Data>
										<GeometryGroup>
											<PathGeometry
												Figures="M2.2860107,6.8569942L2.2860107,25.142988 3.0479736,25.142988 9.1430054,6.8569942z M0,0L11.429016,0 11.429016,2.2859955 27.429016,2.2859955 27.429016,6.8569942 32,6.8569942 25.143005,27.428999 0,27.428999z" />
										</GeometryGroup>
									</Path.Data>
									<UIElement.RenderTransform>
										<TransformGroup>
											<TransformGroup.Children>
												<RotateTransform
													Angle="0" />
												<ScaleTransform
													ScaleX="1"
													ScaleY="1" />
											</TransformGroup.Children>
										</TransformGroup>
									</UIElement.RenderTransform>
								</Path>
							</Grid>
