<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.ClearDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Common;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="5" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			Visibility="{Binding ClearOldDBContext.DisplayClearDataConfirmBox, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<Label
				Grid.Row="0"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				Content="{x:Static resourceRepository:Resources.DB_MIGRATION_CLEAR_DATA}"
				FontSize="18" />
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 1-->
				<controls:RMButton
					Name="btnOK"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
					IsDefault="True"
					Command="{Binding ClearDataCommand}" />
				<!--Unknown connection ID: 2-->
				<controls:RMButton
					Name="btnCancel"
					Grid.Column="3"
					Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
					IsDefault="True"
					Command="{Binding CloseCommand}" />
			</Grid>
		</Grid>
		<Grid
			Row="1"
			Visibility="{Binding ClearOldDBContext.DisplayClearDataProgress, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Label
				Grid.Row="0"
				FontSize="18"
				Content="{Binding ClearOldDBContext.ClearDataMessage}" />
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<!--Unknown connection ID: 3-->
			<controls:RMDataGrid
				Name="dgrJobContainer"
				Grid.Row="2"
				igDP:GroupByAreaLocation="None"
				ToolbarVisibility="Collapsed"
				SearchVisibility="Collapsed"
				StatusbarVisibility="Collapsed"
				igDP:ActiveDataItem="{Binding SelectedJobContainer}"
				igDP:DataSource="{Binding ClearOldDBContext.ProgressList, Converter={StaticResource GridViewSourceConverter}}">
				<igDP:DataPresenterBase.FieldSettings>
					<igDP:FieldSettings
						AllowEdit="False"
						CellClickAction="SelectRecord"
						Width="Auto" />
				</igDP:DataPresenterBase.FieldSettings>
				<igDP:DataPresenterBase.FieldLayouts>
					<igDP:FieldLayout>
						<igDP:FieldLayout.Fields>
							<igDP:Field
								Name="TaskName"
								Label="{x:Static resourceRepository:Resources.DB_MIGRATION_TASK_NAME}"
								Column="0" />
							<igDP:Field
								Name="CreateTime"
								Label="{x:Static resourceRepository:Resources.RMC_JobContainer_CreatedTime}"
								Column="1">
								<igDP:Field.Settings>
									<igDP:FieldSettings
										AllowEdit="false"
										EditAsType="{x:Type sys:DateTime}" />
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								BindingType="Unbound"
								Label="{x:Static resourceRepository:Resources.RMC_Tasks_Summary}"
								Width="300"
								Column="2">
								<igDP:Field.Settings>
									<igDP:FieldSettings
										CellValuePresenterStyle="{StaticResource DBMigrationProgressCellValuePresenterStyle}" />
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								Name="Reason"
								Label="{x:Static resourceRepository:Resources.RMC_Job_Reason}"
								Column="2"
								Visibility="{Binding ClearOldDBContext.IsClearDataDone}" />
						</igDP:FieldLayout.Fields>
					</igDP:FieldLayout>
				</igDP:DataPresenterBase.FieldLayouts>
			</controls:RMDataGrid>
			<Grid
				Row="3"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 4-->
				<controls:RMButton
					Name="btnClose"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.RMC_Button_Close}"
					IsDefault="True"
					Command="{Binding CloseCommand}" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
