<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.DBMigrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:igEditors="http://infragistics.com/Editors" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Common;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style
				TargetType="{x:Type Border}"
				x:Key="BorderStyle">
				<Setter
					Property="BorderBrush"
					Value="#FF808080" />
				<Setter
					Property="BorderThickness"
					Value="1" />
			</Style>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<converters:MigrationJobContainerStateIconConverter
				x:Key="MigrationJobContainerStateIconConverter" />
			<converters:MigrationJobContainerStateVisibilyConverter
				x:Key="MigrationJobContainerStateVisibilyConverter" />
			<converters:MigrateHistoryPBAConverter
				x:Key="MigrateHistoryPBAConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="5" />
		</Grid.RowDefinitions>
		<Grid
			Row="0"
			Visibility="{Binding DBMigrationContext.DisplayMigrationConfirmBox, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<controls:RMTextBlock
				Grid.Row="0"
				VerticalAlignment="Center"
				HorizontalAlignment="Left"
				FontSize="18"
				TextWrapping="Wrap"
				Text="{Binding DBMigrationContext.MigrationNotifyMessage}" />
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="3">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="10" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Grid
					Row="0">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="5" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<controls:RMRadioButton
						Grid.Row="0"
						Content="{x:Static resourceRepository:Resources.DB_MIGRATION_EXCLUDE_HISTORY_PBAS}"
						IsChecked="{Binding Path=DBMigrationContext.NeedMigrateHistoryPBA, Converter={StaticResource MigrateHistoryPBAConverter}}" />
					<Border
						Grid.Row="2"
						Style="{StaticResource BorderStyle}">
						<Border.BorderBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Color="DarkSlateGray"
									Offset="1" />
								<GradientStop
									Color="Black"
									Offset="0" />
							</LinearGradientBrush>
						</Border.BorderBrush>
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<controls:RMTextBlock
									Grid.Column="0"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{x:Static resourceRepository:Resources.DB_MIGRATION_ESTIMATED_TIME}" />
								<controls:RMTextBlock
									Grid.Column="2"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding DBMigrationContext.EstimatedTimeToCompleteNoHistroyPBA}" />
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<controls:RMTextBlock
									Grid.Column="0"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{x:Static resourceRepository:Resources.DB_MIGRATION_ESTIMATED_DISK_SPACE}" />
								<controls:RMTextBlock
									Grid.Column="2"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding DBMigrationContext.FreeDiskSpaceRequiresNoHistroyPBA}" />
							</Grid>
						</StackPanel>
					</Border>
				</Grid>
				<Grid
					Row="2">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="5" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="5" />
					</Grid.RowDefinitions>
					<controls:RMRadioButton
						Grid.Row="0"
						Content="{x:Static resourceRepository:Resources.DB_MIGRATION_INCLUDE_HISTORY_PBAS}"
						IsChecked="{Binding Path=DBMigrationContext.NeedMigrateHistoryPBA}" />
					<Border
						Grid.Row="2"
						Style="{StaticResource BorderStyle}">
						<Border.BorderBrush>
							<LinearGradientBrush
								StartPoint="0,0"
								EndPoint="0,1">
								<GradientStop
									Color="DarkSlateGray"
									Offset="1" />
								<GradientStop
									Color="Black"
									Offset="0" />
							</LinearGradientBrush>
						</Border.BorderBrush>
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<controls:RMTextBlock
									Grid.Column="0"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{x:Static resourceRepository:Resources.DB_MIGRATION_ESTIMATED_TIME}" />
								<controls:RMTextBlock
									Grid.Column="2"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding DBMigrationContext.EstimatedTimeToCompleteWithHistroyPBA}" />
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<controls:RMTextBlock
									Grid.Column="0"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{x:Static resourceRepository:Resources.DB_MIGRATION_ESTIMATED_DISK_SPACE}" />
								<controls:RMTextBlock
									Grid.Column="2"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding DBMigrationContext.FreeDiskSpaceRequiresWithHistroyPBA}" />
							</Grid>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
			<Grid
				Row="4"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="6"
				HorizontalAlignment="Right">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 1-->
				<controls:RMButton
					Name="btnOK"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
					IsDefault="True"
					Command="{Binding MigrateRadioAndCommonResourceCommand}" />
				<!--Unknown connection ID: 2-->
				<controls:RMButton
					Name="btnNotNow"
					Grid.Column="3"
					Content="{x:Static resourceRepository:Resources.DB_MIGRATION_NO_AND_CLOSE}"
					IsDefault="True"
					Command="{Binding NotNowCommand}" />
				<!--Unknown connection ID: 3-->
				<controls:RMButton
					Name="btnNever"
					Grid.Column="5"
					Content="{x:Static resourceRepository:Resources.DB_MIGRATION_NEVER}"
					IsDefault="True"
					Command="{Binding TurnOffMigrationCommand}" />
			</Grid>
		</Grid>
		<Grid
			Row="1"
			Visibility="{Binding DBMigrationContext.DisplayResumeDialog, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="40" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<controls:RMTextBlock
				Grid.Row="0"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				Text="{x:Static resourceRepository:Resources.DB_MIGRATION_RESUME}"
				FontSize="18" />
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="3"
				HorizontalAlignment="Right">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 4-->
				<controls:RMButton
					Name="btnResume"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
					IsDefault="True"
					Command="{Binding ResumeMigrationCommand}" />
			</Grid>
		</Grid>
		<Grid
			Row="2"
			Visibility="{Binding DBMigrationContext.DisplayTemplateSelection, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="500" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<controls:RMTextBlock
				Grid.Row="0"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				Text="{x:Static resourceRepository:Resources.DB_MIGRATION_CHOOSE_UNUSED_TEMPLATE}"
				FontSize="18" />
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<!--Unknown connection ID: 5-->
			<controls:RMDataGrid
				Name="dgrSelectTemplate"
				Grid.Row="2"
				igDP:GroupByAreaLocation="None"
				ToolbarVisibility="Visible"
				SearchVisibility="Visible"
				StatusbarVisibility="Visible"
				CustomizedSelectedCount="{Binding DBMigrationContext.SelectedTemplates.Count}"
				igDP:DataSource="{Binding DBMigrationContext.OrphanTemplates, Converter={StaticResource GridViewSourceConverter}}"
				SearchCommand="{Binding SearchCommand}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type igDP:RecordSelector}"
							BasedOn="{x:Null}"
							x:Key="{x:Type igDP:RecordSelector}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type igDP:RecordSelector}">
										<CheckBox
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											IsChecked="{Binding Path=DataItem.IsChecked, Mode=TwoWay}" />
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
						<Style
							TargetType="{x:Type igDP:HeaderPrefixArea}"
							BasedOn="{x:Null}"
							x:Key="{x:Type igDP:HeaderPrefixArea}">
							<Setter
								Property="Visibility"
								Value="Visible" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type igDP:HeaderPrefixArea}">
										<CheckBox
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											IsChecked="{Binding Path=DataPresenter.DataContext.DBMigrationContext.AllMembersAreChecked, Mode=TwoWay}" />
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<igDP:DataPresenterBase.FieldSettings>
					<igDP:FieldSettings
						AllowEdit="False"
						CellClickAction="SelectRecord"
						Width="Auto" />
				</igDP:DataPresenterBase.FieldSettings>
				<igDP:DataPresenterBase.FieldLayouts>
					<igDP:FieldLayout>
						<igDP:FieldLayout.Fields>
							<igDP:Field
								Name="TemplateName"
								Label="{x:Static resourceRepository:Resources.General_Template_Name}"
								Column="1" />
						</igDP:FieldLayout.Fields>
					</igDP:FieldLayout>
				</igDP:DataPresenterBase.FieldLayouts>
			</controls:RMDataGrid>
			<Grid
				Row="3"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="5"
				HorizontalAlignment="Right">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 6-->
				<controls:RMButton
					Name="btnOK_Template"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
					IsDefault="True"
					Command="{Binding MigrationTemplateCommand}" />
			</Grid>
		</Grid>
		<Grid
			Row="3"
			Visibility="{Binding DBMigrationContext.DisplayMigrationProgress, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="5" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Grid
				Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
				</Grid.ColumnDefinitions>
				<controls:RMTextBlock
					Grid.Column="0"
					FontSize="18"
					Text="{Binding DBMigrationContext.MigrationProgressMessage}" />
				<!--Unknown connection ID: 7-->
				<Button
					Name="btnAbort"
					BorderThickness="0"
					Grid.Column="2"
					Height="30"
					Width="30"
					ToolTip="{x:Static resourceRepository:Resources.DB_MIGRATION_BTN_ABORT}"
					Style="{x:Null}"
					Command="{Binding AbortMigrationCommand}"
					Visibility="{Binding DBMigrationContext.DisplayAbortButton, Converter={StaticResource BoolToVisibilityConverter}}">
					<Image
						Source="/Motorola.CommonCPS.RadioManagement.Icons;component/StatusAnnotations_Stop_16xLG_color.png" />
				</Button>
			</Grid>
			<Grid
				Row="1"
				Background="{StaticResource BrushAccent}" />
			<!--Unknown connection ID: 8-->
			<controls:RMDataGrid
				Name="dgrJobContainer"
				Grid.Row="2"
				igDP:GroupByAreaLocation="None"
				ToolbarVisibility="Collapsed"
				SearchVisibility="Collapsed"
				StatusbarVisibility="Collapsed"
				igDP:ActiveDataItem="{Binding SelectedJobContainer}"
				igDP:DataSource="{Binding DBMigrationContext.JobContainers, Converter={StaticResource GridViewSourceConverter}}">
				<igDP:DataPresenterBase.FieldSettings>
					<igDP:FieldSettings
						AllowEdit="False"
						CellClickAction="SelectRecord"
						Width="Auto" />
				</igDP:DataPresenterBase.FieldSettings>
				<igDP:DataPresenterBase.FieldLayouts>
					<igDP:FieldLayout>
						<igDP:FieldLayout.Fields>
							<igDP:Field
								Name="ContainerName"
								Label="{x:Static resourceRepository:Resources.RMC_JobContainer_Name}"
								Column="0" />
							<igDP:Field
								Name="CreatedTime"
								Label="{x:Static resourceRepository:Resources.RMC_JobContainer_CreatedTime}"
								Column="1">
								<igDP:Field.Settings>
									<igDP:FieldSettings
										AllowEdit="false"
										EditAsType="{x:Type sys:DateTime}" />
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								BindingType="Unbound"
								Label="{x:Static resourceRepository:Resources.RMC_Tasks_Summary}"
								Width="300"
								Column="2">
								<igDP:Field.Settings>
									<igDP:FieldSettings
										CellValuePresenterStyle="{StaticResource DBMigrationProgressCellValuePresenterStyle}" />
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								BindingType="Unbound"
								Label="{x:Static resourceRepository:Resources.RMC_Job_Status}"
								Name="status"
								Column="3">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.CellValuePresenterStyle>
											<Style
												TargetType="{x:Type igDP:CellValuePresenter}">
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate>
															<Image
																Height="16"
																Width="16"
																Source="{Binding Path=DataItem.FailedItemCount, Converter={StaticResource MigrationJobContainerStateIconConverter}}"
																Visibility="{Binding Path=DataItem.Status, Converter={StaticResource MigrationJobContainerStateVisibilyConverter}}" />
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</igDP:FieldSettings.CellValuePresenterStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
							<igDP:Field
								BindingType="Unbound"
								Label="{x:Static resourceRepository:Resources.General_Details}"
								Name="JobDetail"
								Column="4">
								<igDP:Field.Settings>
									<igDP:FieldSettings>
										<igDP:FieldSettings.CellValuePresenterStyle>
											<Style
												TargetType="{x:Type igDP:CellValuePresenter}">
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate>
															<Border
																BorderThickness="{TemplateBinding BorderThickness}"
																BorderBrush="{TemplateBinding BorderBrush}"
																Background="{TemplateBinding Background}">
																<Grid>
																	<ToggleButton
																		Name="lbtDetails"
																		Content="..."
																		IsChecked="{Binding Path=DataRecord.DataItem.IsChecked, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}" />
																	<Popup
																		StaysOpen="False"
																		Placement="MousePoint"
																		IsOpen="{Binding Path=DataRecord.DataItem.IsChecked, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																		<Grid
																			Background="#FFFFFFFF">
																			<controls:RMDataGrid
																				HorizontalAlignment="Right"
																				VerticalAlignment="Top"
																				Panel.ZIndex="2"
																				BorderThickness="0"
																				igDP:GroupByAreaLocation="None"
																				ToolbarVisibility="Collapsed"
																				StatusbarVisibility="Collapsed"
																				Margin="5,5,5,5"
																				MaxHeight="200"
																				Background="#FFFFFFFF"
																				igDP:DataSource="{Binding Path=DataRecord.DataItem.Jobs, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																				<igDP:DataPresenterBase.FieldSettings>
																					<igDP:FieldSettings
																						CellClickAction="SelectRecord"
																						Width="Auto" />
																				</igDP:DataPresenterBase.FieldSettings>
																				<igDP:DataPresenterBase.FieldLayouts>
																					<igDP:FieldLayout>
																						<igDP:FieldLayout.Fields>
																							<igDP:Field
																								Name="Name"
																								Label="{x:Static resourceRepository:Resources.RMC_Job_Item}">
																								<igDP:Field.Settings>
																									<igDP:FieldSettings>
																										<igDP:FieldSettings.EditorStyle>
																											<Style
																												TargetType="{x:Type igEditors:XamTextEditor}">
																												<Setter
																													Property="igEditors:ValueEditor.IsReadOnly"
																													Value="True" />
																											</Style>
																										</igDP:FieldSettings.EditorStyle>
																									</igDP:FieldSettings>
																								</igDP:Field.Settings>
																							</igDP:Field>
																							<igDP:Field
																								Name="UIStatusDisplay"
																								Label="{x:Static resourceRepository:Resources.RMC_Job_Status}">
																								<igDP:Field.Settings>
																									<igDP:FieldSettings>
																										<igDP:FieldSettings.EditorStyle>
																											<Style
																												TargetType="{x:Type igEditors:XamTextEditor}">
																												<Setter
																													Property="igEditors:ValueEditor.IsReadOnly"
																													Value="True" />
																											</Style>
																										</igDP:FieldSettings.EditorStyle>
																									</igDP:FieldSettings>
																								</igDP:Field.Settings>
																							</igDP:Field>
																							<igDP:Field
																								Name="Reason"
																								Label="{x:Static resourceRepository:Resources.RMC_Job_Reason}">
																								<igDP:Field.Settings>
																									<igDP:FieldSettings>
																										<igDP:FieldSettings.EditorStyle>
																											<Style
																												TargetType="{x:Type igEditors:XamTextEditor}">
																												<Setter
																													Property="igEditors:ValueEditor.IsReadOnly"
																													Value="True" />
																											</Style>
																										</igDP:FieldSettings.EditorStyle>
																									</igDP:FieldSettings>
																								</igDP:Field.Settings>
																							</igDP:Field>
																						</igDP:FieldLayout.Fields>
																					</igDP:FieldLayout>
																				</igDP:DataPresenterBase.FieldLayouts>
																			</controls:RMDataGrid>
																		</Grid>
																	</Popup>
																</Grid>
															</Border>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</igDP:FieldSettings.CellValuePresenterStyle>
									</igDP:FieldSettings>
								</igDP:Field.Settings>
							</igDP:Field>
						</igDP:FieldLayout.Fields>
					</igDP:FieldLayout>
				</igDP:DataPresenterBase.FieldLayouts>
			</controls:RMDataGrid>
			<Grid
				Row="3"
				Background="{StaticResource BrushAccent}" />
			<Grid
				Row="5"
				HorizontalAlignment="Right">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--Unknown connection ID: 9-->
				<controls:RMButton
					Name="btnComplete"
					Grid.Column="1"
					Content="{x:Static resourceRepository:Resources.General_OK}"
					IsDefault="True"
					Command="{Binding CompleteCommand}"
					Visibility="{Binding DBMigrationContext.DisplayCompleteButton, Converter={StaticResource BoolToVisibilityConverter}}" />
				<!--Unknown connection ID: 10-->
				<controls:RMButton
