<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters"
	Width="400" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Common;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:MultiPasswordBoxConverter
				x:Key="MultiPasswordBoxConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Connection_Address}"
				VerticalAlignment="Center" />
			<controls:RMTextBlock
				Grid.Column="1"
				Text="{Binding Path=PasswordChangeContext.ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Connection_Port}"
				VerticalAlignment="Center" />
			<controls:RMTextBlock
				Grid.Column="1"
				Text="{Binding Path=PasswordChangeContext.ServerPort, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_User_Name}"
				VerticalAlignment="Center" />
			<controls:RMTextBlock
				Grid.Column="1"
				Text="{Binding Path=PasswordChangeContext.UserName, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.General_CurrentPassword}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 1-->
			<PasswordBox
				Name="CurrentPasswordField"
				Grid.Column="1"
				Style="{StaticResource WPFPasswordBoxStyle}" />
		</Grid>
		<Grid
			Row="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.General_NewPassword}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 2-->
			<PasswordBox
				Name="NewPasswordField"
				Grid.Column="1"
				Style="{StaticResource WPFPasswordBoxStyle}" />
		</Grid>
		<Grid
			Row="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Confirmed_Password}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 3-->
			<PasswordBox
				Name="ReEnterNewPasswordField"
				Grid.Column="1"
				Style="{StaticResource WPFPasswordBoxStyle}" />
		</Grid>
		<Grid
			Row="12"
			HorizontalAlignment="Right"
			Width="170">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 4-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding ChangePasswordCommand}">
				<ButtonBase.CommandParameter>
					<MultiBinding
						Converter="{StaticResource MultiPasswordBoxConverter}">
						<Binding
							ElementName="CurrentPasswordField" />
						<Binding
							ElementName="NewPasswordField" />
						<Binding
							ElementName="ReEnterNewPasswordField" />
					</MultiBinding>
				</ButtonBase.CommandParameter>
			</controls:RMButton>
			<!--Unknown connection ID: 5-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				Command="{Binding Close}" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="14"
			Error="{Binding PasswordChangeContext.ExceptionMessage}" />
	</Grid>
</UserControl>
