<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.UserLoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls"
	Width="400"
	Height="Auto" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Controls;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="10" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Enter_Credentials}"
				VerticalAlignment="Center" />
		</Grid>
		<Grid
			Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Connection_Address}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 2-->
			<controls:RMTextBlock
				Name="ConnectionAddress"
				Grid.Column="1"
				Text="{Binding Path=UserLoginContext.ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.RMC_Connection_Port}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 3-->
			<controls:RMTextBlock
				Name="ConnectionPort"
				Grid.Column="1"
				Text="{Binding Path=UserLoginContext.ServerPort, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="170" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.General_UserName}"
				VerticalAlignment="Center" />
			<!--Unknown connection ID: 4-->
			<controls:RMTextBox
				Name="UserNameField"
				Grid.Column="1"
				Text="{Binding Path=UserLoginContext.UserName, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>
		<Grid
			Row="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="129.2" />
				<ColumnDefinition
					Width="40.4" />
			</Grid.ColumnDefinitions>
			<controls:RMTextBlock
				Text="{x:Static resourceRepository:Resources.General_Password}"
				VerticalAlignment="Center"
				Grid.ColumnSpan="2"
				Margin="0,1,128.6,1.4" />
			<!--Unknown connection ID: 5-->
			<PasswordBox
				Name="UserPassword"
				Style="{StaticResource WPFPasswordBoxStyle}"
				Grid.ColumnSpan="3"
				Grid.Column="0"
				Margin="182,0,0,0.4" />
		</Grid>
		<Grid
			Row="10"
			HorizontalAlignment="Right"
			Width="170">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<!--Unknown connection ID: 6-->
			<controls:RMButton
				Name="btnOK"
				Content="{x:Static resourceRepository:Resources.RMC_Action_OK}"
				IsDefault="True"
				Command="{Binding LoginCommand}"
				CommandParameter="{Binding ElementName=UserPassword}" />
			<!--Unknown connection ID: 7-->
			<controls:RMButton
				Name="btnCancel"
				Grid.Column="2"
				Content="{x:Static resourceRepository:Resources.RMC_Action_Cancel}"
				IsCancel="True" />
		</Grid>
		<controls:RMErrorBar
			Grid.Row="12"
			Error="{Binding UserLoginContext.ExceptionMessage}" />
	</Grid>
</UserControl>
