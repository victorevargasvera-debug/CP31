<UserControl
	x:Class="Motorola.CommonCPS.RadioManagement.Common.TasksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igDP="clr-namespace:Infragistics.Windows.DataPresenter;assembly=InfragisticsWPF4.DataPresenter.v15.1" xmlns:resourceRepository="clr-namespace:Motorola.CommonCPS.ResourceRepository;assembly=Motorola.CommonCPS.ResourceRepository" xmlns:controls="clr-namespace:Motorola.CommonCPS.RadioManagement.Controls;assembly=Motorola.CommonCPS.RadioManagement.Controls" xmlns:converters="clr-namespace:Motorola.CommonCPS.RadioManagement.Converters;assembly=Motorola.CommonCPS.RadioManagement.Converters" xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Name="uclTaskView" xmlns:common="clr-namespace:Motorola.CommonCPS.RadioManagement.Common">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="/Motorola.CommonCPS.RadioManagement.Common;component/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:GridViewSourceConverter
				x:Key="GridViewSourceConverter" />
			<Style
				TargetType="{x:Type igDP:DataRecordCellArea}"
				x:Key="{x:Type igDP:DataRecordCellArea}">
				<Setter
					Property="FrameworkElement.ToolTip"
					Value="{Binding Path=Record.DataItem.UnhandledExceptionMsg, RelativeSource={RelativeSource Self}}" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="24">
		<!--Unknown connection ID: 2-->
		<controls:RMDataGrid
			Name="dgrJobContainer"
			igDP:GroupByAreaLocation="None"
			igDP:ActiveDataItem="{Binding SelectedJobContainer}"
			igDP:DataSource="{Binding TasksContext.JobContainers, Converter={StaticResource GridViewSourceConverter}}"
			SearchCommand="{Binding SearchCommand}">
			<igDP:DataPresenterBase.FieldSettings>
				<igDP:FieldSettings
					AllowEdit="False"
					CellClickAction="SelectRecord"
					Width="Auto" />
			</igDP:DataPresenterBase.FieldSettings>
			<igDP:DataPresenterBase.FieldLayouts>
				<igDP:FieldLayout>
					<igDP:FieldLayout.Fields>
						<igDP:Field
							Name="ContainerName"
							Label="{x:Static resourceRepository:Resources.RMC_JobContainer_Name}"
							Column="0" />
						<igDP:Field
							Name="CreatedTime"
							Label="{x:Static resourceRepository:Resources.RMC_JobContainer_CreatedTime}"
							Column="1">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									AllowEdit="false"
									EditAsType="{x:Type sys:DateTime}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							BindingType="Unbound"
							Label="{x:Static resourceRepository:Resources.RMC_Tasks_Summary}"
							Width="300">
							<igDP:Field.Settings>
								<igDP:FieldSettings
									CellValuePresenterStyle="{StaticResource JobContainersStatusCellValuePresenterStyle}" />
							</igDP:Field.Settings>
						</igDP:Field>
						<igDP:Field
							BindingType="Unbound"
							Name="Actions"
							ToolTip="{x:Static resourceRepository:Resources.RMC_ToolTip_Actions}"
							Label="{x:Static resourceRepository:Resources.RMC_General_Actions}">
							<igDP:Field.Settings>
								<igDP:FieldSettings>
									<igDP:FieldSettings.CellValuePresenterStyle>
										<Style
											TargetType="{x:Type igDP:CellValuePresenter}">
											<Style.Setters>
												<Setter
													Property="Visibility"
													Value="{Binding Path=DataItem.Status, Converter={StaticResource JobContainerStatusToVisibilityConverter}}" />
												<Setter
													Property="Template">
													<Setter.Value>
														<ControlTemplate>
															<controls:RMLinkButton
																Name="lbtCancel"
																ToolTip="{x:Static resourceRepository:Resources.RMC_Action_CancelJob_Tooltip}"
																Command="{Binding Path=DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
																CommandParameter="{Binding Path=DataRecord.DataItem, RelativeSource={RelativeSource AncestorType={x:Type igDP:DataRecordPresenter}}}">
																<Image
																	Source="/Motorola.CommonCPS.RadioManagement.Icons;component/action_Cancel_16xLG.png"
																	Height="16"
																	Width="16" />
															</controls:RMLinkButton>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style.Setters>
										</Style>
									</igDP:FieldSettings.CellValuePresenterStyle>
								</igDP:FieldSettings>
							</igDP:Field.Settings>
						</igDP:Field>
					</igDP:FieldLayout.Fields>
				</igDP:FieldLayout>
			</igDP:DataPresenterBase.FieldLayouts>
		</controls:RMDataGrid>
		<!--Unknown connection ID: 3-->
		<controls:RMButton
			Name="btnClear"
			Style="{StaticResource EditorButtonStyle}"
			Content="{x:Static resourceRepository:Resources.RMC_Action_Clear}"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Width="95"
			Command="{Binding ClearCommand}" />
	</Grid>
</UserControl>
