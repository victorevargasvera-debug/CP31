<UserControl
	x:Class="AcpUITTS.AcpTTSTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI" xmlns:AcpUITTSNS="clr-namespace:AcpUITTS" xmlns:igEditors="http://infragistics.com/Editors">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibility" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Background="#00FFFFFF"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		Width="Auto"
		Height="Auto"
		ShowGridLines="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="50*" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<!--Unknown connection ID: 1-->
		<AcpUINS:AcpTableTextBox
			Name="AcpTextBoxMember"
			Grid.Column="0"
			MinWidth="100"
			Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}"
			IsAcpValid="{Binding Path=IsAcpValid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}"
			IsAcpApplicable="{Binding Path=IsAcpApplicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}"
			IsAcpEditable="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}"
			MaxLength="{Binding Path=MaxLengthTts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}" />
		<!--Unknown connection ID: 2-->
		<AcpUITTSNS:AcpTTSButton
			Name="TTSBtn"
			Grid.Column="1"
			Width="20"
			Height="20"
			Margin="0,0,0,0"
			TTS="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}"
			Speaker="{Binding Path=TargetSpeaker, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUITTSNS:AcpTTSTextBox}}}" />
	</Grid>
</UserControl>
